<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The floating bubble. This is the whole reason the app exists — it is the
      only way on Android to put a control on top of Pokémon GO, and there is no
      iOS equivalent at all.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      The bubble is hosted by a foreground service so Android does not reclaim
      it while the user is in another app, which is precisely when it is needed.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
      Required alongside the `location` foreground service type below. Without
      the type, Android blocks location reads from this service the moment our
      activity is not visible — which is ALWAYS, because the bubble exists to be
      used while Pokémon GO is on screen.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Coarse is enough to pick the nearest gym in a single park. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PogoTxk"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          TWO service types, and the `location` one is load-bearing rather than
          decorative.

          `specialUse` alone was a functional bug, not just a Play-review
          problem. Since Android 10 an app may only read location while it has a
          visible activity OR a foreground service typed `location`. This
          service's whole purpose is to run while our activity is NOT visible —
          Pokémon GO is on screen — so with `specialUse` alone every location
          read from the bubble returns null off a real device, and flares post
          with no gym attached. The emulator hid this because the app had just
          been in the foreground.

          Declaring `location` also keeps us out of the harder Play review:
          foreground-service location is a separate, much more routine
          declaration than ACCESS_BACKGROUND_LOCATION, which we deliberately do
          NOT request.
        -->
        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="location|specialUse">
            <!--
              Android 14 requires a justification for `specialUse`. This is it:
              a persistent floating control that has to outlive our own UI,
              because its entire purpose is to be usable while another app is in
              the foreground.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent floating shortcut so community members can report a raid while playing another app." />
        </service>
    </application>
</manifest>
