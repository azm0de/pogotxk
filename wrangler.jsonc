{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pogotxk",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // Non-secret configuration lives here, NOT in the dashboard.
  //
  // `wrangler deploy` deletes every plain-text var not present in this file
  // before applying the ones that are — and Workers Builds runs a deploy on
  // every push. A var added through the dashboard therefore survives only
  // until the next commit. Secrets are exempt and are never deleted.
  //
  // The Discord client id is a public identifier: it appears in the OAuth URL
  // in the user's address bar on every sign-in. Committing it is safe, and it
  // makes the value deploy-stable. The client SECRET must stay a dashboard
  // secret and must never appear here.
  // The VAPID public key is likewise public by design — it is handed to every
  // browser as `applicationServerKey` when a push subscription is created, so
  // it is in the client bundle regardless. Its private half is a Secret.
  //
  // Do not rotate this pair casually: a browser binds its subscription to the
  // key it subscribed with, so a new pair silently orphans every existing
  // subscription. They keep receiving nothing, with no error anywhere.
  // The guild id is a public identifier too — any member can read it off the
  // server icon with Developer Mode on. Setting it turns ON the membership
  // check: from here, people outside the Discord sign in as guests.
  //
  // DISCORD_BOOTSTRAP_ADMIN_ID is deliberately NOT here. It is a personal
  // Discord user id in a public repo, and it marks an account as permanently
  // admin — no reason to advertise which one. It lives as a Secret, which
  // survives deploys just as reliably.
  //
  // Order matters if this is ever re-done from scratch: set the bootstrap
  // secret BEFORE the guild id. Once a guild is configured Discord becomes
  // authoritative over roles, and with no DISCORD_ROLE_* ids set yet every
  // member resolves to `member` — which would overwrite a hand-promoted admin
  // on their next sign-in.
  "vars": {
    "DISCORD_CLIENT_ID": "1534670096256073778",
    "DISCORD_GUILD_ID": "1249232349972004897",
    "VAPID_PUBLIC_KEY": "BHiriS0MKh0cyP6a6frGjAkGnMTJtO-QJqguGei8k9wgA4ffHi6R4L6_LPGJ7NzoD4cwS_G9qD1dia_5_R9i8-c"
  },

  // Belt and braces: preserve any other plain-text var set in the dashboard
  // (for example DISCORD_GUILD_ID) instead of wiping it on the next deploy.
  "keep_vars": true,

  // D1 — POIs, posts, meetups, users, flares, settings.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pogotxk-db",
      "database_id": "574a5165-3259-4e4a-bb6a-bd87356c8283",
      "migrations_dir": "migrations"
    }
  ],

  // R2 — photo originals, KMZ uploads, PDFs.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "pogotxk-media"
    }
  ],

  // KV — ScrapedDuck payloads, cached settings.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "3141511cbac84035a73941fca56449c1"
    }
  ],

  // Durable Object — live board (flares + presence) over WebSocket hibernation.
  //
  // The class is re-exported onto the Worker entry by the `exportDurableObjects`
  // Vite plugin in astro.config.mjs: Cloudflare resolves a binding by looking
  // for a named export on the deployed script, and the Astro adapter's entry
  // only exports `default` on its own. Verified in dist/server/entry.mjs.
  //
  // SQLite-backed (`new_sqlite_classes`) rather than the legacy key-value
  // storage — it is the current default and the only option on the free plan.
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveBoard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveBoard"] }]

  // NO CRON. Deliberately.
  //
  // A `*/30 * * * *` trigger was declared here before the handler existed, and
  // the Astro adapter emits a worker entry exporting only `default` — verified:
  // `dist/server/entry.mjs` contains no `scheduled()`. Cloudflare would have
  // invoked the trigger and failed with "Handler does not export a scheduled()
  // function" every thirty minutes, forever, into an observability-enabled
  // Worker. A permanent error stream is a worse trade than a cold cache.
  //
  // It is not needed for correctness: `getFeed` in src/lib/scrapedduck.ts
  // refreshes lazily on read and falls back to the last good copy when upstream
  // is unreachable, so pages stay correct without it. The only cost is that the
  // first visitor after the freshness window waits for the upstream fetch.
  //
  // To add it back properly: @astrojs/cloudflare passes `auxiliaryWorkers`
  // through to the Cloudflare Vite plugin. Register a second worker that
  // exports `scheduled()` and calls `refreshAllFeeds`, then put the cron on
  // that worker rather than this one.
}
