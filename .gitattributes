# Normalize line endings so Windows and the Linux build container agree.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.kmz binary
*.woff binary
*.woff2 binary

# gradlew must stay executable and LF-terminated for CI/Linux.
gradlew text eol=lf
*.jar binary
