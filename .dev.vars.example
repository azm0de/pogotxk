# Copy to `.dev.vars` for local development. Never commit the real file.
# In production these are set with `wrangler secret put <NAME>` or in the
# Cloudflare dashboard under Workers > pogotxk > Settings > Variables.

# --- Discord OAuth (https://discord.com/developers/applications) ---
#
# In the developer portal, the ONLY thing that must be configured is the
# redirect URI, under OAuth2 > Redirects. Scopes are sent per-request in the
# authorize URL, so the "OAuth2 URL Generator" checkboxes are just a link
# builder and are not part of this flow.
#
# Register both:
#   http://localhost:4321/auth/callback                                   (dev)
#   https://<your-worker>.workers.dev/auth/callback                       (prod)
#   https://pokemontxk.com/auth/callback                       (custom domain - not live yet)
#
# Public Client must be ON (OAuth2 tab). The device sign-in at /auth/device
# needs it, and the ordinary token endpoint still accepts the client secret
# below alongside PKCE, so nothing else changes. Details and the second portal
# step (Social SDK enrollment) are in vault/Auth and Roles.md. The secret itself
# is still used from the server side only.
#
# pokemontxk.com is NOT live yet: it still runs the old static site, so do not
# register its redirect until that domain points at this Worker.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your Discord server. Enable Developer Mode (Settings > Advanced), then
# right-click the server icon > Copy Server ID.
#
# Not a secret: in production it is a plain var in wrangler.jsonc, in the open.
# The dev platform proxy only surfaces .dev.vars, though, so local dev needs its
# own copy, or getDiscordEvents reports "DISCORD_GUILD_ID is not set" and the
# "Next meetup" card falls back to its empty state. Define it ONCE, here - a
# second definition further down silently wins over this one.
DISCORD_GUILD_ID=1249232349972004897

# Reading guild roles at sign-in needs no bot: it uses the signed-in user's own
# access token via the `guilds.members.read` scope. The "Next meetup" board is
# different - it reads the server's scheduled events and DOES need a bot token
# (DISCORD_BOT_TOKEN, further down).

# Role IDs from your Discord server, mapped to site roles.
# Enable Developer Mode in Discord, then right-click a role > Copy Role ID.
# All optional. Without them, anyone in the guild becomes a `member` and nobody
# is made an admin by Discord. That is intended: admins are standalone accounts
# (see the bootstrap note below).
DISCORD_ROLE_ADMIN=
DISCORD_ROLE_AMBASSADOR=
# Optional. If set, this specific role is required to count as a member —
# for servers that gate behind a verification step. If unset, being in the
# guild at all is enough.
DISCORD_ROLE_MEMBER=

# DELIBERATELY UNSET IN PRODUCTION - LEAVE BLANK. The code still honours this
# id (one Discord account that always resolves to admin), so setting it would
# bring back a single point of failure the password door exists to remove. The
# way an admin is made is a standalone account with a password:
#
#   npm run set:password -- --create <name> --email you@example.com
#
# run from a real console (PowerShell or Windows Terminal; it refuses Git Bash).
# For a throwaway local admin without a prompt: npx tsx scripts/dev-admin.ts
# --create <name>. See vault/Auth and Roles.md.
DISCORD_BOOTSTRAP_ADMIN_ID=

# --- Discord fan-out (optional) ---
# Server Settings > Integrations > Webhooks > New Webhook, then Copy Webhook URL.
# Flares post here as rich embeds. Only discord.com / discordapp.com hosts are
# accepted — anything else is refused rather than forwarding your community's
# flares to someone else's server.
DISCORD_WEBHOOK_URL=

# --- Web Push (optional) ---
# Generate a keypair with:  npm run gen:vapid
# Set ALL THREE or push stays off; the site degrades quietly without them.
#
# The public key is served to browsers from /api/push/subscribe rather than
# committed, so neither half of the pair needs to live in git.
#
# VAPID_SUBJECT must be mailto: or https:// — Apple's push service returns 403
# for anything else, which breaks iOS only and looks like "push just doesn't
# work on iPhones".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Admin password reset by email (optional) ---
#
# Turns on /admin/reset. Without BOTH of these the endpoint is inert: it writes
# no token, sends nothing, and answers exactly as it does for an address it
# does not know — so a half-finished configuration cannot mint a link for a
# message that will never arrive.
#
# Get the key from https://resend.com > API Keys. A sending-only key is enough;
# this app never reads mail. Only api.resend.com is ever contacted, checked in
# code, because the request carries this key in an Authorization header and a
# wrong host would hand it to somebody else along with a live reset link.
RESEND_API_KEY=
#
# The From address. It must be on a domain VERIFIED IN RESEND — an unverified
# one is refused, and the reset flow cannot report that to the person who asked
# without also telling a stranger which addresses are registered, so it would
# fail silently. A bare address only: no "Name <addr>" display form.
RESEND_FROM=

# Sessions need no secret: tokens are random and stored as SHA-256 hashes
# rather than signed, so there is nothing to sign with.
#
# Reset tokens need none either, and for the same reason — 32 random bytes in
# the link, their SHA-256 in the row.

# --- Maintenance endpoints ---
# Bearer token for the two import endpoints ONLY: /api/admin/import-legacy and
# /api/admin/import-media. Those accept either an admin session or this token.
# It is not a stopgap and it does not unlock anything else - config-check, for
# one, takes an admin session only. A curl call with the token also needs
# -H "Origin: https://<site>" (or a JSON content type), or Astro's CSRF check
# answers 403 before the route runs. Generate with: openssl rand -hex 32
IMPORT_TOKEN=

# Discord scheduled-event sync for the "Next meetup" card (discord-events.ts).
# Needs DISCORD_GUILD_ID (defined once, above) AND a bot token. Read-only bot
# ("Pogo TXK Events", View Channels only). Production keeps this in
# `wrangler secret put DISCORD_BOT_TOKEN`, never in a file. Without it the card
# falls back to its empty state.
DISCORD_BOT_TOKEN=
