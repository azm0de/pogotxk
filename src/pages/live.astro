---
/**
 * The live board.
 *
 * Rendered server-side with the current flares so the page is correct before
 * any JavaScript runs — which also means the island hydrates onto real markup
 * rather than a spinner, and the WebSocket only ever has to carry deltas.
 */
import { env } from 'cloudflare:workers';
import Base from '~/layouts/Base.astro';
import Attribution from '~/components/game/Attribution.astro';
import LiveBoard from '~/components/live/LiveBoard';
import { hasRole } from '~/lib/auth/types';
import { getViewerRsvps, isoNow, listActiveFlares } from '~/lib/db/flares';

export const prerender = false;

const user = Astro.locals.user;
const now = isoNow();

const [flares, mine] = await Promise.all([
  listActiveFlares(env.DB, now),
  user ? getViewerRsvps(env.DB, user.id) : Promise.resolve({}),
]);
---

<Base
  title="Live Board"
  description="Raids, gym takedowns, trades and remote invites happening right now around Texarkana. Raise a flare and the community sees it instantly."
>
  <div class="live-page">
    <LiveBoard
      client:load
      initialFlares={flares}
      initialNow={now}
      initialMine={mine}
      canPost={hasRole(user, 'member')}
      signedIn={!!user}
      currentUserId={user?.id ?? null}
      canModerate={hasRole(user, 'ambassador')}
    />

    {
      /*
       * A raid flare puts a Leek Duck boss sprite on this page (proxied through
       * our own origin, never hotlinked), so this page uses their data and owes
       * the credit both projects require. Outside every conditional on purpose:
       * it has to survive a board with nothing on it and a feed that failed.
       */
    }
    <div class="live-credit">
      <Attribution />
    </div>
  </div>
</Base>

<style>
  /*
   * The board's own type. Body and UI in Atkinson Hyperlegible Next; the
   * signage face is set per element inside the island. The global `body` rule
   * still points at the old stack and is the chrome wave's to flip, so this is
   * set on the page wrapper and inherits into the island.
   *
   * The Moltres art band that used to run down this page is gone. The direction
   * has no Pokémon watermarks on its surfaces, and this one least of all: it is
   * a log whose height changes every time a flare comes or goes. The file stays
   * in `public/art/` for whatever wants it next.
   */
  .live-page {
    font-family: var(--font-read);
  }

  .live-credit {
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-bottom: var(--space-12);
  }
</style>
