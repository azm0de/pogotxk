---
import Base from '~/layouts/Base.astro';
import { safeNext } from '~/lib/auth/next';

export const prerender = false;

/**
 * Approve the sign-in from a Discord that is already signed in, instead of
 * typing credentials into one that is not.
 *
 * This page exists for browsing contexts whose cookie jar has never held a
 * Discord session — a fresh Safari, the installed home-screen app on iOS, a
 * Mac web app, and every phone browser. The redirect flow cannot help there:
 * its next screen is the email-and-password form, which members never see in
 * our flow. Here they tap through to discord.com/activate (or open it on their
 * phone) and press Approve inside the Discord app.
 *
 * How members arrive: **every phone browser**, sent here by
 * `phoneSignInTarget` before `/auth/login` ever redirects, and installed apps
 * via `divertSignInToBrowser`. Not, in practice, by the callback catching
 * `login_required` — this note used to say Discord answers that, and it does
 * not. Measured 2026-09-05: `prompt=none` with no Discord cookie returns `200`
 * and Discord's own login page, so the browser never comes back for the
 * callback to route. That is the bug this page spent months unreachable behind.
 *
 * The page only ever handles the short user code. The device code — the
 * credential Discord redeems — lives in an HttpOnly cookie between polls and
 * is never in this document.
 */

const next = safeNext(Astro.url.searchParams.get('next'));

// Already signed in — nothing to approve. Straight through.
if (Astro.locals.user) return Astro.redirect(next, 302);

const browserHref = `/auth/login?retry=1${next !== '/' ? `&next=${encodeURIComponent(next)}` : ''}`;
---

<Base title="Approve sign-in">
  <section class="device container" data-device data-next={next}>
    <header class="device-head">
      <h1>Approve in Discord</h1>
    </header>

    <p class="lede">
      No password, no typing — your Discord app opens with everything filled in, and you tap{' '}
      <strong>Approve</strong>.
    </p>

    <div class="panel code-panel" data-panel hidden>
      {/*
        No target="_blank". From a home-screen app, _blank forces the in-app
        browser sheet — the same empty cookie jar this page exists to escape,
        so Discord asked for a login one hop later. A same-tab tap is what
        lets iOS hand the link to the Discord app instead: discord.com's own
        universal-link manifest registers /activate for exactly this. And when
        the handoff fires, this page never actually navigates, so polling
        carries on underneath. The script re-adds _blank only for ordinary
        desktop browsers, where a new tab keeps this page visible.
      */}
      <a
        class="btn btn--discord btn--arrow"
        data-open
        href="https://discord.com/activate"
        rel="noopener noreferrer"
      >
        Open Discord to approve
      </a>
      <p class="code-line">
        Code <strong class="code" data-code aria-label="Your approval code"></strong> — already
        filled in for you. It only needs typing if you approve from a different device.
      </p>
      <p class="hint">
        If a login page opens instead of your Discord app, close it — then open{' '}
        <strong>discord.com/activate</strong> inside the Discord app (or any signed-in Discord)
        and enter the code above.
      </p>
    </div>

    {/*
      Two lines, deliberately. The status is the live region and speaks only
      when something changes; the countdown ticks every second and is kept out
      of it, or a screen reader would read the clock aloud sixty times a minute.
    */}
    <div class="panel device-status">
      <p class="status-msg" data-status role="status" aria-live="polite">Getting your code…</p>
      <p class="countdown" data-countdown hidden></p>
    </div>

    <div class="actions cluster">
      <button class="btn btn--outline btn--arrow" data-restart type="button" hidden>
        Get a new code
      </button>
    </div>

    <p class="fallback">
      Cannot approve from the Discord app?{' '}
      <a class="target" href={browserHref} data-browser>Sign in in this browser instead</a>.
    </p>

    <noscript>
      <p class="fallback">
        This page needs JavaScript to poll for your approval. You can still{' '}
        <a class="target" href={browserHref}>sign in in this browser</a>.
      </p>
    </noscript>
  </section>
</Base>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-device]');
    if (!root) return;

    const panel = root.querySelector('[data-panel]');
    const codeEl = root.querySelector('[data-code]');
    const openEl = root.querySelector('[data-open]');
    const statusEl = root.querySelector('[data-status]');
    const clockEl = root.querySelector('[data-countdown]');
    const restartEl = root.querySelector('[data-restart]');
    const next = root.getAttribute('data-next') || '/';

    let interval = 5;
    let deadline = 0;
    let timer = 0;
    let ticker = 0;
    let warned60 = false;
    let warned30 = false;

    const say = (text) => {
      statusEl.textContent = text;
    };

    const stop = () => {
      if (timer) clearTimeout(timer);
      timer = 0;
    };

    /*
     * The 300 seconds were invisible: the page waited in silence and then
     * snapped to "expired". The clock is visible text, updated every second,
     * and the live region is spoken to only twice before the end.
     */
    const two = (n) => String(n).padStart(2, '0');

    const stopClock = () => {
      if (ticker) clearInterval(ticker);
      ticker = 0;
      clockEl.hidden = true;
    };

    const renderClock = () => {
      const left = Math.max(0, Math.round((deadline - Date.now()) / 1000));
      clockEl.textContent = `Code expires in ${Math.floor(left / 60)}:${two(left % 60)}`;
      if (left <= 0) {
        stopClock();
        return;
      }
      if (left <= 30 && !warned30) {
        warned30 = true;
        say('Thirty seconds left to approve this code.');
      } else if (left <= 60 && !warned60) {
        warned60 = true;
        say('One minute left to approve this code.');
      }
    };

    const startClock = () => {
      warned60 = false;
      warned30 = false;
      clockEl.hidden = false;
      renderClock();
      ticker = setInterval(renderClock, 1000);
    };

    /*
     * The device grant can be unavailable — Discord down, or the grant gated
     * for this app. The page's whole fallback story is that the browser link
     * below is always there, so unavailability demotes the device UI rather
     * than erroring the page.
     */
    const unavailable = () => {
      stop();
      stopClock();
      panel.hidden = true;
      restartEl.hidden = true;
      say('Approving from Discord is not available right now — use the browser sign-in below.');
    };

    const finished = (text, canRestart) => {
      stop();
      stopClock();
      restartEl.hidden = !canRestart;
      say(text);
    };

    const tick = async () => {
      if (Date.now() > deadline) {
        finished('That code expired before it was approved.', true);
        return;
      }
      let out;
      try {
        const res = await fetch('/api/auth/device/poll', { method: 'POST' });
        out = await res.json();
      } catch {
        // Offline blip — keep the cadence, the cookie is patient.
        timer = setTimeout(tick, interval * 1000);
        return;
      }

      if (out.status === 'ok') {
        finished('Approved. Signing you in…', false);
        window.location.href = out.next || next;
        return;
      }
      if (out.status === 'pending') {
        // RFC 8628: slow_down means add five seconds, permanently.
        if (out.slowDown) interval += 5;
        timer = setTimeout(tick, interval * 1000);
        return;
      }
      if (out.status === 'denied') {
        finished('That sign-in was declined in Discord. Nothing was changed.', true);
        return;
      }
      if (out.status === 'expired') {
        finished('That code expired before it was approved.', true);
        return;
      }
      finished(out.message || 'Something went wrong talking to Discord.', true);
    };

    const start = async () => {
      stop();
      stopClock();
      restartEl.hidden = true;
      panel.hidden = true;
      say('Getting your code…');
      let out;
      try {
        const res = await fetch('/api/auth/device/start', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ next }),
        });
        if (!res.ok) {
          unavailable();
          return;
        }
        out = await res.json();
      } catch {
        unavailable();
        return;
      }

      interval = out.interval || 5;
      deadline = Date.now() + (out.expiresIn || 300) * 1000;
      codeEl.textContent = out.userCode;
      openEl.href = out.verificationUriComplete;
      /*
       * Same-tab wherever the Discord app could claim the link — an installed
       * web app, or any iPhone/iPad — so the universal link can hand off to
       * the app. A new tab only for ordinary desktop browsers, where it keeps
       * this polling page visible while the approval happens next door.
       */
      const standalone =
        window.matchMedia?.('(display-mode: standalone)').matches ||
        window.navigator.standalone === true;
      const iOS = /iPhone|iPad|iPod/.test(navigator.userAgent) ||
        (navigator.userAgent.includes('Mac') && navigator.maxTouchPoints > 1);
      if (!standalone && !iOS) openEl.target = '_blank';
      panel.hidden = false;
      say('Waiting for you to approve…');
      startClock();
      timer = setTimeout(tick, interval * 1000);
    };

    // Coming back from the Discord app is the moment the approval usually just
    // landed — poll immediately instead of waiting out the interval. The clock
    // keeps running; only the poll timer is reset.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && timer) {
        stop();
        void tick();
      }
    });

    restartEl.addEventListener('click', () => void start());
    void start();
  })();
</script>

<style>
  .device {
    /* `--measure` (68ch) reads ~96 characters a line in Atkinson; capped at the
       58-60ch the token is being retuned to, and still follows it downward. */
    --read-measure: min(var(--measure), 60ch);
    max-width: var(--container-narrow);
    padding-block: var(--space-section) var(--space-16);
    font-family: var(--font-read);
  }
  .device > * + * {
    margin-block-start: var(--space-5);
  }

  .device-head {
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--text);
  }
  .device h1 {
    margin: 0;
    font-family: var(--font-sign);
    font-size: var(--display-lg);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
  }
  .lede {
    margin: 0;
    max-width: var(--read-measure);
    font-size: var(--text-lg);
    line-height: var(--lh-body);
  }

  /*
   * The button is the hero; the code is a verification detail. It used to be
   * the loudest thing on the page, which read as "copy this somewhere" — a
   * ceremony the prefilled link makes unnecessary. Still monospace with real
   * letter spacing, because O/0 confusion in the fallback case is a support
   * thread.
   */
  .code-panel {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .code-line,
  .hint {
    margin: 0;
    max-width: var(--read-measure);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .code {
    font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    color: var(--text);
  }

  /* Was a gym-orange border-left callout. It is a status, so it is quiet: a
     panel with the small shadow and no colour of its own. */
  .device-status {
    --panel-pad: var(--space-4);
    display: grid;
    gap: var(--space-1);
    box-shadow: var(--shadow-sm);
  }
  .status-msg {
    margin: 0;
    font-size: var(--text-md);
  }
  .countdown {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .actions {
    --cluster-gap: var(--space-3);
  }
  /* An empty flex row still takes its own margin; with the only button hidden
     the page would carry a stray gap. */
  .actions:not(:has(> *:not([hidden]))) {
    display: none;
  }

  .fallback {
    margin: 0;
    max-width: var(--read-measure);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
