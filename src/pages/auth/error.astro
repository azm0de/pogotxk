---
import Base from '~/layouts/Base.astro';
import { DISCORD_INVITE } from '~/lib/socials';

export const prerender = false;

const reason = Astro.url.searchParams.get('reason') ?? '';

// Discord's own error codes are terse; translate the ones people actually hit.
const EXPLANATIONS: Record<string, string> = {
  access_denied: 'You cancelled the Discord sign-in, so nothing was changed.',
  'State mismatch':
    'The sign-in request could not be verified. This usually means it was started in another tab or took too long. Try again.',
  'Sign-in session expired, please try again':
    'The sign-in took longer than ten minutes. Start again and it should go straight through.',
  'This account is banned': 'This account has been banned from the site. Contact an ambassador on Discord.',
  'Discord sign-in is not configured':
    'Discord sign-in has not been set up on this deployment yet.',
};

const explanation = EXPLANATIONS[reason];

/*
 * The page used to lead with `Error 400` and print the raw reason louder than
 * the help. The HTTP status told nobody anything they could act on, so it is
 * gone from the page entirely; the explanation is the lede, and the raw string
 * only survives when we have nothing better to say about it.
 *
 * The recovery follows the reason: a banned account cannot try again, a
 * cancelled sign-in was deliberate, and a misconfigured deployment is not the
 * reader's problem to retry.
 */
const banned = reason === 'This account is banned';
const cancelled = reason === 'access_denied';
const misconfigured = reason === 'Discord sign-in is not configured';
const canRetry = !banned && !misconfigured;

const lede =
  explanation ?? 'The sign-in did not finish, so nothing was changed and you are not signed in.';
---

<Base title="Sign-in problem">
  <section class="auth-error container">
    <div class="panel">
      <div class="panel-head">
        <h1>Could not sign you in</h1>
      </div>

      <p class="lede">{lede}</p>

      {/* Only when the reason is one we cannot explain: it is a detail, not the message. */}
      {!explanation && reason && <p class="detail">Discord reported: {reason}</p>}

      <div class="actions cluster">
        {
          banned && (
            <a
              class="btn btn--discord btn--arrow"
              href={DISCORD_INVITE}
              rel="noopener noreferrer"
              target="_blank"
            >
              Contact an ambassador on Discord
            </a>
          )
        }
        {canRetry && <a class="btn btn--primary btn--arrow" href="/auth/login">Try again</a>}
        {
          cancelled ? (
            <a class="btn btn--outline btn--arrow" href="/">Back home</a>
          ) : (
            <a class="btn btn--outline btn--arrow" href="/map">Back to the map</a>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .auth-error {
    /* `--measure` (68ch) reads ~96 characters a line in Atkinson; capped at the
       58-60ch the token is being retuned to, and still follows it downward. */
    --read-measure: min(var(--measure), 60ch);
    padding-block: var(--space-section) var(--space-16);
    font-family: var(--font-read);
    max-width: var(--container-narrow);
  }
  .auth-error h1 {
    font-family: var(--font-sign);
    font-size: var(--display-lg);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
  }
  .lede {
    margin: 0;
    max-width: var(--read-measure);
    font-size: var(--text-lg);
    line-height: var(--lh-body);
  }
  .detail {
    margin: var(--space-3) 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .actions {
    margin-top: var(--space-6);
    --cluster-gap: var(--space-3);
  }
</style>
