---
/**
 * The news index. Pinned posts first, then newest, twelve to a page.
 *
 * Nothing here decides what is public — `listPublishedPosts` does, against the
 * database clock, so a post scheduled for tonight starts appearing on this page
 * by itself.
 */

import { env } from 'cloudflare:workers';
import Base from '~/layouts/Base.astro';
import { listPublicTags, listPublishedPosts, normalizeTag } from '~/lib/db/posts';
import { DEFAULT_TZ } from '~/lib/time';

export const prerender = false;

const PAGE_SIZE = 12;

const params = Astro.url.searchParams;
const rawTag = params.get('tag');
// Normalise rather than 404 — `?tag=Raid Hour` should find the `raid-hour` tag.
const tag = rawTag ? normalizeTag(rawTag) || null : null;
// Clamped, not just floored: `?page=1e999` parses to Infinity, and an infinite
// OFFSET reaches D1 as an invalid binding and 500s the page. An upper bound
// costs nothing — no real feed is a million pages deep.
const MAX_PAGE = 10_000;
const rawPage = Math.floor(Number(params.get('page')) || 1);
const page = Number.isFinite(rawPage) ? Math.min(Math.max(1, rawPage), MAX_PAGE) : 1;

interface Photo {
  id: number;
  r2_key: string;
  alt: string | null;
  caption: string | null;
  credit: string | null;
  source_title: string | null;
  source_date: string | null;
  source_url: string | null;
  created_at: string | null;
  width: number | null;
  height: number | null;
  lat: number | null;
  lng: number | null;
}

/*
 * The photo band is a fixture of the page, not part of the paged post feed:
 * repeating it under page 3 would be noise, and showing every community photo
 * beneath a list filtered to one tag is answering a question nobody asked. It is
 * only queried where it is rendered.
 */
const wantPhotos = !tag && page === 1;

const [{ posts, total }, tags, photoRows] = await Promise.all([
  listPublishedPosts(env.DB, { limit: PAGE_SIZE, offset: (page - 1) * PAGE_SIZE, tag }),
  listPublicTags(env.DB),
  wantPhotos
    ? env.DB.prepare(
        `SELECT id, r2_key, alt, caption, credit, source_title, source_date, source_url,
                created_at, width, height, lat, lng
           FROM media
          WHERE kind = 'community_photo'`,
      )
        .all<Photo>()
        .then((r) => r.results)
        .catch(() => [] as Photo[])
    : Promise.resolve([] as Photo[]),
]);

/**
 * Sorted here rather than in the query, because `source_date` is a label and not
 * a date column. Press photos carry the string their article printed — "November
 * 3, 2024" — while uploads carry an ISO timestamp, and the column is rendered
 * verbatim, so it cannot simply be normalised to one format without changing
 * what the caption says.
 *
 * `ORDER BY` over that is a string sort, which is how /gallery came to render
 * its newest photo last: "November" sorts above "July" above "December" above
 * "2026-08-06", alphabetically. Parsing both shapes and sorting on the instant
 * is the fix. Anything unparseable falls back to `created_at`, then to the
 * epoch, so a bad value sinks to the bottom instead of jumping to the top.
 */
const photoTime = (p: Photo) => {
  const printed = p.source_date ? Date.parse(p.source_date) : Number.NaN;
  if (!Number.isNaN(printed)) return printed;
  const created = p.created_at ? Date.parse(p.created_at) : Number.NaN;
  return Number.isNaN(created) ? 0 : created;
};
const photos = [...photoRows].sort((a, b) => photoTime(b) - photoTime(a) || b.id - a.id);

/** A tall photo should be allowed to be tall, rather than cropping the community
    out of its own gallery. */
const isPortrait = (p: Photo) => (p.width && p.height ? p.height > p.width * 1.15 : false);

const pageCount = Math.max(1, Math.ceil(total / PAGE_SIZE));

// Dates are shown in Texarkana's zone: a post published at 11 PM Central should
// carry that evening's date, not tomorrow's UTC one.
const dateFormat = new Intl.DateTimeFormat('en-US', {
  timeZone: DEFAULT_TZ,
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const showDate = (iso: string | null) => (iso ? dateFormat.format(new Date(iso)) : 'Unpublished');

const pageHref = (n: number) => {
  const next = new URLSearchParams();
  if (tag) next.set('tag', tag);
  if (n > 1) next.set('page', String(n));
  const query = next.toString();
  return query ? `/blog?${query}` : '/blog';
};

const title = tag ? `News tagged “${tag}”` : 'News';
const description = tag
  ? `PoGo TXK community news tagged ${tag} — meetups, raids, events and Campsite updates from Texarkana.`
  : 'Community news from PoGo TXK — meetup recaps, raid plans, event guides and Spring Lake Park Campsite updates for Texarkana trainers.';
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="PoGo TXK News" href="/rss.xml" />
    {
      /* Filtered and paged views are the same articles in a different order —
         let crawlers follow the links without indexing the permutations. */
      (tag || page > 1) && <meta name="robots" content="noindex, follow" />
    }
  </Fragment>

  <div class="blog">
    <header class="blog-hero">
      {/*
        Decorative: the `h1` beside it already says what this is, and describing
        a picnic full of trainers tells a screen-reader user nothing about the
        posts below.

        1280x720 is the whole source and the card caps at 876px, so the widest
        variant is the most any layout can ask for. 1126KB of JPEG became 236KB
        of WebP at full width, and 77KB at 640.
      */}
      <picture class="blog-hero-art">
        <img
          src="/hero/outing-1280.webp"
          srcset="/hero/outing-640.webp 640w, /hero/outing-960.webp 960w, /hero/outing-1280.webp 1280w"
          sizes="(min-width: 1004px) 876px, calc(100vw - 32px)"
          width="1280"
          height="720"
          alt=""
          decoding="async"
        />
      </picture>

      <h1>{tag ? <>Tagged <span class="blog-tagname">{tag}</span></> : 'Community news'}</h1>
      <p class="blog-lede">
        Meetup recaps, raid plans and Campsite updates from the PoGo TXK crew.{' '}
        <a class="blog-feed" href="/rss.xml">RSS feed</a>
      </p>

    </header>

    {
      tags.length > 0 && (
        <nav class="blog-tags" aria-label="Filter by tag">
          <a href="/blog" aria-current={tag ? undefined : 'page'}>
            All
          </a>
          {tags.map((t) => (
            <a
              href={`/blog?tag=${encodeURIComponent(t.tag)}`}
              aria-current={t.tag === tag ? 'page' : undefined}
            >
              {t.tag}
              <span class="blog-tag-count">{t.count}</span>
            </a>
          ))}
        </nav>
      )
    }

    {
      posts.length === 0 ? (
        <p class="blog-empty">
          {tag
            ? 'Nothing tagged that yet.'
            : 'No posts yet. Check the Discord for what is happening this week.'}
        </p>
      ) : (
        <ul class="blog-list">
          {posts.map((post) => (
            <li>
              <article class={`post-card${post.pinned ? ' post-card--pinned' : ''}`}>
                {post.hero && (
                  <a class="post-card-media" href={`/blog/${post.slug}`} tabindex="-1" aria-hidden="true">
                    <img
                      src={`/media/${post.hero.key}`}
                      alt=""
                      width={post.hero.width ?? undefined}
                      height={post.hero.height ?? undefined}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}

                <div class="post-card-body">
                  {post.pinned && <p class="post-pin">Pinned</p>}
                  <h2>
                    <a href={`/blog/${post.slug}`}>{post.title}</a>
                  </h2>
                  <p class="post-meta">
                    <time datetime={post.publishedAt ?? undefined}>{showDate(post.publishedAt)}</time>
                    {post.author && <> · {post.author.name}</>}
                  </p>
                  <p class="post-excerpt">{post.excerpt}</p>
                  {post.tags.length > 0 && (
                    <p class="post-card-tags">
                      {post.tags.map((t) => (
                        <a href={`/blog?tag=${encodeURIComponent(t)}`}>#{t}</a>
                      ))}
                    </p>
                  )}
                </div>
              </article>
            </li>
          ))}
        </ul>
      )
    }

    {
      pageCount > 1 && (
        <nav class="blog-pager" aria-label="Pagination">
          {page > 1 ? (
            <a rel="prev" href={pageHref(page - 1)}>
              ← Newer
            </a>
          ) : (
            <span aria-hidden="true" />
          )}
          <p>
            Page {page} of {pageCount}
          </p>
          {page < pageCount ? (
            <a rel="next" href={pageHref(page + 1)}>
              Older →
            </a>
          ) : (
            <span aria-hidden="true" />
          )}
        </nav>
      )
    }

    {
      photos.length > 0 && (
        <section class="photos" id="photos" aria-labelledby="photos-heading">
          <div class="photos-head">
            <h2 id="photos-heading">From the community</h2>
            <p>
              Trainers from all three teams at Spring Lake Park. Several of these were taken by
              the Texarkana Gazette — their photographers are credited on each image, and the
              original articles are linked.
            </p>
          </div>

          <ul class="photo-grid">
            {photos.map((photo) => (
              <li class={isPortrait(photo) ? 'is-tall' : undefined}>
                <figure>
                  <img
                    src={`/media/${photo.r2_key}`}
                    alt={photo.alt ?? photo.caption ?? 'PoGo TXK community photo'}
                    width={photo.width ?? undefined}
                    height={photo.height ?? undefined}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>
                    {photo.caption && <p class="photo-caption">{photo.caption}</p>}
                    <p class="photo-credit">
                      {photo.credit}
                      {photo.source_url && photo.source_title && (
                        <>
                          {' · '}
                          <a href={photo.source_url} rel="noopener noreferrer" target="_blank">
                            {photo.source_title}
                          </a>
                          {photo.source_date && ` (${photo.source_date})`}
                        </>
                      )}
                    </p>
                    {photo.lat && photo.lng && (
                      <p class="photo-where">
                        <a href={`/map?lat=${photo.lat}&lng=${photo.lng}`}>
                          Where this was taken →
                        </a>
                      </p>
                    )}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>

          {/*
            Moved here with the photographs, not left behind on the old route.
            The first sentence is a licence condition and the second is the
            promise the community was given; neither belongs to a page more than
            it belongs to the pictures.
          */}
          <p class="photo-rights">
            Press photographs remain the property of their publications and are reproduced with
            credit. If you appear in a photo and would rather not, tell any ambassador on Discord
            and it comes down — no reason needed.
          </p>
        </section>
      )
    }
  </div>
</Base>

<style>
  .blog {
    max-width: 940px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 48px) clamp(16px, 4vw, 32px) 72px;
  }

  /* --- the hero card -------------------------------------------------------
   *
   * Built the same way as the /events and /raids heroes, deliberately: art at
   * z-index −2, scrim at −1, and `isolation: isolate` so neither escapes to the
   * root stacking context and paints behind the page itself.
   */
  .blog-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-lg);
    /* Symmetric now. The bottom was the short side because the credit line sat
       in it; with that gone an uneven pad just reads as the text having slipped
       upward. */
    padding: clamp(22px, 5vw, 42px) clamp(16px, 4vw, 30px);
    color: #fff;
    /* The column used to exist to push the credit to the bottom edge. With only
       the heading and lede left, it centres them instead — anchored to the top
       of a 320px card they would sit above a pool of empty scrim. */
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Shorter than the /raids hero on purpose — this page is a list, and the
     posts should not start below the fold to make room for a picture. */
  @media (min-width: 760px) {
    .blog-hero {
      min-height: clamp(220px, 26vw, 320px);
    }
  }

  .blog-hero-art {
    display: block;
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .blog-hero-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 45% keeps the trainers and the table in the band; centre drifts up into
       sky and mountain, which is the half with nothing in it. */
    object-position: center 45%;
  }

  /*
   * The /raids scrim unchanged, but re-measured against this artwork rather
   * than assumed to carry over — it is the brightest of the three, with white
   * sky, snow and a lot of pale green. Worst case over the region text can
   * occupy is 5.21:1 at 876x320, 5.19:1 at 736x260, 5.49:1 at 343x205 and
   * 5.56:1 at 288x230, against a 4.5 threshold.
   *
   * Those were the credit line at 0.78 white, the lightest text on the card,
   * and it has since been removed — so they are a floor with room to spare now
   * rather than the real worst case. The lede is 0.92 and the heading is solid
   * white. Worth keeping because they are what any future 0.78 text is checked
   * against; it was the credit overrunning the dark plateau by 8px that
   * measured 4.07:1 and had to be wrapped.
   *
   * Pixel stops, and 90deg rather than any tilt, for the reasons written out at
   * length on `.raids-hero::before`: text occupies a fixed ~546px of the left
   * however wide the card gets, and `margin-top: auto` puts the smallest text
   * at the bottom where a tilted gradient is at its lightest.
   */
  .blog-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      90deg,
      rgb(6 8 12 / 0.72) 0px,
      rgb(6 8 12 / 0.68) 580px,
      rgb(6 8 12 / 0.22) 880px,
      rgb(6 8 12 / 0.12) 100%
    );
  }

  .blog-hero h1 {
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    margin: 0 0 6px;
    color: #fff;
  }
  .blog-lede {
    margin: 0;
    max-width: 62ch;
    color: rgb(255 255 255 / 0.92);
  }

  /* Both of these were coloured for dark text on the page background and are
     now sitting on the scrim. `--accent` is the *dark* red — it measured 2.2:1
     here — and the feed link was inheriting the same. */
  .blog-tagname {
    color: #ffb3bc;
  }
  .blog-feed {
    margin-left: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 20px 0 24px;
  }
  .blog-tags a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-panel);
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }
  .blog-tags a:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }
  .blog-tags a[aria-current='page'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }
  .blog-tag-count {
    font-size: 0.7rem;
    opacity: 0.7;
  }

  .blog-empty {
    padding: 28px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--text-muted);
    text-align: center;
  }

  .blog-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .post-card {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 18px;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: box-shadow 0.16s ease, border-color 0.16s ease;
  }
  .post-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  .post-card:not(:has(.post-card-media)) {
    grid-template-columns: 1fr;
  }
  .post-card--pinned {
    border-color: var(--accent);
  }

  /* The image is taken out of flow so the row height comes from the text
     column alone. Left in flow, a portrait hero drags the whole card to its
     own aspect ratio and a 4:3 photo and a 3:4 photo produce wildly different
     cards in the same list. */
  .post-card-media {
    position: relative;
    display: block;
    background: var(--bg-sunken);
  }
  .post-card-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .post-card:has(.post-card-media) {
    min-height: 168px;
  }

  .post-card-body {
    padding: 16px 18px 18px;
    min-width: 0;
  }
  .post-card-body h2 {
    font-size: 1.15rem;
    margin: 0 0 4px;
  }
  .post-card-body h2 a {
    color: inherit;
    text-decoration: none;
  }
  .post-card-body h2 a:hover {
    text-decoration: underline;
  }

  .post-pin {
    display: inline-block;
    margin: 0 0 6px;
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .post-meta {
    margin: 0 0 8px;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .post-excerpt {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .post-card-tags {
    margin: 10px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 0.76rem;
  }
  .post-card-tags a {
    text-decoration: none;
    font-weight: 600;
  }
  .post-card-tags a:hover {
    text-decoration: underline;
  }

  .blog-pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
  }
  .blog-pager p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .blog-pager a {
    font-weight: 600;
    text-decoration: none;
  }
  .blog-pager a[rel='next'] {
    justify-self: end;
  }
  .blog-pager a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .post-card {
      grid-template-columns: 1fr;
    }
    /* Stacked, the image is back in flow and sets its own band. */
    .post-card-media img {
      position: static;
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  /* --- the photographs -----------------------------------------------------
   * Was /gallery. A band on this page rather than a route of its own: two
   * published posts and nine photographs did not need two nav items between
   * them, and both are the same thing — what the community has been doing.
   *
   * A band and not an interleaved feed, deliberately. A post is a dated article
   * with an excerpt, tags and a page of its own; a photograph is an image whose
   * credit is a licence condition. Mixed into one stream they would need a card
   * shape that suits neither.
   */
  .photos {
    margin-top: 44px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .photos-head {
    max-width: 62ch;
    margin-bottom: 20px;
  }
  .photos-head h2 {
    margin: 0 0 6px;
    font-size: 1.3rem;
  }
  .photos-head p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .photo-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    grid-auto-rows: 190px;
    gap: 12px;
  }
  .photo-grid li {
    /* Photographs are the content here, so they get to break the grid rhythm. */
    grid-row: span 1;
  }
  .photo-grid li.is-tall {
    grid-row: span 2;
  }

  .photo-grid figure {
    margin: 0;
    height: 100%;
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-sunken);
  }
  .photo-grid figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .photo-grid figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 46px 13px 11px;
    /* The credit is a licensing obligation. It sits on the image so it cannot be
       separated from it by a layout change or a screenshot.

       Which makes legibility the scrim's job, and a two-stop
       `transparent -> 0.82` was not doing it: the gradient only reached full
       strength at the very bottom edge, so every line above the last one sat on
       bare photograph. Over the bright foliage shots the white text all but
       disappeared. These stops hold the scrim near-opaque for the whole height
       the text occupies and only fade across the top third. */
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.93) 0%,
      rgb(0 0 0 / 0.89) 38%,
      rgb(0 0 0 / 0.74) 62%,
      rgb(0 0 0 / 0.36) 84%,
      transparent 100%
    );
    color: #fff;
    /* Belt and braces for the brightest images, where even a heavy scrim leaves
       thin white type fighting a high-frequency background. */
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.55);
  }
  .photo-caption {
    margin: 0 0 4px;
    font-size: 0.8rem;
    line-height: 1.35;
  }
  .photo-credit {
    margin: 0;
    font-size: 0.68rem;
    opacity: 0.9;
  }
  .photo-credit a {
    color: #fff;
  }
  .photo-where {
    margin: 4px 0 0;
    font-size: 0.68rem;
  }
  .photo-where a {
    color: #fff;
    opacity: 0.85;
  }

  .photo-rights {
    margin: 24px 0 0;
    max-width: 68ch;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
