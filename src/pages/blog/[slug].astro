---
/**
 * A single post.
 *
 * The body is Markdown rendered by `~/lib/markdown`, which escapes everything
 * before it emits a tag — so `set:html` here is handling HTML this codebase
 * built, never HTML an author typed. It emits bare elements, which is why
 * `.prose` styles it with no `:global()` beyond the one noted below.
 */

import { env } from 'cloudflare:workers';
import Base from '~/layouts/Base.astro';
import { getPostNeighbours, getPublishedPost } from '~/lib/db/posts';
import { markdownToText, readingMinutes, renderMarkdown } from '~/lib/markdown';
import { DEFAULT_TZ } from '~/lib/time';

export const prerender = false;

const slug = Astro.params.slug!;
const post = await getPublishedPost(env.DB, slug);

if (!post) {
  // A draft and a typo look the same from outside, which is the point.
  Astro.response.status = 404;
}

const neighbours = post
  ? await getPostNeighbours(env.DB, post)
  : { newer: null, older: null };

const canonical = new URL(`/blog/${slug}`, Astro.site ?? Astro.url.origin).href;

const dateFormat = new Intl.DateTimeFormat('en-US', {
  timeZone: DEFAULT_TZ,
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const publishedIso = post?.publishedAt ?? post?.createdAt ?? null;
const bodyHtml = post ? renderMarkdown(post.bodyMd) : '';
const description = post
  ? post.excerpt || markdownToText(post.bodyMd, 200)
  : 'That post does not exist.';

// Structured data goes in the body on purpose: JSON-LD is valid anywhere in the
// document, so this works without the layout needing to grow a head slot.
const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.title,
      description,
      datePublished: publishedIso,
      dateModified: post.updatedAt,
      url: canonical,
      mainEntityOfPage: canonical,
      ...(post.hero ? { image: new URL(`/media/${post.hero.key}`, canonical).href } : {}),
      ...(post.author ? { author: { '@type': 'Person', name: post.author.name } } : {}),
      publisher: { '@type': 'Organization', name: 'PoGo TXK' },
      ...(post.tags.length ? { keywords: post.tags.join(', ') } : {}),
    }
  : null;
---

<Base
  title={post ? post.title : 'Post not found'}
  description={description}
  ogImage={post?.hero ? `/media/${post.hero.key}` : undefined}
  ogType={post ? 'article' : 'website'}
>
  <Fragment slot="head">
    {
      post && (
        <>
          {publishedIso && <meta property="article:published_time" content={publishedIso} />}
          <meta property="article:modified_time" content={post.updatedAt} />
          {post.author && <meta property="article:author" content={post.author.name} />}
          {post.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    {!post && <meta name="robots" content="noindex, follow" />}
  </Fragment>

  <div class="post-page">
    {
      post ? (
        <article class="post-article container">
          <nav class="post-back" aria-label="Breadcrumb">
            <a class="target" href="/blog">← All news</a>
          </nav>

          <header class="post-header">
            {post.pinned && <p class="badge post-pin">Pinned</p>}
            <h1>{post.title}</h1>
            <p class="post-byline">
              {post.author && (
                <span class="post-author">
                  {post.author.avatarUrl && (
                    <img class="post-avatar" src={post.author.avatarUrl} alt="" width="28" height="28" />
                  )}
                  {post.author.name}
                </span>
              )}
              <time datetime={publishedIso ?? undefined}>
                {publishedIso ? dateFormat.format(new Date(publishedIso)) : 'Unpublished'}
              </time>
              <span class="post-read">{readingMinutes(post.bodyMd)} min read</span>
            </p>

            {post.tags.length > 0 && (
              <p class="post-taglist">
                {post.tags.map((tag) => (
                  <a
                    class="badge badge--outline target"
                    href={`/blog?tag=${encodeURIComponent(tag)}`}
                  >
                    #{tag}
                  </a>
                ))}
              </p>
            )}
          </header>

          {post.hero && (
            <figure class="figure post-hero">
              <img
                src={`/media/${post.hero.key}`}
                alt={post.hero.alt ?? ''}
                width={post.hero.width ?? undefined}
                height={post.hero.height ?? undefined}
                decoding="async"
              />
              {/* The credit rides on the photograph, never beneath it: a crop or
                  a screenshot must not be able to separate the two. */}
              {post.hero.credit && <p class="credit">{post.hero.credit}</p>}
            </figure>
          )}

          <div class="post-body prose" set:html={bodyHtml} />

          {(neighbours.newer || neighbours.older) && (
            <nav class="post-nav" aria-label="More posts">
              <div class="post-nav-side">
                <p class="post-nav-label">Newer</p>
                {neighbours.newer ? (
                  <a
                    class="btn btn--outline btn--arrow-back"
                    rel="prev"
                    href={`/blog/${neighbours.newer.slug}`}
                  >
                    {neighbours.newer.title}
                  </a>
                ) : (
                  <p class="post-nav-none">This is the newest post.</p>
                )}
              </div>
              <div class="post-nav-side post-nav-side--older">
                <p class="post-nav-label">Older</p>
                {neighbours.older ? (
                  <a
                    class="btn btn--outline btn--arrow"
                    rel="next"
                    href={`/blog/${neighbours.older.slug}`}
                  >
                    {neighbours.older.title}
                  </a>
                ) : (
                  <p class="post-nav-none">This is the oldest post.</p>
                )}
              </div>
            </nav>
          )}

          {jsonLd && (
            <script
              type="application/ld+json"
              is:inline
              set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
            />
          )}
        </article>
      ) : (
        <div class="post-article post-missing container">
          <h1>Post not found</h1>
          <p>
            That link is either wrong or points at a post that has not gone live yet. Scheduled posts
            appear on their own at the time they were set for.
          </p>
          <p>
            <a class="btn btn--outline btn--arrow" href="/blog">
              Browse all news
            </a>
          </p>
        </div>
      )
    }
  </div>
</Base>

<style>
  /* The same 940px board as the index. The reading measure inside it comes from
     `.prose`, not from the container. */
  .post-page {
    --container: 940px;
    font-family: var(--font-read);
    padding-block: var(--space-section) var(--space-20);
  }

  /* `.btn` pins `var(--font)` in the primitives layer; the kiosk world's UI face
     is `--font-read`. Set here because nobody edits the primitive. */
  .post-page .btn {
    font-family: var(--font-read);
  }

  /* `post-article`, not `post`: `.post` is the numbered-post primitive — a
     two-column grid — and it laid the header out beside the body. */
  .post-article {
    /* A flex child in the column that `body` lays out, and it holds a scrolling
       table. Without this the table's intrinsic width can win. */
    min-width: 0;
    /* `--measure`'s 68ch measured 77-93 characters a line in this face: `ch` is
       the width of a zero, and Atkinson draws a wide one. Counted back down to
       ~72 characters, inside the 65-75 the craft floor asks for. */
    --prose-measure: 58ch;
  }

  .post-back {
    margin: 0 0 var(--space-4);
    font-size: var(--text-md);
  }
  .post-back a {
    text-decoration: none;
    font-weight: 700;
  }
  .post-back a:hover {
    text-decoration: underline;
  }

  /* --- the head ------------------------------------------------------------ */

  /* The head shares the body's measure so the title, byline and tags line up
     with the text under them; only the photograph runs the full board width. */
  .post-header {
    max-width: var(--prose-measure);
  }
  .post-header h1 {
    font-family: var(--font-sign);
    font-size: var(--display-lg);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }

  .post-pin {
    margin: 0 0 var(--space-3);
    --badge-bg: var(--text);
    --badge-fg: var(--bg);
  }

  .post-byline {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-md);
  }
  .post-author {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    color: var(--text);
  }
  .post-avatar {
    border-radius: 50%;
  }
  /* The separator belongs *between* two items, not in front of one. It used to
     be pinned to `time` and to `.post-read` unconditionally, so a post with no
     author opened with a stray `·`. */
  .post-byline > * + *::before {
    content: '·';
    margin-right: var(--space-3);
    color: var(--border-strong);
  }
  .post-read {
    font-variant-numeric: tabular-nums;
  }

  .post-taglist {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: var(--space-4) 0 0;
  }
  .post-taglist a {
    text-decoration: none;
    /* `.badge`'s padding is declared after `.target`'s inside the primitives
       layer, so the block padding that lifts the hit area to the 24px floor has
       to be restored here. Measured 25px tall. */
    padding-block: var(--space-1);
    margin-block: calc(var(--space-1) * -1);
  }
  .post-taglist a:hover {
    background: var(--bg-sunken);
  }

  /* --- the hero ------------------------------------------------------------ */

  .post-hero {
    margin: var(--space-8) 0 0;
    border-radius: var(--radius);
    background: var(--bg-sunken);
  }
  .post-hero img {
    display: block;
    width: 100%;
  }

  /* --- the body ------------------------------------------------------------
   * `.prose` carries the typography now; the forty `:global()` rules that used
   * to live here are gone. The one below stays because `set:html` output carries
   * no scope attribute for a plain selector to reach, so the article's headings
   * are named here explicitly (the global reset already sets them in the
   * signage face; this keeps the page correct if that ever changes).
   */
  .post-body {
    margin-top: var(--space-8);
    min-width: 0;
  }
  .post-body :global(:is(h2, h3, h4)) {
    font-family: var(--font-sign);
    font-weight: 800;
  }

  /* --- newer / older ------------------------------------------------------- */

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 2px solid var(--text);
  }
  .post-nav-side {
    min-width: 0;
  }
  /* Both sides are always labelled and always drawn, so an empty column reads as
     "there is nothing older" rather than as a layout that fell over. */
  .post-nav-label {
    margin: 0 0 var(--space-2);
    font-family: var(--font-sign);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .post-nav-none {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-md);
  }
  .post-nav-side .btn {
    width: 100%;
    justify-content: flex-start;
    text-align: left;
    font-size: var(--text-md);
    line-height: var(--lh-ui);
  }
  .post-nav-side--older {
    text-align: right;
  }
  .post-nav-side--older .btn {
    justify-content: flex-end;
    text-align: right;
  }

  /* --- not found ----------------------------------------------------------- */

  .post-missing {
    padding-top: var(--space-12);
  }
  .post-missing h1 {
    font-family: var(--font-sign);
    font-size: var(--display-md);
    font-weight: 800;
    margin: 0 0 var(--space-4);
  }
  .post-missing p {
    color: var(--text-muted);
    max-width: var(--measure);
    margin: 0 0 var(--space-4);
  }
  .post-missing p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 560px) {
    .post-nav {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .post-nav-side--older,
    .post-nav-side--older .btn {
      text-align: left;
    }
    .post-nav-side--older .btn {
      justify-content: flex-start;
    }
  }
</style>
