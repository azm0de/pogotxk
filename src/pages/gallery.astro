---
import { env } from 'cloudflare:workers';
import Base from '~/layouts/Base.astro';

export const prerender = false;

interface Photo {
  id: number;
  r2_key: string;
  alt: string | null;
  caption: string | null;
  credit: string | null;
  source_title: string | null;
  source_date: string | null;
  source_url: string | null;
  width: number | null;
  height: number | null;
  lat: number | null;
  lng: number | null;
}

const { results: photos } = await env.DB.prepare(
  `SELECT id, r2_key, alt, caption, credit, source_title, source_date, source_url,
          width, height, lat, lng
     FROM media
    WHERE kind = 'community_photo'
    ORDER BY COALESCE(source_date, created_at) DESC, id DESC`,
)
  .all<Photo>()
  .catch(() => ({ results: [] as Photo[] }));

/**
 * A tall photo in a masonry-ish grid should be allowed to be tall. Portrait
 * shots get two rows so the layout does not crop the community out of its own
 * gallery.
 */
const isPortrait = (p: Photo) => (p.width && p.height ? p.height > p.width * 1.15 : false);
---

<Base
  title="Gallery"
  description="Photos of the PoGo TXK community at Spring Lake Park — GO Fest, Community Days, and raid nights in Texarkana."
>
  <section class="gallery">
    <header>
      <p class="eyebrow">PoGo TXK</p>
      <h1>The community</h1>
      <p class="lede">
        Trainers from all three teams at Spring Lake Park. Several of these were taken by the
        Texarkana Gazette — their photographers are credited on each image, and the original
        articles are linked.
      </p>
    </header>

    {
      photos.length === 0 ? (
        <p class="empty">
          No photos yet. They arrive with the map import, or an ambassador can upload them from
          the admin console.
        </p>
      ) : (
        <ul class="grid">
          {photos.map((photo) => (
            <li class={isPortrait(photo) ? 'is-tall' : undefined}>
              <figure>
                <img
                  src={`/media/${photo.r2_key}`}
                  alt={photo.alt ?? photo.caption ?? 'PoGo TXK community photo'}
                  width={photo.width ?? undefined}
                  height={photo.height ?? undefined}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>
                  {photo.caption && <p class="caption">{photo.caption}</p>}
                  <p class="credit">
                    {photo.credit}
                    {photo.source_url && photo.source_title && (
                      <>
                        {' · '}
                        <a href={photo.source_url} rel="noopener noreferrer" target="_blank">
                          {photo.source_title}
                        </a>
                        {photo.source_date && ` (${photo.source_date})`}
                      </>
                    )}
                  </p>
                  {photo.lat && photo.lng && (
                    <p class="where">
                      <a href={`/map?lat=${photo.lat}&lng=${photo.lng}`}>Where this was taken →</a>
                    </p>
                  )}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )
    }

    <p class="rights">
      Press photographs remain the property of their publications and are reproduced with credit.
      If you appear in a photo and would rather not, tell any ambassador on Discord and it comes
      down — no reason needed.
    </p>
  </section>
</Base>

<style>
  .gallery {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 56px) 20px 72px;
  }
  header {
    max-width: 62ch;
    margin-bottom: 28px;
  }
  .eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  h1 {
    margin: 6px 0 10px;
    font-size: clamp(1.7rem, 5vw, 2.4rem);
  }
  .lede {
    margin: 0;
    color: var(--text-muted);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    grid-auto-rows: 210px;
    gap: 12px;
  }
  .grid li {
    /* Photos are the content here, so they get to break the grid rhythm. */
    grid-row: span 1;
  }
  .grid li.is-tall {
    grid-row: span 2;
  }

  figure {
    margin: 0;
    height: 100%;
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-sunken);
  }
  figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 46px 13px 11px;
    /* The credit is a licensing obligation. It sits on the image so it cannot
       be separated from it by a layout change or a screenshot.

       Which makes legibility the scrim's job, and a two-stop
       `transparent -> 0.82` was not doing it: the gradient only reached full
       strength at the very bottom edge, so every line above the last one sat on
       bare photograph. Over the bright foliage shots the white text all but
       disappeared. These stops hold the scrim near-opaque for the whole height
       the text occupies and only fade across the top third. */
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.93) 0%,
      rgb(0 0 0 / 0.89) 38%,
      rgb(0 0 0 / 0.74) 62%,
      rgb(0 0 0 / 0.36) 84%,
      transparent 100%
    );
    color: #fff;
    /* Belt and braces for the brightest images, where even a heavy scrim leaves
       thin white type fighting a high-frequency background. */
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.55);
  }
  .caption {
    margin: 0 0 4px;
    font-size: 0.8rem;
    line-height: 1.35;
  }
  .credit {
    margin: 0;
    font-size: 0.68rem;
    opacity: 0.9;
  }
  .credit a {
    color: #fff;
  }
  .where {
    margin: 4px 0 0;
    font-size: 0.68rem;
  }
  .where a {
    color: #fff;
    opacity: 0.85;
  }

  .empty {
    padding: 28px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    text-align: center;
    color: var(--text-muted);
  }

  .rights {
    margin: 32px 0 0;
    max-width: 68ch;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
