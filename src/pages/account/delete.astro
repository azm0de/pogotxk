---
import Base from '~/layouts/Base.astro';
import '~/styles/legal.css';
import { DISCORD_INVITE } from '~/lib/socials';

export const prerender = false;

// Deliberately server-rendered from Astro.locals.user rather than the
// client-side fetch Base.astro's header menu uses: this page's whole point is
// to work for someone who arrived from a link with no session, and a page
// that flashes "signed in" chrome before correcting itself is the wrong first
// impression for a page about to delete an account.
const user = Astro.locals.user ?? null;

// Google Play's Data deletion policy requires this exact route to work
// without the app installed — this IS that route, submitted in Play Console —
// so signing in has to be possible from a plain browser with nothing
// installed. It already is: Discord OAuth here has never required the app.
const next = '/account/delete';
---

<Base
  title="Delete your account"
  description="Permanently delete your PoGo TXK account and personal data."
>
  <article class="legal container">
    <header class="legal-head">
      <h1>Delete your account</h1>
    </header>

    {/*
      The warning and the closure are the same slot: on success the first is
      replaced by the second, so the page never describes a deletion that has
      already happened as something about to happen.
    */}
    <div class="panel acct-warning" data-warning>
      {/* Ink, not red. Red on this site answers "where am I" and "what is live";
          lending it to "irreversible" as well leaves it meaning nothing in
          particular. `.badge--warn` is the ink-filled plate for this. */}
      <p class="acct-warning-head">
        <span class="badge badge--warn">Permanent</span>
      </p>
      <p>
        <strong>
          This removes your Discord identity, avatar, trainer profile and active sessions from
          PoGo TXK.
        </strong>{' '}
        It does not require the app to be installed — this page works in any browser, signed in
        or not.
      </p>
    </div>

    <div class="panel acct-done" data-done hidden>
      <p class="acct-done-head">Your account is deleted.</p>
      <p>
        Your Discord identity, avatar, trainer profile and sessions are gone from PoGo TXK, and
        you are signed out. Flares, RSVPs and change-log entries you were part of stay as
        community history, no longer linked to you. Signing in with the same Discord account
        creates a brand new one, starting from guest.
      </p>
      <a class="btn btn--primary btn--arrow" href="/map">Open the map</a>
    </div>

    <div class="legal-body prose">
      <p>
        Flares, RSVPs and change-log entries you are part of stay as community history — see{' '}
        <a href="/privacy#retention">how long we keep it</a> — but stop being linked to your
        Discord identity. Your account cannot be recovered afterwards: signing back in with the
        same Discord account creates a brand new one, starting from guest.
      </p>
    </div>

    {/*
      The controls sit outside `.prose` on purpose. `.prose a` (0,2,0) sets the
      link colour and out-ranks `.btn--primary` (0,1,0), which painted the
      sign-in button's label in the accent red on its own accent-red fill —
      measured 1.00:1, an invisible label.
    */}
    {
        user ? (
          <section class="acct-delete" data-account-delete>
            <p class="acct-delete-who">
              {user.avatarUrl && (
                <img src={user.avatarUrl} alt="" width="32" height="32" loading="lazy" />
              )}
              <span>
                Signed in as <strong>{user.displayName}</strong>.{' '}
                <a class="target" href={`/auth/logout?switch=1&next=${encodeURIComponent(next)}`}>
                  Not you?
                </a>
              </span>
            </p>

            <label class="acct-delete-confirm">
              <input type="checkbox" data-confirm-check />
              I understand this is permanent and cannot be undone.
            </label>

            <button type="button" class="btn btn--primary" data-confirm-btn disabled>
              Delete my account
            </button>

            <p class="acct-delete-status" data-status role="status" hidden />
          </section>
        ) : (
          <section class="acct-delete">
            {/* The Discord button, in Discord's colour, everywhere it appears —
                it was the red primary here and blurple on every other page. */}
            <a
              class="btn btn--discord btn--arrow"
              href={`/auth/login?next=${encodeURIComponent(next)}`}
            >
              Sign in with Discord
            </a>
            <p class="acct-delete-note">
              Signing in only proves who you are. It does not delete anything by itself.
            </p>
          </section>
      )
    }

    <p class="legal-note">
      Would rather have a person handle it, or hit a problem here? Ask any ambassador on our{' '}
      <a href={DISCORD_INVITE} rel="noopener noreferrer" target="_blank">Discord server</a>, or
      see the full <a href="/privacy">Privacy Policy</a>.
    </p>
  </article>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-account-delete]');
      if (!root) return;

      const check = root.querySelector('[data-confirm-check]');
      const btn = root.querySelector('[data-confirm-btn]');
      const status = root.querySelector('[data-status]');
      const warning = document.querySelector('[data-warning]');
      const done = document.querySelector('[data-done]');

      check.addEventListener('change', () => {
        btn.disabled = !check.checked;
      });

      const say = (text) => {
        status.textContent = text;
        status.hidden = false;
      };

      btn.addEventListener('click', async () => {
        if (!window.confirm('Delete your PoGo TXK account? This cannot be undone.')) return;

        btn.disabled = true;
        check.disabled = true;
        say('Deleting…');

        try {
          const res = await fetch('/api/account', { method: 'DELETE' });
          if (!res.ok) throw new Error('Request failed');

          check.closest('label').remove();
          btn.remove();
          // The warning describes something about to happen; once it has, the
          // closure panel takes its place rather than sitting under it.
          if (warning) warning.hidden = true;
          if (done) done.hidden = false;
          say('Your account is deleted.');
        } catch {
          say('Something went wrong — your account was not deleted. Try again, or ask an ambassador on Discord.');
          btn.disabled = false;
          check.disabled = false;
        }
      });
    })();
  </script>

  <style>
    .acct-warning,
    .acct-done {
      display: grid;
      gap: var(--space-3);
      justify-items: start;
    }
    .acct-warning p,
    .acct-done p {
      margin: 0;
    }
    .acct-warning-head {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }
    .acct-done-head {
      font-family: var(--font-sign);
      font-weight: 800;
      font-size: var(--text-xl);
      line-height: var(--lh-heading);
    }

    .acct-delete {
      display: grid;
      gap: var(--space-4);
      justify-items: start;
    }
    .acct-delete-who {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin: 0;
      min-width: 0;
    }
    .acct-delete-who img {
      flex: none;
      border-radius: 50%;
    }
    .acct-delete-confirm {
      display: flex;
      align-items: flex-start;
      gap: var(--space-2);
      margin: 0;
      cursor: pointer;
    }
    .acct-delete-status {
      margin: 0;
      font-weight: 700;
    }
    .acct-delete-note {
      margin: 0;
      color: var(--text-muted);
      font-size: var(--text-sm);
    }
  </style>
</Base>
