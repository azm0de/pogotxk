---
import { env } from 'cloudflare:workers';
import Admin from '~/layouts/Admin.astro';
import ImportPanel from '~/components/admin/ImportPanel';
import { hasRole } from '~/lib/auth/types';
import { formatInZone } from '~/lib/time';

export const prerender = false;

const db = env.DB;

const [counts, nextMeetup, recent] = await Promise.all([
  db
    .prepare(
      // Only what a card shows. "Awaiting review", "Open reports" and a user
      // count used to be queried too; the first two are hidden until their
      // screens exist (admin audit, 2026-10, C-12) and the third was never shown.
      `SELECT
         (SELECT COUNT(*) FROM pois WHERE status = 'published')  AS pois_live,
         (SELECT COUNT(*) FROM media)                            AS media,
         (SELECT COUNT(*) FROM posts WHERE status = 'published') AS posts,
         (SELECT COUNT(*) FROM meetups WHERE status = 'published'
            AND starts_at >= strftime('%Y-%m-%dT%H:%M:%SZ','now')) AS meetups_upcoming`,
    )
    .first<Record<string, number>>(),

  db
    .prepare(
      `SELECT m.title, m.starts_at, m.tz, p.name AS poi_name, m.location_text
         FROM meetups m LEFT JOIN pois p ON p.id = m.poi_id
        WHERE m.status = 'published' AND m.starts_at >= strftime('%Y-%m-%dT%H:%M:%SZ','now')
        ORDER BY m.starts_at LIMIT 1`,
    )
    .first<{ title: string; starts_at: string; tz: string; poi_name: string | null; location_text: string | null }>(),

  db
    .prepare(
      `SELECT a.action, a.entity, a.entity_id, a.created_at, u.username
         FROM audit_log a LEFT JOIN users u ON u.id = a.actor_id
        ORDER BY a.id DESC LIMIT 8`,
    )
    .all<{ action: string; entity: string; entity_id: string | null; created_at: string; username: string | null }>(),
]);

const c = counts ?? {};

/*
 * "Awaiting review" and "Open reports" both linked to /admin/map, which has
 * no status filter and no reports screen — a count with nowhere to act on it.
 * Hidden until those screens exist (Justin's decision, admin audit 2026-10,
 * C-12); add them back in the same change as the screen.
 */
interface Card {
  label: string;
  value: number;
  href?: string;
  warn?: boolean;
}
const cards: Card[] = [
  { label: 'Live locations', value: c.pois_live ?? 0, href: '/admin/map' },
  { label: 'Upcoming meetups', value: c.meetups_upcoming ?? 0, href: '/admin/meetups' },
  { label: 'Published posts', value: c.posts ?? 0, href: '/admin/posts' },
  { label: 'Media items', value: c.media ?? 0, href: '/admin/media' },
];

/*
 * Recent activity in words. It printed the raw audit codes ("update",
 * "poi #105") and a bare UTC timestamp with no zone (C-21). The verbs mirror
 * `AuditAction` in src/lib/db/audit.ts; anything new falls back to its code.
 */
const VERB: Record<string, string> = {
  create: 'Created',
  update: 'Edited',
  delete: 'Deleted',
  archive: 'Archived',
  restore: 'Restored',
  import: 'Imported',
};
/** Events about a person rather than a thing: no "#id" after them. */
const SELF_EVENT: Record<string, string> = {
  login: 'Signed in',
  lockout: 'Locked out after failed sign-ins',
  'reset-request': 'Asked for a password reset',
  'reset-complete': 'Reset a password',
};
const NOUN: Record<string, string> = {
  poi: 'location',
  post: 'post',
  meetup: 'meetup',
  media: 'media item',
  flare: 'flare',
};

function describe(r: { action: string; entity: string; entity_id: string | null }): string {
  const self = SELF_EVENT[r.action];
  if (self) return self;
  const verb = VERB[r.action] ?? r.action;
  const noun = NOUN[r.entity] ?? r.entity.replace(/_/g, ' ');
  return r.entity_id ? `${verb} ${noun} #${r.entity_id}` : `${verb} ${noun}`;
}

/** "Sat, Oct 4, 3:12 PM CT" — the zone named, as everywhere else in admin. */
function when(iso: string): string {
  return formatInZone(iso).replace(/\s(CDT|CST)$/, ' CT');
}
---

<Admin title="Dashboard">
  <div class="dash admin-page">
    <h1>Dashboard</h1>

    {
      /* Admin-only: it rewrites map data wholesale, which is more than an
         ambassador's editing remit. Shown first while the site is empty,
         since seeding is the only useful thing to do at that point. */
      hasRole(Astro.locals.user, 'admin') && (c.pois_live ?? 0) === 0 && (
        <ImportPanel client:load poiCount={c.pois_live ?? 0} mediaCount={c.media ?? 0} />
      )
    }

    <div class="cards">
      {
        /* A card without a destination renders as a div, not an <a> with no
           href — the latter looks identical, is not focusable, and does
           nothing when clicked, which is the worst of both. */
        cards.map((card) => {
          const body = (
            <Fragment>
              <strong>{card.value}</strong>
              <span class="stat-label">{card.label}</span>
              {/* The count alone used to carry the warning in an orange that
                  measured 3.18:1. Colour is never the only signal here, so the
                  state is spelled out and the number stays ink. */}
              {card.warn && <span class="badge badge--outline">Needs review</span>}
            </Fragment>
          );
          return card.href ? (
            <a class="card stat" href={card.href}>
              {body}
            </a>
          ) : (
            <div class="card stat stat--static">{body}</div>
          );
        })
      }
    </div>

    <section class="panel">
      <div class="panel-head">
        <h2>Next meetup</h2>
      </div>
      {
        nextMeetup ? (
          <p class="next-meetup">
            <strong>{nextMeetup.title}</strong>
            <span>{formatInZone(nextMeetup.starts_at, nextMeetup.tz)}</span>
            <span>{nextMeetup.poi_name ?? nextMeetup.location_text ?? 'No location set'}</span>
          </p>
        ) : (
          <p class="muted">
            Nothing published.{' '}
            <a class="target" href="/admin/meetups">
              Schedule one
            </a>{' '}
            — the home page and the calendar feed both read from here.
          </p>
        )
      }
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>Recent activity</h2>
      </div>
      {
        recent.results.length ? (
          <ul class="activity">
            {recent.results.map((r) => (
              <li>
                <span>{describe(r)}</span>
                <span class="muted">by {r.username ?? 'system'}</span>
                <time datetime={r.created_at}>{when(r.created_at)}</time>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty-state">No changes recorded yet.</p>
        )
      }
    </section>

    {
      /* Once the map has data, the importer stops being the headline action.
         It will not re-import over a populated site (it answers 409); what it
         still offers here is the resumable photo copy. */
      hasRole(Astro.locals.user, 'admin') && (c.pois_live ?? 0) > 0 && (
        <ImportPanel client:load poiCount={c.pois_live ?? 0} mediaCount={c.media ?? 0} />
      )
    }
  </div>

  <style>
    /*
     * The console's front page. Panels bolted on the sunken ground, in the same
     * vocabulary as the public board — `.panel`, `.card`, `.badge`,
     * `.empty-state` — which this page now imports rather than reimplements.
     */
    h1 {
      margin: 0;
      font-size: var(--display-sm);
    }
    h2 {
      margin: 0;
      font-size: var(--text-xl);
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: var(--space-3);
    }
    /* `.stat` adds layout to the `.card` surface; the surface itself, its
       padding and its radius come from the primitive. */
    .stat {
      display: grid;
      align-content: start;
      justify-items: start;
      gap: var(--space-1);
      text-decoration: none;
      color: inherit;
      transition: border-color var(--dur-1) var(--ease-out);
    }
    a.stat:hover {
      border-color: var(--text);
    }
    /* A card with nowhere to go should not invite a click. */
    .stat--static {
      cursor: default;
    }
    .stat strong {
      font-family: var(--font-sign);
      font-size: var(--display-sm);
      font-weight: 800;
      line-height: 1;
      letter-spacing: var(--tracking-tight);
      font-variant-numeric: tabular-nums;
    }
    .stat-label {
      font-size: var(--text-sm);
      color: var(--text-muted);
    }
    .stat .badge {
      margin-top: var(--space-1);
    }

    .next-meetup {
      display: grid;
      gap: var(--space-1);
      margin: 0;
    }
    .next-meetup strong {
      font-family: var(--font-sign);
      font-size: var(--text-xl);
      font-weight: 800;
      letter-spacing: var(--tracking-tight);
    }
    .next-meetup span {
      font-size: var(--text-md);
      color: var(--text-muted);
    }

    .activity {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: var(--space-2);
      font-size: var(--text-sm);
    }
    .activity li {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      flex-wrap: wrap;
      min-width: 0;
    }
    .activity time {
      margin-left: auto;
      color: var(--text-muted);
      font-size: var(--text-xs);
      font-variant-numeric: tabular-nums;
    }

    .muted {
      color: var(--text-muted);
      margin: 0;
      font-size: var(--text-md);
    }
  </style>
</Admin>
