---
import Base from '~/layouts/Base.astro';
import { canReachAdmin } from '~/lib/auth/admin-path';
import { parseMinutesParam } from '~/lib/auth/lockout';
import { safeNext } from '~/lib/auth/next';

export const prerender = false;

/**
 * The admin password sign-in form.
 *
 * An admin account is a standalone identity: a username and a password in
 * `admin_credentials`, with no Discord account behind it. Members sign in with
 * Discord and never need this page; admins have no Discord account to fall
 * back on, so nothing on this page may offer them one.
 *
 * The first box takes the username **or** the recovery address on file, since
 * 2026-09-23. The reset flow is addressed by email and never used to say what
 * the username was, so an admin fresh from a reset typed the address here and
 * was told it did not match. How the route tells the two apart, and why that
 * cannot cross them over, is in the header of `/api/auth/admin-login`.
 *
 * It depends on nothing but this Worker and its database, which is why it was
 * built — it keeps working when Discord is down, when the guild is
 * misconfigured, and without `DISCORD_BOOTSTRAP_ADMIN_ID`, which has been unset
 * on the live Worker since 2026-09-22 — so this form is now the only way into
 * the admin console at all. See `migrations/0004_owner_password.sql` for the
 * original argument; the file is named for the terminology this feature has
 * since left behind.
 *
 * ---------------------------------------------------------------------------
 * THE PATH IS NOT A SECRET, AND IS NOT PROTECTING ANYTHING
 * ---------------------------------------------------------------------------
 *
 * `/admin/login` is fixed, unlinked and `noindex`, and none of that makes it
 * confidential. The repository is public, so every path written in it is public
 * knowledge the moment it is committed; an unguessable path was considered and
 * rejected for exactly that reason. What protects this door is the password and
 * the lockout behind it — nothing else may be weakened on the theory that the
 * URL is hard to find, because it is not.
 *
 * Unlinked and `noindex` are tidiness, not defence: they keep a password form
 * out of the nav and out of a search index, and that is the whole of what they
 * are worth.
 *
 * Sitting under `/admin` means the gate in `src/middleware.ts` covers this page
 * by default — and since 2026-09-23 the gate sends everyone it turns away
 * *here*, so without an exemption this page would redirect to itself forever.
 * `isAdminLoginPath` in `~/lib/auth/admin-path` is the exemption that stops it,
 * matched exactly so it covers this path and no other.
 *
 * That makes this page the answer to every refused `/admin` page, for
 * signed-out visitors and signed-in members alike. It shows the form to anybody
 * below `ambassador` and sends anybody at or above it on to `next`, so the gate
 * and this page can never bounce a caller between them.
 *
 * ---------------------------------------------------------------------------
 * THIS PAGE SHIPS NO SCRIPT OF ITS OWN, AND THE FORM NEEDS NONE
 * ---------------------------------------------------------------------------
 *
 * Said precisely, because it used to say "no JavaScript on this page, at all",
 * and that was not true as served (admin audit, 2026-10, A-12): `Base.astro`
 * puts its header scripts — the menu, the account control, the in-app sign-in
 * hand-off — on every page, this one included, and they run here as anywhere.
 * What is true, and asserted in `test/auth/admin-login.test.ts`:
 *
 * - Nothing inside `<main>` is a script, an island or a `client:` directive.
 * - The form is a plain POST that works with scripting off. That is the
 *   break-glass promise: this page is reached at exactly the moment other
 *   things are broken, and a plain `<form>` posts from a browser with scripting
 *   off, from a text browser, and from a half-loaded page.
 * - A form-encoded body is the more protected option. Astro's origin check
 *   polices form-like content types and skips `application/json` entirely
 *   (`vault/Platform Limits and Traps.md`), so the `fetch`-and-JSON shape the
 *   rest of this app uses would *remove* the CSRF protection here.
 *
 * What is NOT claimed any more: that "the password never touches app code".
 * No code of ours reads the field, but the header scripts share the page, so
 * the honest statement is that nothing here handles the password, not that
 * nothing could. Keep the header scripts free of anything that reads inputs.
 *
 * The account control in that header is hidden on this page (C-25): its
 * "Sign in" goes to Discord, a different door from this one, and offering both
 * on one screen asked an admin to pick the wrong one.
 */

/*
 * Never cached (A-11). The page reflects `error`, `minutes` and `next` from
 * its own query string and is answered differently to a signed-in caller, so a
 * stored copy is wrong for the next person on a shared machine. The reset
 * pages beside it already send the same header.
 */
Astro.response.headers.set('cache-control', 'no-store');

const next = safeNext(Astro.url.searchParams.get('next'));

// Already able to reach the console — there is nothing here for them, and a
// sign-in form shown to somebody already signed in is just a confusing dead
// end. Same shape as `/auth/device`'s early return. The same predicate as the
// gate itself, so the two can never disagree about who is through.
if (canReachAdmin(Astro.locals.user)) return Astro.redirect(next, 302);

/*
 * The Discord link carries `next` too, so a member the gate sent here can sign
 * in the ordinary way and come back to where they were going. It is already
 * through `safeNext` above and `/auth/login` runs it again on arrival; the
 * bare path is `/auth/login`'s own default, so it is left off rather than
 * spelled out. The same shape `/account/delete` uses.
 */
const discordHref = next === '/' ? '/auth/login' : `/auth/login?next=${encodeURIComponent(next)}`;

// Only the three the API route emits. Anything else in the query string is
// somebody poking at it, and gets no message.
//
// `bad` is worded as "those sign-in details did not match" — not "that
// username", now the box also takes an address — and it never says which half
// was wrong or whether the account exists. The route does not tell this page
// that, on purpose; see `back()` in `/api/auth/admin-login`.
const raw = Astro.url.searchParams.get('error');
const error = raw === 'bad' || raw === 'locked' || raw === 'role' ? raw : null;

// How long the lock has left, as the route computed it (A-07). Read through
// the same validator that bounds it, so a hand-typed `minutes=9999` or
// `minutes=<b>` falls back to the general wording instead of being printed.
const minutes = error === 'locked' ? parseMinutesParam(Astro.url.searchParams.get('minutes')) : null;

/**
 * Set by `POST /api/auth/admin-reset/confirm` after a password has actually
 * been changed.
 *
 * The reset flow deliberately ends here rather than minting a session — the
 * link proves control of a mailbox, and this door is the one that is supposed
 * to require a password — so the person arrives at a form having just chosen a
 * credential, and without a word from us it looks like the reset did nothing.
 * Nobody may set this except by completing a reset: it is a redirect target,
 * not a claim, and the only thing it does is render a sentence.
 */
const reset = Astro.url.searchParams.get('reset') === '1';
---

<Base title="Admin sign-in" hideAccountControl>
  <Fragment slot="head">
    {/*
      The page is publicly reachable — it has to be, or it is no use on the day
      the other door is shut — and there is no `public/robots.txt`. This tag is
      therefore the only thing keeping a password form out of a search index.
      `<slot name="head" />` exists at Base.astro:105; without it this would be
      silently discarded, which is invisible in a browser.
    */}
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <section class="admin-login container">
    <header class="admin-login-head">
      <h1>Admin sign-in</h1>
    </header>

    {/*
      Not "the spare key", which is what this said while the credential hung off
      a Discord row that could also reach /admin. Admin accounts are standalone
      now — no Discord account behind them — so this is not a second way into an
      account that has another.
    */}
    <p class="lede">
      Admin accounts sign in here. Everyone else signs in with <a
        class="target"
        href={discordHref}>Discord</a
      >.
    </p>

    {
      reset && !error && (
        <div class="notice" role="status">
          <p>
            <strong>Your password has been reset.</strong>
          </p>
          <p>
            Sign in with the new one. Every other session on that account was ended, so anything
            else that was signed in — including anything that should not have been — is signed out.
          </p>
        </div>
      )
    }

    {/*
      Immediately before the form, and the only `role="alert"` on the page, so
      it is the first thing a screen reader announces and sits right above the
      field it is about (A-13). The username box points at it with
      `aria-describedby`, so when that box takes focus the reason is read out
      again with it.
    */}
    {
      error && (
        <div class="notice" role="alert" id="admin-login-error">
          {error === 'locked' ? (
            <>
              <p>
                <strong>
                  {minutes
                    ? `Too many wrong attempts, so this account is locked. Try again in about ${minutes} ${minutes === 1 ? 'minute' : 'minutes'}.`
                    : 'Too many wrong attempts, so this account is locked for a little while.'}
                </strong>
              </p>
              <p>
                Five wrong passwords lock the account for a minute, and each further wrong attempt
                after that locks it for longer — up to an hour, never more. Nothing else has
                changed: the password still works, and waiting is the whole of the fix. The lock is
                on this one account, so another admin can still sign in.
              </p>
            </>
          ) : error === 'role' ? (
            <p>
              This account can sign in but does not have admin access. Ask Justin to check its
              role.
            </p>
          ) : (
            <p>Those sign-in details did not match.</p>
          )}
        </div>
      )
    }

    {/*
      Plain POST to the API route. No `fetch`, no island, no `client:` directive.
      `autocomplete` is set on both fields on purpose: this credential is meant
      to be long and unmemorable, which only works if a password manager can
      store and fill it.

      The first box takes a username or an address, and keeps
      `name="username"` and `autocomplete="username"` all the same. The name is
      what the route reads; the token is the standard one for "the login this
      password belongs to", which is what a password manager needs to know
      whichever of the two was typed. `type="text"`, not `email`, because a
      bare username is not an address and the browser would refuse it.

      After `error=bad` the username box takes focus (A-13), so a keyboard user
      can retype straight away instead of starting from the top of the page.
      Not after `locked` or `role`, where typing again is not the fix. The box
      is NOT refilled with what was typed: the only way to carry it here would
      be the redirect's query string, which puts the identifier — sometimes an
      address, one day a password typed into the wrong box — into the history,
      the server logs and the `Referer`. A password manager refills it anyway.
    */}
    <form class="panel admin-login-form" method="post" action="/api/auth/admin-login">
      <input type="hidden" name="next" value={next} />

      <div class="field">
        <label for="admin-username">Username or email</label>
        <input
          id="admin-username"
          name="username"
          type="text"
          autocomplete="username"
          autocapitalize="none"
          autocorrect="off"
          spellcheck="false"
          aria-describedby={error ? 'admin-login-error' : undefined}
          autofocus={error === 'bad'}
          required
        />
      </div>

      <div class="field">
        <label for="admin-password">Password</label>
        <input
          id="admin-password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </div>

      <button class="btn btn--primary" type="submit">Sign in</button>
    </form>

    {/*
      The recovery path, and the only thing that makes it discoverable — the
      page is unlinked from everywhere else, so an admin who has lost the
      password and does not already know this URL exists has nowhere to find
      it. A plain link, below the form rather than beside it: it is the rarer
      action by a wide margin and it should not compete with the button.

      It is shown unconditionally, and deliberately does not check whether any
      address is on file or whether mail is configured. Both of those are a
      database read and an environment read on a page that currently performs
      neither, and this page is the break-glass door — its value is that it
      works when other things do not. The page it links to says "if that
      address is on file", which is already the honest answer when none is.
    */}
    <p class="forgot">
      <a class="target" href="/admin/reset">Lost the password?</a>
    </p>
  </section>
</Base>

<style>
  /* Follows /auth/device's conventions: a narrow reading measure, the reading
     face rather than the signage face, and the narrow container. */
  .admin-login {
    --read-measure: min(var(--measure), 60ch);
    max-width: var(--container-narrow);
    padding-block: var(--space-section) var(--space-16);
    font-family: var(--font-read);
  }
  .admin-login > * + * {
    margin-block-start: var(--space-5);
  }

  .admin-login-head {
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--text);
  }
  .admin-login h1 {
    margin: 0;
    font-family: var(--font-sign);
    font-size: var(--display-lg);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
  }

  .lede {
    margin: 0;
    max-width: var(--read-measure);
    font-size: var(--text-lg);
    line-height: var(--lh-body);
  }

  /* The message is a status, so it is quiet — a rule in the live-text red
     rather than a filled alarm. `--live-text` inverts correctly in dark mode
     and is the token already used for urgent text elsewhere. */
  .notice {
    max-width: var(--read-measure);
    padding: var(--space-4);
    border-left: 4px solid var(--live-text);
    background: var(--bg-sunken);
    border-radius: var(--radius-sm);
  }
  .notice p {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--lh-body);
  }
  .notice p + p {
    margin-block-start: var(--space-3);
  }

  .admin-login-form {
    display: grid;
    gap: var(--space-5);
    max-width: var(--read-measure);
    justify-items: start;
  }

  .field {
    display: grid;
    gap: var(--space-2);
    width: 100%;
  }
  .field label {
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .field input {
    /* `min-width: 0` so a grid item cannot be widened past its track by its own
       intrinsic size — the trap that produces horizontal scroll at 375px.
       48px clears the 24px target floor with room to spare. */
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: var(--space-2) var(--space-4);
    /* `--text-muted`, not `--border-strong` (admin audit, 2026-10, D-06): an
       input's edge is the only thing that shows where to type, so it owes
       3:1 against the panel it sits on. `--border-strong` measured 1.68 light
       and 1.96 dark; `--text-muted` is 6.32 on white and well over 3 on the
       dark panel. */
    border: 1.5px solid var(--text-muted);
    border-radius: var(--radius-sm);
    background: var(--bg-panel);
    color: var(--text);
    font-family: var(--font-read);
    /* 16px, not the 14px `--text-md` the rest of this page uses for secondary
       text. Below 16px iOS Safari zooms the viewport on focus, and a zoomed
       viewport is horizontal scroll on a 375px screen — the exact thing the
       accessibility floor forbids. */
    font-size: var(--text-base);
  }

  .forgot {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--lh-body);
  }
</style>
