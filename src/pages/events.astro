---
/**
 * The public events page.
 *
 * Two sources arrive here and are rendered identically: community meetups out of
 * D1, and the global Pokémon GO calendar fetched from /api/game/events.json.
 * That route is owned by the ScrapedDuck module and may not be deployed yet, so
 * the page treats it as optional — if it is missing or slow, this still renders
 * the meetups and says so rather than failing.
 *
 * The page itself is server-rendered. The only client JavaScript is the
 * countdown ticker and the copy-link button.
 */

import Base from '~/layouts/Base.astro';
import EventCard from '~/components/events/EventCard.astro';
import { env } from 'cloudflare:workers';
import { listPublicMeetups, meetupToCalendarEvent } from '~/lib/db/meetups';
import {
  allDayEndExclusive,
  gameEventsFromPayload,
  groupEvents,
  type CalendarEvent,
} from '~/lib/ics';
import { getFeed } from '~/lib/scrapedduck';
import { DEFAULT_TZ } from '~/lib/time';

export const prerender = false;

/**
 * Calendar links are built from the host you are actually reading this on, not
 * from the configured canonical site.
 *
 * A subscribe URL is only useful if it resolves, and the host serving this page
 * demonstrably does. Preferring the canonical value is what produced six dead
 * subscribe links when `site` still named a domain that had not been pointed at
 * the Worker — and ICS is subscribe-once, so a dead URL is an empty calendar
 * forever rather than a visible error. Once the custom domain is live the two
 * agree anyway.
 */
const base = new URL(Astro.url.origin);

// Independent sources, so they run together.
//
// Global events come straight from the data layer rather than over HTTP from
// /api/game/events.json — a Worker fetching its own hostname is a loopback
// through the edge, which works against `astro dev` and returns nothing in
// production.
const [meetups, global] = await Promise.all([
  listPublicMeetups(env.DB),
  getFeed('events')
    .then(gameEventsFromPayload)
    .catch(() => null),
]);

const globalAvailable = global !== null;
const meetupEvents = meetups.map((meetup) => meetupToCalendarEvent(meetup, base));

const grouped = groupEvents([...meetupEvents, ...(global?.events ?? [])]);
// The past is context, not content — a dozen cards is plenty.
const past = grouped.past.slice(0, 12);

/*
 * The subscribe panel is gone from this page, and with it the `Feed` list that
 * only existed to populate it.
 *
 * `/calendar/meetups.ics`, `/calendar/all.ics` and `/calendar/game.ics` are all
 * still served — anyone already subscribed keeps receiving updates, because a
 * calendar client polls the URL it stored and never revisits this page. What is
 * gone is the way to *find* them, so there is no autodiscovery either. Add
 * `<link rel="alternate" type="text/calendar">` to the head slot if they should
 * stay discoverable without the panel.
 */

/* ------------------------------------------------------------ formatting -- */

// Built once per request and reused across every card; constructing an
// Intl.DateTimeFormat per event adds up over a 40-event calendar.
const dayFmt = new Intl.DateTimeFormat('en-US', {
  timeZone: DEFAULT_TZ,
  weekday: 'short',
  month: 'short',
  day: 'numeric',
});
const timeFmt = new Intl.DateTimeFormat('en-US', {
  timeZone: DEFAULT_TZ,
  hour: 'numeric',
  minute: '2-digit',
});
const zoneFmt = new Intl.DateTimeFormat('en-US', {
  timeZone: DEFAULT_TZ,
  timeZoneName: 'short',
});

/** "CDT" or "CST" — resolved at the given instant, not at page-render time. */
function zoneLabel(at: Date): string {
  return zoneFmt.formatToParts(at).find((part) => part.type === 'timeZoneName')?.value ?? '';
}

function formatWhen(event: CalendarEvent): string {
  const start = new Date(event.start);

  if (event.allDay) {
    const startDay = dayFmt.format(start);
    // Step back off the exclusive end so a one-day event reads as one day.
    const lastDay = dayFmt.format(new Date(allDayEndExclusive(event) - 86_400_000));
    return lastDay === startDay ? `${startDay} · all day` : `${startDay} – ${lastDay}`;
  }

  const zone = zoneLabel(start);
  const startDay = dayFmt.format(start);
  if (!event.end) return `${startDay} · ${timeFmt.format(start)} ${zone}`;

  const end = new Date(event.end);
  const endDay = dayFmt.format(end);
  return endDay === startDay
    ? `${startDay} · ${timeFmt.format(start)} – ${timeFmt.format(end)} ${zone}`
    : `${startDay} ${timeFmt.format(start)} – ${endDay} ${timeFmt.format(end)} ${zone}`;
}

const nowZone = zoneLabel(new Date());

// Leek Duck and ScrapedDuck both require visible credit wherever their data is
// shown, so the credit line renders alongside the events, not in the footer.
const credit = global?.attribution ?? null;
---

<Base
  title="Events"
  description="Pokémon GO meetups, raid hours and community days in Texarkana, plus the global in-game event calendar."
>
  <div class="events">
    <header class="events-hero">
      {/*
        Decorative: the `h1` right beside it already says what this is, and a
        description of forty Pokémon walking down a road tells a screen-reader
        user nothing about the events below.

        1280x720 is the whole source, so `sizes` never asks for more than exists
        — the card caps at 932px and the largest file is the original's width.
        1073KB of JPEG became 182KB of WebP at that size, 62KB at 640.
      */}
      <picture class="events-hero-art">
        <img
          src="/hero/pokestop-1280.webp"
          srcset="/hero/pokestop-640.webp 640w, /hero/pokestop-960.webp 960w, /hero/pokestop-1280.webp 1280w"
          sizes="(min-width: 1010px) 932px, calc(100vw - 28px)"
          width="1280"
          height="720"
          alt=""
          decoding="async"
        />
      </picture>

      <h1>Events</h1>
      <p class="events-lede">
        Community meetups around Texarkana alongside the global Pokémon GO calendar. All times
        are shown in Texarkana local time ({nowZone}).
      </p>

    </header>

    {
      !globalAvailable && (
        <p class="events-note">
          The global Pokémon GO event calendar is unavailable right now, so this page is showing
          community meetups only. Try again shortly.
        </p>
      )
    }

    {/* Announces an event flipping to live; the countdowns write into it. */}
    <p class="events-live-status" id="events-status" role="status" aria-live="polite"></p>

    {
      grouped.live.length > 0 && (
        <section class="event-group" aria-labelledby="live-heading">
          <h2 class="group-heading group-heading--live" id="live-heading">
            <span class="group-dot" aria-hidden="true"></span>Live now
          </h2>
          <div class="event-grid">
            {grouped.live.map((event) => (
              <EventCard event={event} when={formatWhen(event)} state="live" showImage />
            ))}
          </div>
        </section>
      )
    }

    {
      grouped.ongoing.length > 0 && (
        <section class="event-group" aria-labelledby="ongoing-heading">
          <h2 class="group-heading" id="ongoing-heading">Running now</h2>
          <div class="event-grid">
            {grouped.ongoing.map((event) => (
              <EventCard event={event} when={formatWhen(event)} state="ongoing" showImage />
            ))}
          </div>
        </section>
      )
    }

    <section class="event-group" aria-labelledby="upcoming-heading">
      <h2 class="group-heading" id="upcoming-heading">Upcoming</h2>
      {
        grouped.upcoming.length > 0 ? (
          <div class="event-grid">
            {grouped.upcoming.map((event) => (
              <EventCard event={event} when={formatWhen(event)} state="upcoming" showImage />
            ))}
          </div>
        ) : (
          <p class="events-empty">
            Nothing on the calendar yet. Meetups are announced in{' '}
            <a href="https://discord.com/invite/2sYR5YdRpH" rel="noopener noreferrer" target="_blank">
              the Discord
            </a>
            first — subscribe to the feed above and they will land on your phone as soon as they
            are posted.
          </p>
        )
      }
    </section>

    {
      past.length > 0 && (
        <section class="event-group" aria-labelledby="past-heading">
          <h2 class="group-heading" id="past-heading">Recently finished</h2>
          <div class="event-grid">
            {past.map((event) => (
              <EventCard event={event} when={formatWhen(event)} state="past" showImage />
            ))}
          </div>
        </section>
      )
    }

    {
      credit && (
        <p class="events-credit">
          Global Pokémon GO event data from{' '}
          {credit.sourceUrl ? (
            <a href={credit.sourceUrl} rel="noopener noreferrer" target="_blank">
              {credit.source}
            </a>
          ) : (
            credit.source
          )}
          {credit.scraper && ' via '}
          {credit.scraper &&
            (credit.scraperUrl ? (
              <a href={credit.scraperUrl} rel="noopener noreferrer" target="_blank">
                {credit.scraper}
              </a>
            ) : (
              credit.scraper
            ))}
          .
        </p>
      )
    }
  </div>
</Base>

<style>
  .events {
    max-width: 980px;
    margin: 0 auto;
    padding: clamp(20px, 4vw, 40px) clamp(14px, 3vw, 24px) 56px;
    display: grid;
    gap: 24px;
  }

  /* --- the hero card -------------------------------------------------------
   *
   * `isolation: isolate` matters here. The art sits at z-index −2 and the scrim
   * at −1; without a stacking context on the card those escape to the root and
   * paint behind the page itself, which is the same trap the home page's hero
   * video hit.
   */
  .events-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-lg);
    /* Symmetric now. The bottom was the short side because the credit line sat
       in it; with that gone an uneven pad just reads as the text having slipped
       upward. */
    padding: clamp(22px, 5vw, 42px) clamp(16px, 4vw, 30px);
    color: #fff;
    /* The column used to exist to push the credit to the bottom edge. With only
       the heading and lede left, it centres them instead — anchored to the top
       of a 380px card they would sit above a pool of empty scrim. */
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /*
   * Taller from 760px up, so more of the artwork survives the crop.
   *
   * At the natural content height the card was 932x199 — a 4.7:1 slot for a
   * 16:9 image, which threw away most of it. This gives it closer to 3:1.
   * Height rather than aspect-ratio: the text still sets the floor on a narrow
   * screen, where a fixed ratio would leave a very tall card with four lines in
   * it.
   */
  @media (min-width: 760px) {
    .events-hero {
      min-height: clamp(260px, 30vw, 380px);
    }
  }
  .events-hero-art {
    display: block;
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .events-hero-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* High: the card is far wider than the 16:9 source, so `cover` keeps a
       horizontal band, and the trainers and Pokémon are in the upper half. */
    object-position: center 34%;
  }
  /*
   * Never lighter than 0.70 anywhere, and that is measured rather than chosen.
   * The artwork contains pure white cloud, so at 0.62 the credit line came out
   * at 4.23:1 — under AA. At 0.70 the worst case is h1 7.8:1, lede 6.9:1 and
   * the credit 5.6:1.
   */
  .events-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      105deg,
      rgb(6 8 12 / 0.84) 0%,
      rgb(6 8 12 / 0.74) 58%,
      rgb(6 8 12 / 0.7) 100%
    );
  }

  .events-hero h1 {
    margin: 0 0 6px;
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    color: #fff;
  }
  .events-lede {
    margin: 0;
    max-width: 62ch;
    color: rgb(255 255 255 / 0.92);
  }
  .events-note {
    margin: 0;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-left: 4px solid var(--poi-campsite);
    border-radius: var(--radius-sm);
    background: var(--bg-sunken);
    color: var(--text-muted);
    font-size: 0.86rem;
  }

  /* Empty until a countdown announces something, so it must not reserve space. */
  .events-live-status {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--live-text);
  }
  .events-live-status:empty {
    display: none;
  }

  .event-group {
    display: grid;
    gap: 12px;
  }

  .group-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .group-heading--live {
    color: var(--live-text);
    border-bottom-color: var(--live-text);
  }
  .group-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: currentColor;
    animation: group-dot-pulse 1.6s ease-in-out infinite;
  }
  @keyframes group-dot-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  .event-grid {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 760px) {
    .event-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .events-credit {
    margin: 0;
    padding-top: 8px;
    border-top: 1px solid var(--border);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .events-empty {
    margin: 0;
    padding: 22px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-sunken);
    color: var(--text-muted);
    text-align: center;
    max-width: 60ch;
    justify-self: center;
  }
</style>
