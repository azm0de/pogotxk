---
/**
 * Field research tasks and their encounter rewards, grouped by task category.
 *
 * Grouping matters here: a trainer spinning stops at Spring Lake Park wants to
 * know "which task should I keep" and the answer depends on what they can
 * actually do while walking a loop — throwing tasks are trivial, Rocket tasks
 * are not.
 *
 * Same architecture as /raids and /eggs: a running head, the freshness line,
 * then one panel per category.
 */
import Base from '~/layouts/Base.astro';
import Attribution from '~/components/game/Attribution.astro';
import GameNav from '~/components/game/GameNav.astro';
import FeedStatus from '~/components/game/FeedStatus.astro';
import ResearchCard from '~/components/game/ResearchCard.astro';
import '~/components/game/game.css';
import {
  getFeed,
  groupSorted,
  researchCategoryLabel,
  researchCategoryRank,
  slugifyLabel,
} from '~/lib/scrapedduck';

export const prerender = false;

const cfContext = Astro.locals.cfContext as ExecutionContext | undefined;
const feed = await getFeed('research', {
  waitUntil: cfContext ? (promise) => cfContext.waitUntil(promise) : undefined,
});

// A handful of tasks arrive with no category at all; they get their own bucket
// rather than being dropped or silently folded into "catch".
const categories = groupSorted(feed.data, (task) => task.type ?? 'other', researchCategoryRank);

const total = feed.data.length;
const shinyTasks = feed.data.filter((task) =>
  (task.rewards ?? []).some((reward) => reward.canBeShiny),
).length;
---

<Base
  title="Field Research"
  description="Every current Pokémon GO field research task and the encounters it rewards, grouped by task type — with CP ranges and shiny availability."
>
  <div class="g-page">
    <header class="g-head">
      <div class="panel-head">
        <h1>Field research</h1>
        {total > 0 && <span class="g-count">{total} tasks</span>}
      </div>
      <p class="g-lede">
        Tasks currently dropping from PokéStops, grouped by what they ask you to do. Each card
        lists every possible encounter, its CP range at the fixed research level, and whether the
        shiny is available.
      </p>
      <GameNav />
    </header>

    <FeedStatus
      fetchedAt={feed.fetchedAt}
      stale={feed.stale}
      error={feed.error}
      label="research list"
    />

    {
      total > 0 && (
        <p class="g-count g-summary">
          {total} tasks in rotation · {shinyTasks} can reward a shiny
        </p>
      )
    }

    {
      total === 0 ? (
        <div class="empty-state g-empty">
          <h2>No research list right now</h2>
          <p>
            We could not reach the live research data and have nothing saved to fall back on. Try
            again shortly, or check{' '}
            <a href="https://leekduck.com/research/">Leek Duck's research list</a> directly.
          </p>
        </div>
      ) : (
        categories.map((group) => {
          const id = `task-${slugifyLabel(group.key)}`;
          const headingId = `${id}-name`;
          const count = group.items.length;
          return (
            <section class="panel g-section" id={id} aria-labelledby={headingId}>
              <div class="panel-head g-section-head">
                <h2 id={headingId}>{researchCategoryLabel(group.key)}</h2>
                <span class="g-count">
                  {count} {count === 1 ? 'task' : 'tasks'}
                </span>
              </div>
              <ul class="g-grid g-grid--wide">
                {group.items.map((task) => (
                  <ResearchCard task={task} />
                ))}
              </ul>
            </section>
          );
        })
      )
    }

    <p class="g-map-link">
      <a class="btn btn--ghost btn--arrow" href="/map">Find these PokéStops on the park map</a>
    </p>

    <Attribution />
  </div>
</Base>
