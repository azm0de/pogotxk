---
/**
 * Current raid bosses, as a ladder: hardest tier first.
 *
 * Server-rendered from the KV-cached ScrapedDuck feed so the page is useful on
 * a phone with one bar of signal at Spring Lake Park — no client fetch, no
 * spinner. The only script is the shiny filter, and the page is complete
 * without it.
 *
 * The page used to open on a 375px-tall slab of Niantic key art that put the
 * 5-star tier at y=2169 — past two screenfuls of scrolling to reach the one
 * tier anybody plans an evening around. It now opens on its own heading, and
 * the jump row — shared with /eggs and /research, and sticky on all three —
 * puts every tier one tap away from anywhere on the page.
 */
import Base from '~/layouts/Base.astro';
import Attribution from '~/components/game/Attribution.astro';
import GameNav from '~/components/game/GameNav.astro';
import FeedStatus from '~/components/game/FeedStatus.astro';
import JumpRow from '~/components/game/JumpRow.astro';
import RaidCard from '~/components/game/RaidCard.astro';
import TierBadge from '~/components/game/TierBadge.astro';
import '~/components/game/game.css';
import { getFeed, groupSorted, raidTierRank, slugifyLabel } from '~/lib/scrapedduck';

export const prerender = false;

// Keep the KV write off the response path — the reader gets their bosses while
// the cache refresh finishes in the background.
const cfContext = Astro.locals.cfContext as ExecutionContext | undefined;
const feed = await getFeed('raids', {
  waitUntil: cfContext ? (promise) => cfContext.waitUntil(promise) : undefined,
});

/**
 * Ladder order: hardest first.
 *
 * `raidTierRank` ranks tiers the way a list of them is written down — 1-star up
 * to Elite, Shadow after everything — and that is the order nobody reads them
 * in. A raid hour is planned from the legendary tier down, so the ladder leads
 * with 5-star, then Mega and its named relatives, then anything unrecognised
 * (Niantic names a new tier most seasons), then the soloable tiers counting
 * down. A Shadow variant sorts immediately above its plain sibling.
 */
function ladderRank(tier: string): number {
  const rank = raidTierRank(tier);
  const shadow = rank >= 1000;
  const base = shadow ? rank - 1000 : rank;
  const lead = shadow ? -0.5 : 0;

  if (base >= 4 && base < 100) return -base + lead; // 6-star, 5-star, 4-star
  if (base >= 100 && base < 900) return 100 + base + lead; // Mega, Primal, Elite
  if (base >= 900) return 500 + lead; // a tier we have never seen
  return 1000 - base + lead; // 3-star, 2-star, 1-star
}

const ladder = groupSorted(feed.data, (boss) => boss.tier, ladderRank);
const total = feed.data.length;
const shinyCount = feed.data.filter((boss) => boss.canBeShiny).length;

/**
 * The filter only earns its place when it would actually remove something.
 * Right now every boss in rotation can be shiny, so a "shiny-eligible only"
 * button would be a control that does nothing — the count says it instead.
 */
const filterChangesSomething = shinyCount > 0 && shinyCount < total;
const shinyLine =
  shinyCount === total
    ? `All ${total} bosses in rotation can be shiny.`
    : `None of the ${total} bosses in rotation can be shiny right now.`;

/** Local, practical context per tier — the part a boss list alone does not tell you. */
function tierNote(tier: string): string | null {
  const t = tier.toLowerCase();
  if (t.includes('shadow')) return 'Shadow bosses hit harder and cannot be re-lobbied — go in with a full group.';
  if (t.includes('mega') || t.includes('primal'))
    return 'Rewards Mega Energy for that species line. Two or three trainers usually clear it.';
  if (t.includes('1-star')) return 'Soloable at almost any level — good candy and TM farming.';
  if (t.includes('3-star')) return 'Soloable once you have a decent counter roster; quicker with a friend.';
  if (t.includes('5-star'))
    return 'Legendary tier. Raid trains and remote invites get organised in the Discord.';
  return null;
}

/** "5-Star Raids" -> "5-Star", for the jump chips. */
function shortTier(tier: string): string {
  return tier.replace(/\s*raids?\s*$/i, '').trim() || tier;
}
---

<Base
  title="Raid Bosses"
  description="Every current Pokémon GO raid boss by tier, with catch CP, weather-boosted CP, type matchups, and shiny availability — for the PoGo TXK community in Texarkana."
>
  <div class="g-page">
    <header class="g-head">
      <div class="panel-head">
        <h1>Current raid bosses</h1>
        {total > 0 && <span class="g-count">{total} in rotation</span>}
      </div>
      <p class="g-lede">
        Every boss in rotation right now, hardest tier first, with the CP you will see on the catch
        screen and the weather that boosts it.
      </p>
      <GameNav />
    </header>

    <FeedStatus
      fetchedAt={feed.fetchedAt}
      stale={feed.stale}
      error={feed.error}
      label="raid list"
    />

    <JumpRow
      label="Jump to a tier"
      noun={['boss', 'bosses']}
      items={ladder.map((group) => ({
        key: shortTier(group.key),
        id: `tier-${slugifyLabel(group.key)}`,
        count: group.items.length,
      }))}
    />

    {
      total > 0 &&
        (filterChangesSomething ? (
          <div class="g-toolbar" id="raid-toolbar" hidden>
            <button type="button" class="chip" id="shiny-toggle" aria-pressed="false">
              Shiny-eligible only
            </button>
            <p class="g-count" id="raid-filter-status" role="status">
              Showing all {total} bosses · {shinyCount} can be shiny
            </p>
          </div>
        ) : (
          <p class="g-count g-summary">{shinyLine}</p>
        ))
    }

    {
      total === 0 ? (
        <div class="empty-state g-empty">
          <h2>No raid list right now</h2>
          <p>
            We could not reach the live boss list and have nothing saved to fall back on. Try again
            in a few minutes, or check <a href="https://leekduck.com/boss/">Leek Duck's boss list</a>{' '}
            directly.
          </p>
        </div>
      ) : (
        ladder.map((group) => {
          const id = `tier-${slugifyLabel(group.key)}`;
          const headingId = `${id}-name`;
          return (
            <section class="panel g-section" id={id} data-tier-section aria-labelledby={headingId}>
              <div class="panel-head g-section-head">
                <TierBadge tier={group.key} headingId={headingId} note={tierNote(group.key)} />
                <span class="g-count" data-tier-count>
                  {group.items.length} {group.items.length === 1 ? 'boss' : 'bosses'}
                </span>
              </div>
              <ul class="g-grid">
                {group.items.map((boss) => (
                  <RaidCard boss={boss} />
                ))}
              </ul>
            </section>
          );
        })
      )
    }

    <p class="g-map-link">
      <a class="btn btn--outline btn--arrow" href="/map">Find these gyms on the park map</a>
    </p>

    <Attribution />
  </div>
</Base>

<script>
  /*
   * Shiny filter. Rendered `hidden` and revealed here so the control never
   * appears for a reader who has no JavaScript to run it — without this script
   * the page is simply the full, unfiltered list. The page only renders the
   * toolbar at all when filtering would change what is on screen.
   */
  const toolbar = document.getElementById('raid-toolbar');
  const toggle = document.getElementById('shiny-toggle');
  const status = document.getElementById('raid-filter-status');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.g-card[data-shiny]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-tier-section]'));

  if (toolbar && toggle && status && cards.length > 0) {
    toolbar.hidden = false;

    toggle.addEventListener('click', () => {
      const shinyOnly = toggle.getAttribute('aria-pressed') !== 'true';
      toggle.setAttribute('aria-pressed', String(shinyOnly));

      let shown = 0;
      for (const card of cards) {
        const visible = !shinyOnly || card.dataset.shiny === 'true';
        card.hidden = !visible;
        if (visible) shown += 1;
      }

      // A tier whose whole grid just emptied should take its heading with it —
      // and its jump chip, which would otherwise point at nothing. A tier that
      // kept some of its bosses recounts, so its head never claims six above
      // two cards.
      for (const section of sections) {
        const left = section.querySelectorAll('.g-card:not([hidden])').length;
        section.hidden = left === 0;
        const jump = document.querySelector<HTMLElement>(`[data-jump-for="${section.id}"]`);
        if (jump) jump.hidden = left === 0;
        const count = section.querySelector<HTMLElement>('[data-tier-count]');
        if (count) count.textContent = `${left} ${left === 1 ? 'boss' : 'bosses'}`;
      }

      status.textContent = shinyOnly
        ? `Showing ${shown} shiny-eligible ${shown === 1 ? 'boss' : 'bosses'}`
        : `Showing all ${cards.length} bosses`;
    });
  }
</script>
