---
import Base from '~/layouts/Base.astro';
import QuickActions from '~/components/go/QuickActions';
import BubbleControl from '~/components/go/BubbleControl';

export const prerender = false;

// Passed in from the server so the screen knows immediately whether it can post,
// rather than flashing a sign-in prompt at someone who is already signed in.
const user = Astro.locals.user ?? null;

// `/go?poi=<slug>` is how the map hands over: the trainer tapped a pin and
// chose "Flare this", so the location question is already answered. Same
// parameter name and same slug vocabulary as /map?poi=, so a link is
// interchangeable between the two screens.
const initialPoi = Astro.url.searchParams.get('poi') ?? undefined;

// `/go?action=<kind>` is the installed app's "Flare a gym" shortcut (see
// site.webmanifest) and any future link that wants to open straight into an
// action sheet. An unrecognised kind is just passed through — QuickActions
// falls back to the normal picker rather than throwing, since this is a raw
// query param and nothing here validates it against the ActionDef vocabulary.
const initialAction = Astro.url.searchParams.get('action') ?? undefined;
---

<Base
  title="Quick actions"
  description="Fire a raid flare, call for remote invites, or check in — one-handed, while you play."
  fullBleed
>
  <Fragment slot="head">
    <!-- This is the screen people install to their home screen. The iOS
         home-screen tags themselves now live in Base.astro, so every page
         gets them, not just this one. -->
    <meta name="robots" content="noindex" />
  </Fragment>

  <div class="go-page">
    <!-- Renders nothing unless the page is inside the Android app, which is the
         only place the ball can exist. Placed above the actions because turning
         it on is a thing you do once, before you start playing — not a step in
         sending a flare.

         `client:idle` rather than `client:load`: outside the app this component
         renders nothing at all, so it has no business competing with the action
         grid for the main thread on a phone on park wifi. -->
    <BubbleControl client:idle />

    <QuickActions client:load user={user} initialPoi={initialPoi} initialAction={initialAction} />
  </div>
</Base>

<style>
  /*
   * The page's root wrapper. `main` is a flex item with a definite height (see
   * `body.is-full-bleed` in Base.astro), so this passes that height straight
   * through to the panel, which does its own scrolling.
   */
  .go-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    font-family: var(--font-read);
  }
</style>

<script>
  // Registered only from /go: the service worker exists to make the installed
  // app work on a bad signal, and there is no reason to install it on someone
  // who just read a blog post.
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {
        /* Non-fatal: the page works fine without it. */
      });
    });
  }
</script>
