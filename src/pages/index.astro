---
import { env } from 'cloudflare:workers';
import Base from '~/layouts/Base.astro';
import MapPreview from '~/components/map/MapPreview';
import SocialIcon from '~/components/SocialIcon.astro';
import { SOCIALS } from '~/lib/socials';
import EventCard from '~/components/events/EventCard.astro';
import {
  listPublicMeetups,
  markdownToText,
  meetupLocation,
  meetupToCalendarEvent,
} from '~/lib/db/meetups';
import { listPublishedPosts } from '~/lib/db/posts';
import { gameEventsFromPayload, groupEvents, type CalendarEvent } from '~/lib/ics';
import { getFeed, raidTierRank } from '~/lib/scrapedduck';
import Attribution from '~/components/game/Attribution.astro';
import { proxiedImageUrl } from '~/lib/game-image';
import { DEFAULT_TZ, formatInZone } from '~/lib/time';

export const prerender = false;

const db = env.DB;

/**
 * Everything on this page is optional. A brand-new deployment has no POIs, no
 * meetups and no posts, and the page still has to look deliberate rather than
 * broken — so each section renders a real fallback instead of an empty shell.
 */
const [counts, meetups, posts, photos, landmarks] = await Promise.all([
  db
    .prepare(
      `SELECT
         SUM(type = 'pokestop')  AS pokestops,
         SUM(type = 'gym')       AS gyms,
         SUM(type = 'powerspot') AS powerspots,
         SUM(is_campsite)        AS campsite
       FROM pois WHERE status = 'published'`,
    )
    .first<{ pokestops: number; gyms: number; powerspots: number; campsite: number }>()
    .catch(() => null),

  listPublicMeetups(db).catch(() => []),
  listPublishedPosts(db, { limit: 3 }).catch(() => ({ posts: [], total: 0 })),

  db
    .prepare(
      `SELECT r2_key, alt, credit FROM media
        WHERE kind = 'community_photo' ORDER BY created_at DESC LIMIT 4`,
    )
    .all<{ r2_key: string; alt: string | null; credit: string | null }>()
    .then((r) => r.results)
    .catch(() => []),

  /*
   * The landmarks themselves — a T-33 trainer jet, the park mural, the water
   * spring. Sixty-three of the 104 POIs carry a photograph, and until now the
   * only way to see one was to tap its pin on the map.
   *
   * Gyms first: they are where people actually stand around together, so the
   * rail opens on the places that matter for a raid. Then by name, which is
   * arbitrary but stable — the order must not shuffle between requests.
   */
  db
    .prepare(
      `SELECT p.slug, p.name, p.type, m.r2_key
         FROM pois p
         JOIN media m ON m.id = p.hero_media_id
        WHERE p.status = 'published'
        ORDER BY (p.type = 'gym') DESC, p.name
        LIMIT 18`,
    )
    .all<{ slug: string; name: string; type: string; r2_key: string }>()
    .then((r) => r.results)
    .catch(() => []),
]);

const nowIso = new Date().toISOString();
const nextMeetup = meetups.find((m) => (m.endsAt ?? m.startsAt) >= nowIso) ?? null;

const latestPosts = Array.isArray(posts) ? posts : posts.posts;

const totalPois =
  (counts?.pokestops ?? 0) + (counts?.gyms ?? 0) + (counts?.powerspots ?? 0);

/**
 * What is happening *right now* — community meetups and Pokémon GO events in
 * one list, the same way /events builds it.
 *
 * Read from the data layer rather than fetched from our own /api route: a
 * Worker fetching its own origin is a loopback through the edge that works
 * under `astro dev` and returns nothing in production. That bug already shipped
 * once — see the vault's Bugs Worth Remembering.
 */
const globalEvents = await getFeed('events')
  .then(gameEventsFromPayload)
  .catch(() => null);

/**
 * The bosses actually worth walking to tonight — legendary and mega tiers only.
 *
 * `raidTierRank` is the same ordering /raids uses, so "headline" means the same
 * thing on both pages rather than being a second opinion. Capped at four: this
 * is a glance, and /raids is one tap away for the rest.
 */
const raidFeed = await getFeed('raids').catch(() => null);
const headlineBosses = (raidFeed?.data ?? [])
  .filter((boss) => {
    const t = boss.tier.toLowerCase();
    return t.includes('5-star') || t.includes('mega') || t.includes('primal');
  })
  .sort((a, b) => raidTierRank(b.tier) - raidTierRank(a.tier))
  .slice(0, 4);

const happening = groupEvents([
  ...meetups.map((m) => meetupToCalendarEvent(m, new URL(Astro.url.origin))),
  ...(globalEvents?.events ?? []),
]);

// "Live" is a short window (a Raid Hour); "ongoing" is a season that runs for
// weeks. Both are on right now, so the home page shows them together, live
// first, and caps the list — this is a teaser for /events, not a second copy.
const onNow: CalendarEvent[] = [...happening.live, ...happening.ongoing].slice(0, 4);
const moreOnNow = happening.live.length + happening.ongoing.length - onNow.length;

const dayFmt = new Intl.DateTimeFormat('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  timeZone: DEFAULT_TZ,
});
const timeFmt = new Intl.DateTimeFormat('en-US', {
  hour: 'numeric',
  minute: '2-digit',
  timeZone: DEFAULT_TZ,
});

/** Compact "when" line for the home page cards. */
function homeWhen(event: CalendarEvent): string {
  const start = new Date(event.start);
  if (event.allDay) return `${dayFmt.format(start)} · all day`;
  if (!event.end) return `${dayFmt.format(start)} · ${timeFmt.format(start)}`;
  const end = new Date(event.end);
  const sameDay = dayFmt.format(start) === dayFmt.format(end);
  return sameDay
    ? `${dayFmt.format(start)} · ${timeFmt.format(start)} – ${timeFmt.format(end)}`
    : `${dayFmt.format(start)} – ${dayFmt.format(end)}`;
}

---

<Base title="PoGo TXK">

  {/*
    A full-width band around the hero purely so the artwork has an edge to run
    off. The hero itself is capped at 1100px and centred, so art anchored to it
    would stop at the content box rather than the screen.
  */}
  <div class="hero-band art-band">
    {/*
      Leafeon and Espeon, behind the logo and the map.
      Source was 3440x1440 at 60fps and 25Mbps — 53MB, with an audio track on a
      background that is muted by definition. Re-encoded to 1600 wide, 30fps and
      no audio: 656KB, which is 1.2% of what was handed over.

      `data-src`, not `src`, and `preload="none"`: the script below only promotes
      it above 900px and only when motion is allowed, so a phone on cell data
      never fetches it at all. Everything is keyed off `data-hero-video`, which
      goes on the band when the video actually reaches `playing` — so a blocked
      autoplay, a decode failure or reduced motion all land on exactly the hero
      that exists today rather than on a dark band over nothing.
    */}
    {/*
      No `poster`. The element is transparent until `playing` fires, so a poster
      would never actually be seen — but the browser fetches it regardless, which
      cost every phone 61KB for an image behind an invisible element. The static
      hero is the loading state.
    */}
    <video
      class="hero-video"
      data-src="/hero/eevee-forest.mp4"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"></video>
    <div class="hero-scrim" aria-hidden="true"></div>

    <section class="hero">
    <div class="hero-copy">
      {/*
        The logo says the name now, so the h1 holds the image instead of the
        words. The heading element itself stays — it is this page's only h1 and
        the document outline hangs off it — which makes `alt` load-bearing: it
        has to read exactly what the text used to.
      */}
      <h1>
        {/*
          Deliberately NO `fetchpriority="high"`, despite Lighthouse's LCP audit
          asking for it. This is the LCP element, so the advice looks right — it
          was tried, and the trace says otherwise.
          Without the hint Chrome already assigns this image **High** on its own,
          because it is large and in the initial viewport. Adding the attribute
          did not raise that; the request came back **Medium**, and the audit
          still reported `priorityHinted: false`, so it never satisfied the check
          it was added for. Measured production LCP was worse with it than
          without across three runs.
          Do not re-add it on the strength of the audit alone. Check the priority
          in the network trace first.
        */}
        <img
          class="hero-logo"
          src="/art/logo-txk-classic.webp"
          width="850"
          height="793"
          alt="Pokémon GO Texarkana"
        />
      </h1>
      <p class="lede">
        A community Campsite at Spring Lake Park, run by trainers from all three teams. Find every
        PokéStop and Gym, catch the next meetup, and raid with people who actually show up.
      </p>

      <div class="hero-actions">
        <a class="btn btn--primary" href="/map">Open the map</a>
        <a
          class="btn btn--discord"
          href="https://discord.com/invite/2sYR5YdRpH"
          rel="noopener noreferrer"
          target="_blank">Join the Discord</a
        >
      </div>

    </div>

    {/*
      A sibling of `.hero-copy`, not a child of it, and that is load-bearing on
      desktop: it gives the counts their own grid row, which lets the map end on
      the same line as the buttons without anyone having to know how tall this
      block is. Stacked below 820px it simply follows the copy, exactly where it
      read before.
    */}
    {
      totalPois > 0 && (
        <dl class="stats">
          <div><dt>PokéStops</dt><dd>{counts?.pokestops ?? 0}</dd></div>
          <div><dt>Gyms</dt><dd>{counts?.gyms ?? 0}</dd></div>
          <div><dt>Power Spots</dt><dd>{counts?.powerspots ?? 0}</dd></div>
          <div><dt>★ Campsite</dt><dd>{counts?.campsite ?? 0}</dd></div>
        </dl>
      )
    }

    {/*
      The real map, not a picture of one. It is the thing people came for, so
      making them click through to find out whether their park is on it was the
      wrong trade.

      `client:visible` keeps Leaflet and the marker data off the critical path —
      nothing loads until the preview is actually scrolled to, which on a phone
      is often never. MapPreview exists to make that possible: MapView itself
      cannot be server-rendered, because Leaflet reads `window` on import.
    */}
    <div class="hero-map">
      <MapPreview client:visible compact />

      <a class="hero-map-open" href="/map">
        <span>Open the full map</span>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M13.2 5.4 11.8 6.8l4.2 4.2H4v2h12l-4.2 4.2 1.4 1.4 6.6-6.6z"></path>
        </svg>
      </a>

      <noscript>
        <div class="hero-map-fallback">
          <strong>Spring Lake Park</strong>
          <span>
            {
              totalPois > 0
                ? `${totalPois} locations mapped — the interactive map needs JavaScript.`
                : 'The interactive map needs JavaScript.'
            }
          </span>
        </div>
      </noscript>
      </div>
    </section>
  </div>

  {/*
    What is on right now, immediately under the map. The hero says where we are;
    this says whether anything is happening there today — which is the first
    thing a returning member wants and the second thing a newcomer does.
    Community meetups and Pokémon GO events in one list, as /events builds it.
  */}
  <div class="onnow-band art-band">
  <section class="section" aria-labelledby="on-now-heading">
    <div class="section-head">
      <h2 id="on-now-heading">
        {onNow.length > 0 && <span class="on-now-dot" aria-hidden="true" />}
        Happening now
      </h2>
      <a href="/events">Upcoming events →</a>
    </div>

    {
      onNow.length > 0 ? (
        <>
          <div class="on-now">
            {onNow.map((event) => (
              <EventCard
                event={event}
                when={homeWhen(event)}
                state={happening.live.includes(event) ? 'live' : 'ongoing'}
                showImage
              />
            ))}
          </div>
          <p class="on-now-more">
            <a class="btn btn--outline" href="/events">
              <span>
                {moreOnNow > 0
                  ? `See ${moreOnNow} more and everything upcoming`
                  : 'See everything upcoming'}
              </span>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M13.2 5.4 11.8 6.8l4.2 4.2H4v2h12l-4.2 4.2 1.4 1.4 6.6-6.6z"></path>
              </svg>
            </a>
          </p>
        </>
      ) : (
        <div class="on-now-empty">
          <p class="empty">
            Nothing running at this minute. Raid Hours, Community Days and Spotlight Hours all
            show up here automatically when they start.
          </p>
          <a class="btn btn--outline" href="/events">
            See what is coming up
          </a>
        </div>
      )
    }

    {/*
      Licence, not decoration. This page shows Leek Duck's event artwork and raid
      bosses, and their terms require visible credit to both Leek Duck AND
      ScrapedDuck on any page using the data. It had been crediting Leek Duck in
      one line of prose and never naming ScrapedDuck at all — a gap introduced
      when "Happening now" started rendering their artwork.
    */}
    <Attribution />
  </section>
  </div>

  {
    photos.length > 0 && (
      <section class="section">
        {/* Four of nine, and until now there was no way to reach the other
            five from here — the section was the only one on the page with no
            route onward. */}
        <div class="section-head">
          <h2>The community</h2>
          <a href="/gallery">All photos →</a>
        </div>

        {/*
          The GO Fest group shot, in the flow above the tiles rather than behind
          them. As a background it was never really visible: the tiles are opaque
          and `auto-fit` collapses them to a single column below ~430px, so no
          amount of scrim tuning was going to show a photograph they were sitting
          on top of.

          Its `alt` is back. It was `alt=""` while it was decoration behind a
          heading that already said what it was; now it is the thing itself.

          Still art-directed — a sixty-person group shot 3.4 times wider than it
          is tall renders every face about three pixels across on a phone, so
          narrow screens get the tighter crop centred on the two Ambassador
          banners. `sizes` is no longer `100vw`: it sits inside the 1100px
          section now, not across the viewport.
        */}
        <figure class="community-shot">
          <picture>
            <source
              media="(min-width: 900px)"
              srcset="/hero/community-wide-1200.webp 1200w, /hero/community-wide-1600.webp 1600w, /hero/community-wide-2400.webp 2400w"
              sizes="(min-width: 1140px) 1060px, calc(100vw - 40px)"
            />
            <img
              src="/hero/community-tight-900.webp"
              srcset="/hero/community-tight-600.webp 600w, /hero/community-tight-900.webp 900w, /hero/community-tight-1200.webp 1200w"
              sizes="calc(100vw - 40px)"
              width="1200"
              height="560"
              alt="PoGo TXK members gathered at Spring Lake Park for GO Fest 2026, holding two Pokémon GO Community Ambassador banners under a black and a purple canopy."
              loading="lazy"
              decoding="async"
            />
          </picture>
        </figure>
        <ul class="photos">
          {photos.map((photo) => (
            <li>
              <img
                src={`/media/${photo.r2_key}`}
                alt={photo.alt ?? 'PoGo TXK community photo'}
                loading="lazy"
                width="400"
                height="300"
              />
              {photo.credit && <span>{photo.credit}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="grid">
    <section class="card card--meetup">
      <h2>Next meetup</h2>
      {
        nextMeetup ? (
          <>
            <p class="meetup-title">{nextMeetup.title}</p>
            <p class="meetup-when">{formatInZone(nextMeetup.startsAt, nextMeetup.tz)}</p>
            <p class="meetup-where">{meetupLocation(nextMeetup) ?? 'Location to be confirmed'}</p>
            {nextMeetup.descriptionMd && (
              <p class="meetup-note">{markdownToText(nextMeetup.descriptionMd)}</p>
            )}
            <a class="card-link" href="/events">All events →</a>
          </>
        ) : (
          <>
            <p class="empty">
              Nothing on the calendar right now. Meetups get announced in Discord first — the
              regular slot is Wednesday evenings at the Campsite.
            </p>
            <a class="card-link" href="/events">See the event calendar →</a>
          </>
        )
      }
    </section>

    <section class="card empty-art-bg">
      <h2>Right now</h2>
      <p class="empty">
        Raid flares from the community appear on the live board. Fire one when you are at a gym
        and need people.
      </p>
      <a class="card-link" href="/live">Open the live board →</a>
    </section>

    <section class="card card--raids">
      <h2>In game today</h2>
      {
        headlineBosses.length > 0 ? (
          <>
            {/* The bosses themselves, not a sentence about them. This is the
                same functional use as /raids — you are here to find out what
                is worth walking to tonight — and the same attributed source. */}
            <ul class="boss-strip">
              {headlineBosses.map((boss) => (
                <li>
                  {/* Through our proxy, not hotlinked — same reasoning as the
                      event artwork: it is Leek Duck's bandwidth, and a cached
                      copy survives them adding hotlink protection. */}
                  <img
                    src={proxiedImageUrl(boss.image) ?? boss.image}
                    alt=""
                    width="56"
                    height="56"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="boss-name">{boss.name}</span>
                  <span class="boss-tier">{boss.tier.replace(/ Raids?$/i, '')}</span>
                  {boss.canBeShiny && (
                    <span class="boss-shiny" title="Can be shiny">
                      <span class="sr-only">Can be shiny</span>
                      <span aria-hidden="true">✦</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
            <p class="card-links">
              <a href="/raids">All raid bosses</a> · <a href="/eggs">Eggs</a> ·{' '}
              <a href="/research">Research</a>
            </p>
          </>
        ) : (
          <>
            <p class="empty">
              Current raid bosses, egg pools and field research, updated automatically.
            </p>
            <p class="card-links">
              <a href="/raids">Raid bosses</a> · <a href="/eggs">Eggs</a> ·{' '}
              <a href="/research">Research</a>
            </p>
          </>
        )
      }
    </section>
  </div>

  {
    latestPosts.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Community news</h2>
          <a href="/blog">All posts →</a>
        </div>
        <ul class="posts">
          {latestPosts.map((post) => (
            <li>
              <a href={`/blog/${post.slug}`}>
                <strong>{post.title}</strong>
                {post.excerpt && <span>{post.excerpt}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/*
    The places themselves, with their faces on. Sits last because it is the
    "go and look" note the page ends on, immediately before the ways to reach
    us — a local recognises three of these instantly, and that recognition is
    the moment the page stops being a generic fan site.

    A rail rather than a grid because the photographs are overwhelmingly
    portrait phone shots — eighteen of those in a grid is a wall of vertical
    crops, and a row that runs off the edge is also the true statement: there
    are more of these than fit.
  */}
  {
    landmarks.length > 0 && (
      <section class="section places" aria-labelledby="places-heading">
        <div class="section-head">
          <h2 id="places-heading">Places you already know</h2>
          <a href="/map">All {totalPois} on the map →</a>
        </div>

        <ul class="place-rail">
          {landmarks.map((place) => (
            <li>
              <a href={`/map?poi=${encodeURIComponent(place.slug)}`}>
                {/* alt="" deliberately: the name is right there as visible
                    text, and the link takes its accessible name from it.
                    Real alt text here would read every place twice. */}
                <img
                  src={`/media/${place.r2_key}`}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span class="place-label">
                  <span class="place-type">
                    <span class={`place-dot place-dot--${place.type}`} aria-hidden="true" />
                    {place.type === 'gym' ? 'Gym' : 'PokéStop'}
                  </span>
                  <strong>{place.name}</strong>
                </span>
              </a>
            </li>
          ))}

          <li class="place-more">
            <a href="/map">
              <span>See all {totalPois} on the map</span>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M13.2 5.4 11.8 6.8l4.2 4.2H4v2h12l-4.2 4.2 1.4 1.4 6.6-6.6z"></path>
              </svg>
            </a>
          </li>
        </ul>
      </section>
    )
  }

  <section class="section">
    <div class="section-head">
      <h2>Find us</h2>
    </div>
    <ul class="socials">
      {
        SOCIALS.map((social) => (
          <li>
            <a
              class={`social social--${social.name}`}
              href={social.href}
              rel="noopener noreferrer"
              target="_blank"
            >
              <span class="social-mark" aria-hidden="true">
                <SocialIcon name={social.name} size={42} />
              </span>
              <span class="social-text">
                <strong>{social.label}</strong>
                <span>{social.hint}</span>
              </span>
              {/* Every one of these opens in a new tab; the arrow is the only
                  thing on the tile that says so. Decorative, because the link
                  already has its name from the label. */}
              <span class="social-go" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/*
    The one section on this page with real room for artwork. Its paragraphs are
    capped at 68ch, so at 1600px there are ~798px of clear space to their right
    — everything else on the home page is edge-to-edge cards. This is where a
    bird can be a whole bird rather than a slice cropped by the screen.
  */}
  <div class="campsite-band art-band">
    <section class="section campsite">
      <h2>What is a Community Campsite?</h2>
      <p>
        Community Campsites are dedicated in-game areas established by official Community
        Ambassadors, and they act as local hubs for in-person meetups. They come with perks —
        exclusive event check-ins, special Timed Research, and enhanced PokéStops and Gyms.
      </p>
      <p>
        Ours covers Spring Lake Park. The ★ markers on the map are the Campsite locations.
      </p>
    </section>
  </div>

  <script is:inline>
    // The hero video. Every screen now, phones included.
    //
    // The width gate that used to be here was not about bandwidth so much as
    // framing: `cover` on a 2.39:1 clip inside a tall phone column keeps about
    // 18% of the width, and both Pokémon sit outside that. The CSS solves it by
    // giving the clip its own strip at the top on narrow screens instead of
    // stretching it over the whole band, so the gate is gone.
    //
    // `saveData` stays as the one opt-out. 656KB of decoration is not something
    // to push at someone who has explicitly asked their browser to spend less.
    (() => {
      const band = document.querySelector('.hero-band');
      const video = band && band.querySelector('.hero-video');
      if (!video) return;

      const still = matchMedia('(prefers-reduced-motion: reduce)');
      const thrifty = navigator.connection && navigator.connection.saveData;

      // Set on `playing`, not on load: until frames are actually going up there
      // is nothing to darken, and the scrim would just be a grey slab.
      video.addEventListener('playing', () => band.setAttribute('data-hero-video', ''));

      const sync = () => {
        if (!still.matches && !thrifty) {
          if (!video.src) video.src = video.dataset.src;
          // The attribute alone is not always enough for autoplay policy; the
          // property is what browsers actually check.
          video.muted = true;
          // A refused autoplay is a normal outcome, not an error — the static
          // hero is already the fallback, so there is nothing to handle.
          video.play().catch(() => {});
        } else {
          video.pause();
          band.removeAttribute('data-hero-video');
        }
      };

      sync();
      still.addEventListener('change', sync);
    })();
  </script>
</Base>

<style>
  /* --- the community photograph --------------------------------------------
   *
   * In the flow above the tiles, not behind them.
   *
   * It spent one revision as a background, and the problem there was structural
   * rather than a matter of tuning: the tiles are opaque, and `auto-fit`
   * collapses them to a single column below ~430px, so on a phone they covered
   * the band end to end. No amount of scrim grading shows a photograph that
   * something is sitting on top of — the only pixels ever visible were the
   * padding around the grid.
   *
   * Gone with that approach: the band wrapper, the absolute positioning, the
   * three-stage scrim built off `--cb-pad`, and the white-text overrides the
   * dark scrim needed. The heading is back to ordinary `--text` on the page
   * background, because there is no longer anything dark behind it.
   */
  .community-shot {
    margin: 0 0 10px;
    border-radius: var(--radius);
    /* Clips the drift below, which scales the image past its own box. */
    overflow: hidden;
    background: var(--bg-sunken);
  }
  .community-shot picture {
    display: block;
  }
  .community-shot img {
    display: block;
    width: 100%;
    height: auto;
    /* Matches the tight crop the `<img>` fallback actually serves, so `cover`
       is not cropping an already-cropped frame a second time. */
    aspect-ratio: 1200 / 560;
    max-height: 300px;
    object-fit: cover;
    /* Low, because the people are in the lower two-thirds of the frame. */
    object-position: center 58%;
    /* The same slow drift the hero video has, so the page does not read as one
       moving half and one still one. 1.00 -> 1.04 over 32s, `alternate` so it
       eases back rather than snapping at the loop. */
    animation: cb-drift 32s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes cb-drift {
    from {
      transform: scale(1) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.04) translate3d(-0.6%, -0.5%, 0);
    }
  }
  /* The `<source>` swaps to the wide crop at exactly this width, so the ratio
     has to swap with it or `cover` starts eating the group. */
  @media (min-width: 900px) {
    .community-shot img {
      aspect-ratio: 2540 / 740;
      max-height: 360px;
      object-position: center 72%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .community-shot img {
      animation: none;
    }
  }

  /* --- hero artwork ---------------------------------------------------------
   * Articuno — Mystic's bird, and the one whose blue sits with the navy brand.
   *
   * Sized against the gap, not against taste. The hero content box is capped at
   * 1100px and the map card fills the right half of it, so at a 1280px viewport
   * there are only ~118px between that card's edge and the screen's. Anything
   * wider simply hides behind an opaque card — a first pass at 320px had 157px
   * of the bird behind it.
   *
   * It cannot go in front, either: the map's bottom-right corner carries the
   * OpenStreetMap and CARTO attribution, which must never be covered.
   *
   * So it is pushed deliberately past the edge — the leading half shows and the
   * screen crops the rest. Both values are vw-based so the visible slice grows
   * on wider screens instead of being pinned to one breakpoint's arithmetic.
   */
  .hero-band {
    /* The negative top margin that used to slide this under the community
       banner is gone with the banner. It is the first thing in `main` now, and
       a −80px margin there would only have pulled the video up behind an opaque
       sticky header. */
    --art-src: url('/art/lucario-shiny.webp');
    /* 280x431 trimmed — the narrowest of the three, which is why it gets the
       hero: a tall subject reads from a thin sliver where a round one would
       show as an unidentifiable curve. */
    --art-ratio: 0.65;
    --art-right: calc(-1 * clamp(30px, 6vw, 110px));
    --art-bottom: -14px;
    --art-w: clamp(150px, 17vw, 280px);

    /*
     * The distance the video and its scrim dissolve over at the foot of the
     * band, and the room made for them to do it in.
     *
     * The padding is unconditional rather than sitting under
     * `[data-hero-video]`. Tying it to the video would move everything below the
     * hero down the moment playback started — a layout shift a second into the
     * page load, which is worse than a little extra breathing room on the runs
     * where the video never plays.
     *
     * `--hero-out` stays under the clear space beneath the last content, so the
     * dissolve never thins the scrim under the stats. Measured, not assumed: at
     * 5.5vw/88px the margin came out at 8px at 1280, which is a rounding step
     * from the fade reaching white text on a bright frame. 6.5vw/96px puts it at
     * 21–26px across 900–1920.
     */
    --hero-out: clamp(70px, 8vw, 110px);
    padding-bottom: clamp(52px, 6.5vw, 96px);
  }

  /* --- the forest behind the hero -------------------------------------------
   *
   * Both layers start invisible and are revealed together by `data-hero-video`.
   * That attribute is set on `playing`, never on load, so every way this can
   * fail — autoplay refused, codec missing, reduced motion, narrow screen —
   * leaves the hero exactly as it is without the video, instead of leaving a
   * scrim darkening an empty band.
   *
   * z-index −2 and −1 put them under the hero's static content while keeping
   * the scrim over the video. Same trick the `.art-band` pseudo-elements
   * already use, and it works for the same reason: nothing between here and the
   * root paints an opaque background.
   */
  .hero-video,
  .hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  .hero-video {
    z-index: -2;
    width: 100%;
    height: 100%;
    /* Fills the band, which is what a phone wants: stacked, the band is taller
       than it is wide, and a clip sized to its own 2.39:1 ratio would be a
       thin strip over a lot of empty. The sides are heavily cropped as a
       result — unavoidable at that shape.

       From 900px up this is overridden below, where there is enough width for
       the clip to be shown closer to whole. Centred either way: the two
       subjects sit at 33% and 76% across, so any `object-position` off centre
       drops one of them first. */
    object-fit: cover;
    object-position: center;
  }
  .hero-scrim {
    z-index: -1;
    /* Heaviest on the left, where the copy is, and lifting toward the map card
       on the right, which brings its own opaque background. */
    background: linear-gradient(
      to right,
      rgb(6 8 12 / 0.84) 0%,
      rgb(6 8 12 / 0.72) 46%,
      rgb(6 8 12 / 0.52) 100%
    );
  }
  .hero-band[data-hero-video] .hero-video,
  .hero-band[data-hero-video] .hero-scrim {
    opacity: 1;
  }

  /* Lucario stands down wherever the video actually runs. Any time it does not
     play, he is still the hero's artwork. */
  .hero-band[data-hero-video]::after {
    display: none;
  }

  /* --- the same forest, on a phone -----------------------------------------
   *
   * Not the desktop treatment scaled down. Stretching a 2.39:1 clip over a tall
   * phone column with `cover` keeps roughly 18% of its width — Espeon is at 33%
   * across and Leafeon at 76%, so both fall outside it and what is left is a
   * strip of light between two trunks, upscaled past the source's own 1600px.
   *
   * So the clip gets a band at the top rather than the whole background. At
   * 390px wide a ~242px strip keeps about 60% of the width, x18%–x78%, which
   * holds both of them.
   *
   * Below the strip the scrim goes fully opaque and becomes the hero's
   * background. It is done in the scrim — already the layer above the video —
   * rather than as a `background` on `.hero-band`, because by default that
   * would paint *over* the video: `.hero-band` sets no stacking context, so the
   * z-index −2 video escapes to the root and ends up beneath any background its
   * own parent draws.
   *
   * The 900px-and-up block does take the other route and puts the backdrop on
   * the band, which is why it also sets `isolation: isolate` — that is the part
   * that makes a band background legal. Neither approach works without its own
   * half, so do not move one without the other.
   */
  @media (max-width: 899px) {
    .hero-band {
      /* Sized to end behind the logo, which is ~340px tall here. Everything
         with a contrast requirement — lede, stats — then sits on the solid part
         below, where white is simply white on #0b0e13. */
      --hero-vid-h: clamp(210px, 62vw, 330px);
    }
    .hero-video {
      height: var(--hero-vid-h);
      bottom: auto;
    }
    .hero-scrim {
      background: linear-gradient(
        to bottom,
        rgb(6 8 12 / 0.42) 0,
        rgb(6 8 12 / 0.5) calc(var(--hero-vid-h) * 0.55),
        rgb(11 14 19) var(--hero-vid-h),
        rgb(11 14 19) 100%
      );
    }
  }

  /* The copy inverts over the scrim. `--text-muted` is a grey tuned for a light
     panel and reads at roughly 2:1 on this. */
  .hero-band[data-hero-video] .lede {
    color: rgb(255 255 255 / 0.92);
  }
  .hero-band[data-hero-video] .stats dt {
    color: rgb(255 255 255 / 0.78);
  }
  .hero-band[data-hero-video] .stats dd {
    color: #fff;
  }

  /*
   * The foot of the band dissolves instead of stopping dead.
   *
   * Masked to transparent rather than covered by a gradient in the page colour,
   * for the same reason the community photograph is: whatever is below shows
   * through on its own, so this needs no knowledge of the next section's
   * background and holds in both themes.
   *
   * The scrim is masked at every width. The video is only masked from 900px up,
   * because below that it is a strip at the top of the band and its own bottom
   * edge is already hidden by the scrim reaching full opacity there — masking it
   * would fade the strip early, in the middle of the hero, for nothing.
   */
  .hero-band[data-hero-video] .hero-scrim {
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 calc(100% - var(--hero-out)),
      transparent 100%
    );
    mask-image: linear-gradient(to bottom, #000 calc(100% - var(--hero-out)), transparent 100%);
  }
  @media (min-width: 900px) {
    .hero-band[data-hero-video] .hero-video {
      -webkit-mask-image: linear-gradient(
        to bottom,
        #000 calc(100% - var(--hero-out)),
        transparent 100%
      );
      mask-image: linear-gradient(to bottom, #000 calc(100% - var(--hero-out)), transparent 100%);
    }

    /*
     * Stop stretching the clip to the band's height.
     *
     * The source is 2.39:1 and the band is nowhere near it — 1.46:1 at 1200px,
     * 1.2:1 at 1000 — so `cover` was binding on height and eating the sides.
     * The comment above still claimed a "~1.7:1 band" keeping "the middle 70%";
     * the band has grown since, and the real numbers were 61% at 1200 and 50%
     * at 1000. That last one matters: the two subjects sit at 33% and 76%
     * across, and a centred 50% window is 25%–75%, so the second one was being
     * cropped out of its own hero.
     *
     * Letting the box take the clip's own ratio instead, floored at 72% of the
     * band, gives 72% at 1000, 78% at 1200 and the whole frame from ~1585px up
     * — both subjects in view at every width this rule covers. `height: auto`
     * rather than a hardcoded `aspect-ratio`, so it tracks the file if the clip
     * is ever recut; `[data-hero-video]` is only set on `playing`, so the
     * intrinsic ratio is always known by the time this applies. `max-height`
     * catches beyond ~1912px, where the clip would otherwise outgrow the band.
     */
    .hero-band[data-hero-video] .hero-video {
      bottom: auto;
      height: auto;
      min-height: 72%;
      max-height: 100%;
    }

    /*
     * What fills the strip below the clip. The page behind the hero is white,
     * so without this the scrim over it read as a grey slab.
     *
     * `isolation` is not optional here, and it is the whole reason this looks
     * the way it does. The video and scrim sit at z-index −2 and −1, and the
     * note above is explicit that the trick only works because "nothing between
     * here and the root paints an opaque background" — with no stacking context
     * on the band, those two escape to the root, and the band's own background
     * paints straight over them. Adding the backdrop without this turns the
     * entire hero into a flat dark rectangle.
     *
     * The colour is the clip's own bottom edge, averaged over its last 2% of
     * rows: rgb(46 49 46). Matching it is what makes the masked bottom of the
     * video dissolve into the strip rather than step into it. It then fades out
     * over `--hero-out`, the same distance the video and scrim already use.
     */
    .hero-band[data-hero-video] {
      isolation: isolate;
      background: linear-gradient(
        to bottom,
        rgb(46 49 46) 0%,
        rgb(46 49 46) calc(100% - var(--hero-out)),
        transparent 100%
      );
    }
  }

  /*
   * Wide screens: he stands in the hero's own gap, between the end of the copy
   * and the left edge of the map, facing the map instead of off the page.
   *
   * The offset is derived from the grid rather than guessed, because the hero
   * is a centred 1100px box sitting inside a full-width band:
   *
   *   outer gutter          (100% − heroWidth) / 2
   * + the map column        (heroWidth − 40 − gap) / 2.15   [1fr of 1.15fr+1fr]
   * + the hero's padding    20px
   * + a gutter off the map  12px
   *
   * Only above 1080px. Below that the two columns are too tight to hold him
   * without crowding the lede, so he keeps the edge bleed defined above.
   */
  @media (min-width: 1080px) {
    .hero-band {
      --art-right: calc(
        (100% - min(1100px, 100%)) / 2 + (min(1100px, 100%) - 40px - clamp(20px, 4vw, 48px)) /
          2.15 + 26px
      );
      --art-bottom: 42px;
      /*
       * Sized to the corridor, not to preference. Measured at 1280: the lede's
       * longest line ends at x534 and the map starts at x692, so there are 158px
       * to work with and nothing wider than that can grow without going behind
       * body copy — he sits at full opacity, so "behind text" means unreadable
       * text, not a subtle wash.
       *
       * Two things buy the extra size over the old 130px cap. The gutter term
       * above went 32px → 26px, moving him from 12px off the map to 6px, and the
       * cap rose to 142px. That leaves 9–11px of clearance to the lede across
       * 1080–1440 — checked at each, not interpolated.
       *
       * Note he cannot escape the corridor by tucking his empty corner behind
       * the map. The frame's top-right *is* empty (the figure occupies only
       * x21–53% for its top eighth) but `--art-flip: -1` mirrors it, so that
       * empty corner lands top-left, away from the map.
       */
      --art-w: clamp(112px, 11vw, 142px);
      --art-flip: -1;
    }
  }

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    /* Columns only. The rows are spaced by `.stats`' own top margin, so that
       one number keeps setting the distance under the buttons the way it did
       when the counts were still inside `.hero-copy`. A row gap here would be
       added on top of it. */
    column-gap: clamp(20px, 4vw, 48px);
    row-gap: 0;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(28px, 6vw, 64px) 20px clamp(20px, 4vw, 40px);
  }

  /*
   * Two columns, two rows: copy and map share the first, the counts have the
   * second to themselves.
   *
   * That is what lands the map's bottom edge on the same line as "Join the
   * Discord". The first row is only as tall as the copy down to the end of the
   * buttons — the counts are not in it — so `align-self: end` puts the map on
   * that line exactly, with no measurement of the counts block and nothing to
   * re-tune if its type ever changes. Centred, the map used to finish 65px
   * short of the buttons at 1200px.
   */
  @media (min-width: 821px) {
    .hero-copy {
      grid-column: 1;
      grid-row: 1;
    }
    .hero > .stats {
      grid-column: 1;
      grid-row: 2;
    }
    .hero-map {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
    }
  }

  /* No font-size or line-height any more: the h1's only child is an image, and
     a stray line-height on the block would show up as unexplained space under
     it. */
  .hero h1 {
    margin: 6px 0 16px;
    line-height: 0;
  }
  /* Capped in px rather than left at 100%: the copy column is ~563px at the
     1100px cap, and a logo that wide dwarfs the lede and pushes both buttons
     below the fold. */
  .hero-logo {
    display: block;
    width: 100%;
    max-width: 380px;
    height: auto;
  }
  .lede {
    margin: 0 0 22px;
    font-size: clamp(1rem, 2.2vw, 1.12rem);
    color: var(--text-muted);
    max-width: 46ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .btn {
    padding: 12px 22px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .btn--primary {
    background: var(--accent);
    color: var(--accent-contrast);
  }
  .btn--discord {
    background: #5865f2;
    color: #fff;
  }
  .btn--outline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--border);
    background: var(--bg-panel);
    color: inherit;
  }
  .btn--outline:hover {
    border-color: var(--accent);
  }
  .btn--outline svg {
    flex: none;
    transition: transform 0.16s ease;
  }
  .btn--outline:hover svg {
    transform: translateX(3px);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    margin: 28px 0 0;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .stats dt {
    font-size: 0.74rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .stats dd {
    margin: 0;
    font-size: 1.7rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* Holds the live map island. The island sizes to this box, so the height
     lives here rather than inside the component. */
  .hero-map {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--bg-sunken);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    isolation: isolate;
  }

  /* Above Leaflet's panes (z-index 400) and its controls (1000). */
  .hero-map-open {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 1001;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 14px;
    border-radius: 999px;
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--accent-contrast);
    background: var(--accent);
    box-shadow: var(--shadow-md);
    transition:
      transform 0.16s ease,
      filter 0.16s ease;
  }
  .hero-map-open:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }
  .hero-map-open svg {
    transition: transform 0.16s ease;
  }
  .hero-map-open:hover svg {
    transform: translateX(2px);
  }

  .hero-map-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 4px;
    justify-items: center;
    text-align: center;
    padding: 20px;
  }
  .hero-map-fallback span {
    font-size: 0.85rem;
    color: var(--text-muted);
    max-width: 30ch;
  }


  /* --- the landmark rail ----------------------------------------------------
     Sits tight under the hero: it is the hero's evidence, not a separate
     topic, so it gets less air above it than a real section would. */
  .places {
    padding-top: 10px;
  }

  .place-rail {
    list-style: none;
    margin: 0;
    /* Headroom for the focus ring. `overflow-x: auto` forces `overflow-y` to
       compute to `auto` as well, so anything drawn outside the box is clipped
       — and the global :focus-visible ring reaches 5px out (3px wide, 2px
       offset). 8px clears it with room for the hover lift. */
    padding: 8px 0;
    display: flex;
    gap: 10px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }

  .place-rail li {
    /* Without `0 0 auto` a flex child shrinks to share the row, and eighteen
       tiles would compress to slivers instead of scrolling. */
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  /*
   * `:not(.place-more)` matters. Without it this rule also matched the trailing
   * "See all 104 on the map" tile and its `color: #fff` outranked
   * `.place-more > a { color: var(--accent) }` — two classes beat one — so that
   * tile rendered white on the page background and was invisible. It shipped
   * that way. Caught by auditing computed contrast on the rendered page rather
   * than reading the stylesheet.
   */
  .place-rail li:not(.place-more) > a {
    position: relative;
    display: block;
    width: 148px;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-sunken);
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }
  .place-rail li:not(.place-more) > a:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  /* Beats the global `img { height: auto }`, which would otherwise let a
     portrait photo set the tile's height and break the 3:4 ratio. */
  .place-rail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .place-label {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: grid;
    gap: 1px;
    padding: 26px 10px 9px;
    /* Same gradient strength as the community photo credits, so text over a
       photograph means one thing across the page. */
    background: linear-gradient(transparent, rgb(0 0 0 / 0.82));
  }
  .place-label strong {
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.25;
    /* Two lines, then ellipsis: "Walk Through History Marker #4" is real. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* The type is carried by the word, and the colour only reinforces it — a
     blue label on a near-black gradient would sit near the contrast floor,
     and colour alone is never the signal on this site. */
  .place-type {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgb(255 255 255 / 0.88);
  }
  .place-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: none;
  }
  .place-dot--gym {
    background: var(--poi-gym);
  }
  .place-dot--pokestop {
    background: var(--poi-pokestop);
  }

  .place-more > a {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 7px;
    width: 148px;
    aspect-ratio: 3 / 4;
    padding: 12px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    text-align: center;
    text-decoration: none;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .place-more > a:hover {
    border-color: var(--accent);
    border-style: solid;
  }

  @media (prefers-reduced-motion: reduce) {
    .place-rail li:not(.place-more) > a {
      transition: none;
    }
    .place-rail li:not(.place-more) > a:hover {
      transform: none;
    }
  }

  /* On a phone the rail runs edge to edge. The negative margin is exactly the
     section's own padding and the same value is added back as padding, so the
     scroll area widens without the page gaining any horizontal overflow. */
  @media (max-width: 720px) {
    .place-rail {
      margin-inline: -20px;
      padding-inline: 20px;
    }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .card {
    padding: 20px;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .card h2 {
    margin: 0 0 10px;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
  }
  .card--meetup {
    border-color: var(--poi-campsite);
  }
  .meetup-title {
    margin: 0 0 2px;
    font-size: 1.15rem;
    font-weight: 700;
  }
  .meetup-when {
    margin: 0;
    font-weight: 600;
    color: var(--accent);
  }
  .meetup-where,
  .meetup-note {
    margin: 4px 0 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .empty {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* --- tonight's raid bosses ------------------------------------------------
     A row of sprites rather than a sentence about sprites. Sized so four fit a
     phone without wrapping into a second row that would make the card taller
     than its two neighbours and break the grid's rhythm. */
  .boss-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(64px, 1fr));
    gap: 8px;
  }
  .boss-strip li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1px;
    padding: 8px 4px 7px;
    border-radius: var(--radius-sm);
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    text-align: center;
  }
  .boss-strip img {
    width: 46px;
    height: 46px;
    object-fit: contain;
  }
  .boss-name {
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.2;
    /* Names like "Hisuian Growlithe" would otherwise set the column width. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }
  .boss-tier {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .boss-shiny {
    position: absolute;
    top: 4px;
    right: 5px;
    font-size: 0.7rem;
    color: var(--poi-campsite);
  }
  /* `padding-block` rather than a bare line of text: at 22px tall these fell
     under the 24px minimum target size (WCAG 2.2 SC 2.5.8). They are standalone
     calls to action, not links inside a sentence, so the inline exemption does
     not cover them. The negative margin keeps the visual spacing unchanged. */
  .card-link,
  .card-links {
    display: inline-block;
    margin-top: 7px;
    padding-block: 5px;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .card-links {
    color: var(--text-muted);
  }

  .section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 36px 20px 0;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    margin-bottom: 12px;
    /* On a narrow screen a two-line heading leaves the link too little room and
       it breaks mid-phrase — "All 104 on the map" over one line and the arrow
       stranded on the next. Wrapping the row instead drops the whole link to
       its own line intact. */
    flex-wrap: wrap;
  }
  .section-head h2 {
    margin: 0;
    font-size: 1.15rem;
  }
  .section-head a {
    font-size: 0.86rem;
    font-weight: 600;
    /* Same reason as .card-link: a standalone action, so it needs a real target. */
    display: inline-block;
    padding-block: 5px;
    /* Safe only because the row above may wrap; without that this would
       overflow rather than break. */
    white-space: nowrap;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .posts a {
    display: grid;
    gap: 3px;
    padding: 14px 16px;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
  }
  .posts a:hover {
    border-color: var(--accent);
  }
  .posts span {
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .photos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px;
  }
  .photos li {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .photos img {
    display: block;
    width: 100%;
    height: 160px;
    object-fit: cover;
  }
  /* Photo credit is a licensing obligation, not decoration — it stays on the
     image rather than in a caption that could be cropped out. */
  .photos span {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 14px 10px 5px;
    font-size: 0.66rem;
    color: #fff;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.75));
  }

  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px;
  }
  /*
   * Dark tile with the brand as light, rather than a tile painted in the brand.
   *
   * The previous version filled each tile with the brand's own colour and put
   * white text on top, which six of its seven gradient stops could not carry:
   * Campfire's light end measured 2.55:1 for the title and Instagram's amber
   * 1.84:1, against a 4.5 floor. Darkening those colours enough to pass would
   * have taken the brand down with them — a 4.5:1 orange is brown.
   *
   * So the colour becomes a glow over a dark surface. The base is 18.04:1, and
   * even with the glow at full strength the worst composite measures 5.70:1
   * (Campfire's hint). The brand still reads instantly, because it sits behind
   * its own full-colour app icon and tints the whole tile.
   */
  .social {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 13px;
    padding: 15px 16px;
    border-radius: 14px;
    text-decoration: none;
    color: #fff;
    background: #16161a;
    border: 1px solid rgb(255 255 255 / 0.09);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.28);
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }
  /* The brand glow, anchored left so it peaks behind the mark and has faded out
     by the time it reaches the text. Held at 0.85 so the hover state has
     somewhere to go. */
  .social::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.85;
    background: radial-gradient(78% 130% at 6% 50%, var(--brand-glow), transparent 72%);
    pointer-events: none;
    transition: opacity 0.18s ease;
  }
  /* One lit pixel along the top. This is the whole difference between a surface
     catching light and a rectangle of colour. */
  .social::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    z-index: 1;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.32), transparent);
    pointer-events: none;
  }
  .social > * {
    position: relative;
    z-index: 2;
  }
  .social:hover {
    transform: translateY(-3px);
    border-color: var(--brand-edge);
    box-shadow:
      0 12px 26px -10px var(--brand-glow),
      0 3px 8px rgb(0 0 0 / 0.32);
  }
  .social:hover::before {
    opacity: 1;
  }
  .social:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .social-go {
    justify-self: end;
    font-size: 0.95rem;
    line-height: 1;
    opacity: 0.45;
    transition:
      transform 0.18s ease,
      opacity 0.18s ease;
  }
  .social:hover .social-go {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  /* The mark is each brand's real app icon, so it brings its own background — a
     translucent chip behind it would be a second tile behind a tile. The ring is
     lighter than it was: against a dark surface the icon no longer risks
     dissolving into a panel of its own colour, so the ring is there to seat it,
     not to rescue it. The drop shadow does the lifting instead. */
  .social-mark {
    display: grid;
    place-items: center;
    line-height: 0;
    border-radius: 12px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.16),
      0 4px 10px rgb(0 0 0 / 0.38);
  }
  .social-mark svg {
    display: block;
    border-radius: 11px;
  }

  .social-text {
    display: grid;
    gap: 1px;
    min-width: 0;
  }
  .social-text strong {
    font-size: 0.98rem;
    line-height: 1.2;
  }
  .social-text span {
    font-size: 0.78rem;
    line-height: 1.35;
    /* 0.88, which is the value the contrast pass was run at. Dropping it dims
       the text toward the background it is measured against. */
    opacity: 0.88;
    /* Allowed to wrap. Truncating instead turned "Raids, chat, meetups" into
       "Raids, chat, meet…" at two-up widths, which loses the only thing the
       line was there to say. Grid stretches the tiles to equal height anyway,
       so a second line costs nothing but a few pixels of row height. */
  }

  /* Each brand supplies a glow and an edge now, not a fill. These alphas are the
     ones the contrast pass cleared, so they are not free to nudge upward —
     raising one lightens the composite the text sits on.

     Facebook is back to its real #1877f2. The old #1668d8 existed only to claw
     white text up to AA while the colour was a fill; as a glow it no longer has
     that job, so the brand gets its actual blue back. */
  .social--discord {
    --brand-glow: rgb(88 101 242 / 0.55);
    --brand-edge: rgb(88 101 242 / 0.7);
  }
  .social--campfire {
    --brand-glow: rgb(240 135 61 / 0.5);
    --brand-edge: rgb(240 135 61 / 0.65);
  }
  .social--facebook {
    --brand-glow: rgb(24 119 242 / 0.5);
    --brand-edge: rgb(24 119 242 / 0.65);
  }
  .social--instagram {
    --brand-glow: rgb(214 41 118 / 0.55);
    --brand-edge: rgb(214 41 118 / 0.7);
  }
  /* Instagram is the one brand whose identity *is* the gradient, so its glow is
     three offset stops rather than one.
     Stacked gradients compound where they overlap, and these alphas are set from
     that worst case rather than from each layer alone: at 0.45/0.55/0.38 the
     fully-compounded point measured 3.72:1 for the hint. That point sits behind
     the icon rather than under the text, but a bound that fails is not a bound.
     0.36/0.44/0.24 puts even the compounded case at 5.04:1. */
  .social--instagram::before {
    background:
      radial-gradient(58% 105% at 3% 92%, rgb(252 176 69 / 0.24), transparent 68%),
      radial-gradient(78% 130% at 6% 48%, rgb(214 41 118 / 0.44), transparent 72%),
      radial-gradient(56% 100% at 24% 2%, rgb(131 58 180 / 0.36), transparent 70%);
  }

  @media (prefers-reduced-motion: reduce) {
    .social,
    .hero-map-open,
    .hero-map-open svg,
    .btn--outline svg {
      transition: none;
    }
    .social-go {
      transition: none;
    }
    .social:hover,
    .hero-map-open:hover,
    .social:hover .social-go {
      transform: none;
    }
    .hero-map-open:hover svg,
    .btn--outline:hover svg {
      transform: none;
    }
  }

  /* --- "Happening now" artwork ----------------------------------------------
   * Mew on the left, Incineroar on the right. The hero and the Campsite
   * explainer both come in from the right, so alternating here keeps the page
   * from reading as a column of art stacked down one margin.
   *
   * These were previously anchored to the band's bottom corners on the
   * assumption that the 1100px content cap left a margin for them to stand in.
   * It does not, below roughly 1400px: at 1000px the section fills the band edge
   * to edge, so Mew's box ran x −80→120 and Incineroar's 865→1045 — straight
   * through the cards. And every surface in this section is opaque (the cards
   * are #fff, the attribution carries its own panel), so at `z-index: -1`
   * neither one rendered at all. Vertically it was no better: the attribution
   * ran to the band's bottom edge, which is exactly where both were anchored.
   *
   * So they get their own strip rather than borrowing a margin that is not
   * there. `padding-bottom` opens genuinely empty band below the attribution and
   * both are anchored into it, which makes them visible at every width instead
   * of only on a wide desktop.
   */
  .onnow-band {
    /*
     * Narrow screens keep the strip: the attribution fills the width, so there
     * is nothing to stand beside and the art goes underneath it instead.
     *
     * The floor is 132px and not 120px, and the cap 280px and not 265px, because
     * Incineroar is the tall one: at 19vw/265px he cleared the attribution by
     * 2px at 1000 wide and 1px at 375, which is not clearance, it is luck.
     */
    padding-bottom: clamp(132px, 20vw, 280px);

    --art-src: url('/art/mew.webp');
    --art-ratio: 0.99;
    /* Barely any bleed now. The old −150px hid nearly half of him off-page; in
       clear space there is no reason to throw the image away. */
    --art-left: calc(-1 * clamp(8px, 2.5vw, 44px));
    --art-bottom: clamp(6px, 1.5vw, 18px);
    --art-w: clamp(100px, 16vw, 225px);

    /*
     * `--art-2nd` is the opt-in: it turns `content: none` into `content: ''` and
     * brings the ::before into existence.
     *
     * Incineroar is sized off a different number from Mew even though they share
     * the strip: at a trimmed ratio of 0.55 he is 1.82x as tall as he is wide, so
     * the width that fits is set by the strip's height, not by matching Mew's
     * width. At 1440 that is 132px wide and 240px tall against a 265px strip.
     */
    --art-2nd: '';
    --art2-src: url('/art/incineroar.webp');
    --art2-ratio: 0.55;
    --art2-right: calc(-1 * clamp(6px, 2vw, 38px));
    --art2-bottom: clamp(6px, 1.5vw, 18px);
    --art2-w: clamp(62px, 9.5vw, 132px);
  }

  /*
   * Wide enough for the art to stand either side of the credit, so the box
   * stops being full width and they flank it instead of queueing underneath.
   *
   * This block has to sit *after* the base rule above, not before it. Media
   * queries add no specificity — `.onnow-band` inside `@media` and `.onnow-band`
   * outside it are an exact tie, decided purely on source order. Placed earlier
   * in the file it lost every property the base rule also declares, while the
   * two it does not (`--art-right`, `--art2-left`) applied normally: the art
   * kept its old size and its 200px strip while claiming a new anchor.
   *
   * The empty space was never slack in the layout — `.g-attribution p` caps at
   * 74ch while the box itself ran the full 985px, so most of it was padding.
   * Capping the box near the measure the text already obeys closes the gap
   * without reflowing the copy.
   *
   * `--attr-w` is the single number both sides derive from. The box is centred,
   * so its left edge sits at (100% − attrW)/2, and the distance from the band's
   * right edge back to that point is (100% + attrW)/2 — exactly what
   * `--art-right` needs, and its mirror what `--art2-left` needs. Change the
   * width and both pieces follow.
   */
  @media (min-width: 900px) {
    .onnow-band {
      --attr-w: min(640px, 100%);
      --attr-gap: clamp(14px, 2vw, 30px);

      /* No strip any more — the art is beside the box, not below it. This is
         just breathing room under the band. */
      padding-bottom: clamp(24px, 3vw, 44px);

      /* Same value as the padding, which lands the art's feet exactly on the
         attribution's bottom edge rather than near it. */
      --art-bottom: clamp(24px, 3vw, 44px);
      --art-right: calc((100% + var(--attr-w)) / 2 + var(--attr-gap));
      --art-left: auto;
      /*
       * Two ceilings, and the smaller wins.
       *
       * The gutter one is why these are not `vw`: the space beside a fixed 640px
       * box is (100% − attrW)/2, which at 1000 wide is 172px. A 17vw Mew was
       * 170 plus a 20px gap and hung 18px off the left edge — and at the 900px
       * end of this query he would have been half again too wide.
       *
       * The px one is height in disguise. The art is bottom-aligned with the
       * box, so anything taller than the box rises past its top, and there are
       * only 36px of clear band up there before the "See 5 more" pill. At a 0.99
       * ratio 180px of width is 182px of height, which is 33px of rise. Mew is
       * the round one, so width and height are nearly the same number; keep that
       * in mind before raising it.
       */
      --art-w: min(180px, calc((100% - var(--attr-w)) / 2 - var(--attr-gap)));

      --art2-bottom: clamp(24px, 3vw, 44px);
      --art2-left: calc((100% + var(--attr-w)) / 2 + var(--attr-gap));
      --art2-right: auto;
      /* Same two ceilings, but Incineroar is 1.82x as tall as he is wide, so the
         height budget caps him at 100px where Mew gets 180. */
      --art2-w: min(100px, calc((100% - var(--attr-w)) / 2 - var(--attr-gap)));
    }

    /* `:global`, because the aside belongs to Attribution.astro and Astro would
       otherwise scope this selector to elements this page rendered itself.
       Kept under `.onnow-band` so /raids, /eggs and /research — which run the
       same component full width with no art beside it — are untouched. */
    .onnow-band :global(.g-attribution) {
      max-width: var(--attr-w);
      margin-inline: auto;
    }
  }

  .on-now {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 12px;
    align-items: start;
  }

  /*
   * Same EventCard as /events, trimmed for a teaser.
   *
   * The card is reused rather than reimplemented so "live" and "ongoing" look
   * identical wherever they appear. What it does not need here is the outbound
   * "Details" button and the blurb — this block exists to say what is on, and
   * the section's own button is the one route onward. :global is required to
   * reach inside a child component's markup from a scoped style block.
   */
  .on-now :global(.event-actions),
  .on-now :global(.event-blurb) {
    display: none;
  }
  .on-now :global(.event-title) {
    font-size: 1rem;
  }
  /* The card's own padding is left alone here: .event-image cancels it with a
     matching negative margin to bleed the artwork edge to edge, so changing it
     in one place and not the other leaves a sliver of panel down the sides. */
  .on-now-more {
    margin: 14px 0 0;
  }
  .on-now-empty {
    display: grid;
    justify-items: start;
    gap: 14px;
    padding: 20px;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .on-now-empty .empty {
    max-width: 62ch;
  }

  /* Same red as the live board, so "on now" means one thing across the site. */
  .on-now-dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--live);
    vertical-align: middle;
    animation: on-now-pulse 2s ease-in-out infinite;
  }
  @keyframes on-now-pulse {
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .on-now-dot {
      animation: none;
    }
    /* The campsite artwork's reduced-motion swap is NOT here — it has to come
       after the rule it overrides. See below, next to `.campsite-band`. */
  }

  /* --- campsite artwork -----------------------------------------------------
   * Magikarp, flopping. 16 frames over 1.6s as an animated WebP.
   *
   * Encoded **lossless**, which is not the usual choice for a 147KB asset — but
   * this is pixel art, and lossless actually came out smaller than lossy at the
   * same size (183KB vs 188KB at full width) as well as keeping the pixel edges
   * intact. The 480x480 source was trimmed to its union bounding box across all
   * sixteen frames — a per-frame crop would make the fish jitter — and scaled to
   * 384 with NEAREST, so the pixel grid survives the resize.
   *
   * 239KB of GIF became 147KB. Modest, and it is worth knowing that most of the
   * remaining weight is the frame count, not the resolution: 320px wide would
   * be 115KB if this ever needs to come down.
   */
  .campsite-band {
    --art-src: url('/art/magikarp-anim.webp');
    --art-ratio: 1.04;
    /*
     * Parked under the Instagram tile, which is the last column of the "Find
     * us" grid directly above this band — the band's top edge and that tile's
     * bottom edge are the same line.
     *
     * Derived from the grid rather than nudged into place, the same way Lucario
     * is positioned in the hero:
     *
     *   outer gutter        (100% − sectionWidth) / 2
     * + the section padding 20px
     * + half a column       (sectionWidth − 40 − 3×10 gaps) / 8
     * − half the artwork    var(--art-w) / 2
     *
     * The grid is `repeat(auto-fit, minmax(180px, 1fr))`, so four columns need
     * 750px of content. That holds everywhere this rule applies: the mobile
     * override below takes over at 820px, where there is still 781px.
     */
    --art-right: calc(
      (100% - min(1100px, 100%)) / 2 + 20px + (min(1100px, 100%) - 70px) / 8 - var(--art-w) / 2
    );
    --art-top: 0px;
    --art-bottom: auto;
    /*
     * Capped by the section's *height*, not by the 798px of clear width beside
     * the text. `overflow-x: clip` leaves `overflow-y` computing to `visible`,
     * so anything taller than the band is not cropped — it spills out of it.
     *
     * The padding below is what catches that, and it is load-bearing rather
     * than decorative: at 1440px the fish is 317px tall against 295px of
     * content, so without the extra 72px it would hang into the footer. Raising
     * `--art-w` past this without raising the padding to match will do exactly
     * that. (Anchored to the top now, the overflow goes down; it used to go up
     * into "Find us".)
     */
    --art-w: clamp(170px, 23vw, 330px);
    padding-bottom: clamp(0px, 5vw, 76px);
  }

  /*
   * Swap the source, because there is nothing else to swap.
   *
   * An animated WebP used as a `background-image` has no CSS switch — it is not
   * an animation the cascade can set to `none`, and there is no element to call
   * `pause()` on the way the hero video has. The only way to honour reduced
   * motion here is to serve a different file, so this one is a single frame of
   * the same fish at 12KB.
   *
   * This block must stay BELOW `.campsite-band` above. It lived up with the
   * other reduced-motion rules until 2026-08-10 and did nothing at all: a media
   * query adds no specificity, both selectors are `.campsite-band`, so the later
   * one wins on source order alone and the animated file was served to everyone.
   * Nothing after this point may set `--art-src` — the mobile override below
   * deliberately does not.
   */
  @media (prefers-reduced-motion: reduce) {
    .campsite-band {
      --art-src: url('/art/magikarp-still.webp');
    }
  }

  .campsite {
    padding-bottom: 56px;
  }
  .campsite h2 {
    font-size: 1.15rem;
    margin-bottom: 8px;
  }
  .campsite p {
    max-width: 68ch;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-map {
      aspect-ratio: 16 / 9;
      /* Stacked, this is the gap the grid's row gap used to provide. That was
