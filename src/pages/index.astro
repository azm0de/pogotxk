     * body copy cannot be made to hold 4.5:1 at every scroll position.
     */
    .hero-band {
      --art-top: -14px;
      --art-right: -54px;
      --art-bottom: auto;
      --art-w: 208px;
      --art-opacity: 0.16;
    }

    /* Same reason: below this width the campsite paragraphs stop being capped
