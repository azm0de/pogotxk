---
import { env } from 'cloudflare:workers';
import Base from '~/layouts/Base.astro';
import MapPreview from '~/components/map/MapPreview';
import SocialIcon from '~/components/SocialIcon.astro';
import EventCard from '~/components/events/EventCard.astro';
import {
  listPublicMeetups,
  markdownToText,
  meetupLocation,
  meetupToCalendarEvent,
} from '~/lib/db/meetups';
import { listPublishedPosts } from '~/lib/db/posts';
import { gameEventsFromPayload, groupEvents, type CalendarEvent } from '~/lib/ics';
import { getFeed } from '~/lib/scrapedduck';
import { DEFAULT_TZ, formatInZone } from '~/lib/time';

export const prerender = false;

const db = env.DB;

/**
 * Everything on this page is optional. A brand-new deployment has no POIs, no
 * meetups and no posts, and the page still has to look deliberate rather than
 * broken — so each section renders a real fallback instead of an empty shell.
 */
const [counts, meetups, posts, photos] = await Promise.all([
  db
    .prepare(
      `SELECT
         SUM(type = 'pokestop')  AS pokestops,
         SUM(type = 'gym')       AS gyms,
         SUM(type = 'powerspot') AS powerspots,
         SUM(is_campsite)        AS campsite
       FROM pois WHERE status = 'published'`,
    )
    .first<{ pokestops: number; gyms: number; powerspots: number; campsite: number }>()
    .catch(() => null),

  listPublicMeetups(db).catch(() => []),
  listPublishedPosts(db, { limit: 3 }).catch(() => ({ posts: [], total: 0 })),

  db
    .prepare(
      `SELECT r2_key, alt, credit FROM media
        WHERE kind = 'community_photo' ORDER BY created_at DESC LIMIT 4`,
    )
    .all<{ r2_key: string; alt: string | null; credit: string | null }>()
    .then((r) => r.results)
    .catch(() => []),
]);

const nowIso = new Date().toISOString();
const nextMeetup = meetups.find((m) => (m.endsAt ?? m.startsAt) >= nowIso) ?? null;

const latestPosts = Array.isArray(posts) ? posts : posts.posts;

const totalPois =
  (counts?.pokestops ?? 0) + (counts?.gyms ?? 0) + (counts?.powerspots ?? 0);

/**
 * What is happening *right now* — community meetups and Pokémon GO events in
 * one list, the same way /events builds it.
 *
 * Read from the data layer rather than fetched from our own /api route: a
 * Worker fetching its own origin is a loopback through the edge that works
 * under `astro dev` and returns nothing in production. That bug already shipped
 * once — see the vault's Bugs Worth Remembering.
 */
const globalEvents = await getFeed('events')
  .then(gameEventsFromPayload)
  .catch(() => null);

const happening = groupEvents([
  ...meetups.map((m) => meetupToCalendarEvent(m, new URL(Astro.url.origin))),
  ...(globalEvents?.events ?? []),
]);

// "Live" is a short window (a Raid Hour); "ongoing" is a season that runs for
// weeks. Both are on right now, so the home page shows them together, live
// first, and caps the list — this is a teaser for /events, not a second copy.
const onNow: CalendarEvent[] = [...happening.live, ...happening.ongoing].slice(0, 4);
const moreOnNow = happening.live.length + happening.ongoing.length - onNow.length;

const dayFmt = new Intl.DateTimeFormat('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  timeZone: DEFAULT_TZ,
});
const timeFmt = new Intl.DateTimeFormat('en-US', {
  hour: 'numeric',
  minute: '2-digit',
  timeZone: DEFAULT_TZ,
});

/** Compact "when" line for the home page cards. */
function homeWhen(event: CalendarEvent): string {
  const start = new Date(event.start);
  if (event.allDay) return `${dayFmt.format(start)} · all day`;
  if (!event.end) return `${dayFmt.format(start)} · ${timeFmt.format(start)}`;
  const end = new Date(event.end);
  const sameDay = dayFmt.format(start) === dayFmt.format(end);
  return sameDay
    ? `${dayFmt.format(start)} · ${timeFmt.format(start)} – ${timeFmt.format(end)}`
    : `${dayFmt.format(start)} – ${dayFmt.format(end)}`;
}

const socials = [
  {
    href: 'https://discord.com/invite/2sYR5YdRpH',
    label: 'Discord',
    hint: 'Raids, chat, meetups',
    cls: 'discord',
    icon: 'discord',
  },
  {
    href: 'https://campfire.onelink.me/eBr8?af_dp=campfire%3A%2F%2F&af_force_deeplink=true&deep_link_sub1=cj1jbHVicyZjPTI4Y2Y0NDJjLTg2M2UtNDcwZS1iYmQwLTQwNjdhNDcxMDJjYyZpPXRydWU%3D',
    label: 'Campfire',
    hint: 'Check in at meetups',
    cls: 'campfire',
    icon: 'campfire',
  },
  {
    href: 'https://www.facebook.com/groups/1792291964630166/',
    label: 'Facebook',
    hint: 'Community group',
    cls: 'facebook',
    icon: 'facebook',
  },
  {
    href: 'https://www.instagram.com/pogotxk',
    label: 'Instagram',
    hint: '@pogotxk',
    cls: 'instagram',
    icon: 'instagram',
  },
] as const;
---

<Base title="PoGo TXK">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Texarkana, Texas &amp; Arkansas</p>
      <h1>Pokémon GO Texarkana</h1>
      <p class="lede">
        A community Campsite at Spring Lake Park, run by trainers from all three teams. Find every
        PokéStop and Gym, catch the next meetup, and raid with people who actually show up.
      </p>

      <div class="hero-actions">
        <a class="btn btn--primary" href="/map">Open the map</a>
        <a
          class="btn btn--discord"
          href="https://discord.com/invite/2sYR5YdRpH"
          rel="noopener noreferrer"
          target="_blank">Join the Discord</a
        >
      </div>

      {
        totalPois > 0 && (
          <dl class="stats">
            <div><dt>PokéStops</dt><dd>{counts?.pokestops ?? 0}</dd></div>
            <div><dt>Gyms</dt><dd>{counts?.gyms ?? 0}</dd></div>
            <div><dt>Power Spots</dt><dd>{counts?.powerspots ?? 0}</dd></div>
            <div><dt>★ Campsite</dt><dd>{counts?.campsite ?? 0}</dd></div>
          </dl>
        )
      }
    </div>

    {/*
      The real map, not a picture of one. It is the thing people came for, so
      making them click through to find out whether their park is on it was the
      wrong trade.

      `client:visible` keeps Leaflet and the marker data off the critical path —
      nothing loads until the preview is actually scrolled to, which on a phone
      is often never. MapPreview exists to make that possible: MapView itself
      cannot be server-rendered, because Leaflet reads `window` on import.
    */}
    <div class="hero-map">
      <MapPreview client:visible compact />

      <a class="hero-map-open" href="/map">
        <span>Open the full map</span>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M13.2 5.4 11.8 6.8l4.2 4.2H4v2h12l-4.2 4.2 1.4 1.4 6.6-6.6z"></path>
        </svg>
      </a>

      <noscript>
        <div class="hero-map-fallback">
          <strong>Spring Lake Park</strong>
          <span>
            {
              totalPois > 0
                ? `${totalPois} locations mapped — the interactive map needs JavaScript.`
                : 'The interactive map needs JavaScript.'
            }
          </span>
        </div>
      </noscript>
    </div>
  </section>

  <div class="grid">
    <section class="card card--meetup">
      <h2>Next meetup</h2>
      {
        nextMeetup ? (
          <>
            <p class="meetup-title">{nextMeetup.title}</p>
            <p class="meetup-when">{formatInZone(nextMeetup.startsAt, nextMeetup.tz)}</p>
            <p class="meetup-where">{meetupLocation(nextMeetup) ?? 'Location to be confirmed'}</p>
            {nextMeetup.descriptionMd && (
              <p class="meetup-note">{markdownToText(nextMeetup.descriptionMd)}</p>
            )}
            <a class="card-link" href="/events">All events →</a>
          </>
        ) : (
          <>
            <p class="empty">
              Nothing on the calendar right now. Meetups get announced in Discord first — the
              regular slot is Wednesday evenings at the Campsite.
            </p>
            <a class="card-link" href="/events">See the event calendar →</a>
          </>
        )
      }
    </section>

    <section class="card">
      <h2>Right now</h2>
      <p class="empty">
        Raid flares from the community appear on the live board. Fire one when you are at a gym
        and need people.
      </p>
      <a class="card-link" href="/live">Open the live board →</a>
    </section>

    <section class="card">
      <h2>In game today</h2>
      <p class="empty">
        Current raid bosses, egg pools and field research, updated automatically from Leek Duck.
      </p>
      <p class="card-links">
        <a href="/raids">Raid bosses</a> · <a href="/eggs">Eggs</a> ·
        <a href="/research">Research</a>
      </p>
    </section>
  </div>

  {
    latestPosts.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Community news</h2>
          <a href="/blog">All posts →</a>
        </div>
        <ul class="posts">
          {latestPosts.map((post) => (
            <li>
              <a href={`/blog/${post.slug}`}>
                <strong>{post.title}</strong>
                {post.excerpt && <span>{post.excerpt}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    photos.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>The community</h2>
        </div>
        <ul class="photos">
          {photos.map((photo) => (
            <li>
              <img
                src={`/media/${photo.r2_key}`}
                alt={photo.alt ?? 'PoGo TXK community photo'}
                loading="lazy"
                width="400"
                height="300"
              />
              {photo.credit && <span>{photo.credit}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/*
    What is on right now, community and game side by side. Placed directly under
    the community photos because that is where the page stops being "who we are"
    and starts being "come do something".
  */}
  <section class="section" aria-labelledby="on-now-heading">
    <div class="section-head">
      <h2 id="on-now-heading">
        {onNow.length > 0 && <span class="on-now-dot" aria-hidden="true" />}
        Happening now
      </h2>
      <a href="/events">Upcoming events →</a>
    </div>

    {
      onNow.length > 0 ? (
        <>
          <div class="on-now">
            {onNow.map((event) => (
              <EventCard
                event={event}
                when={homeWhen(event)}
                state={happening.live.includes(event) ? 'live' : 'ongoing'}
              />
            ))}
          </div>
          <p class="on-now-more">
            <a class="btn btn--outline" href="/events">
              {moreOnNow > 0
                ? `See ${moreOnNow} more and everything upcoming`
                : 'See everything upcoming'}
            </a>
          </p>
        </>
      ) : (
        <div class="on-now-empty">
          <p class="empty">
            Nothing running at this minute. Raid Hours, Community Days and Spotlight Hours all
            show up here automatically when they start.
          </p>
          <a class="btn btn--outline" href="/events">
            See what is coming up
          </a>
        </div>
      )
    }
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Find us</h2>
    </div>
    <ul class="socials">
      {
        socials.map((social) => (
          <li>
            <a
              class={`social social--${social.cls}`}
              href={social.href}
              rel="noopener noreferrer"
              target="_blank"
            >
              <span class="social-mark" aria-hidden="true">
                <SocialIcon name={social.icon} size={24} />
              </span>
              <span class="social-text">
                <strong>{social.label}</strong>
                <span>{social.hint}</span>
              </span>
              <svg class="social-go" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M13.2 5.4 11.8 6.8l4.2 4.2H4v2h12l-4.2 4.2 1.4 1.4 6.6-6.6z"
                />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section campsite">
    <h2>What is a Community Campsite?</h2>
    <p>
      Community Campsites are dedicated in-game areas established by official Community
      Ambassadors, and they act as local hubs for in-person meetups. They come with perks —
      exclusive event check-ins, special Timed Research, and enhanced PokéStops and Gyms.
    </p>
    <p>
      Ours covers Spring Lake Park. The ★ markers on the map are the Campsite locations.
    </p>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(20px, 4vw, 48px);
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(28px, 6vw, 64px) 20px clamp(20px, 4vw, 40px);
  }

  .eyebrow {
    margin: 0;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .hero h1 {
    margin: 6px 0 12px;
    font-size: clamp(2rem, 6vw, 3.2rem);
    line-height: 1.05;
  }
  .lede {
    margin: 0 0 22px;
    font-size: clamp(1rem, 2.2vw, 1.12rem);
    color: var(--text-muted);
    max-width: 46ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .btn {
    padding: 12px 22px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .btn--primary {
    background: var(--accent);
    color: var(--accent-contrast);
  }
  .btn--discord {
    background: #5865f2;
    color: #fff;
  }
  .btn--outline {
    display: inline-block;
    border: 1px solid var(--border);
    background: var(--bg-panel);
    color: inherit;
  }
  .btn--outline:hover {
    border-color: var(--accent);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    margin: 28px 0 0;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .stats dt {
    font-size: 0.74rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .stats dd {
    margin: 0;
    font-size: 1.7rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* Holds the live map island. The island sizes to this box, so the height
     lives here rather than inside the component. */
  .hero-map {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--bg-sunken);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    isolation: isolate;
  }

  /* Above Leaflet's panes (z-index 400) and its controls (1000). */
  .hero-map-open {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 1001;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 14px;
    border-radius: 999px;
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--accent-contrast);
    background: var(--accent);
    box-shadow: var(--shadow-md);
    transition:
      transform 0.16s ease,
      filter 0.16s ease;
  }
  .hero-map-open:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }
  .hero-map-open svg {
    transition: transform 0.16s ease;
  }
  .hero-map-open:hover svg {
    transform: translateX(2px);
  }

  .hero-map-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 4px;
    justify-items: center;
    text-align: center;
    padding: 20px;
  }
  .hero-map-fallback span {
    font-size: 0.85rem;
    color: var(--text-muted);
    max-width: 30ch;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .card {
    padding: 20px;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .card h2 {
    margin: 0 0 10px;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
  }
  .card--meetup {
    border-color: var(--poi-campsite);
  }
  .meetup-title {
    margin: 0 0 2px;
    font-size: 1.15rem;
    font-weight: 700;
  }
  .meetup-when {
    margin: 0;
    font-weight: 600;
    color: var(--accent);
  }
  .meetup-where,
  .meetup-note {
    margin: 4px 0 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .empty {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .card-link,
  .card-links {
    display: inline-block;
    margin-top: 12px;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .card-links {
    color: var(--text-muted);
  }

  .section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 36px 20px 0;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }
  .section-head h2 {
    margin: 0;
    font-size: 1.15rem;
  }
  .section-head a {
    font-size: 0.86rem;
    font-weight: 600;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .posts a {
    display: grid;
    gap: 3px;
    padding: 14px 16px;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
  }
  .posts a:hover {
    border-color: var(--accent);
  }
  .posts span {
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .photos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px;
  }
  .photos li {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .photos img {
    display: block;
    width: 100%;
    height: 160px;
    object-fit: cover;
  }
  /* Photo credit is a licensing obligation, not decoration — it stays on the
     image rather than in a caption that could be cropped out. */
  .photos span {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 14px 10px 5px;
    font-size: 0.66rem;
    color: #fff;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.75));
  }

  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px;
  }
  .social {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 13px;
    padding: 15px 16px;
    border-radius: var(--radius);
    text-decoration: none;
    color: #fff;
    background: var(--navy-700);
    overflow: hidden;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }
  /* A soft top-left sheen so each tile reads as a surface rather than a
     flat colour swatch. Sits under the content via the stacking context. */
  .social::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 12% 0%, rgb(255 255 255 / 0.28), transparent 62%);
    pointer-events: none;
  }
  .social > * {
    position: relative;
  }
  .social:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .social-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.16);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
  }

  .social-text {
    display: grid;
    gap: 1px;
    min-width: 0;
  }
  .social-text strong {
    font-size: 0.98rem;
    line-height: 1.2;
  }
  .social-text span {
    font-size: 0.78rem;
    line-height: 1.35;
    opacity: 0.85;
    /* Allowed to wrap. Truncating instead turned "Raids, chat, meetups" into
       "Raids, chat, meet…" at two-up widths, which loses the only thing the
       line was there to say. Grid stretches the tiles to equal height anyway,
       so a second line costs nothing but a few pixels of row height. */
  }

  .social-go {
    opacity: 0.55;
    transition:
      transform 0.18s ease,
      opacity 0.18s ease;
  }
  .social:hover .social-go {
    opacity: 1;
    transform: translateX(3px);
  }

  .social--discord {
    background: #5865f2;
  }
  .social--campfire {
    background: linear-gradient(135deg, #f0873d, #d1502a);
  }
  .social--facebook {
    background: #1877f2;
  }
  .social--instagram {
    background: linear-gradient(135deg, #833ab4, #fd1d1d 55%, #fcb045);
  }

  @media (prefers-reduced-motion: reduce) {
    .social,
    .social-go,
    .hero-map-open,
    .hero-map-open svg {
      transition: none;
    }
    .social:hover,
    .hero-map-open:hover {
      transform: none;
    }
    .social:hover .social-go,
    .hero-map-open:hover svg {
      transform: none;
    }
  }

  .on-now {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 12px;
    align-items: start;
  }

  /*
   * Same EventCard as /events, trimmed for a teaser.
   *
   * The card is reused rather than reimplemented so "live" and "ongoing" look
   * identical wherever they appear. What it does not need here is the outbound
   * "Details" button and the blurb — this block exists to say what is on, and
   * the section's own button is the one route onward. :global is required to
   * reach inside a child component's markup from a scoped style block.
   */
  .on-now :global(.event-actions),
  .on-now :global(.event-blurb) {
    display: none;
  }
  .on-now :global(.event-card) {
    padding: 14px 16px;
  }
  .on-now :global(.event-title) {
    font-size: 1rem;
  }
