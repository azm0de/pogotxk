---
import { env } from 'cloudflare:workers';
import Base from '~/layouts/Base.astro';
import MapPreview from '~/components/map/MapPreview';
import SocialIcon from '~/components/SocialIcon.astro';
import { DISCORD_INVITE, SOCIALS } from '~/lib/socials';
import EventCard from '~/components/events/EventCard.astro';
import {
  listPublicMeetups,
  markdownToText,
  meetupLocation,
  meetupToCalendarEvent,
} from '~/lib/db/meetups';
import { listPublishedPosts } from '~/lib/db/posts';
import { gameEventsFromPayload, groupEvents, type CalendarEvent } from '~/lib/events';
import {
  eggDistanceRank,
  getFeed,
  groupSorted,
  raidTierRank,
  researchCategoryLabel,
  researchCategoryRank,
  type ResearchReward,
} from '~/lib/scrapedduck';
import { getDiscordEvents, nextDiscordMeetup } from '~/lib/discord-events';
import { rsvpLabel, splitDescription } from '~/lib/discord-events-map';
import Attribution from '~/components/game/Attribution.astro';
import FeedStatus from '~/components/game/FeedStatus.astro';
import ShinyMark from '~/components/game/ShinyMark.astro';
import { proxiedImageUrl } from '~/lib/game-image';
import { isoNow } from '~/lib/db/flares';
import { DEFAULT_TZ, formatInZone } from '~/lib/time';

export const prerender = false;

const db = env.DB;
const now = isoNow();

/**
 * Everything on this page is optional. A brand-new deployment has no POIs, no
 * meetups and no posts, and the page still has to look deliberate rather than
 * broken — so each section renders a real fallback instead of an empty shell.
 */
const [counts, meetups, posts, photos, flareCount] = await Promise.all([
  db
    .prepare(
      `SELECT
         SUM(type = 'pokestop')  AS pokestops,
         SUM(type = 'gym')       AS gyms,
         SUM(type = 'powerspot') AS powerspots,
         SUM(is_campsite)        AS campsite
       FROM pois WHERE status = 'published'`,
    )
    .first<{ pokestops: number; gyms: number; powerspots: number; campsite: number }>()
    .catch(() => null),

  listPublicMeetups(db).catch(() => []),
  listPublishedPosts(db, { limit: 3 }).catch(() => ({ posts: [], total: 0 })),

  db
    .prepare(
      `SELECT r2_key, alt, credit FROM media
        WHERE kind = 'community_photo' ORDER BY created_at DESC LIMIT 4`,
    )
    .all<{ r2_key: string; alt: string | null; credit: string | null }>()
    .then((r) => r.results)
    .catch(() => []),

  /*
   * How many flares are burning, counted here rather than fetched.
   *
   * The board's second post says whether anything is on right now, and it has
   * to be true before any JavaScript runs — /live owns the socket, this is a
   * number. Deliberately a COUNT rather than `listActiveFlares`: that query
   * joins the RSVP and author tables to build cards nobody is drawing here.
   * The predicate is the live board's own, so the two cannot disagree.
   */
  db
    .prepare(`SELECT COUNT(*) AS n FROM flares WHERE closed_at IS NULL AND expires_at > ?1`)
    .bind(now)
    .first<{ n: number }>()
    .catch(() => null),
]);

const flaresLive = flareCount?.n ?? 0;

const nowIso = new Date().toISOString();
const nextMeetup = meetups.find((m) => (m.endsAt ?? m.startsAt) >= nowIso) ?? null;

/*
 * "Next meetup" used to sit empty whenever a meetup was announced in Discord and
 * nobody re-typed it into the admin screens — which is most of the time, because
 * announcing it in Discord is the actual workflow. So the guild's scheduled
 * events are a second source for this post.
 *
 * Lazy refresh on read with a KV cache and a stale fallback, same as `getFeed`;
 * wrangler.jsonc documents why this Worker has no cron to do it on a timer.
 * `waitUntil` keeps the cache write off the response path.
 *
 * Never throws — a Discord outage degrades to whatever was last seen, and then
 * to the hand-entered meetup, and then to the existing empty state.
 */
const cfContext = Astro.locals.cfContext as ExecutionContext | undefined;
const discordEvents = await getDiscordEvents({
  waitUntil: cfContext ? (promise) => cfContext.waitUntil(promise) : undefined,
}).catch(() => null);
const nextDiscord = discordEvents ? nextDiscordMeetup(discordEvents.events, nowIso) : null;

/*
 * Whichever comes first, not "prefer the database".
 *
 * An admin-entered meetup three weeks out must not hide a Discord event
 * tomorrow — the post says "next", and being wrong about that is the one thing
 * it cannot do. When both exist for the same outing the hand-entered row wins
 * the tie, since it is the one carrying a POI, an RSVP list and a Campfire link.
 */
const nextUp: {
  title: string;
  startsAt: string;
  tz: string;
  where: string | null;
  note: string | null;
  rsvpUrl: string | null;
  rsvpLabel: string;
  fromDiscord: boolean;
} | null = (() => {
  const fromDb = nextMeetup && {
    title: nextMeetup.title,
    startsAt: nextMeetup.startsAt,
    tz: nextMeetup.tz,
    where: meetupLocation(nextMeetup),
    note: nextMeetup.descriptionMd ? markdownToText(nextMeetup.descriptionMd) : null,
    // The hand-entered row keeps RSVP in its own column, so there is no
    // guessing to do here — only the Discord path has to dig it out of prose.
    rsvpUrl: nextMeetup.campfireUrl,
    rsvpLabel: rsvpLabel(nextMeetup.campfireUrl),
    fromDiscord: false,
  };
  const discordBody = nextDiscord ? splitDescription(nextDiscord.descriptionMd) : null;
  const fromDiscord = nextDiscord && {
    title: nextDiscord.title,
    startsAt: nextDiscord.startsAt,
    // Discord hands back a UTC instant with no zone; the community reads local.
    tz: DEFAULT_TZ,
    where: nextDiscord.locationText,
    // splitDescription has already stripped the Markdown that mattered here and
    // lifted the link out; markdownToText still runs so any remaining emphasis
    // or heading syntax renders as words rather than punctuation.
    note: discordBody?.text ? markdownToText(discordBody.text) : null,
    rsvpUrl: discordBody?.url ?? null,
    rsvpLabel: rsvpLabel(discordBody?.url ?? null),
    fromDiscord: true,
  };
  if (!fromDb) return fromDiscord;
  if (!fromDiscord) return fromDb;
  return fromDiscord.startsAt < fromDb.startsAt ? fromDiscord : fromDb;
})();

/*
 * The meetup's cover art does not come to the board.
 *
 * The post is a time, a place and one button; a 16:9 cover above it put the
 * artwork back on top of the thing the post exists to say. `/events` still
 * renders it, which is where someone has gone to browse rather than to glance.
 */
const nextUpWhen = nextUp ? formatInZone(nextUp.startsAt, nextUp.tz) : null;

const latestPosts = Array.isArray(posts) ? posts : posts.posts;
// Short form for a news row — /blog's own `dateFormat` spells the month out
// because it has a whole line to itself; this one shares a row with a title.
const newsDateFormat = new Intl.DateTimeFormat('en-US', {
  timeZone: DEFAULT_TZ,
  month: 'short',
  day: 'numeric',
});

const totalPois = (counts?.pokestops ?? 0) + (counts?.gyms ?? 0) + (counts?.powerspots ?? 0);

/**
 * What is happening *right now* — community meetups and Pokémon GO events in
 * one list, the same way /events builds it.
 *
 * Read from the data layer rather than fetched from our own /api route: a
 * Worker fetching its own origin is a loopback through the edge that works
 * under `astro dev` and returns nothing in production. That bug already shipped
 * once — see the vault's Bugs Worth Remembering.
 */
const globalEvents = await getFeed('events')
  .then(gameEventsFromPayload)
  .catch(() => null);

/**
 * The bosses actually worth walking to tonight — legendary and mega tiers only.
 *
 * `raidTierRank` is the same ordering /raids uses, so "headline" means the same
 * thing on both pages rather than being a second opinion. Capped at four: this
 * is a glance, and /raids is one tap away for the rest.
 */
const raidFeed = await getFeed('raids').catch(() => null);
const headlineBosses = (raidFeed?.data ?? [])
  .filter((boss) => {
    const t = boss.tier.toLowerCase();
    return t.includes('5-star') || t.includes('mega') || t.includes('primal');
  })
  .sort((a, b) => raidTierRank(b.tier) - raidTierRank(a.tier))
  .slice(0, 4);

/**
 * "In game today" used to be raids alone, and on a day with no headline boss it
 * was three sprites of empty space. Eggs and research are the other two feeds
 * this panel already links out to without ever rendering.
 *
 * Both read through `getFeed` with the same `waitUntil` wiring as the meetup
 * lookup above, so a ScrapedDuck outage degrades exactly like the raid strip
 * already does: less content, never an error.
 */
const eggFeed = await getFeed('eggs', {
  waitUntil: cfContext ? (promise) => cfContext.waitUntil(promise) : undefined,
}).catch(() => null);
const researchFeed = await getFeed('research', {
  waitUntil: cfContext ? (promise) => cfContext.waitUntil(promise) : undefined,
}).catch(() => null);

/**
 * How old this panel is, said out loud.
 *
 * The three feeds are cached independently and can be different ages, so the
 * line reports the *oldest* of them and calls the panel stale if any one of
 * them is. Claiming the freshest number would be the flattering answer rather
 * than the true one, and truth over polish is a product principle here.
 */
interface FeedFreshness {
  fetchedAt: string | null;
  stale: boolean;
  error: string | null;
}
const gameFeeds: FeedFreshness[] = [raidFeed, eggFeed, researchFeed].filter(
  (feed): feed is FeedFreshness => feed !== null,
);
const gameFetchedAt =
  gameFeeds
    .map((feed) => feed.fetchedAt)
    .filter((at): at is string => at !== null)
    .sort()[0] ?? null;
const gameStale = gameFeeds.length === 0 || gameFeeds.some((feed) => feed.stale);
const gameError = gameFeeds.find((feed) => feed.error)?.error ?? null;

/**
 * One species per distance bucket, capped at four so this row can never run
 * taller than the boss strip above it. `groupSorted` already orders buckets
 * shortest-walk-first, so the cap keeps the most commonly-spun distances
 * (2 km outward) rather than an arbitrary slice.
 *
 * Picks the first shiny-eligible species in the bucket, falling back to the
 * first species otherwise. Rarity was the other candidate signal, but
 * EggCard.astro already flags that Leek Duck's `rarity` field doesn't say
 * which end is rare — showing it here would be inventing a claim this
 * codebase has deliberately avoided elsewhere.
 */
const eggHighlights = groupSorted(eggFeed?.data ?? [], (egg) => egg.eggType, eggDistanceRank)
  .slice(0, 4)
  .map((group) => ({
    distance: group.key,
    egg: group.items.find((egg) => egg.canBeShiny) ?? group.items[0],
  }));

/**
 * One task per category, capped at four, favouring a task whose reward can be
 * shiny — "worth keeping tonight" is a sharper glance than "here is a task".
 * Shiny research rewards are seasonal and often absent, so this falls back to
 * any task that at least has a reward to show an icon for; a category where
 * every task rewards Stardust with no encounter is dropped rather than rendered
 * as a tile with no image.
 */
const researchHighlights = groupSorted(
  researchFeed?.data ?? [],
  (task) => task.type ?? 'other',
  researchCategoryRank,
)
  .map((group) => {
    const withReward =
      group.items.find(
        (task) => (task.rewards ?? []).length > 0 && task.rewards.some((r) => r.canBeShiny),
      ) ?? group.items.find((task) => (task.rewards ?? []).length > 0);
    if (!withReward) return null;
    return {
      category: group.key,
      reward: (withReward.rewards.find((r) => r.canBeShiny) ??
        withReward.rewards[0]) as ResearchReward,
    };
  })
  .filter((entry): entry is { category: string; reward: ResearchReward } => entry !== null)
  .slice(0, 4);

const happening = groupEvents([
  ...meetups.map((m) => meetupToCalendarEvent(m, new URL(Astro.url.origin))),
  ...(globalEvents?.events ?? []),
]);

// "Live" is a short window (a Raid Hour); "ongoing" is a season that runs for
// weeks. Both are on right now, so the home page shows them together, live
// first, and caps the list at four — this is a teaser for /events, not a second
// copy of it.
const onNow: CalendarEvent[] = [...happening.live, ...happening.ongoing].slice(0, 4);
const moreOnNow = happening.live.length + happening.ongoing.length - onNow.length;

const dayFmt = new Intl.DateTimeFormat('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  timeZone: DEFAULT_TZ,
});
const timeFmt = new Intl.DateTimeFormat('en-US', {
  hour: 'numeric',
  minute: '2-digit',
  timeZone: DEFAULT_TZ,
});

/** Compact "when" line for the home page rows. */
function homeWhen(event: CalendarEvent): string {
  const start = new Date(event.start);
  if (event.allDay) return `${dayFmt.format(start)} · all day`;
  if (!event.end) return `${dayFmt.format(start)} · ${timeFmt.format(start)}`;
  const end = new Date(event.end);
  const sameDay = dayFmt.format(start) === dayFmt.format(end);
  return sameDay
    ? `${dayFmt.format(start)} · ${timeFmt.format(start)} – ${timeFmt.format(end)}`
    : `${dayFmt.format(start)} – ${dayFmt.format(end)}`;
}
---

<Base title="PoGo TXK">
  <div class="home">
    {/*
      THE BANNER, and the board it sits on.

      The photograph is the first thing on the page because a stranger's first
      impression of a community site should be the community. It is the top
      plate of one object: the group shot, then the park itself, then a panel of
      posts bolted over the map's lower edge.

      The credit rides ON the image (`.figure` + `.credit`), which is why the
      map does not overlap the photograph's bottom edge — that strip is a
      licence obligation, not a margin. The two share one radius and one shadow
      instead, which is what makes them read as a single board.
    */}
    <section class="board container" aria-labelledby="board-title">
      <div class="board-plate">
        <figure class="figure banner">
          {/*
            Art-directed, not scaled: a sixty-person group shot 3.4 times wider
            than it is tall renders every face about three pixels across on a
            phone, so narrow screens get the tighter crop centred on the two
            Ambassador banners.
          */}
          <picture>
            <source
              media="(min-width: 900px)"
              srcset="/hero/community-wide-1200.webp 1200w, /hero/community-wide-1600.webp 1600w, /hero/community-wide-2400.webp 2400w"
              sizes="(min-width: 1140px) 1060px, calc(100vw - 40px)"
            />
            <img
              src="/hero/community-tight-900.webp"
              srcset="/hero/community-tight-600.webp 600w, /hero/community-tight-900.webp 900w, /hero/community-tight-1200.webp 1200w"
              sizes="calc(100vw - 40px)"
              width="1200"
              height="560"
              alt="PoGo TXK members gathered at Spring Lake Park for GO Fest 2026, holding two Pokémon GO Community Ambassador banners under a black and a purple canopy."
              decoding="async"
            />
          </picture>
          <figcaption class="credit">
            GO Fest 2026 at Spring Lake Park.{' '}
            <a class="target" href="/blog#photos">All photos</a>
          </figcaption>
        </figure>

        {/*
          The real map, not a picture of one. It is the thing people came for,
          so making them click through to find out whether their park is on it
          was the wrong trade.

          `client:visible` keeps Leaflet and the marker data off the critical
          path. MapPreview exists to make that possible: MapView itself cannot
          be server-rendered, because Leaflet reads `window` on import.
        */}
        <div class="board-map">
          <MapPreview client:visible compact />

          <noscript>
            <div class="board-fallback">
              <strong>Spring Lake Park</strong>
              <span>
                {
                  totalPois > 0
                    ? `${totalPois} locations mapped. The interactive map needs JavaScript.`
                    : 'The interactive map needs JavaScript.'
                }
              </span>
              <a class="btn btn--primary btn--arrow" href="/map">Open the map</a>
            </div>
          </noscript>
        </div>
      </div>

      {/*
        The panel: three posts and one arrow. The numbers are a legend, so the
        board can be read in any order — what is on, who is out there, and how
        much of the park has been surveyed.
      */}
      <div class="panel board-panel">
        <div class="panel-head">
          <h1 id="board-title">Spring Lake Park</h1>
        </div>
        <p class="board-lede">
          The Pokémon GO Community Campsite in Texarkana, run by the official Ambassadors.
        </p>

        <ol class="posts" role="list">
          <li class="post">
            <span class="disc" aria-hidden="true">1</span>
            <div class="post-body">
              {
                nextUp ? (
                  <>
                    <p class="post-lead tnum">
                      <time datetime={nextUp.startsAt}>{nextUpWhen}</time>
                    </p>
                    <p class="post-line">{nextUp.title}</p>
                    <p class="post-line post-muted">{nextUp.where ?? 'Place to be confirmed'}</p>
                    {nextUp.rsvpUrl && (
                      <p class="post-action">
                        <a
                          class="btn btn--sm btn--primary btn--arrow"
                          href={nextUp.rsvpUrl}
                          rel="noopener noreferrer"
                          target="_blank"
                        >
                          {nextUp.rsvpLabel}
                          <span class="sr-only"> (opens in a new tab)</span>
                        </a>
                      </p>
                    )}
                  </>
                ) : (
                  <>
                    <p class="post-lead">Wednesday evenings at the Campsite</p>
                    <p class="post-line post-muted">
                      Nothing on the calendar yet. Meetups get announced in Discord first.
                    </p>
                    <p class="post-action">
                      <a class="target" href="/events">See the event calendar</a>
                    </p>
                  </>
                )
              }
            </div>
          </li>

          <li class="post">
            <span class:list={['disc', flaresLive > 0 && 'disc--live']} aria-hidden="true">2</span>
            <div class="post-body">
              {
                flaresLive > 0 ? (
                  <>
                    <p class="post-lead tnum">
                      {flaresLive} {flaresLive === 1 ? 'flare' : 'flares'}
                    </p>
                    <p class="post-line">
                      <span class="here">Live now</span>
                    </p>
                    <p class="post-action">
                      <a class="target" href="/live">Open the live board</a>
                    </p>
                  </>
                ) : (
                  <>
                    <p class="post-lead post-lead--quiet">Nothing burning right now</p>
                    <p class="post-action">
                      <a class="target" href="/live">Open the live board</a>
                    </p>
                  </>
                )
              }
            </div>
          </li>

          <li class="post">
            <span class="disc" aria-hidden="true">3</span>
            <div class="post-body">
              {
                totalPois > 0 ? (
                  <>
                    <p class="post-lead tnum">{totalPois} places surveyed</p>
                    <p class="post-line post-muted tnum">
                      {counts?.pokestops ?? 0} PokéStops, {counts?.gyms ?? 0} Gyms,{' '}
                      {counts?.powerspots ?? 0} Power Spots, {counts?.campsite ?? 0} starred for the
                      Campsite.
                    </p>
                  </>
                ) : (
                  <p class="post-lead post-lead--quiet">The survey is not published yet</p>
                )
              }
            </div>
          </li>
        </ol>

        <p class="board-actions actions">
          <a class="btn btn--primary btn--arrow" href="/map">Open the map</a>
          <a
            class="btn btn--outline"
            href={DISCORD_INVITE}
            rel="noopener noreferrer"
            target="_blank"
          >
            Join the Discord
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
      </div>
    </section>

    {/*
      IN GAME TODAY, moved above "Happening now" on the owner's call. The next
      meetup used to lead this group and now lives in the board panel, so what
      is left is the one panel that says what the game itself is doing today.
    */}
    <section class="band container" aria-labelledby="in-game-heading">
      <div class="panel">
        <div class="panel-head">
          <h2 id="in-game-heading">In game today</h2>
          <span class="count">Raids, eggs and research</span>
        </div>

        {
          headlineBosses.length > 0 && (
            <>
              <h3 class="panel-subhead">Raid bosses</h3>
              <ul class="minis" role="list">
                {headlineBosses.map((boss) => (
                  <li class="mini">
                    {/* Through our proxy, not hotlinked — it is Leek Duck's
                        bandwidth, and a cached copy survives them adding
                        hotlink protection. */}
                    <img
                      src={proxiedImageUrl(boss.image) ?? boss.image}
                      alt=""
                      width="56"
                      height="56"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="mini-name">{boss.name}</span>
                    <span class="mini-tier">{boss.tier.replace(/ Raids?$/i, '')}</span>
                    {boss.canBeShiny && (
                      <ShinyMark />
                    )}
                  </li>
                ))}
              </ul>
            </>
          )
        }

        {
          eggHighlights.length > 0 && (
            <>
              <h3 class="panel-subhead">Egg pools</h3>
              <ul class="minis" role="list">
                {eggHighlights.map(({ distance, egg }) => (
                  <li class="mini">
                    <img
                      src={proxiedImageUrl(egg.image) ?? egg.image}
                      alt=""
                      width="56"
                      height="56"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="mini-name">{egg.name}</span>
                    <span class="mini-tier">{distance}</span>
                    {egg.canBeShiny && (
                      <ShinyMark />
                    )}
                  </li>
                ))}
              </ul>
            </>
          )
        }

        {
          researchHighlights.length > 0 && (
            <>
              <h3 class="panel-subhead">Field research</h3>
              <ul class="minis" role="list">
                {researchHighlights.map(({ category, reward }) => (
                  <li class="mini">
                    <img
                      src={proxiedImageUrl(reward.image) ?? reward.image}
                      alt=""
                      width="56"
                      height="56"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="mini-name">{reward.name}</span>
                    <span class="mini-tier">{researchCategoryLabel(category)}</span>
                    {reward.canBeShiny && (
                      <ShinyMark />
                    )}
                  </li>
                ))}
              </ul>
            </>
          )
        }

        {
          /* Only when all three feeds came back with nothing worth a tile — a
             bare `headlineBosses` alone is a normal day (no 5-star or Mega up
             right now), not an outage, and eggs and research still carry the
             panel. */
          headlineBosses.length === 0 &&
            eggHighlights.length === 0 &&
            researchHighlights.length === 0 && (
              <p class="panel-note">
                Current raid bosses, egg pools and field research, updated automatically.
              </p>
            )
        }

        {/* The panel says how old it is now, rather than discarding the two
            fields the feed already carries. */}
        <div class="panel-status">
          <FeedStatus
            fetchedAt={gameFetchedAt}
            stale={gameStale}
            error={gameError}
            label="raid, egg and research data"
          />
        </div>

        <p class="panel-links">
          <a class="target" href="/raids">All raid bosses</a> ·{' '}
          <a class="target" href="/eggs">Eggs</a> · <a class="target" href="/research">Research</a>
        </p>
      </div>
    </section>

    {/*
      HAPPENING NOW. Four rows at most: EventCard prints each one as a 64px
      thumbnail with the time as the loudest line, and its outbound link is a
      source line at the foot of the row rather than a red "Details" button.
    */}
    <section class="band container" aria-labelledby="on-now-heading">
      <div class="section-head">
        <h2 id="on-now-heading">Happening now</h2>
        <span class="actions">
          {happening.live.length > 0 && <span class="here">Live now</span>}
          <a class="target" href="/events">Upcoming events</a>
        </span>
      </div>

      {
        onNow.length > 0 ? (
          <>
            <ul class="rows" role="list">
              {onNow.map((event) => (
                <li>
                  <EventCard
                    event={event}
                    when={homeWhen(event)}
                    state={happening.live.includes(event) ? 'live' : 'ongoing'}
                    showImage
                  />
                </li>
              ))}
            </ul>
            <p class="rows-more">
              <a class="btn btn--outline btn--arrow" href="/events">
                {moreOnNow > 0
                  ? `See ${moreOnNow} more and everything upcoming`
                  : 'See everything upcoming'}
              </a>
            </p>
          </>
        ) : (
          <>
            <p class="empty-state">
              Nothing running at this minute. Raid Hours, Community Days and Spotlight Hours all
              show up here automatically when they start.
            </p>
            <p class="rows-more">
              <a class="btn btn--outline btn--arrow" href="/events">See what is coming up</a>
            </p>
          </>
        )
      }

      {/*
        Licence, not decoration. This page shows Leek Duck's event artwork and
        raid bosses, and their terms require visible credit to both Leek Duck AND
        ScrapedDuck on any page using the data. It sits outside the conditional
        above so a failed fetch cannot take the credit down with it.
      */}
      <Attribution />
    </section>

    {
      photos.length > 0 && (
        <section class="band container" aria-labelledby="community-heading">
          <div class="section-head">
            <h2 id="community-heading">The community</h2>
            <a class="target" href="/blog#photos">All photos</a>
          </div>
          <p class="band-lede">
            PoGo TXK meets year-round at Spring Lake Park. New players and veterans, any team.
          </p>
          {/* Several of these are Texarkana Gazette press photos, so the credit
              rides on the image rather than sitting in a caption a crop could
              separate from it. */}
          <ul class="photos" role="list">
            {photos.map((photo) => (
              <li class="figure photo">
                <img
                  src={`/media/${photo.r2_key}`}
                  alt={photo.alt ?? 'PoGo TXK community photo'}
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="300"
                />
                {photo.credit && <p class="credit">{photo.credit}</p>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      latestPosts.length > 0 && (
        <section class="band container" aria-labelledby="news-heading">
          <div class="section-head">
            <h2 id="news-heading">Community news</h2>
            <a class="target" href="/blog">All posts</a>
          </div>
          <ul class="news" role="list">
            {latestPosts.map((post) => (
              <li>
                <a class="card news-row" href={`/blog/${post.slug}`}>
                  {post.hero && (
                    <img
                      class="news-thumb"
                      src={`/media/${post.hero.key}`}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width="64"
                      height="64"
                    />
                  )}
                  <span class="news-body">
                    {post.publishedAt && (
                      <time class="news-date tnum" datetime={post.publishedAt}>
                        {newsDateFormat.format(new Date(post.publishedAt))}
                      </time>
                    )}
                    <span class="news-title">{post.title}</span>
                    {post.pinned && <span class="badge">Pinned</span>}
                    {post.excerpt && <span class="news-excerpt">{post.excerpt}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="band container" aria-labelledby="find-us-heading">
      <div class="panel">
        <div class="panel-head">
          <h2 id="find-us-heading">Find us</h2>
        </div>
        <ul class="socials" role="list">
          {
            SOCIALS.map((social) => (
              <li>
                <a class="social" href={social.href} rel="noopener noreferrer" target="_blank">
                  {/* Each brand's own app icon, which brings its own background
                      — a chip behind it would be a second tile behind a tile. */}
                  <span class="social-mark" aria-hidden="true">
                    <SocialIcon name={social.name} size={42} />
                  </span>
                  <span class="social-text">
                    <strong>{social.label}</strong>
                    <span>{social.hint}</span>
                    <span class="sr-only"> (opens in a new tab)</span>
                  </span>
                  <svg class="social-go" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                    <path
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M8 16 16 8M9 8h7v7"
                    />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="band container" aria-labelledby="campsite-heading">
      <div class="panel prose campsite">
        <h2 id="campsite-heading">What is a Community Campsite?</h2>
        <p>
          Community Campsites are dedicated in-game areas established by official Community
          Ambassadors, and they act as local hubs for in-person meetups. They come with perks:
          exclusive event check-ins, special Timed Research, and enhanced PokéStops and Gyms.
        </p>
        <p>Ours covers Spring Lake Park. The ★ markers on the map are the Campsite locations.</p>
      </div>
    </section>

    {/*
      The page ends on the ask rather than on a glossary entry: where to be, and
      the one arrow to follow.
    */}
    <section class="band container" aria-labelledby="closing-heading">
      <div class="panel closing">
        <div class="panel-head">
          <h2 id="closing-heading">See you at the park</h2>
        </div>
        <p class="closing-line">
          {
            nextUp ? (
              <>
                Next meetup: <strong class="tnum">{nextUpWhen}</strong>
                {nextUp.where ? `, ${nextUp.where}.` : '.'}
              </>
            ) : (
              'Meetups run on Wednesday evenings at the Campsite, and get announced in Discord first.'
            )
          }
        </p>
        <p class="actions">
          <a class="btn btn--primary btn--arrow" href="/map">Open the map</a>
          <a class="btn btn--outline btn--arrow" href="/events">See the event calendar</a>
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  /* ---------------------------------------------------------------- page --
   * The kiosk board. Body and UI in Atkinson Hyperlegible Next; every heading,
   * label and numeral in Overpass, which is Highway Gothic's descendant and so
   * the face the object this page imitates is actually signed in.
   *
   * Set here rather than on `body`: the global rule belongs to the chrome wave,
   * and a page flipping it early would take the header and footer with it.
   */
  .home {
    font-family: var(--font-read);
    line-height: var(--lh-body);
    padding-bottom: var(--space-section);
  }
  .home h1,
  .home h2,
  .home h3 {
    font-family: var(--font-sign);
    letter-spacing: var(--tracking-tight);
  }
  /* Data numerals line up in a column. */
  .tnum {
    font-variant-numeric: tabular-nums;
  }

  /* Every section below the board keeps one rhythm. `.section-head` and
     `.panel-head` carry their own rule, so the band only owns the gap. */
  .band {
    margin-block-start: var(--space-section);
  }
  .band > .section-head:first-child {
    margin-block-start: 0;
  }
  .band-lede {
    margin: calc(var(--space-2) * -1) 0 var(--space-4);
    max-width: var(--measure);
    color: var(--text-muted);
  }

  /* --------------------------------------------------------------- board --
   * The banner, the map and the panel are one object: one radius, one shadow,
   * and no gap between the photograph and the park it was taken in.
   *
   * The panel overlaps the map rather than the photograph, and that is a
   * licence decision rather than a compositional one — the press credit lives
   * on the bottom strip of the image (`.credit`), and nothing sits on top of it.
   */
  .board {
    --board-overlap: var(--space-10);
    margin-block-start: var(--space-6);
  }
  .board-plate {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    /* Map paper, so a tile that has not painted yet reads as loading rather
       than as a hole punched in the board. */
    background: var(--map-canvas);
  }

  .banner {
    margin: 0;
    display: block;
  }
  .banner picture {
    display: block;
  }
  .banner img {
    display: block;
    width: 100%;
    height: auto;
    /* Matches the tight crop the `<img>` fallback actually serves, so `cover`
       is not cropping an already-cropped frame a second time. */
    aspect-ratio: 1200 / 560;
    max-height: 300px;
    object-fit: cover;
    /* Low, because the people are in the lower two-thirds of the frame. */
    object-position: center 58%;
  }
  /* The `<source>` swaps to the wide crop at exactly this width, so the ratio
     has to swap with it or `cover` starts eating the group. */
  @media (min-width: 900px) {
    .banner img {
      aspect-ratio: 2540 / 740;
      max-height: 360px;
      object-position: center 72%;
    }
  }
  /* The primitive's five-stop ramp does the contrast work; this only sets the
     weight, because the caption names the photograph rather than whispering it.
     The two-stop scrim it replaces measured 2.50:1 where the glyphs are. */
  .banner .credit {
    font-family: var(--font-sign);
    font-weight: 700;
  }

  .board-map {
    position: relative;
    height: 70dvh;
    min-height: 320px;
    max-height: 560px;
  }
  /* 768px is the tablet break, and the board's own: below it the panel needs the
     full width to hold a date, a place and a button on one readable measure. */
  @media (min-width: 768px) {
    .board-map {
      height: 560px;
      max-height: none;
    }
  }
  /*
   * The tile attribution is an obligation, so the panel is never allowed to
   * cover it. Leaflet anchors its bottom controls to the map's own bottom edge
   * and the panel rises over that edge, so the whole corner moves up by the
   * overlap plus a little air. `:global` because the map is a React island with
   * no scoping of its own, and scoped under `.board-map` so /map is untouched.
   */
  .board-map :global(.leaflet-bottom) {
    bottom: calc(var(--board-overlap) + var(--space-2));
  }

  /*
   * The map's own "Loading map…" placeholder writes `color: var(--text-muted)`
   * as an inline style in MapPreview.tsx. `--text-muted` inverts to a light grey
   * in dark mode while `--map-canvas` under it stays light in both themes, so
   * the placeholder measured 2.03:1 there. An inline style cannot be beaten
   * without `!important`, and the accessibility floor outranks the tidier fix —
   * which is a fixed ink in the component, requested in the wave report.
   */
  .board-map :global([role='status']) {
    color: var(--ink-700) !important;
  }

  .board-fallback {
    position: absolute;
    inset: 0;
    z-index: var(--z-content);
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-2);
    padding: var(--gutter);
    background: var(--map-canvas);
    /* Fixed ink, like `.map-loading`: this sits on map paper, which is light in
       both themes, so `--text` would invert out from under it. */
    color: var(--ink-800);
  }
  .board-fallback strong {
    font-family: var(--font-sign);
    font-size: var(--display-sm);
  }

  .board-panel {
    position: relative;
    z-index: var(--z-content);
    margin-top: calc(var(--board-overlap) * -1);
  }
  @media (min-width: 768px) {
    .board {
      --board-overlap: var(--space-16);
    }
    .board-panel {
      width: min(440px, 100%);
      margin-inline-start: auto;
      margin-inline-end: var(--space-6);
    }
  }
  /* The board is the page's title plate, so its heading is the display size the
     rest of the page steps down from. */
  .board-panel .panel-head h1 {
    font-size: var(--display-lg);
    line-height: var(--lh-display);
  }
  .board-lede {
    margin: 0 0 var(--space-5);
    color: var(--text-muted);
  }

  /* ---------------------------------------------------------------- posts --
   * A legend: three numbered posts, readable in any order. The numbers are keys
   * rather than decoration, which is the only thing that earns them here.
   */
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  .post-body {
    /* Long meetup titles and place names live here; a grid child will not
       shrink below its content without this, which is exactly how 169px of
       horizontal overflow shipped once already. */
    min-width: 0;
  }
  .post-lead {
    margin: 0;
    font-family: var(--font-sign);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
  }
  .post-lead--quiet {
    font-size: var(--text-lg);
    color: var(--text-muted);
  }
  .post-line {
    margin: var(--space-1) 0 0;
    font-size: var(--text-md);
    line-height: var(--lh-ui);
  }
  .post-muted {
    color: var(--text-muted);
  }
  .post-action {
    margin: var(--space-3) 0 0;
  }

  /*
   * A local `.cluster`, and not the primitive, because this page mounts the map
   * island: `MapView.css:257` already owns the global name `.cluster` for the
   * 38px red marker-cluster disc, it is unlayered React-island CSS, and so it
   * beats the primitive everywhere the map is on the page. Two buttons rendered
   * as one red circle. See the cross-file request in the wave report.
   */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .board-actions {
    margin: var(--space-6) 0 0;
  }

  /* --------------------------------------------------------------- panels --
   * `primitives.css` styles `.section-head .count` but not `.panel-head .count`,
   * so the trailing caption in a panel head would otherwise set at body size and
   * read as a second heading. Same treatment, one level down. */
  .panel-head .count {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .panel-subhead {
    margin: var(--space-5) 0 var(--space-2);
    font-size: var(--text-md);
    font-weight: 700;
  }
  .panel-subhead:first-of-type {
    margin-top: 0;
  }
  .panel-note {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-md);
  }
  .panel-status {
    margin-top: var(--space-5);
  }
  .panel-links {
    margin: var(--space-4) 0 0;
    font-size: var(--text-md);
    color: var(--text-muted);
  }
  /* The 24px target belongs on the anchors, not on the paragraph around them:
     padding on the `<p>` gave the row its height and left every link 18px tall.
     `.target` does it per anchor. */
  .panel-links a {
    font-weight: 700;
  }

  /* ---------------------------------------------------------------- minis --
   * The bosses, eggs and research rewards themselves, not a sentence about
   * them. Names wrap rather than truncate: "Hisuian Growlithe" clipped to
   * "Hisuian Gro…" loses the only thing the tile was there to say.
   */
  .minis {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* 120px, not 96: at 96 a four-tile strip broke 3 + 1 on a phone and left a
       tile stranded on its own row. 120 gives two columns at the narrowest
       content width this site supports, so four tiles read as a 2 x 2 block. */
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--space-2);
  }
  .mini {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-1);
    min-width: 0;
    padding: var(--space-2) var(--space-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-sunken);
    text-align: center;
  }
  .mini img {
    width: 46px;
    height: 46px;
    object-fit: contain;
  }
  .mini-name {
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: var(--lh-ui);
    /* Wrapping, deliberately: see the note above. */
    overflow-wrap: anywhere;
  }
  .mini-tier {
    font-family: var(--font-sign);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--text-muted);
  }
  /* The shiny mark is the shared `ShinyMark` badge, not a corner sparkle in
     `--poi-campsite` — that measured 1.81:1 on this surface and hid the word
     "shiny" in `sr-only` text, which made colour the only signal for the one
     fact the tile was flagging. It sits in the flow, so nothing overlaps. */
  .mini :global(.g-shiny) {
    margin-top: var(--space-1);
  }

  /* ----------------------------------------------------------------- rows --
   * "Happening now". EventCard already prints the row: a 64px thumbnail, the
   * time as the loudest line, then the title and its source. All this page adds
   * is the list, and the fact that a teaser does not need the blurb.
   */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .rows :global(.event-blurb) {
    display: none;
  }
  .rows-more {
    margin: var(--space-4) 0 0;
  }

  /* --------------------------------------------------------------- photos -- */
  .photos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* 130px keeps two columns down to a 300px-ish content box (320px phones
       included), the width the container's own padding leaves at the narrowest
       viewport this site supports. */
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: var(--space-3);
  }
  .photo {
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }
  .photo img {
    display: block;
    width: 100%;
    /* Tall enough that the credit stays a strip rather than a lid: the ramp
       covers the bottom quarter of the tile and no more. */
    height: 190px;
    object-fit: cover;
  }

  /* ----------------------------------------------------------------- news -- */
  .news {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .news-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  .news-row:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
  }
  .news-thumb {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    background: var(--bg-sunken);
  }
  .news-body {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
    min-width: 0;
  }
  /* The date is signage: a date is how a notice board is read. */
  .news-date {
    font-family: var(--font-sign);
    font-size: var(--text-md);
    font-weight: 800;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .news-title {
    font-family: var(--font-sign);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
  }
  .news-row:hover .news-title {
    text-decoration: underline;
  }
  .news-excerpt {
    font-size: var(--text-md);
    line-height: var(--lh-body);
    color: var(--text-muted);
  }

  /* -------------------------------------------------------------- socials --
   * Four tiles on the panel, not four near-black blocks on a light page. Each
   * mark is the brand's own app icon and brings its own background, so there is
   * no chip behind it; the tile is the same sunken surface every other list on
   * this page sits on.
   */
  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-3);
  }
  .social {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-sunken);
    color: var(--text);
    text-decoration: none;
    transition:
      transform var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }
  .social:hover {
    transform: var(--lift);
    border-color: var(--text);
  }
  .social-mark {
    display: grid;
    place-items: center;
    line-height: 0;
  }
  .social-mark svg {
    display: block;
    border-radius: var(--radius-sm);
  }
  .social-text {
    display: grid;
    gap: 1px;
    min-width: 0;
  }
  .social-text strong {
    font-family: var(--font-sign);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: var(--lh-heading);
  }
  .social-text span {
    font-size: var(--text-sm);
    line-height: var(--lh-ui);
    color: var(--text-muted);
  }
  .social-go {
    flex: none;
    color: var(--text-muted);
  }

  /* ------------------------------------------------------------- campsite -- */
  .campsite > :first-child {
    margin-block-start: 0;
  }
  /*
   * The paragraph gap, restored locally.
   *
   * `primitives.css` sets `.prose > * + * { margin-block-start: var(--space-4) }`
   * at (0,1,0) and then `.prose p { margin-block: 0 }` at (0,1,1), so the second
   * rule wins on specificity and every `.prose` on the site runs its paragraphs
   * together with no space between them. This is a scoped, unlayered rule, so it
   * beats both — but the real fix belongs in the primitive. See the wave report.
   */
  .campsite p + p {
    margin-block-start: var(--space-4);
  }

  /* -------------------------------------------------------------- closing -- */
  .closing-line {
    margin: 0 0 var(--space-5);
    font-size: var(--text-lg);
    line-height: var(--lh-body);
  }

  /* Every transform on this page goes through `--lift`, which global.css sets
     to `none` under reduced motion, so that escape is structural rather than
     remembered. The transitions above are duration-only and the blanket
     reduced-motion rule zeroes them. */
</style>
