---
import { env } from 'cloudflare:workers';
import Base from '~/layouts/Base.astro';
import MapPreview from '~/components/map/MapPreview';
import SocialIcon from '~/components/SocialIcon.astro';
import { DISCORD_INVITE, SOCIALS } from '~/lib/socials';
import EventCard from '~/components/events/EventCard.astro';
import {
  listPublicMeetups,
  markdownToText,
  meetupLocation,
  meetupToCalendarEvent,
} from '~/lib/db/meetups';
import { listPublishedPosts } from '~/lib/db/posts';
import { gameEventsFromPayload, groupEvents, type CalendarEvent } from '~/lib/events';
import {
  eggDistanceRank,
  getFeed,
  groupSorted,
  raidTierRank,
  researchCategoryLabel,
  researchCategoryRank,
  type ResearchReward,
} from '~/lib/scrapedduck';
import { getDiscordEvents, nextDiscordMeetup } from '~/lib/discord-events';
import { rsvpLabel, splitDescription } from '~/lib/discord-events-map';
import Attribution from '~/components/game/Attribution.astro';
import FeedStatus from '~/components/game/FeedStatus.astro';
import ShinyMark from '~/components/game/ShinyMark.astro';
import { proxiedImageUrl } from '~/lib/game-image';
import { isoNow } from '~/lib/db/flares';
import { DEFAULT_TZ, formatInZone } from '~/lib/time';

export const prerender = false;

const db = env.DB;
const now = isoNow();

/**
 * Everything on this page is optional. A brand-new deployment has no POIs, no
 * meetups and no posts, and the page still has to look deliberate rather than
 * broken — so each section renders a real fallback instead of an empty shell.
 */
const [counts, meetups, posts, photos, flareCount] = await Promise.all([
  db
    .prepare(
      `SELECT
         SUM(type = 'pokestop')  AS pokestops,
         SUM(type = 'gym')       AS gyms,
         SUM(type = 'powerspot') AS powerspots,
         SUM(is_campsite)        AS campsite
       FROM pois WHERE status = 'published'`,
    )
    .first<{ pokestops: number; gyms: number; powerspots: number; campsite: number }>()
    .catch(() => null),

  listPublicMeetups(db).catch(() => []),
  listPublishedPosts(db, { limit: 3 }).catch(() => ({ posts: [], total: 0 })),

  db
    .prepare(
      `SELECT r2_key, alt, credit FROM media
        WHERE kind = 'community_photo' ORDER BY created_at DESC LIMIT 4`,
    )
    .all<{ r2_key: string; alt: string | null; credit: string | null }>()
    .then((r) => r.results)
    .catch(() => []),

  /*
   * How many flares are burning, counted here rather than fetched.
   *
   * The board's second post says whether anything is on right now, and it has
   * to be true before any JavaScript runs — /live owns the socket, this is a
   * number. Deliberately a COUNT rather than `listActiveFlares`: that query
   * joins the RSVP and author tables to build cards nobody is drawing here.
   * The predicate is the live board's own, so the two cannot disagree.
   */
  db
    .prepare(`SELECT COUNT(*) AS n FROM flares WHERE closed_at IS NULL AND expires_at > ?1`)
    .bind(now)
    .first<{ n: number }>()
    .catch(() => null),
]);

const flaresLive = flareCount?.n ?? 0;

const nowIso = new Date().toISOString();
const nextMeetup = meetups.find((m) => (m.endsAt ?? m.startsAt) >= nowIso) ?? null;

/*
 * "Next meetup" used to sit empty whenever a meetup was announced in Discord and
 * nobody re-typed it into the admin screens — which is most of the time, because
 * announcing it in Discord is the actual workflow. So the guild's scheduled
 * events are a second source for this post.
 *
 * Lazy refresh on read with a KV cache and a stale fallback, same as `getFeed`;
 * wrangler.jsonc documents why this Worker has no cron to do it on a timer.
 * `waitUntil` keeps the cache write off the response path.
 *
 * Never throws — a Discord outage degrades to whatever was last seen, and then
 * to the hand-entered meetup, and then to the existing empty state.
 */
const cfContext = Astro.locals.cfContext as ExecutionContext | undefined;
const discordEvents = await getDiscordEvents({
  waitUntil: cfContext ? (promise) => cfContext.waitUntil(promise) : undefined,
}).catch(() => null);
const nextDiscord = discordEvents ? nextDiscordMeetup(discordEvents.events, nowIso) : null;

/*
 * Whichever comes first, not "prefer the database".
 *
 * An admin-entered meetup three weeks out must not hide a Discord event
 * tomorrow — the post says "next", and being wrong about that is the one thing
 * it cannot do. When both exist for the same outing the hand-entered row wins
 * the tie, since it is the one carrying a POI, an RSVP list and a Campfire link.
 */
/**
 * A Discord location string, cut back to the place.
 *
 * Discord stores a scheduled event's location as free text, and the guild's
 * events are entered from a phone's address autocomplete — so the board was
 * printing `Street A, Texarkana, TX, USA`, a postal string nobody in Texarkana
 * needs the last three quarters of. Everything after the venue is city, state
 * and country, all three of which this whole site is already about.
 *
 * Display only, and conservative: if trimming would leave nothing, the original
 * string is kept. The hand-entered meetups come through `meetupLocation()` with
 * a real POI name and never match any of this.
 *
 * The proper fix is a resolver beside `discord-events-map.ts` that matches the
 * string against the surveyed POIs and hands back the POI. That file is not
 * this wave's to edit; see the cross-file request in the wave report.
 */
const ADMIN_TAIL = /^(texarkana|tx|texas|ar|arkansas|usa|us|united states)$/i;
function placeLabel(where: string | null): string | null {
  if (!where) return null;
  const parts = where
    .split(',')
    .map((part) => part.trim())
    .filter(Boolean);
  if (parts.length < 2) return where;
  const kept = parts.filter((part) => !ADMIN_TAIL.test(part));
  return kept.length ? kept.join(', ') : where;
}

const nextUp: {
  title: string;
  startsAt: string;
  tz: string;
  where: string | null;
  note: string | null;
  rsvpUrl: string | null;
  rsvpLabel: string;
  fromDiscord: boolean;
  /** Cover art: the hand-entered hero from R2, or the Discord event's image. */
  imageUrl: string | null;
} | null = (() => {
  const fromDb = nextMeetup && {
    title: nextMeetup.title,
    startsAt: nextMeetup.startsAt,
    tz: nextMeetup.tz,
    where: meetupLocation(nextMeetup),
    imageUrl: nextMeetup.heroKey ? `/media/${nextMeetup.heroKey}` : null,
    note: nextMeetup.descriptionMd ? markdownToText(nextMeetup.descriptionMd) : null,
    // The hand-entered row keeps RSVP in its own column, so there is no
    // guessing to do here — only the Discord path has to dig it out of prose.
    rsvpUrl: nextMeetup.campfireUrl,
    rsvpLabel: rsvpLabel(nextMeetup.campfireUrl),
    fromDiscord: false,
  };
  const discordBody = nextDiscord ? splitDescription(nextDiscord.descriptionMd) : null;
  const fromDiscord = nextDiscord && {
    title: nextDiscord.title,
    startsAt: nextDiscord.startsAt,
    // Discord hands back a UTC instant with no zone; the community reads local.
    tz: DEFAULT_TZ,
    where: nextDiscord.locationText,
    imageUrl: nextDiscord.imageUrl,
    // splitDescription has already stripped the Markdown that mattered here and
    // lifted the link out; markdownToText still runs so any remaining emphasis
    // or heading syntax renders as words rather than punctuation.
    note: discordBody?.text ? markdownToText(discordBody.text) : null,
    rsvpUrl: discordBody?.url ?? null,
    rsvpLabel: rsvpLabel(discordBody?.url ?? null),
    fromDiscord: true,
  };
  if (!fromDb) return fromDiscord;
  if (!fromDiscord) return fromDb;
  return fromDiscord.startsAt < fromDb.startsAt ? fromDiscord : fromDb;
})();

/*
 * The meetup's cover art comes to the board now, in post 1 below.
 *
 * It used to stop at `/events`, on the theory that the board post is a time,
 * a place and one button, and a 16:9 cover on top of that would outrank the
 * thing the post exists to say. The owner's call (2026-09-04) folds the
 * closing panel's own card — art, name, time, place, RSVP — up into post 1
 * instead of repeating it at the foot of the page, so the art comes with it.
 */
const nextUpWhen = nextUp ? formatInZone(nextUp.startsAt, nextUp.tz) : null;
const nextUpWhere = placeLabel(nextUp?.where ?? null);

const latestPosts = Array.isArray(posts) ? posts : posts.posts;
// Short form for a news row — /blog's own `dateFormat` spells the month out
// because it has a whole line to itself; this one shares a row with a title.
const newsDateFormat = new Intl.DateTimeFormat('en-US', {
  timeZone: DEFAULT_TZ,
  month: 'short',
  day: 'numeric',
});

const totalPois = (counts?.pokestops ?? 0) + (counts?.gyms ?? 0) + (counts?.powerspots ?? 0);

/**
 * What is happening *right now* — community meetups and Pokémon GO events in
 * one list, the same way /events builds it.
 *
 * Read from the data layer rather than fetched from our own /api route: a
 * Worker fetching its own origin is a loopback through the edge that works
 * under `astro dev` and returns nothing in production. That bug already shipped
 * once — see the vault's Bugs Worth Remembering.
 */
const globalEvents = await getFeed('events')
  .then(gameEventsFromPayload)
  .catch(() => null);

/**
 * The bosses actually worth walking to tonight — legendary and mega tiers only.
 *
 * `raidTierRank` is the same ordering /raids uses, so "headline" means the same
 * thing on both pages rather than being a second opinion. Capped at four: this
 * is a glance, and /raids is one tap away for the rest.
 */
const raidFeed = await getFeed('raids').catch(() => null);
const headlineBosses = (raidFeed?.data ?? [])
  .filter((boss) => {
    const t = boss.tier.toLowerCase();
    return t.includes('5-star') || t.includes('mega') || t.includes('primal');
  })
  .sort((a, b) => raidTierRank(b.tier) - raidTierRank(a.tier))
  .slice(0, 4);

/**
 * "In game today" used to be raids alone, and on a day with no headline boss it
 * was three sprites of empty space. Eggs and research are the other two feeds
 * this panel already links out to without ever rendering.
 *
 * Both read through `getFeed` with the same `waitUntil` wiring as the meetup
 * lookup above, so a ScrapedDuck outage degrades exactly like the raid strip
 * already does: less content, never an error.
 */
const eggFeed = await getFeed('eggs', {
  waitUntil: cfContext ? (promise) => cfContext.waitUntil(promise) : undefined,
}).catch(() => null);
const researchFeed = await getFeed('research', {
  waitUntil: cfContext ? (promise) => cfContext.waitUntil(promise) : undefined,
}).catch(() => null);

/**
 * How old this panel is, said out loud.
 *
 * The three feeds are cached independently and can be different ages, so the
 * line reports the *oldest* of them and calls the panel stale if any one of
 * them is. Claiming the freshest number would be the flattering answer rather
 * than the true one, and truth over polish is a product principle here.
 */
interface FeedFreshness {
  fetchedAt: string | null;
  stale: boolean;
  error: string | null;
}
const gameFeeds: FeedFreshness[] = [raidFeed, eggFeed, researchFeed].filter(
  (feed): feed is FeedFreshness => feed !== null,
);
const gameFetchedAt =
  gameFeeds
    .map((feed) => feed.fetchedAt)
    .filter((at): at is string => at !== null)
    .sort()[0] ?? null;
const gameStale = gameFeeds.length === 0 || gameFeeds.some((feed) => feed.stale);
const gameError = gameFeeds.find((feed) => feed.error)?.error ?? null;

/**
 * One species per distance bucket, capped at four so this row can never run
 * taller than the boss strip above it. `groupSorted` already orders buckets
 * shortest-walk-first, so the cap keeps the most commonly-spun distances
 * (2 km outward) rather than an arbitrary slice.
 *
 * Picks the first shiny-eligible species in the bucket, falling back to the
 * first species otherwise. Rarity was the other candidate signal, but
 * EggCard.astro already flags that Leek Duck's `rarity` field doesn't say
 * which end is rare — showing it here would be inventing a claim this
 * codebase has deliberately avoided elsewhere.
 */
const eggHighlights = groupSorted(eggFeed?.data ?? [], (egg) => egg.eggType, eggDistanceRank)
  .slice(0, 4)
  .map((group) => ({
    distance: group.key,
    egg: group.items.find((egg) => egg.canBeShiny) ?? group.items[0],
  }));

/**
 * One task per category, capped at four, favouring a task whose reward can be
 * shiny — "worth keeping tonight" is a sharper glance than "here is a task".
 * Shiny research rewards are seasonal and often absent, so this falls back to
 * any task that at least has a reward to show an icon for; a category where
 * every task rewards Stardust with no encounter is dropped rather than rendered
 * as a tile with no image.
 */
const researchHighlights = groupSorted(
  researchFeed?.data ?? [],
  (task) => task.type ?? 'other',
  researchCategoryRank,
)
  .map((group) => {
    const withReward =
      group.items.find(
        (task) => (task.rewards ?? []).length > 0 && task.rewards.some((r) => r.canBeShiny),
      ) ?? group.items.find((task) => (task.rewards ?? []).length > 0);
    if (!withReward) return null;
    return {
      category: group.key,
      reward: (withReward.rewards.find((r) => r.canBeShiny) ??
        withReward.rewards[0]) as ResearchReward,
    };
  })
  .filter((entry): entry is { category: string; reward: ResearchReward } => entry !== null)
  .slice(0, 4);

const happening = groupEvents([
  ...meetups.map((m) => meetupToCalendarEvent(m, new URL(Astro.url.origin))),
  ...(globalEvents?.events ?? []),
]);

// "Live" is a short window (a Raid Hour); "ongoing" is a season that runs for
// weeks. Both are on right now, so the home page shows them together, live
// first, and caps the list at four — this is a teaser for /events, not a second
// copy of it.
const onNow: CalendarEvent[] = [...happening.live, ...happening.ongoing].slice(0, 4);
const moreOnNow = happening.live.length + happening.ongoing.length - onNow.length;

const dayFmt = new Intl.DateTimeFormat('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  timeZone: DEFAULT_TZ,
});
const timeFmt = new Intl.DateTimeFormat('en-US', {
  hour: 'numeric',
  minute: '2-digit',
  timeZone: DEFAULT_TZ,
});

/** Compact "when" line for the home page rows. */
function homeWhen(event: CalendarEvent): string {
  const start = new Date(event.start);
  if (event.allDay) return `${dayFmt.format(start)} · all day`;
  if (!event.end) return `${dayFmt.format(start)} · ${timeFmt.format(start)}`;
  const end = new Date(event.end);
  const sameDay = dayFmt.format(start) === dayFmt.format(end);
  return sameDay
    ? `${dayFmt.format(start)} · ${timeFmt.format(start)} – ${timeFmt.format(end)}`
    : `${dayFmt.format(start)} – ${dayFmt.format(end)}`;
}
---

<Base title="PoGo TXK">
  <div class="home">
    {/*
      THE HERO, as production had it, on the owner's call (2026-09-04): the
      wordmark and the live map side by side over the forest on a wide screen,
      stacked on a phone. The lede, the two buttons and the survey counts sit
      under the mark, and the board panel below is bolted over the band's foot.

      A full-width band so the forest and the artwork have an edge to run off;
      the content keeps to the container.
    */}
    <div class="hero-band art-band">
      {/*
        Leafeon and Espeon, behind the logo and the map. The source was
        3440x1440 at 60fps and 25Mbps with an audio track on a background that
        is muted by definition; re-encoded to 1600 wide, 30fps and no audio it
        is 656KB.

        `data-src`, not `src`, and `preload="none"`: the script below promotes
        it only when motion is allowed and the browser is not in data-saver
        mode. Served from R2 via /media, NOT from /hero in the static assets:
        Cloudflare's asset layer does not do byte ranges, and iOS Safari probes
        with a range request before it will play any `<video>`. R2 serves
        ranges natively, /media passes them through, and the service worker
        steps aside for any ranged request (public/sw.js).

        The poster is the whole fallback strategy. The band comes up when the
        still loads and the clip fades in over it for whoever can have it; Low
        Power Mode, Data Saver and Reduce Motion all refuse playback and all
        still get the forest, because the still is a frame of this clip.
      */}
      <video
        class="hero-video"
        poster="/hero/eevee-forest-still.webp"
        data-src="/media/hero/eevee-forest.mp4"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"></video>
      <div class="hero-scrim" aria-hidden="true"></div>

      <section class="hero container" aria-labelledby="hero-title">
        <div class="hero-copy">
          {/*
            The wordmark is the page's h1: the heading element holds the image
            and its `alt` reads exactly what the words would. Deliberately NO
            `fetchpriority="high"`, despite Lighthouse asking for it: Chrome
            already ranks a large first-viewport image High on its own, and
            measured production LCP was worse with the hint than without over
            three runs. Check the priority in a network trace before re-adding.
          */}
          <h1 id="hero-title" class="hero-title">
            <img
              class="hero-logo"
              src="/art/logo-txk-classic.webp"
              width="850"
              height="793"
              alt="Pokémon GO Texarkana"
            />
          </h1>
          <p class="lede">
            A community Campsite at Spring Lake Park, run by the official Texarkana Pokémon GO
            Ambassadors. Find every PokéStop and Gym, catch the next meetup, and raid with new and
            experienced players.
          </p>

          <div class="hero-actions">
            <a class="btn btn--primary btn--arrow" href="/map">Open the map</a>
            <a
              class="btn btn--discord"
              href={DISCORD_INVITE}
              rel="noopener noreferrer"
              target="_blank"
            >
              Join the Discord
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        </div>

        {/*
          A sibling of `.hero-copy`, not a child of it, and that is load-bearing
          on a wide screen: it gives the counts their own grid row, which lets
          the map end on the same line as the buttons without anyone having to
          know how tall this block is. Stacked below 820px it simply follows the
          copy.
        */}
        {
          totalPois > 0 && (
            <dl class="stats tnum">
              <div>
                <dt>PokéStops</dt>
                <dd>{counts?.pokestops ?? 0}</dd>
              </div>
              <div>
                <dt>Gyms</dt>
                <dd>{counts?.gyms ?? 0}</dd>
              </div>
              <div>
                <dt>Power Spots</dt>
                <dd>{counts?.powerspots ?? 0}</dd>
              </div>
              <div>
                <dt>★ Campsite</dt>
                <dd>{counts?.campsite ?? 0}</dd>
              </div>
            </dl>
          )
        }

        {/*
          The real map, not a picture of one. It is the thing people came for,
          so making them click through to find out whether their park is on it
          was the wrong trade.

          `client:visible` keeps Leaflet and the marker data off the critical
          path. MapPreview exists to make that possible: MapView itself cannot
          be server-rendered, because Leaflet reads `window` on import.
        */}
        <div class="hero-map">
          <MapPreview client:visible compact />

          <noscript>
            <div class="hero-map-fallback">
              <strong>Spring Lake Park</strong>
              <span>
                {
                  totalPois > 0
                    ? `${totalPois} locations mapped. The interactive map needs JavaScript.`
                    : 'The interactive map needs JavaScript.'
                }
              </span>
              <a class="btn btn--primary btn--arrow" href="/map">Open the map</a>
            </div>
          </noscript>
        </div>
      </section>
    </div>

    <script is:inline>
      // The hero video, on every screen, phones included. `saveData` is the one
      // opt-out: 656KB of decoration is not something to push at someone who
      // has explicitly asked their browser to spend less.
      (() => {
        const band = document.querySelector('.hero-band');
        const video = band && band.querySelector('.hero-video');
        if (!video) return;

        const still = matchMedia('(prefers-reduced-motion: reduce)');
        const thrifty = navigator.connection && navigator.connection.saveData;

        /*
         * Raised when the POSTER has loaded, not only when the clip plays. A
         * phone can refuse playback in at least three ways it never reports
         * (iOS Low Power Mode, Data Saver, and Reduce Motion, which is declined
         * on purpose), and keying the band to the still gives every one of
         * them the forest while keeping the original guarantee: the scrim only
         * ever goes over a picture that actually loaded. A 404 on the still
         * leaves the attribute unset and the hero exactly as it is without any
         * of this.
         */
        const reveal = () => band.setAttribute('data-hero-video', '');
        const art = new Image();
        art.addEventListener('load', reveal);
        art.src = video.getAttribute('poster');
        // Either signal is enough, and the second is not redundant: a still
        // that 404s while the clip plays would otherwise leave the clip playing
        // perfectly and invisibly behind Lucario. Not hypothetical — the poster
        // answered 404 for about a minute after a deploy once.
        video.addEventListener('playing', reveal);

        const sync = () => {
          if (!still.matches && !thrifty) {
            if (!video.src) video.src = video.dataset.src;
            // The attribute alone is not always enough for autoplay policy; the
            // property is what browsers actually check.
            video.muted = true;
            // A refused autoplay is a normal outcome, not an error: the poster
            // is already up, so there is nothing to handle here.
            video.play().catch(() => {});
          } else {
            // Reduced motion asks for a still image, not for no image. The
            // poster stays up and the attribute belongs to it.
            video.pause();
          }
        };
        sync();
        still.addEventListener('change', sync);

        /*
         * Ask again, because asking once is why the hero was once a still.
         * `play()` at script time is a request, a refusal is silent, and on
         * production the clip sat fully loaded, `readyState` 4, and paused.
         * `canplay` covers the ordinary race with `preload="none"`, where
         * assigning `src` and playing happen in the same tick. The first real
         * interaction covers the policies no retry gets past on its own: a
         * user gesture satisfies Chrome's autoplay rules, and on iOS it is what
         * permits playback in Low Power Mode. `scroll` counts, and is what
         * someone does first on a page like this. `once` on each, and both are
         * no-ops when the clip is already running or the reader has opted out.
         */
        const retry = () => {
          if (still.matches || thrifty) return;
          if (!video.paused) return;
          video.play().catch(() => {});
        };
        video.addEventListener('canplay', retry, { once: true });
        for (const evt of ['pointerdown', 'touchstart', 'keydown', 'scroll']) {
          addEventListener(evt, retry, { once: true, passive: true });
        }
      })();
    </script>

    {/*
      THE BOARD: two posts on a panel bolted over the hero's foot. The numbers
      are a legend, so the board can be read in any order — the next meetup,
      cover art included, and what is on right now. The map it used to sit
      over is in the hero now, and the arrows that used to ride on its title
      plate are the hero's own two buttons.
    */}
    <section class="board container" aria-labelledby="board-title">
      <div class="panel board-panel">
        <div class="panel-head">
          {/* An h2: the hero's wordmark is the page's h1. */}
          <h2 id="board-title">Spring Lake Park</h2>
        </div>

        <ol class="posts" role="list">
          <li class:list={['post', nextUp?.imageUrl && 'post--event']}>
            <span class="disc" aria-hidden="true">1</span>
            <div class="post-body">
              {
                nextUp ? (
                  <>
                    {/*
                      The closing panel's own card, folded up here on the
                      owner's call: cover art as a plate, the name, the time
                      and place, and the RSVP — not a sentence about the
                      meetup, the meetup itself. The art is its own (the
                      hand-entered hero, or the cover the organiser attached
                      to the Discord event), so it carries no credit
                      obligation. Its "Open the map" button did not come with
                      it; the hero's own map button is a scroll above this.
                    */}
                    {nextUp.imageUrl && (
                      <div class="post-art">
                        <img
                          src={nextUp.imageUrl}
                          alt=""
                          width="480"
                          height="270"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    )}
                    <div class="post-text">
                      <p class="post-kind">Next meetup</p>
                      {/* The name leads. The date used to be the loudest line on
                          the board, which made the display face a function of
                          position rather than of meaning — a reader glancing at
                          the post learned "Wed, Sep 10" before they learned what
                          was happening. */}
                      <p class="post-lead">{nextUp.title}</p>
                      <p class="post-line post-when tnum">
                        <time datetime={nextUp.startsAt}>{nextUpWhen}</time>
                        <span class="post-where"> · {nextUpWhere ?? 'Place to be confirmed'}</span>
                      </p>
                      <p class="actions post-action">
                        {nextUp.rsvpUrl && (
                          <a
                            class="btn btn--primary btn--arrow"
                            href={nextUp.rsvpUrl}
                            rel="noopener noreferrer"
                            target="_blank"
                          >
                            {nextUp.rsvpLabel}
                            <span class="sr-only"> (opens in a new tab)</span>
                          </a>
                        )}
                        <a
                          class={`btn ${nextUp.rsvpUrl ? 'btn--outline' : 'btn--primary'} btn--arrow`}
                          href="/events"
                        >
                          See the event calendar
                        </a>
                      </p>
                    </div>
                  </>
                ) : (
                  <>
                    <p class="post-lead">Wednesday evenings at the Campsite</p>
                    <p class="post-line post-muted">
                      Nothing on the calendar yet. Meetups get announced in Discord first.
                    </p>
                    <p class="post-action">
                      <a class="target" href="/events">See the event calendar</a>
                    </p>
                  </>
                )
              }
            </div>
          </li>

          <li class="post">
            <span class:list={['disc', flaresLive > 0 && 'disc--live']} aria-hidden="true">2</span>
            <div class="post-body">
              {
                flaresLive > 0 ? (
                  <>
                    <p class="post-lead tnum">
                      {flaresLive} {flaresLive === 1 ? 'flare' : 'flares'} lit
                    </p>
                    <p class="post-line">
                      <span class="here">Live now</span>
                    </p>
                    {/* The one red link on the board, and only in this branch:
                        something is burning right now, which is exactly what red
                        answers here. With no flares up the same link is ink like
                        every other. */}
                    <p class="post-action">
                      <a class="target post-link--now" href="/live">Open the live board</a>
                    </p>
                  </>
                ) : (
                  <>
                    {/* Says what a flare is, because "nothing burning" only
                        meant something to people who already knew. The owner's
                        wording: it is about flares, the Campfire-style call-outs
                        on the live board. */}
                    <p class="post-lead post-lead--quiet">No flares lit right now</p>
                    <p class="post-line post-muted">
                      Flares are live call-outs for raids and meetups at the park. Raise one from
                      the live board.
                    </p>
                    <p class="post-action">
                      <a class="target" href="/live">Open the live board</a>
                    </p>
                  </>
                )
              }
            </div>
          </li>
        </ol>
      </div>
    </section>

    {/*
      IN GAME TODAY, moved above "Happening now" on the owner's call. The next
      meetup used to lead this group and now lives in the board panel, so what
      is left is the one panel that says what the game itself is doing today.
    */}
    <section class="band container" aria-labelledby="in-game-heading">
      <div class="panel">
        <div class="panel-head">
          <h2 id="in-game-heading">In game today</h2>
          <span class="caption">Raids, eggs and research</span>
        </div>

        {
          headlineBosses.length > 0 && (
            <>
              <h3 class="panel-subhead">Raid bosses</h3>
              <ul class="minis" role="list">
                {headlineBosses.map((boss) => (
                  <li class="mini">
                    {/* Through our proxy, not hotlinked — it is Leek Duck's
                        bandwidth, and a cached copy survives them adding
                        hotlink protection. */}
                    <img
                      src={proxiedImageUrl(boss.image) ?? boss.image}
                      alt=""
                      width="56"
                      height="56"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="mini-name">{boss.name}</span>
                    <span class="mini-tier">{boss.tier.replace(/ Raids?$/i, '')}</span>
                    {boss.canBeShiny && (
                      <ShinyMark />
                    )}
                  </li>
                ))}
              </ul>
            </>
          )
        }

        {
          eggHighlights.length > 0 && (
            <>
              <h3 class="panel-subhead">Egg pools</h3>
              <ul class="minis" role="list">
                {eggHighlights.map(({ distance, egg }) => (
                  <li class="mini">
                    <img
                      src={proxiedImageUrl(egg.image) ?? egg.image}
                      alt=""
                      width="56"
                      height="56"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="mini-name">{egg.name}</span>
                    <span class="mini-tier">{distance}</span>
                    {egg.canBeShiny && (
                      <ShinyMark />
                    )}
                  </li>
                ))}
              </ul>
            </>
          )
        }

        {
          researchHighlights.length > 0 && (
            <>
              <h3 class="panel-subhead">Field research</h3>
              <ul class="minis" role="list">
                {researchHighlights.map(({ category, reward }) => (
                  <li class="mini">
                    <img
                      src={proxiedImageUrl(reward.image) ?? reward.image}
                      alt=""
                      width="56"
                      height="56"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="mini-name">{reward.name}</span>
                    <span class="mini-tier">{researchCategoryLabel(category)}</span>
                    {reward.canBeShiny && (
                      <ShinyMark />
                    )}
                  </li>
                ))}
              </ul>
            </>
          )
        }

        {
          /* Only when all three feeds came back with nothing worth a tile — a
             bare `headlineBosses` alone is a normal day (no 5-star or Mega up
             right now), not an outage, and eggs and research still carry the
             panel. */
          headlineBosses.length === 0 &&
            eggHighlights.length === 0 &&
            researchHighlights.length === 0 && (
              <p class="panel-note">
                Current raid bosses, egg pools and field research, updated automatically.
              </p>
            )
        }

        {/* The panel says how old it is now, rather than discarding the two
            fields the feed already carries. */}
        <div class="panel-status">
          <FeedStatus
            fetchedAt={gameFetchedAt}
            stale={gameStale}
            error={gameError}
            label="raid, egg and research data"
          />
        </div>

        <p class="panel-links">
          <a class="target" href="/raids">All raid bosses</a> ·{' '}
          <a class="target" href="/eggs">Eggs</a> · <a class="target" href="/research">Research</a>
        </p>
      </div>
    </section>

    {/*
      HAPPENING NOW. Four rows at most: EventCard prints each one as a 64px
      thumbnail with the time as the loudest line, and its outbound link is a
      source line at the foot of the row rather than a red "Details" button.
    */}
    <div class="calendar-band art-band">
    <section class="band container" aria-labelledby="on-now-heading">
      <div class="section-head">
        <h2 id="on-now-heading">On the calendar</h2>
        <span class="actions">
          {happening.live.length > 0 && <span class="here">Live now</span>}
          <a class="target" href="/events">Upcoming events</a>
        </span>
      </div>

      {
        onNow.length > 0 ? (
          <>
            <ul class="rows" role="list">
              {onNow.map((event) => (
                <li>
                  <EventCard
                    event={event}
                    when={homeWhen(event)}
                    state={happening.live.includes(event) ? 'live' : 'ongoing'}
                    showImage
                    art="poster"
                    stateNamedByGroup
                  />
                </li>
              ))}
            </ul>
            <p class="rows-more">
              <a class="btn btn--outline btn--arrow" href="/events">
                {moreOnNow > 0
                  ? `See ${moreOnNow} more and everything upcoming`
                  : 'See everything upcoming'}
              </a>
            </p>
          </>
        ) : (
          <>
            <p class="empty-state">
              Nothing running at this minute. Raid Hours, Community Days and Spotlight Hours all
              show up here automatically when they start.
            </p>
            <p class="rows-more">
              <a class="btn btn--outline btn--arrow" href="/events">See what is coming up</a>
            </p>
          </>
        )
      }

      {/*
        Licence, not decoration. This page shows Leek Duck's event artwork and
        raid bosses, and their terms require visible credit to both Leek Duck AND
        ScrapedDuck on any page using the data. It sits outside the conditional
        above so a failed fetch cannot take the credit down with it.
      */}
      <Attribution />
    </section>
    </div>

    {
      photos.length > 0 && (
        <section class="band container" aria-labelledby="community-heading">
          <div class="section-head">
            <h2 id="community-heading">The community</h2>
            <a class="target" href="/blog#photos">All photos</a>
          </div>
          <p class="band-lede">
            PoGo TXK meets year-round at Spring Lake Park. New players and veterans, any team.
          </p>
          {/*
            The GO Fest group shot leads the section, where production had it.
            Art-directed, not scaled: a sixty-person group shot 3.4 times wider
            than it is tall renders every face about three pixels across on a
            phone, so narrow screens get the tighter crop centred on the two
            Ambassador banners.
          */}
          <figure class="figure banner">
            <picture>
              <source
                media="(min-width: 900px)"
                srcset="/hero/community-wide-1200.webp 1200w, /hero/community-wide-1600.webp 1600w, /hero/community-wide-2400.webp 2400w"
                sizes="(min-width: 1140px) 1060px, calc(100vw - 40px)"
              />
              <img
                src="/hero/community-tight-900.webp"
                srcset="/hero/community-tight-600.webp 600w, /hero/community-tight-900.webp 900w, /hero/community-tight-1200.webp 1200w"
                sizes="calc(100vw - 40px)"
                width="1200"
                height="560"
                alt="PoGo TXK members gathered at Spring Lake Park for GO Fest 2026, holding two Pokémon GO Community Ambassador banners under a black and a purple canopy."
                loading="lazy"
                decoding="async"
              />
            </picture>
            <figcaption class="credit">GO Fest 2026 at Spring Lake Park</figcaption>
          </figure>
          {/* Several of these are Texarkana Gazette press photos, so the credit
              rides on the image rather than sitting in a caption a crop could
              separate from it. */}
          <ul class="photos" role="list">
            {photos.map((photo) => (
              <li class="figure photo">
                <img
                  src={`/media/${photo.r2_key}`}
                  alt={photo.alt ?? 'PoGo TXK community photo'}
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="300"
                />
                {photo.credit && <p class="credit">{photo.credit}</p>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      latestPosts.length > 0 && (
        <section class="band container" aria-labelledby="news-heading">
          <div class="section-head">
            <h2 id="news-heading">Community news</h2>
            <a class="target" href="/blog">All posts</a>
          </div>
          <ul class="news" role="list">
            {latestPosts.map((post) => (
              <li>
                <a class="card news-row" href={`/blog/${post.slug}`}>
                  {post.hero && (
                    <img
                      class="news-thumb"
                      src={`/media/${post.hero.key}`}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width="64"
                      height="64"
                    />
                  )}
                  <span class="news-body">
                    {post.publishedAt && (
                      <time class="news-date tnum" datetime={post.publishedAt}>
                        {newsDateFormat.format(new Date(post.publishedAt))}
                      </time>
                    )}
                    <span class="news-title">{post.title}</span>
                    {post.pinned && <span class="badge">Pinned</span>}
                    {post.excerpt && <span class="news-excerpt">{post.excerpt}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="band container" aria-labelledby="find-us-heading">
      <div class="panel">
        <div class="panel-head">
          <h2 id="find-us-heading">Find us</h2>
        </div>
        <ul class="socials" role="list">
          {
            SOCIALS.map((social) => (
              <li>
                <a class="social" href={social.href} rel="noopener noreferrer" target="_blank">
                  {/* Each brand's own app icon, which brings its own background
                      — a chip behind it would be a second tile behind a tile. */}
                  <span class="social-mark" aria-hidden="true">
                    <SocialIcon name={social.name} size={42} />
                  </span>
                  <span class="social-text">
                    <strong>{social.label}</strong>
                    <span>{social.hint}</span>
                    <span class="sr-only"> (opens in a new tab)</span>
                  </span>
                  <svg class="social-go" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                    <path
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M8 16 16 8M9 8h7v7"
                    />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <div class="campsite-band art-band">
    <section class="band container" aria-labelledby="campsite-heading">
      <div class="panel prose campsite">
        <h2 id="campsite-heading">What is a Community Campsite?</h2>
        <p>
          Community Campsites are dedicated in-game areas established by official Community
          Ambassadors, and they act as local hubs for in-person meetups. They come with perks:
          exclusive event check-ins, special Timed Research, and enhanced PokéStops and Gyms.
        </p>
        {/* The star is drawn, and it is the same path the map badges the
            Campsite pins with — a key drawn from different artwork than the
            thing it keys is not a key. */}
        <p>
          Ours covers Spring Lake Park. The{' '}
          <svg class="inline-star" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"
            />
          </svg>{' '}
          <span class="sr-only">star</span> markers on the map are the Campsite locations.
        </p>
      </div>
    </section>
    </div>

  </div>
</Base>

<style>
  /* ---------------------------------------------------------------- page --
   * The kiosk board. Body and UI in Atkinson Hyperlegible Next; every heading,
   * label and numeral in Overpass, which is Highway Gothic's descendant and so
   * the face the object this page imitates is actually signed in.
   *
   * Set here rather than on `body`: the global rule belongs to the chrome wave,
   * and a page flipping it early would take the header and footer with it.
   */
  .home {
    font-family: var(--font-read);
    line-height: var(--lh-body);
    padding-bottom: var(--space-section);
    /* How far the board panel rises into the hero's foot. The band pads its
       bottom by the same amount, so the two agree by construction. */
    --board-overlap: var(--space-12);
  }
  .home h1,
  .home h2,
  .home h3 {
    font-family: var(--font-sign);
    letter-spacing: var(--tracking-tight);
  }
  /* Data numerals line up in a column. */
  .tnum {
    font-variant-numeric: tabular-nums;
  }

  /* Every section below the board keeps one rhythm. `.section-head` and
     `.panel-head` carry their own rule, so the band only owns the gap. */
  .band {
    margin-block-start: var(--space-section);
  }
  .band > .section-head:first-child {
    margin-block-start: 0;
  }
  .band-lede {
    margin: calc(var(--space-2) * -1) 0 var(--space-4);
    max-width: var(--measure);
    color: var(--text-muted);
  }

  /* ---------------------------------------------------------------- hero --
   * The production hero, back on the owner's call (2026-09-04). The forest
   * clip and its scrim sit behind the band at negative z; the wordmark, lede,
   * buttons and counts take the left column and the live map the right, and
   * the board panel below rises over the band's dissolving foot by
   * `--board-overlap` (declared on `.home`, read here and by `.board`).
   */
  .hero-band {
    /*
     * Shiny Lucario is the hero's artwork only while the forest is not up: the
     * moment the still loads he stands down (below), so this is the picture a
     * broken still leaves behind. 280x431 trimmed, pushed past the edge so the
     * leading half shows and the screen crops the rest — anything wider would
     * only hide behind the map card, whose corner carries the tile credit.
     */
    --art-src: url('/art/lucario-shiny.webp');
    --art-ratio: 0.65;
    --art-right: calc(-1 * clamp(30px, 6vw, 110px));
    --art-bottom: -14px;
    --art-w: clamp(150px, 17vw, 280px);
    /*
     * The distance the forest and its scrim dissolve over at the foot of the
     * band, and the room made for them to do it in. The padding is
     * unconditional rather than under `[data-hero-video]`: tied to the clip it
     * would move everything below the hero the moment the still landed. The
     * panel's overlap is added on top, so the counts and the map keep their
     * clearance from the fade and from the panel both. Production measured the
     * 6.5vw/96px term at 21–26px of margin between the last content and the
     * fade across 900–1920.
     */
    --hero-out: clamp(70px, 8vw, 110px);
    padding-bottom: calc(clamp(52px, 6.5vw, 96px) + var(--board-overlap));
  }

  /* --- the forest behind the hero -------------------------------------------
   * Both layers start invisible and are revealed together by
   * `data-hero-video`, which the script sets when the still has loaded or the
   * clip is playing, so every way this can fail leaves the hero exactly as it
   * is without the forest instead of a scrim darkening an empty band.
   *
   * `--z-art` and one step below it put them under the band's content while
   * keeping the scrim over the clip. The same trick `.art-band::after` uses,
   * and it works for the same reason: nothing between here and the root
   * paints an opaque background.
   */
  .hero-video,
  .hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity calc(var(--dur-4) * 2) var(--ease-out);
  }
  .hero-video {
    z-index: calc(var(--z-art) - 1);
    width: 100%;
    height: 100%;
    /* Fills the band, which is what a phone wants: stacked, the band is taller
       than it is wide, and a clip sized to its own 2.39:1 would be a thin strip
       over a lot of empty. From 900px up this is overridden below. Centred
       either way: the two subjects sit at 33% and 76% across, so any
       `object-position` off centre drops one of them first. */
    object-fit: cover;
    object-position: center;
  }
  .hero-scrim {
    z-index: var(--z-art);
    /* Heaviest on the left, where the copy is, lifting toward the map card on
       the right, which brings its own opaque ground. The stops are the ones
       production shipped under this copy. */
    background: linear-gradient(
      to right,
      rgb(6 8 12 / 0.84) 0%,
      rgb(6 8 12 / 0.72) 46%,
      rgb(6 8 12 / 0.52) 100%
    );
  }
  .hero-band[data-hero-video] .hero-video,
  .hero-band[data-hero-video] .hero-scrim {
    opacity: 1;
  }
  /* Lucario stands down wherever the forest is up. */
  .hero-band[data-hero-video]::after {
    display: none;
  }

  /* --- the same forest, on a phone -----------------------------------------
   * Not the desktop treatment scaled down. `cover` on a 2.39:1 clip over a tall
   * phone column keeps roughly 18% of its width, and both Pokémon fall outside
   * it. So the clip gets a strip at the top of the band instead, sized to end
   * behind the mark, and below the strip the scrim goes fully opaque and
   * becomes the hero's ground. In the scrim, already the layer above the clip,
   * because a `background` on the band would paint over a clip that has
   * escaped to the root stacking context; the 900px-and-up block takes the
   * other route and sets `isolation: isolate` to make a band background legal.
   * Neither approach works without its own half, so do not move one alone.
   */
  @media (max-width: 899px) {
    .hero-band {
      --hero-vid-h: clamp(210px, 62vw, 330px);
    }
    .hero-video {
      height: var(--hero-vid-h);
      bottom: auto;
    }
    .hero-scrim {
      background: linear-gradient(
        to bottom,
        rgb(6 8 12 / 0.42) 0,
        rgb(6 8 12 / 0.5) calc(var(--hero-vid-h) * 0.55),
        rgb(11 14 19) var(--hero-vid-h),
        rgb(11 14 19) 100%
      );
    }
  }

  /* The copy inverts over the scrim. `--text-muted` is a grey tuned for a light
     panel and reads at roughly 2:1 on this ground. */
  .hero-band[data-hero-video] .lede {
    color: rgb(255 255 255 / 0.92);
  }
  .hero-band[data-hero-video] .stats dt {
    color: rgb(255 255 255 / 0.78);
  }
  .hero-band[data-hero-video] .stats dd {
    color: #fff;
  }

  /*
   * The foot of the band dissolves instead of stopping dead: masked to
   * transparent rather than covered by a page-colour gradient, so whatever is
   * below shows through on its own and it holds in both themes. The scrim is
   * masked at every width; the clip only from 900px up, because below that it
   * is a strip whose bottom edge the opaque scrim already hides.
   */
  .hero-band[data-hero-video] .hero-scrim {
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 calc(100% - var(--hero-out)),
      transparent 100%
    );
    mask-image: linear-gradient(to bottom, #000 calc(100% - var(--hero-out)), transparent 100%);
  }
  @media (min-width: 900px) {
    .hero-band[data-hero-video] .hero-video {
      -webkit-mask-image: linear-gradient(
        to bottom,
        #000 calc(100% - var(--hero-out)),
        transparent 100%
      );
      mask-image: linear-gradient(to bottom, #000 calc(100% - var(--hero-out)), transparent 100%);
      /*
       * Stop stretching the clip to the band's height. The source is 2.39:1
       * and the band is nowhere near it, so `cover` was binding on height and
       * eating the sides: at 1000px a centred 50% window is 25%–75%, and the
       * subject at 76% was cropped out of its own hero. The box takes the
       * clip's own ratio instead, floored at 72% of the band — 72% at 1000,
       * 78% at 1200, the whole frame from ~1585px up. `aspect-ratio` is
       * declared because a device that declines playback never gets a `src`,
       * and `height: auto` on a video with nothing but a poster is not
       * reliably the poster's ratio. The number matches the file; recut the
       * clip and it moves.
       */
      bottom: auto;
      height: auto;
      aspect-ratio: 1600 / 670;
      min-height: 72%;
      max-height: 100%;
    }
    /*
     * What fills the strip below the clip. `isolation` is the whole reason
     * this works: the clip and scrim sit at negative z, and without a stacking
     * context on the band its own background would paint straight over them.
     * The colour is the clip's own bottom edge averaged over its last 2% of
     * rows, which is what makes the masked bottom of the clip dissolve into
     * the strip rather than step into it; it then fades out over `--hero-out`.
     */
    .hero-band[data-hero-video] {
      isolation: isolate;
      background: linear-gradient(
        to bottom,
        rgb(46 49 46) 0%,
        rgb(46 49 46) calc(100% - var(--hero-out)),
        transparent 100%
      );
    }
  }

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    /* Columns only: the rows are spaced by `.stats`' own top margin, so that
       one number keeps setting the distance under the buttons. */
    column-gap: clamp(var(--space-5), 4vw, var(--space-12));
    row-gap: 0;
    align-items: center;
    /* The top value is the space above the mark, so it is what sets how high
       the mark sits under the header: ~46px on a wide screen and 24px on a
       phone, where the same number would crowd the bar. The band's own
       padding closes the foot. */
    padding-block: clamp(var(--space-6), 4.4vw, var(--space-12))
      clamp(var(--space-5), 4vw, var(--space-10));
  }
  /*
   * Two columns, two rows: copy and map share the first, the counts have the
   * second to themselves. That is what lands the map's bottom edge on the same
   * line as "Join the Discord": the first row is only as tall as the copy down
   * to the end of the buttons, so `align-self: end` puts the map on that line
   * with no measurement of the counts block and nothing to re-tune if its type
   * ever changes.
   */
  @media (min-width: 821px) {
    .hero-copy {
      grid-column: 1;
      grid-row: 1;
    }
    .hero > .stats {
      grid-column: 1;
      grid-row: 2;
    }
    .hero-map {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
    }
  }
  .hero-title {
    margin: var(--space-2) 0 var(--space-4);
    /* The h1's only child is an image; a line-height on the block would show
       up as unexplained space under it. */
    line-height: 0;
  }
  /* Capped in px rather than left at 100%: the copy column is ~560px at the
     container's cap, and a mark that wide dwarfs the lede and pushes both
     buttons below the fold. */
  .hero-logo {
    display: block;
    width: 100%;
    max-width: 380px;
    height: auto;
  }
  .lede {
    margin: 0 0 var(--space-6);
    max-width: 46ch;
    font-size: clamp(var(--text-base), 2.2vw, var(--text-lg));
    line-height: var(--lh-body);
    color: var(--text-muted);
  }
  /*
   * One row, not two. At 375 the primitive's `--space-5` inline padding made
   * the pair 322px wide in a 349px box once the arrow was counted, so they
   * stacked and spent 57px of the first screen on the wrap. Tightened through
   * the primitive's own custom property rather than by restyling `.btn`; the
   * 44px target height is untouched, and they still wrap if a narrower phone
   * or a larger root font needs them to.
   */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    --btn-pad-inline: var(--space-3);
  }

  /* Four counts on one line at 375: the label is the eyebrow size and the
     columns sit `--space-6` apart, which is 322px against the 349px box. */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    margin: var(--space-8) 0 0;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .stats dt {
    font-family: var(--font-sign);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-sign);
    font-size: var(--display-sm);
    font-weight: 800;
    line-height: 1;
  }

  /* Holds the live map island, which sizes to this box. Square: the card is
     bottom-aligned to the buttons and shares its row with the copy, which runs
     ~560px tall at 1280 against the card's 470, so it grows to the copy's
     height before the hero gets any taller at all. */
  .hero-map {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    /* Map paper, so a tile that has not painted yet reads as loading rather
       than as a hole punched in the band. */
    background: var(--map-canvas);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    /* Leaflet's panes carry z-index 200–700 and `.leaflet-container` is not a
       stacking context of its own; this keeps them inside the card. */
    isolation: isolate;
  }
  .hero-map-fallback {
    position: absolute;
    inset: 0;
    z-index: var(--z-content);
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-2);
    padding: var(--gutter);
    background: var(--map-canvas);
    /* Fixed ink, like `.map-loading`: this sits on map paper, which is light in
       both themes, so `--text` would invert out from under it. */
    color: var(--ink-800);
  }
  .hero-map-fallback strong {
    font-family: var(--font-sign);
    font-size: var(--display-sm);
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-map {
      /* Full width on a phone, a square card would be 345px of map and push
         everything under it off the screen. */
      aspect-ratio: 4 / 3;
      /* Stacked, this is the gap the grid's row gap used to provide. */
      margin-top: clamp(var(--space-5), 4vw, var(--space-12));
    }
    /* Single column, so there is no margin for the art to live in: every
       horizontal band of the hero has text or the map card in it. He moves up
       behind the mark and drops to atmosphere, because full opacity behind
       body copy cannot hold 4.5:1 at every scroll position. */
    .hero-band {
      --art-top: -14px;
      --art-right: -54px;
      --art-bottom: auto;
      --art-w: 208px;
      --art-opacity: 0.16;
    }
  }

  /* --------------------------------------------------------------- board --
   * The panel, bolted over the hero's foot: `--board-overlap` up into the
   * dissolving forest, above the band's content at `--z-content`.
   */
  .board {
    position: relative;
    z-index: var(--z-content);
    margin-block-start: calc(var(--board-overlap) * -1);
  }
  .board-panel {
    /* One step tighter than the default panel, and only here: this is the panel
       whose contents have to clear a phone's fold, and 4px on each of four edges
       is 8px of the budget for nothing the reader can name. */
    --panel-pad: var(--space-4);
  }
  .board-panel .panel-head {
    margin-bottom: var(--space-3);
  }
  /* Wide screens: the board's two posts on a sign across the foot of the
     hero — the next meetup wide with its art, flares narrow beside it —
     inset a step from the container's edges so it reads as bolted over the
     band rather than as the next section starting. */
  @media (min-width: 1000px) {
    .board-panel {
      margin-inline: var(--space-6);
    }
    .board-panel .posts {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      /* Row gap unchanged; the column gets a wider one now that its two
         tracks carry unequal weight. */
      gap: var(--space-6) var(--space-8);
    }
  }
  /* The board's title plate, one step down from `--display-lg`: a name over
     two posts, not the page's heading, which is the wordmark above it. */
  .board-panel .panel-head h2 {
    font-size: var(--display-md);
    line-height: var(--lh-heading);
  }

  /* -------------------------------------------------------- community shot --
   * The GO Fest group shot leads "The community", where production had it,
   * rather than opening the page. The credit rides ON the image (`.figure` +
   * `.credit`) because it is a licence line, not a caption.
   */
  .banner {
    margin: 0 0 var(--space-4);
    display: block;
  }
  .banner picture {
    display: block;
  }
  .banner img {
    display: block;
    width: 100%;
    height: auto;
    /* Matches the tight crop the `<img>` fallback actually serves, so `cover`
       is not cropping an already-cropped frame a second time. */
    aspect-ratio: 1200 / 560;
    max-height: 240px;
    object-fit: cover;
    /* Low, because the people are in the lower two-thirds of the frame. */
    object-position: center 58%;
  }
  /* The `<source>` swaps to the wide crop at exactly this width, so the ratio
     has to swap with it or `cover` starts eating the group. */
  @media (min-width: 900px) {
    .banner img {
      aspect-ratio: 2540 / 740;
      max-height: 300px;
      object-position: center 72%;
    }
  }
  /* The primitive's five-stop ramp does the contrast work; this only sets the
     weight, because the caption names the photograph rather than whispering it. */
  .banner .credit {
    font-family: var(--font-sign);
    font-weight: 700;
  }

  /* ---------------------------------------------------------------- posts --
   * A legend: two numbered posts, readable in any order. The numbers are keys
   * rather than decoration, which is the only thing that earns them here.
   */
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  .post-body {
    /* Long meetup titles and place names live here; a grid child will not
       shrink below its content without this, which is exactly how 169px of
       horizontal overflow shipped once already. */
    min-width: 0;
  }
  .post-lead {
    margin: 0;
    font-family: var(--font-sign);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
  }
  .post-lead--quiet {
    font-size: var(--text-lg);
    color: var(--text-muted);
  }
  .post-line {
    margin: var(--space-1) 0 0;
    font-size: var(--text-md);
    line-height: var(--lh-ui);
  }
  /* The date, under the name it belongs to: full ink rather than muted, because
     it is the second thing the post is for and a grey date reads as a footnote.
     Tabular, like every other number on the board. */
  .post-when {
    font-family: var(--font-sign);
    font-weight: 700;
    color: var(--text);
  }
  .post-muted {
    color: var(--text-muted);
  }
  .post-action {
    margin: var(--space-3) 0 0;
  }
  /* Red, and only here: this link is only rendered when a flare is actually
     burning, so the colour is answering "what is live" rather than "this is a
     link". Every other link on the board is ink with its underline. */
  .post-link--now {
    color: var(--live-text);
    text-decoration-color: currentColor;
  }

  /* The meetup's cover art, folded up into post 1 from the old closing panel:
     a plate beside the words on a wide screen, above them on a phone — same
     picture, same treatment, new address. */
  .post-art {
    overflow: hidden;
    border-radius: var(--radius-sm);
    aspect-ratio: 16 / 9;
    background: var(--bg-sunken);
  }
  .post-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post-text {
    /* Same trap `.post-body` guards against above, one level deeper now that
       post 1 has two children instead of one. */
    min-width: 0;
  }
  /* The place, quieter than the time it sits beside: `.post-when` bolds the
     whole line in signage type, and the place is not the time. */
  .post-where {
    color: var(--text-muted);
    font-family: var(--font-read);
    font-weight: 400;
  }
  /* Post 1 only, and only once it actually has art — see the `nextUp.imageUrl`
     check at the call site. Below 640px the art sits above the text; from
     640px it is a plate beside it. With no art (or no meetup at all) this
     class never lands and the post falls back to plain block flow, same as
     every other post on the board. */
  .post--event .post-body {
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .post--event .post-body {
      grid-template-columns: minmax(180px, 240px) minmax(0, 1fr);
      gap: var(--space-4);
      align-items: start;
    }
  }

  /*
   * A local `.cluster`, and not the primitive, because this page mounts the map
   * island: `MapView.css:257` already owns the global name `.cluster` for the
   * 38px red marker-cluster disc, it is unlayered React-island CSS, and so it
   * beats the primitive everywhere the map is on the page. Two buttons rendered
   * as one red circle. See the cross-file request in the wave report.
   */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  /* --------------------------------------------------------------- panels --
   * The trailing phrase in a panel head is `.caption` now, not `.count`: it is
   * prose beside a heading rather than a tally, and the primitive sizes it. */
  .panel-subhead {
    margin: var(--space-5) 0 var(--space-2);
    font-size: var(--text-md);
    font-weight: 700;
  }
  .panel-subhead:first-of-type {
    margin-top: 0;
  }
  .panel-note {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-md);
  }
  .panel-status {
    margin-top: var(--space-5);
  }
  .panel-links {
    margin: var(--space-4) 0 0;
    font-size: var(--text-md);
    color: var(--text-muted);
  }
  /* The 24px target belongs on the anchors, not on the paragraph around them:
     padding on the `<p>` gave the row its height and left every link 18px tall.
     `.target` does it per anchor. */
  .panel-links a {
    font-weight: 700;
  }

  /* ---------------------------------------------------------------- minis --
   * The bosses, eggs and research rewards themselves, not a sentence about
   * them. Names wrap rather than truncate: "Hisuian Growlithe" clipped to
   * "Hisuian Gro…" loses the only thing the tile was there to say.
   */
  .minis {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* 120px, not 96: at 96 a four-tile strip broke 3 + 1 on a phone and left a
       tile stranded on its own row. 120 gives two columns at the narrowest
       content width this site supports, so four tiles read as a 2 x 2 block. */
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--space-2);
  }
  .mini {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-1);
    min-width: 0;
    padding: var(--space-2) var(--space-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-sunken);
    text-align: center;
  }
  .mini img {
    width: 46px;
    height: 46px;
    object-fit: contain;
  }
  .mini-name {
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: var(--lh-ui);
    /* Wrapping, deliberately: see the note above. */
    overflow-wrap: anywhere;
  }
  .mini-tier {
    font-family: var(--font-sign);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--text-muted);
  }
  /* The shiny mark is the shared `ShinyMark` badge, not a corner sparkle in
     `--poi-campsite` — that measured 1.81:1 on this surface and hid the word
     "shiny" in `sr-only` text, which made colour the only signal for the one
     fact the tile was flagging. It sits in the flow, so nothing overlaps. */
  .mini :global(.g-shiny) {
    margin-top: var(--space-1);
  }

  /* ----------------------------------------------------------------- rows --
   * "Happening now". EventCard already prints the row: a 64px thumbnail, the
   * time as the loudest line, then the title and its source. All this page adds
   * is the list, and the fact that a teaser does not need the blurb.
   */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  /* Posters, two abreast on a wide screen: one 16:9 card across a 1,052px
     band would be 590px tall, a hero rather than a row. */
  @media (min-width: 768px) {
    .rows {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
  .rows :global(.event-blurb) {
    display: none;
  }
  /*
   * The name leads here too, matching post 1 on the board above.
   *
   * `/events` is a calendar and answers "when" first, which is why EventCard is
   * built that way. The home rows are under a heading that has already answered
   * it — "Happening now" — so a card headlining "Sat, Sep 6 · all day" spends
   * its loudest line saying today. The class names are W1-B's contract and are
   * untouched; only the two type sizes swap, so the DOM order, the reading order
   * and the focus order are all unchanged.
   */
  .rows :global(.event-when) {
    font-size: var(--text-md);
    font-weight: 800;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .rows :global(.event-title) {
    font-size: var(--text-xl);
    font-weight: 800;
  }
  .rows-more {
    margin: var(--space-4) 0 0;
  }

  /* --------------------------------------------------------------- photos -- */
  .photos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* 130px keeps two columns down to a 300px-ish content box (320px phones
       included), the width the container's own padding leaves at the narrowest
       viewport this site supports. */
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: var(--space-3);
  }
  .photo {
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }
  .photo img {
    display: block;
    width: 100%;
    /* Tall enough that the credit stays a strip rather than a lid: the ramp
       covers the bottom quarter of the tile and no more. */
    height: 190px;
    object-fit: cover;
  }

  /* ----------------------------------------------------------------- news -- */
  .news {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .news-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  /* Ink on hover, not red: a news row is not "now", and red answering "this is
     hoverable" is exactly the leak the rationed-red rule exists to stop. */
  .news-row:hover {
    border-color: var(--text);
    box-shadow: var(--shadow-sm);
  }
  .news-thumb {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    background: var(--bg-sunken);
  }
  .news-body {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
    min-width: 0;
  }
  /* The date is signage: a date is how a notice board is read. */
  .news-date {
    font-family: var(--font-sign);
    font-size: var(--text-md);
    font-weight: 800;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .news-title {
    font-family: var(--font-sign);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
  }
  .news-row:hover .news-title {
    text-decoration: underline;
  }
  .news-excerpt {
    font-size: var(--text-md);
    line-height: var(--lh-body);
    color: var(--text-muted);
  }

  /* -------------------------------------------------------------- socials --
   * Four tiles on the panel, not four near-black blocks on a light page. Each
   * mark is the brand's own app icon and brings its own background, so there is
   * no chip behind it; the tile is the same sunken surface every other list on
   * this page sits on.
   */
  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-3);
  }
  .social {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-sunken);
    color: var(--text);
    text-decoration: none;
    transition:
      transform var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }
  .social:hover {
    transform: var(--lift);
    border-color: var(--text);
  }
  .social-mark {
    display: grid;
    place-items: center;
    line-height: 0;
  }
  .social-mark svg {
    display: block;
    border-radius: var(--radius-sm);
  }
  .social-text {
    display: grid;
    gap: 1px;
    min-width: 0;
  }
  .social-text strong {
    font-family: var(--font-sign);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: var(--lh-heading);
  }
  .social-text span {
    font-size: var(--text-sm);
    line-height: var(--lh-ui);
    color: var(--text-muted);
  }
  .social-go {
    flex: none;
    color: var(--text-muted);
  }

  /* ------------------------------------------------------------- campsite -- */
  .campsite > :first-child {
    margin-block-start: 0;
  }
  /*
   * The paragraph gap, restored locally.
   *
   * `primitives.css` sets `.prose > * + * { margin-block-start: var(--space-4) }`
   * at (0,1,0) and then `.prose p { margin-block: 0 }` at (0,1,1), so the second
   * rule wins on specificity and every `.prose` on the site runs its paragraphs
   * together with no space between them. This is a scoped, unlayered rule, so it
   * beats both — but the real fix belongs in the primitive. See the wave report.
   */
  .campsite p + p {
    margin-block-start: var(--space-4);
  }
  /* The drawn star sits on the text baseline in the middle of a sentence. */
  .inline-star {
    vertical-align: -2px;
    color: var(--poi-campsite-text);
  }

  /* --------------------------------------------------------- calendar art --
   * Mew, drifting, at the foot of the calendar. An animated WebP in the band's
   * `::after`, so reduced motion swaps the file for one frame — there is
   * nothing to pause on a background image. From 768px he stands beside the
   * credit, which keeps to its measure and leaves the band's right side empty;
   * below that the credit runs the full width, so the band opens a strip under
   * it for him to stand in, bottom-left, mirrored to face in.
   */
  .calendar-band {
    --art-src: url('/art/mew-anim.webp');
    --art-ratio: 0.708; /* 255x360, trimmed */
    --art-flip: -1;
    --art-left: calc(-1 * clamp(8px, 2vw, 16px));
    --art-bottom: 0;
    --art-w: clamp(110px, 30vw, 130px);
    /* The strip: his own height plus a little ground under the credit. */
    padding-bottom: calc(var(--art-w) / 0.708 + var(--space-3));
  }
  @media (min-width: 768px) {
    .calendar-band {
      --art-flip: 1;
      --art-left: auto;
      --art-right: calc(max(0px, (100% - var(--container)) / 2) + var(--gutter));
      --art-w: clamp(110px, 11vw, 150px);
      padding-bottom: 0;
    }
  }

  /* --------------------------------------------------------- campsite art --
   * Magikarp, flopping, beside the Campsite panel. Pixel art at its trimmed
   * 384x369, scaled with NEAREST when it was made (see DESIGN.md provenance).
   * The panel is opaque and the art sits behind everything at z −1, so he can
   * never stand on the panel: from 900px the panel narrows to its measure and
   * he takes the room it leaves on the right; below that the band opens a strip
   * under the panel, bottom-right, bled a little off the edge.
   */
  .campsite-band {
    --art-src: url('/art/magikarp-anim.webp');
    --art-ratio: 1.04;
    --art-right: calc(-1 * clamp(16px, 5vw, 36px));
    --art-bottom: 0;
    --art-w: clamp(150px, 40vw, 190px);
    padding-bottom: calc(var(--art-w) / 1.04 + var(--space-2));
  }
  @media (min-width: 900px) {
    .campsite-band {
      --art-right: calc(max(0px, (100% - var(--container)) / 2) + var(--gutter));
      --art-w: clamp(180px, 20vw, 240px);
      padding-bottom: 0;
    }
    /* The prose already stops at its 60ch measure; the panel now stops with
       it, and the fish has the 280px that were empty panel. */
    .campsite {
      max-width: calc(100% - 280px);
    }
  }

  /*
   * One frame each under reduced motion.
   *
   * These sit BELOW the base rules on purpose: a media query adds no
   * specificity, so `.calendar-band` here and `.calendar-band` above are an
   * exact tie decided by source order. Above them, this block would lose and
   * quietly do nothing — which is precisely how the old Magikarp swap shipped
   * dead for a month.
   */
  @media (prefers-reduced-motion: reduce) {
    .calendar-band {
      --art-src: url('/art/mew-still.webp');
    }
    .campsite-band {
      --art-src: url('/art/magikarp-still.webp');
    }
  }

  /* Every transform on this page goes through `--lift`, which global.css sets
     to `none` under reduced motion, so that escape is structural rather than
     remembered. The transitions above are duration-only and the blanket
     reduced-motion rule zeroes them. */
</style>
