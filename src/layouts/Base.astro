---
import '~/styles/global.css';
import '~/styles/primitives.css';
import PokeBall from '~/components/PokeBall.astro';
import SocialIcon from '~/components/SocialIcon.astro';
import { SOCIALS, DISCORD_INVITE } from '~/lib/socials';

interface Props {
  title: string;
  description?: string;
  /** Full-bleed pages (the map) manage their own scrolling. */
  fullBleed?: boolean;
  ogImage?: string;
  /**
   * Open Graph type. Pages set this rather than emitting their own `og:type`
   * into the head slot — two conflicting tags is worse than one wrong one,
   * since scrapers pick between them unpredictably.
   */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'PoGo TXK: the Pokémon GO community for Texarkana, Texas and Arkansas. Spring Lake Park Campsite map, meetups, raids, and community news.',
  fullBleed = false,
  ogImage = '/og-default.png',
  ogType = 'website',
} = Astro.props;

const fullTitle = title === 'PoGo TXK' ? title : `${title} | PoGo TXK`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

/**
 * Primary navigation.
 *
 * `/live` earns a slot: it is the realtime flare board, one of the reasons the
 * site exists, and it was previously reachable only from a card on the home
 * page. `/eggs` and `/research` deliberately do NOT get slots — they link to
 * each other and to `/raids` through GameNav, which covers the set without
 * pushing this list to nine items.
 *
 * Order follows the day: where we are, when we meet, what is happening now.
 */
const nav = [
  { href: '/', label: 'Home' },
  { href: '/map', label: 'Map' },
  { href: '/events', label: 'Events' },
  { href: '/live', label: 'Live' },
  { href: '/raids', label: 'Raids' },
  { href: '/blog', label: 'News' },
  { href: '/go', label: 'Go', highlight: true, describe: 'the PoGo TXK app' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* The bar's own red, as a literal. A meta attribute cannot read a CSS
        custom property, and the browser paints its window chrome with this
        before any stylesheet exists. Keep it equal to `--accent-solid`. */}
    <meta name="theme-color" content="#c8071c" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="PoGo TXK" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, canonical)} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* The two faces the first paint needs, requested before the stylesheet is
        parsed rather than after it: measured, the woff2 requests started at
        603ms behind CSS parse and every H1 flashed in system-ui on a cold load.
        The italic is not preloaded; the browser fetches it only if italic text
        appears. Same-origin, so no preconnect. */}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/overpass-wght.woff2" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/atkinson-hyperlegible-next-wght.woff2"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="PoGo TXK" />
    <!-- Every page can be added to an iOS home screen, not just /go — without
         these, iOS falls back to a screenshot of whatever page was open. -->
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    {/* Per-page head additions — feed autodiscovery, article metadata, noindex.
        Without this slot, any <Fragment slot="head"> a page declares is
        silently dropped, which is invisible in the browser and only shows up
        as missing metadata in a scraper. */}
    <slot name="head" />
  </head>

  <body class={fullBleed ? 'is-full-bleed' : ''}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      {/*
        The brand is typeset, not an image.

        The wordmark raster (`/art/logo-txk-classic.webp`) stacks three tiers of
        lettering into a square, so inside a bar this height it renders about
        62px wide and "TEXARKANA" is a smudge under the "GO". It stays a brand
        asset for OG images and app icons; here the mark and the name are set
        instead, which reads at a glance and scales with the reader's own font
        size. The owner released the header from the raster on 2026-09-01.

        The link's accessible name is unchanged: the ball is decorative and the
        span carries the words.
      */}
      <a class="brand" href="/">
        <PokeBall size={30} class="brand-ball" />
        <span class="brand-name">PoGo TXK</span>
      </a>

      {/*
        The menu, below 820px only, where the nav collapses into a panel.

        A drawn mark with the word beside it. It used to be a second Poké Ball,
        two inches from the brand's — the same mark meaning two different things
        in one bar, so the ball stopped meaning the brand. Three stacked ink
        rules instead: the same 2px rule this world draws under every panel head,
        which is a mark from the board rather than a borrowed hamburger. The ball
        stays the brand, once, on the left.

        Sits before the nav in source order deliberately: with the panel closed
        the links are `display: none` and out of the tab order entirely, and
        with it open Tab moves straight from the button into them. That is the
        whole focus management this needs, with no trapping and nothing to get
        wrong.
      */}
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Open menu"
      >
        <svg
          class="nav-toggle-mark"
          viewBox="0 0 20 14"
          width="20"
          height="14"
          aria-hidden="true"
          focusable="false"
        >
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="square"
            d="M1 1h18M1 7h18M1 13h18"
          />
        </svg>
        <span class="nav-toggle-label">Menu</span>
      </button>

      <nav id="primary-nav" aria-label="Primary">
        <ul>
          {
            nav.map((item) => (
              <li>
                {/*
                  "Go" is a word now, in the black chip, rather than a third
                  Poké Ball in a bar that already has two. A mark on its own told
                  a sighted visitor nothing, and it was the same mark as the menu
                  button a few pixels away.

                  The longer name rides in an `sr-only` span rather than an
                  `aria-label`. "Go" alone reads as a verb with no object, and a
                  screen-reader user pulling up a list of links sees it beside
                  "Map" and "Events" with no way to tell what it does.
                  `aria-label` fixes that for assistive tech but leaves
                  `textContent` as "Go", which is what Lighthouse's link-text
                  audit reads, so it kept failing while looking fixed. This way
                  the name is descriptive for both, and it still *starts* with
                  the visible word, so speech input users saying "click Go" match
                  (WCAG 2.5.3).

                  The disc before the current item is drawn in CSS, not here: it
                  is decoration for a state the markup already carries in
                  `aria-current`.
                */}
                <a
                  href={item.href}
                  class:list={[item.highlight && 'nav-highlight']}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  {item.describe && <span class="sr-only">, {item.describe}</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/*
        The same four links as the home page's "Find us", from the same source:
        see `~/lib/socials`. Marks only, because there is no room for labels
        beside seven nav items, and these are four icons a member already
        recognises. The 28px box around each 22px glyph is what carries them
        over the 24px target floor.

        After the nav, not tucked against the brand where they used to sit. That
        is a source order change rather than a CSS one on purpose: they are
        anchored to the right edge now, and reordering them visually with `order`
        would leave a keyboard user tabbing brand -> socials -> nav while the eye
        reads brand -> nav -> socials. Moving the markup keeps the two in step.

        Still before nothing important: the Poké Ball toggle stays immediately
        ahead of the nav it opens, which is the adjacency its own note below
        depends on.

        `aria-label` goes on the link and the mark stays decorative. Naming both
        would have a screen reader announce "Discord Discord" — the exact trap
        SocialIcon's `decorative` prop documents.
      */}
      {/*
        The socials and the account control share the right-hand zone, and the
        wrapper is what carries the `flex: 1 1 0` that used to sit on the list
        itself. That matters: the nav is centred by the two side zones being
        equal, so hanging the account control off the end as a third sibling
        would have shifted the nav left by exactly its width.
      */}
      <div class="header-right">
        <ul class="header-socials">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  href={social.href}
                  rel="noopener noreferrer"
                  target="_blank"
                  aria-label={`${social.label} (opens in a new tab)`}
                >
                  <SocialIcon name={social.name} size={22} bare />
                </a>
              </li>
            ))
          }
        </ul>

        {/*
          Filled in by the script below rather than rendered here, because four
          pages under this layout are prerendered (/conduct, /privacy, /terms,
          /offline). On those, `Astro.locals.user` is whatever it was at BUILD
          time — which is nobody, forever. A server-rendered control would tell
          a signed-in member they are signed out on a quarter of the site.

          Starts empty and unlabelled so nothing flashes before we know the
          answer; `hidden` comes off once it has something true to say.
        */}
        <div class="header-account" data-account hidden></div>
      </div>
    </header>

    <script is:inline>
      // Bring the current page's nav chip into view when the row is scrollable,
      // so /gallery does not open with its own tab off the right edge.
      // `instant` because a visible scroll animation on load reads as a glitch.
      //
      // Below 820px the row is a hidden column instead, where both measurements
      // are 0 and the condition is simply false — so this needs no breakpoint of
      // its own.
      (() => {
        const current = document.querySelector('.site-header nav a[aria-current="page"]');
        if (!current) return;
        const row = current.closest('ul');
        if (row && row.scrollWidth > row.clientWidth) {
          current.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'instant' });
        }
      })();

      // The Poké Ball menu.
      (() => {
        const btn = document.querySelector('.nav-toggle');
        const nav = document.getElementById('primary-nav');
        if (!btn || !nav) return;

        const isOpen = () => btn.getAttribute('aria-expanded') === 'true';
        const setOpen = (open) => {
          btn.setAttribute('aria-expanded', String(open));
          // The label is the button's whole accessible name, so it has to say
          // what the next press does, not what the icon is.
          btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          nav.toggleAttribute('data-open', open);
        };

        btn.addEventListener('click', () => setOpen(!isOpen()));

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && isOpen()) {
            setOpen(false);
            btn.focus();
          }
        });

        // Tapping the page behind it should close it. The button's own click is
        // already handled above; letting it fall through here would toggle twice
        // and the menu would never open.
        document.addEventListener('click', (e) => {
          if (!isOpen()) return;
          if (btn.contains(e.target) || nav.contains(e.target)) return;
          setOpen(false);
        });

        // Above the breakpoint the panel rules stop applying and the row is
        // visible regardless. Without this, `data-open` would survive the
        // resize and the menu would spring open again on the way back down.
        window
          .matchMedia('(min-width: 821px)')
          .addEventListener('change', (e) => e.matches && setOpen(false));
      })();
    </script>

    <script is:inline>
      /*
       * The account control.
       *
       * Built here rather than server-rendered because four pages under this
       * layout are prerendered, and on those the server's idea of "who is
       * signed in" is frozen at build time. One fetch is the honest answer.
       *
       * Everything is built with createElement and textContent. A Discord
       * display name is chosen by its owner and arrives from an API, so it is
       * untrusted string data — innerHTML here would be a stored XSS on every
       * page of the site.
       */
      (() => {
        const root = document.querySelector('[data-account]');
        if (!root) return;

        const el = (tag, props) => Object.assign(document.createElement(tag), props);
        // Where to come back to. Deliberately not the hash — it never reaches
        // the server, and `safeNext` would be judging a string it cannot see.
        const here = location.pathname + location.search;
        const next = encodeURIComponent(here);

        // The primitives are written into the markup here because these nodes
        // never pass through Astro. `.btn .btn--sm .btn--outline` is the shared
        // pill; the `.account-*` classes beside it carry only what the header
        // adds to it (white on the red bar, the pill radius, the hit area).
        const signedOut = () => {
          root.append(
            el('a', {
              className: 'account-signin btn btn--sm btn--outline',
              href: '/auth/login?next=' + next,
              textContent: 'Sign in',
            }),
          );
        };

        const signedIn = (user) => {
          const details = el('details', { className: 'account-menu' });
          const summary = el('summary', {
            className: 'account-summary btn btn--sm btn--outline',
          });
          summary.setAttribute('aria-label', 'Account menu');

          if (user.avatarUrl) {
            summary.append(
              el('img', {
                className: 'account-avatar',
                src: user.avatarUrl,
                alt: '',
                width: 22,
                height: 22,
                loading: 'lazy',
                decoding: 'async',
              }),
            );
          } else {
            summary.append(el('span', { className: 'account-avatar' }));
          }
          summary.append(
            el('span', {
              className: 'account-name',
              textContent: user.displayName || user.username || 'Account',
            }),
          );

          // Session actions, plus one link out. Who is signed in is already
          // the summary's own avatar and name; a menu that opens over it
          // should hold actions, not repeat that back as prose. Delete stays
          // a link to its own confirmation page rather than a raw button
          // here — this menu is not the place to put something irreversible
          // one misclick away.
          const panel = el('div', { className: 'account-panel panel' });
          panel.append(
            el('a', { href: '/auth/logout?next=' + next, textContent: 'Sign out' }),
            // Signing out here does not sign out of Discord — this is the only
            // way off an account picked by mistake. See commit 4e12bcb.
            el('a', {
              href: '/auth/logout?switch=1&next=' + next,
              textContent: 'Use a different Discord account',
            }),
            el('a', { href: '/account/delete', textContent: 'Delete my account' }),
          );

          details.append(summary, panel);
          root.append(details);

          // A menu that will not close is worse than no menu.
          document.addEventListener('click', (e) => {
            if (details.open && !details.contains(e.target)) details.open = false;
          });
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && details.open) {
              details.open = false;
              summary.focus();
            }
          });
        };

        fetch('/api/me.json', { credentials: 'same-origin', headers: { accept: 'application/json' } })
          .then((res) => (res.ok ? res.json() : null))
          .then((data) => {
            if (!data) return; // Stay hidden rather than assert either state.
            data.user ? signedIn(data.user) : signedOut();
            root.hidden = false;
          })
          .catch(() => {
            /* Offline, or the endpoint is unreachable. Showing "Sign in" to
               someone who is signed in would be a lie, and showing nothing
               costs them only this shortcut — /go and /live still have theirs. */
          });
      })();
    </script>

    {/*
      Not `is:inline`, deliberately — this one needs a real import, and it is
      the only script here that does.

      Inside the installed app, sign-in has to leave for the trainer's own
      browser or Discord shows a password form to someone already signed into
      Discord one app away. The reasoning is in signin-surface.ts; the reason
      it is delegated from the document is that the account control above is
      built at runtime by an inline script that cannot import anything, and a
      second copy of the intent URL would drift from the first.

      Deferred by nature, which is fine: it only has to be listening before a
      human can tap, and it does nothing at all outside an installed app.
    */}
    <script>
      import { attachSignInHandoff } from '~/lib/auth/signin-surface';
      attachSignInHandoff(document);
    </script>

    <main id="main">
      <slot />
    </main>

    {
      !fullBleed && (
        <footer class="site-footer">
          {/*
            The board's foot. It repeats the header's plate at the bottom of
            the page, so the chrome closes with the same mark it opened with,
            and the fan-use notice sits under it as the fine print it is.

            `variant="neutral"` gives the mark a dark ring rather than the
            header's white one: `--bg-sunken` is not the header's known red in
            either theme, and a white ring would erase itself here in light
            mode.

            The footer stays chrome. The ask belongs to the page above it, and
            every page ends on its own.
          */}
          <p class="footer-brand">
            <PokeBall size={22} variant="neutral" /> PoGo TXK
          </p>
          <p class="footer-legal">
            Pokémon GO Texarkana. A fan site, run by players. Not affiliated with Niantic,
            Nintendo, Creatures or GAME FREAK, and not endorsed by them. Pokémon and its
            trademarks are ©1995–2026 Nintendo, Creatures and GAME FREAK. All images and names
            owned or trademarked by Nintendo, Niantic, The Pokémon Company and GAME FREAK are
            the property of their respective owners.
          </p>
          <p class="footer-links">
            <a class="target" href="/about">About</a> ·{' '}
            <a class="target" href="/conduct">Code of Conduct</a> ·{' '}
            <a class="target" href="/terms">Terms</a> ·{' '}
            <a class="target" href="/privacy">Privacy</a> ·{' '}
            <a
              class="target"
              href={DISCORD_INVITE}
              rel="noopener noreferrer"
              target="_blank">Discord</a
            >
          </p>
        </footer>
      )
    }

    <style>
      /*
       * Sticky footer. On a short page the footer was rendering immediately
       * after the content and leaving bare background beneath it — 115px on
       * /live, 220px on /blog — which reads as the page having been cut off.
       *
       * `flex: 1 0 auto` on main, not `1 1 auto`: main must grow to fill a
       * short page but must never shrink below its content on a long one.
       *
       * vh first, dvh second, so browsers without dvh still get the behaviour
       * and those with it avoid the mobile URL-bar jump.
       */
      body {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }
      body > main {
        flex: 1 0 auto;
      }

      /* Overrides the min-height above with a hard height: these screens own
         the viewport and scroll internally rather than as a document. */
      body.is-full-bleed {
        height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      body.is-full-bleed main {
        flex: 1;
        min-height: 0;
      }

      /* ------------------------------------------------------------- header --
       *
       * The board's title bar. The Poké Ball read across the top of every page:
       * the red top, the black band under it, and the white page below.
       */
      .site-header {
        /*
         * The bar is a known deep red in both themes, so its foreground is
         * pinned rather than themed. Three raw values, and they are raw on
         * purpose because they are measured against this gradient and nothing
         * else:
         *
         *   --header-fg     white on the gradient's lightest stop: 5.99:1
         *   --header-fg-2   0.9 white on its darkest stop:         4.92:1
         *   --header-line   a hairline, never text
         *
         * 0.82 white was 4.34:1 and already under AA before it was raised.
         * Nothing here goes below 0.9.
         */
        --header-fg: #ffffff;
        --header-fg-2: rgb(255 255 255 / 0.9);
        --header-line: rgb(255 255 255 / 0.34);
        --header-wash: rgb(255 255 255 / 0.14);
        /* The 1px lit edge along the top, kept in a property because the
           elevation keyframe below has to repeat it: a `box-shadow` animation
           replaces the whole list, not one layer of it. */
        --header-lit-edge: inset 0 1px 0 rgb(255 255 255 / 0.18);

        display: flex;
        align-items: center;
        gap: var(--space-4);
        /*
         * The public header's height, and the one number the `:target`
         * scroll-margin in global.css is derived from, so the two can no longer
         * drift. Deliberately NOT `--header-h`: that token is the admin bar's
         * 60px and belongs to Admin.astro.
         */
        height: var(--header-public-h);
        padding-inline: var(--gutter);
        color: var(--header-fg);
        /*
         * Flat red read as a coloured strip rather than as part of the ball.
         * The bar darkens toward the black band, which is how a curved surface
         * behaves above a shadow line.
         *
         * Only ever *darker* than `--accent-solid`, never lighter, and that is
         * a contrast constraint rather than taste: the nav labels are 0.9 white
         * on this. Lifting the mid band even 7% takes them to 4.5:1 and a
         * little further puts them under AA.
         */
        background: linear-gradient(
          180deg,
          var(--accent-solid) 0%,
          var(--accent-solid) 58%,
          /* The band's shadow side. A measured end stop rather than a palette
             step: it exists only as this gradient's foot and appears nowhere
             else on the site. */ #b00518 100%
        );
        box-shadow: var(--header-lit-edge);
        /*
         * The Poké Ball's band. Red above, white below, and this is the line
         * between them: solid black and deliberately thick, because on the ball
         * it is the heaviest part of the design, not a hairline.
         */
        border-bottom: 4px solid var(--ink-900);
        position: sticky;
        top: 0;
        z-index: var(--z-sticky-header);
      }

      /*
       * Lifts off the page once it stops sitting on it. A sticky bar with no
       * elevation reads as painted onto the content it is covering.
       *
       * Scroll-driven, so no listener and no class toggling. Without support
       * the header simply never gains the shadow, which is exactly the header
       * we had.
       */
      @supports (animation-timeline: scroll()) {
        .site-header {
          animation: header-elevate linear both;
          animation-timeline: scroll();
          animation-range: 0 var(--header-public-h);
        }
        @keyframes header-elevate {
          to {
            box-shadow:
              var(--header-lit-edge),
              0 8px 20px -6px rgb(0 0 0 / 0.45);
          }
        }
        /*
         * This one needs its own reduced-motion escape, and the escape has to
         * land on the *resting* state.
         *
         * The blanket rule in global.css forces every animation to 0.01ms. For
         * a normal animation that is the whole fix. For a scroll-timeline
         * animation with `fill: both` it is the opposite of a fix: the
         * animation is not driven by time at all, so flattening the duration
         * only makes it jump straight to the keyframe's END state, and the
         * header sits at the top of an unscrolled page wearing a drop shadow it
         * has not earned. Cancelling the animation by name is what actually
         * stops it, and the resting shadow is restored beside it.
         */
        @media (prefers-reduced-motion: reduce) {
          .site-header {
            animation: none;
            box-shadow: var(--header-lit-edge);
          }
        }
      }

      /* --------------------------------------------------------------- brand --
       * The mark and the name, set rather than drawn. `1 1 0` makes this and
       * `.header-right` split the leftover width evenly, so the nav lands on the
       * bar's true centre rather than near it.
       */
      .brand {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: var(--space-2);
        color: inherit;
        text-decoration: none;
      }
      .brand-name {
        font-family: var(--font-sign);
        font-size: var(--text-xl);
        font-weight: 800;
        letter-spacing: var(--tracking-tight);
        line-height: 1;
        color: var(--header-fg);
        white-space: nowrap;
      }
      /* `:global` on the ball, and it is required rather than stylistic: the
         mark renders with PokeBall.astro's scope, so a scoped selector here
         compiles to an attribute the SVG does not carry and silently matches
         nothing. */
      .brand :global(.brand-ball) {
        flex: none;
      }

      /* ----------------------------------------------------------------- nav --
       *
       * `min-width: 0` is what makes the `overflow-x: auto` below actually work.
       *
       * A flex item defaults to `min-width: auto`, which refuses to shrink below
       * its content. Without this the nav stayed its full width, the header grew
       * past the viewport, and every page scrolled sideways on a phone: 169px of
       * overhang at 375px, on all twelve routes. Do not remove it.
       */
      .site-header nav {
        min-width: 0;
        position: relative;
        /* The nav takes exactly its own width and the two side zones split
           whatever is left, which is what centres it on the bar. */
        flex: 0 0 auto;
      }

      nav ul {
        display: flex;
        gap: var(--space-1);
        margin: 0;
        padding: 0;
        list-style: none;
        overflow-x: auto;
        scrollbar-width: none;
        /* Deliberately not `justify-content: flex-end`: when a flex row
           overflows, end-alignment can push the first items past the start edge
           where no amount of scrolling reaches them. The current item is brought
           into view by script instead, which degrades to "starts at Home". */
        overscroll-behavior-x: contain;
        scroll-padding-inline: var(--space-3);
        /* Room for a focus ring. `overflow-x: auto` forces `overflow-y` to auto
           as well, so a 3px ring at a 2px offset was being clipped top and
           bottom by the scroll box itself. */
        padding-block: var(--space-2);
      }
      nav ul::-webkit-scrollbar {
        display: none;
      }
      nav li {
        flex: 0 0 auto;
      }

      /*
       * Fades the left edge while the row is scrolled, so it reads as "there is
       * more back that way" rather than as a nav that starts at "Events".
       * `mask-image` rather than an overlaid gradient: the header is a solid
       * colour on some pages and sits over content on others, and a mask needs
       * no knowledge of what is behind it.
       */
      @supports (animation-timeline: scroll(self inline)) {
        nav ul {
          animation: nav-fade-start linear both;
          animation-timeline: scroll(self inline);
          animation-range: 0 24px;
        }
        /* `#000` here is a mask's alpha, not a colour: opaque black means "keep
           this pixel". It is never painted and cannot be tokenised. */
        @keyframes nav-fade-start {
          from {
            mask-image: linear-gradient(to right, #000 0, #000 100%);
          }
          to {
            mask-image: linear-gradient(to right, transparent 0, #000 22px, #000 100%);
          }
        }
        /* Same escape as the header's, and for the same reason: flattening the
           duration would leave the row permanently faded at its start edge. */
        @media (prefers-reduced-motion: reduce) {
          nav ul {
            animation: none;
            mask-image: none;
          }
        }
      }

      nav a {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        min-height: 32px;
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-pill);
        color: var(--header-fg-2);
        text-decoration: none;
        font-family: var(--font-sign);
        font-size: var(--text-md);
        font-weight: 700;
        white-space: nowrap;
        /* Transparent at rest so the chip's box never shifts when the border
           appears on hover. */
        border: 1px solid transparent;
        transition:
          background-color var(--dur-2) var(--ease-out),
          border-color var(--dur-2) var(--ease-out),
          color var(--dur-2) var(--ease-out);
      }
      nav a:hover {
        background: var(--header-wash);
        border-color: var(--header-line);
        color: var(--header-fg);
      }

      /*
       * The focus ring, for everything standing on the red field.
       *
       * The global ring is `outline: 3px solid var(--accent)`, and on this bar
       * in light mode `--accent` *is* the bar: #c8071c on #c8071c, an invisible
       * focus indicator on the brand and all seven nav items. White is the only
       * value that holds against both stops of the gradient and against the
       * white current-page chip, which the 2px offset separates it from.
       */
      .site-header a:focus-visible,
      .nav-toggle:focus-visible {
        outline: 3px solid var(--header-fg);
        outline-offset: 2px;
      }

      /*
       * You Are Here, translated for a red field.
       *
       * On the map the marker is a red disc ringed in ink. The bar is already
       * red, so the plate inverts: a white sign with the same disc printed on
       * it. Shape and position as well as hue, and `aria-current` carries the
       * state for anything that can read neither.
       *
       * `--accent-solid`, not `--accent`: this is dark text on a white chip, and
       * in dark mode `--accent` is the *light* red meant for the opposite job.
       * It measured 3.0:1 here.
       */
      nav a[aria-current='page'] {
        background: var(--header-fg);
        color: var(--accent-solid);
        border-color: var(--header-fg);
        /* The selected chip is the one thing on the bar that should look like it
           is sitting on top of it rather than in it. */
        box-shadow: 0 2px 6px rgb(0 0 0 / 0.28);
      }
      nav a[aria-current='page']::before {
        content: '';
        flex: none;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--accent-solid);
        /* The band's ink, as a ring. Drawn with a shadow rather than a border so
           the disc keeps its 10px and the ring costs no layout. */
        box-shadow: 0 0 0 2px var(--ink-900);
      }
      nav a[aria-current='page']:hover {
        background: var(--header-fg);
        color: var(--accent-solid);
      }

      /*
       * The quick-action screen is the point of the whole site on a phone, so it
       * earns a bit of weight in the nav.
       *
       * Black, the Poké Ball's band, rather than a second colour. It also has to
       * stay distinct from `[aria-current]`, which is a *white* chip: white here
       * would look permanently selected.
       *
       * It is a word rather than a mark. As a bare Poké Ball it told a sighted
       * visitor nothing, and it was the same mark as the menu button beside it.
       */
      nav a.nav-highlight {
        background: var(--ink-900);
        color: var(--header-fg); /* white on --ink-900: 18.4:1 */
        border-color: var(--ink-900);
        box-shadow: 0 2px 6px rgb(0 0 0 / 0.32);
      }
      nav a.nav-highlight:hover {
        background: var(--ink-900);
        border-color: var(--header-line);
        color: var(--header-fg);
      }
      nav a.nav-highlight[aria-current='page'] {
        background: var(--header-fg);
        color: var(--accent-solid);
        border-color: var(--header-fg);
      }

      /* ------------------------------------------------------------ the menu --
       * Hidden until the panel breakpoint below takes over. The ball carries the
       * brand, so on its own it could not also mean "menu"; the word is what
       * separates them, and it is what a sighted visitor reads.
       */
      .nav-toggle {
        display: none;
        align-items: center;
        gap: var(--space-2);
        min-height: 44px;
        padding: var(--space-1) var(--space-3);
        border: 1px solid var(--header-line);
        border-radius: var(--radius-pill);
        background: transparent;
        color: inherit;
        font-family: var(--font-sign);
        font-size: var(--text-md);
        font-weight: 700;
        cursor: pointer;
        transition:
          background-color var(--dur-2) var(--ease-out),
          border-color var(--dur-2) var(--ease-out);
      }
      .nav-toggle-label {
        color: var(--header-fg);
        line-height: 1;
      }
      .nav-toggle:hover {
        background: var(--header-wash);
        border-color: var(--header-fg);
      }
      /* Open reads as the chip lighting up. The three rules stay three rules —
         collapsing them into an X is a different icon system's idiom, and this
         one keeps the word "Menu" beside it either way. */
      .nav-toggle[aria-expanded='true'] {
        background: var(--header-wash);
        border-color: var(--header-fg);
      }
      /* The three ink rules, at the header's own foreground. */
      .nav-toggle-mark {
        display: block;
        flex: none;
        color: var(--header-fg);
      }

      /* ---------------------------------------------------------- right zone --
       * The socials and the account control share the right-hand zone, and the
       * wrapper is what carries the `flex: 1 1 0` that used to sit on the list
       * itself. That matters: the nav is centred by the two side zones being
       * equal, so hanging the account control off the end as a third sibling
       * would have shifted the nav left by exactly its width.
       */
      .header-right {
        flex: 1 1 0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: var(--space-3);
        /* Never let the account name push the nav around; it truncates. */
        min-width: 0;
      }
      .header-socials {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: var(--space-1);
        flex: 0 0 auto;
      }
      /*
       * 28px boxes around 22px marks. The glyphs were their own hit area at
       * 22px, one pixel under the 24px floor for a standalone control (WCAG 2.2
       * SC 2.5.8); the box is what clears it, and it is drawn nowhere.
       */
      .header-socials a {
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        /* The marks are bare glyphs here, so this is what colours them:
           `currentColor` inside the SVG resolves against it. Under full white at
           rest so they read as secondary to the brand plate. */
        color: var(--header-fg-2);
        border-radius: var(--radius-xs);
        transition:
          transform var(--dur-2) var(--ease-out),
          color var(--dur-2) var(--ease-out);
      }
      .header-socials a:hover {
        color: var(--header-fg);
        transform: var(--lift);
      }
      .header-socials svg {
        display: block;
      }

      /* ------------------------------------------------------------- footer --
       * The board's foot: the same plate the header opens with, then the fine
       * print, then the five standing links. Chrome only; the ask belongs to the
       * page above it.
       */
      .site-footer {
        padding: var(--space-8) var(--gutter);
        border-top: 1px solid var(--border);
        background: var(--bg-sunken);
        color: var(--text-muted);
      }
      .site-footer p {
        max-width: var(--measure);
        margin: 0 auto var(--space-3);
      }
      .footer-brand {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        margin-bottom: var(--space-5);
        font-family: var(--font-sign);
        font-size: var(--text-lg);
        font-weight: 800;
        letter-spacing: var(--tracking-tight);
        color: var(--text);
      }
      .footer-legal {
        font-size: var(--text-xs);
        line-height: var(--lh-body);
      }
      .footer-links {
        text-align: center;
        font-size: var(--text-sm);
      }

      /* ------------------------------------------------------- breakpoints -- */

      /* `--header-public-h` steps to 64px at this width in global.css, so the
         bar follows on its own; only the name has to come down with it. */
      @media (max-width: 430px) {
        .brand-name {
          font-size: var(--text-lg);
        }
      }

      /* The marks are a desktop affordance and nothing more. They cost roughly
         130px, and a squeezed nav does not overflow the header, it just scrolls,
         so keeping them on a phone would quietly shrink the primary navigation
         to pay for a secondary one. The home page's "Find us" carries the same
         four links, from the same source, so nothing is lost by dropping them. */
      @media (max-width: 1024px) {
        .header-socials {
          display: none;
        }
      }

      /*
       * Below 820px the nav stops being a scrolling row and becomes a panel
       * behind the menu button.
       *
       * 820 rather than the ~590 where the row actually starts to overflow: that
       * is where the rest of the page already goes single-column, and a header
       * that reflows on a different boundary from the content under it reads as
       * a bug. It also means the row is never cramped, because it is replaced
       * before it has to scroll at all.
       *
       * The panel is positioned against `.site-header`, which is sticky and
       * therefore already a containing block. It sits inside the header's
       * stacking context, so it covers the map on the full-bleed pages too.
       */
      @media (max-width: 820px) {
        .nav-toggle {
          display: inline-flex;
          margin-left: auto;
        }

        .site-header nav {
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          /* It is out of flow now, so the auto margin that kept the row right
             would do nothing but confuse the next reader. */
          margin-left: 0;
          background: var(--accent-solid);
          border-bottom: 4px solid var(--ink-900);
          box-shadow: var(--shadow-lg);
          display: none;
        }
        .site-header nav[data-open] {
          display: block;
        }

        .site-header nav ul {
          flex-direction: column;
          align-items: stretch;
          /* The row's horizontal scroll has nothing to do here, and leaving it
             on clips the chips' focus rings. */
          overflow: visible;
          gap: var(--space-1);
          padding: var(--space-2) var(--gutter) var(--space-4);
        }
        .site-header nav li {
          width: 100%;
        }
        nav a {
          min-height: 44px;
          padding: var(--space-3) var(--space-4);
          font-size: var(--text-base);
        }
      }
    </style>

    <style is:global>
      /* ---------------------------------------------------- browser surfaces --
       *
       * The parts of the page nobody draws still belong to the design. These
       * four ship with defaults that belong to no design system: a blue
       * selection, a black caret, a platform-blue form control, and an underline
       * sitting on the baseline through every descender.
       *
       * Here rather than in global.css because they are chrome, and the chrome
       * is this file's job.
       */
      ::selection {
        background: var(--accent-solid);
        color: #fff; /* white on --accent-solid: 5.99:1, both themes */
      }
      :root {
        /* Checkboxes, radios and range thumbs. `--accent-solid` because the
           browser paints white marks on this and it must not lift in dark. */
        accent-color: var(--accent-solid);
        /* The caret is a line on the page background, not a fill, so it takes
           the theme-aware red. */
        caret-color: var(--accent);
      }
      @layer reset {
        a {
          /* `from-font` where the face publishes a thickness, so the rule keeps
             the weight the type designer drew rather than a browser's guess.
             The offset lifts it clear of Atkinson's descenders, which are long
             by design. */
          text-underline-offset: 0.16em;
          text-decoration-thickness: from-font;
        }
      }

      /* ------------------------------------------------------------- account --
       * Every node below is built by the inline script above with
       * `document.createElement`, never by Astro. Scoped styles work by
       * compiling `.foo` to `.foo[data-astro-cid-…]` and stamping that attribute
       * onto server-rendered elements; a `createElement` node never gets
       * stamped, so a scoped rule here matches nothing. That is how the control
       * once shipped with a native `<details>` triangle and an unpositioned
       * panel. Any new `.account-*` rule belongs in this block and nowhere else.
       *
       * The control adopts `.btn .btn--sm .btn--outline` from primitives.css and
       * the panel adopts `.panel`. What is left here is only what the header
       * adds on top: the pinned white on a known red bar, the pill radius, and
       * the hit area.
       */
      .header-account {
        flex: 0 0 auto;
        min-width: 0;
      }
      .header-account[hidden] {
        display: none;
      }

      .account-signin,
      .account-summary {
        /* The bar is a known deep red in both themes, so this is pinned, not
           themed. White on --accent-solid measures 5.99:1. */
        color: #fff;
        border-radius: var(--radius-pill);
        white-space: nowrap;
        /* Anchors the hit-area expansion below; offsets nothing on its own. */
        position: relative;
      }
      /*
       * The pill's visible box stays at the primitive's 32px: this only widens
       * what counts as a tap. `::before` is generated content owned by the
       * element, so a click anywhere inside its invisible box still resolves to
       * it, and nothing is drawn because there is no background, border or
       * content here. 6px top and bottom brings 32px to a 44px target without
       * touching width, and the header has the room on both sides.
       */
      .account-signin::before,
      .account-summary::before {
        content: '';
        position: absolute;
        inset: -6px 0;
      }
      .account-signin:hover,
      .account-summary:hover {
        background: rgb(255 255 255 / 0.14);
        border-color: #fff; /* on the red bar; see above */
      }
      .account-signin:focus-visible,
      .account-summary:focus-visible {
        outline: 2px solid #fff; /* the global ring is --accent, invisible here */
        outline-offset: 3px;
      }

      .account-menu {
        position: relative;
      }
      /*
       * The marker is a disclosure triangle by default in every engine, the
       * "play button" reported in prod. `list-style: none` is the
       * standards-track way to kill it, `::-webkit-details-marker` is the legacy
       * WebKit pseudo, and `::marker` is a third belt: Chromium has a known
       * quirk where overriding `display` away from `list-item` on a `<summary>`
       * (which `.btn` does, to `inline-flex`) does not reliably suppress the
       * generated marker through `list-style` alone.
       */
      .account-summary {
        list-style: none;
        max-width: 190px;
        padding-inline: var(--space-2);
        cursor: pointer;
        user-select: none;
      }
      .account-summary::-webkit-details-marker {
        display: none;
      }
      .account-summary::marker {
        display: none;
      }
      .account-avatar {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        flex: 0 0 auto;
        background: rgb(255 255 255 / 0.2);
      }
      .account-name {
        font-size: var(--text-sm);
        font-weight: 700;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      /* A surface floating over the page, so it reads against whatever is under
         it rather than against the bar it hangs from. `.panel` supplies the
         ground, the radius and the shadow. */
      .account-panel {
        position: absolute;
        top: calc(100% + var(--space-2));
        right: 0;
        z-index: var(--z-overlay);
        /* Wide enough that "Use a different Discord account", the longest row,
           never wraps to a second line. */
        min-width: 260px;
        --panel-pad: var(--space-1);
        border: 1px solid var(--border);
      }
      .account-panel a {
        display: block;
        min-height: 44px;
        padding: var(--space-3);
        border-radius: var(--radius-sm);
        color: var(--text);
        font-size: var(--text-md);
        text-decoration: none;
      }
      .account-panel a:hover {
        background: var(--bg-sunken);
      }
      .account-panel a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }

      /* On a phone the header is already tight and the nav has collapsed into a
         panel, so the name goes and the avatar carries the control alone. */
      @media (max-width: 560px) {
        .account-name {
          display: none;
        }
        .account-summary {
          padding-inline: var(--space-2);
        }
      }
    </style>
  </body>
</html>
