---
import '~/styles/global.css';
import SocialIcon from '~/components/SocialIcon.astro';
import { SOCIALS } from '~/lib/socials';

interface Props {
  title: string;
  description?: string;
  /** Full-bleed pages (the map) manage their own scrolling. */
  fullBleed?: boolean;
  ogImage?: string;
  /**
   * Open Graph type. Pages set this rather than emitting their own `og:type`
   * into the head slot — two conflicting tags is worse than one wrong one,
   * since scrapers pick between them unpredictably.
   */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'PoGo TXK — the Pokémon GO community for Texarkana, Texas and Arkansas. Spring Lake Park Campsite map, meetups, raids, and community news.',
  fullBleed = false,
  ogImage = '/og-default.png',
  ogType = 'website',
} = Astro.props;

const fullTitle = title === 'PoGo TXK' ? title : `${title} | PoGo TXK`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

/**
 * Primary navigation.
 *
 * `/live` earns a slot: it is the realtime flare board, one of the reasons the
 * site exists, and it was previously reachable only from a card on the home
 * page. `/eggs` and `/research` deliberately do NOT get slots — they link to
 * each other and to `/raids` through GameNav, which covers the set without
 * pushing this list to nine items.
 *
 * Order follows the day: where we are, when we meet, what is happening now.
 */
const nav = [
  { href: '/', label: 'Home' },
  { href: '/map', label: 'Map' },
  { href: '/events', label: 'Events' },
  { href: '/live', label: 'Live' },
  { href: '/raids', label: 'Raids' },
  { href: '/blog', label: 'News' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/go', label: 'Go', highlight: true, describe: 'the PoGo TXK app' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#c8071c" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="PoGo TXK" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, canonical)} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="PoGo TXK" />

    {/* Per-page head additions — feed autodiscovery, article metadata, noindex.
        Without this slot, any <Fragment slot="head"> a page declares is
        silently dropped, which is invisible in the browser and only shows up
        as missing metadata in a scraper. */}
    <slot name="head" />
  </head>

  <body class={fullBleed ? 'is-full-bleed' : ''}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href="/">
        {/*
          The stacked mark, TEXARKANA under the GO as usual. The wide 2.74:1
          lockup is still built at /art/logo-txk-wide.webp if this reads too
          small — inside a fixed 60px header the stacking costs real legibility,
          because the three tiers have to share the height the wide one spends
          on two.

          `alt` carries the full name because this image *is* the site's name —
          it replaced the text that used to say it.
        */}
        <img
          class="brand-logo"
          src="/art/logo-txk-classic.webp"
          width="850"
          height="793"
          alt="PoGo TXK — Pokémon GO Texarkana"
        />
      </a>

      {/*
        The same four links as the home page's "Find us", from the same source —
        see `~/lib/socials`. Marks only: there is no room for labels beside eight
        nav items, and these are four icons a member already recognises.

        They sit with the brand rather than after the nav, so the left of the
        header is "who we are and where to find us" and the right stays purely
        navigation.

        `aria-label` goes on the link and the mark stays decorative. Naming both
        would have a screen reader announce "Discord Discord" — the exact trap
        SocialIcon's `decorative` prop documents.
      */}
      <ul class="header-socials">
        {
          SOCIALS.map((social) => (
            <li>
              <a
                href={social.href}
                rel="noopener noreferrer"
                target="_blank"
                aria-label={`${social.label} (opens in a new tab)`}
              >
                <SocialIcon name={social.name} size={22} bare />
              </a>
            </li>
          ))
        }
      </ul>

      {/*
        A Poké Ball rather than three lines. It only exists below 820px, where
        the nav collapses into a panel.

        Sits before the nav in source order deliberately: with the panel closed
        the links are `display: none` and out of the tab order entirely, and
        with it open Tab moves straight from the button into them. That is the
        whole focus management this needs — no trapping, no moving focus on
        open, nothing to get wrong.
      */}
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Open menu"
      >
        <svg
          class="pokeball"
          viewBox="0 0 40 40"
          width="30"
          height="30"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="20" cy="20" r="17" fill="#fff" />
          {/* Upper half only: sweep-flag 1 from the leftmost point runs over the
              top. Brighter than the header's own #c8071c so the two reds are
              not mistaken for one another. */}
          <path d="M3 20a17 17 0 0 1 34 0Z" fill="#ff2f3d" />
          {/* Weights are set for 30px, not for the 4x view where they were
              drawn. At 4/3/3 the black swallowed most of a 25px ball and it
              read as a dark disc. */}
          <path d="M3 20h34" stroke="#0f0f11" stroke-width="3.2" />
          {/* The outer ring is WHITE, not black. On a red header a red-topped
              ball with a dark outline loses its own silhouette — the top half
              sinks into the background and what is left reads as a dark ring
              with a white dot in it. White draws the edge the background
              cannot. */}
          <circle cx="20" cy="20" r="17" fill="none" stroke="#fff" stroke-width="2.6" />
          <circle cx="20" cy="20" r="5.8" fill="#fff" stroke="#0f0f11" stroke-width="2.4" />
        </svg>
      </button>

      <nav id="primary-nav" aria-label="Primary">
        <ul>
          {
            nav.map((item) => (
              <li>
                {/*
                  Appended in an `sr-only` span, not set as an `aria-label`.

                  "Go" alone reads as a verb with no object — a screen-reader
                  user pulling up a list of links sees it beside "Map" and
                  "Events" with no way to tell what it does. `aria-label` fixes
                  that for assistive tech but leaves `textContent` as "Go", which
                  is what Lighthouse's link-text audit reads, so it kept failing
                  while looking fixed.

                  This way the name is genuinely descriptive for both, the
                  visible chip is untouched, and the accessible name still
                  *starts* with the visible word — WCAG 2.5.3, so speech input
                  users saying "click Go" still match.
                */}
                <a
                  href={item.href}
                  class={item.highlight ? 'nav-highlight' : undefined}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  {item.describe && <span class="sr-only"> — {item.describe}</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

    </header>

    <script is:inline>
      // Bring the current page's nav chip into view when the row is scrollable,
      // so /gallery does not open with its own tab off the right edge.
      // `instant` because a visible scroll animation on load reads as a glitch.
      //
      // Below 820px the row is a hidden column instead, where both measurements
      // are 0 and the condition is simply false — so this needs no breakpoint of
      // its own.
      (() => {
        const current = document.querySelector('.site-header nav a[aria-current="page"]');
        if (!current) return;
        const row = current.closest('ul');
        if (row && row.scrollWidth > row.clientWidth) {
          current.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'instant' });
        }
      })();

      // The Poké Ball menu.
      (() => {
        const btn = document.querySelector('.nav-toggle');
        const nav = document.getElementById('primary-nav');
        if (!btn || !nav) return;

        const isOpen = () => btn.getAttribute('aria-expanded') === 'true';
        const setOpen = (open) => {
          btn.setAttribute('aria-expanded', String(open));
          // The label is the button's whole accessible name, so it has to say
          // what the next press does, not what the icon is.
          btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          nav.toggleAttribute('data-open', open);
        };

        btn.addEventListener('click', () => setOpen(!isOpen()));

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && isOpen()) {
            setOpen(false);
            btn.focus();
          }
        });

        // Tapping the page behind it should close it. The button's own click is
        // already handled above; letting it fall through here would toggle twice
        // and the menu would never open.
        document.addEventListener('click', (e) => {
          if (!isOpen()) return;
          if (btn.contains(e.target) || nav.contains(e.target)) return;
          setOpen(false);
        });

        // Above the breakpoint the panel rules stop applying and the row is
        // visible regardless. Without this, `data-open` would survive the
        // resize and the menu would spring open again on the way back down.
        window
          .matchMedia('(min-width: 821px)')
          .addEventListener('change', (e) => e.matches && setOpen(false));
      })();
    </script>

    <main id="main">
      <slot />
    </main>

    {
      !fullBleed && (
        <footer class="site-footer">
          <p>
            <strong>PoGo TXK</strong> — Pokémon GO Texarkana. Not officially affiliated with
            Pokémon GO. Pokémon and its trademarks are ©1995–2026 Nintendo, Creatures, and
            GAMEFREAK. All images and names owned and trademarked by Nintendo, Niantic, The
            Pokémon Company, and GAMEFREAK are property of their respective owners.
          </p>
          <p class="footer-links">
            <a href="/about">About</a> · <a href="/conduct">Code of Conduct</a> ·{' '}
            <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a> ·{' '}
            <a href="https://discord.com/invite/2sYR5YdRpH" rel="noopener noreferrer" target="_blank"
              >Discord</a
            >
          </p>
        </footer>
      )
    }

    <style>
      /*
       * Sticky footer. On a short page the footer was rendering immediately
       * after the content and leaving bare background beneath it — 115px on
       * /live, 220px on /blog — which reads as the page having been cut off.
       *
       * `flex: 1 0 auto` on main, not `1 1 auto`: main must grow to fill a
       * short page but must never shrink below its content on a long one.
       *
       * vh first, dvh second, so browsers without dvh still get the behaviour
       * and those with it avoid the mobile URL-bar jump.
       */
      body {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }
      body > main {
        flex: 1 0 auto;
      }

      /* Overrides the min-height above with a hard height: these screens own
         the viewport and scroll internally rather than as a document. */
      body.is-full-bleed {
        height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      body.is-full-bleed main {
        flex: 1;
        min-height: 0;
      }

      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        height: var(--header-h);
        padding: 0 clamp(12px, 3vw, 24px);
        background: var(--accent-solid);
        color: #fff;
        /*
         * The Poké Ball's band. Red above, white below, and this is the line
         * between them — solid black and deliberately thick, because on the ball
         * it is the heaviest part of the design, not a hairline.
         *
         * Safe to add height here: `--header-h` is only ever used to set these
         * two headers' own height. Nothing offsets content by it, so the extra
         * 4px cannot desynchronise a sticky or scroll-margin calculation.
         */
        border-bottom: 4px solid var(--ink-900);
        position: sticky;
        top: 0;
        z-index: 900;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: inherit;
        text-decoration: none;
      }
      /* Sized by height, never width — the header is a fixed 60px and the logo
         has to sit inside it with air above and below. `width: auto` lets the
         intrinsic ratio decide the rest.

         48px, not the 40px the wide lockup used: the stacked mark spends its
         height on three tiers instead of two, so it needs every pixel the
         56px content box will give it. */
      .brand-logo {
        display: block;
        height: 48px;
        width: auto;
      }

      /*
       * `min-width: 0` is what makes the `overflow-x: auto` below actually work.
       *
       * A flex item defaults to `min-width: auto`, which refuses to shrink below
       * its content. Without this the nav stayed its full 433px, the header grew
       * past the viewport, and every page scrolled sideways on a phone — 169px of
       * overhang at 375px wide, on all twelve routes. The scrolling nav was
       * written correctly from the start; this one property is all that was
       * stopping it from ever engaging.
       */
      .site-header nav {
        min-width: 0;
        position: relative;
        /* The nav and the social marks travel together on the right, with the
           brand holding the left. Without this, `space-between` distributes
           three children evenly and strands the nav mid-header. */
        margin-left: auto;
      }

      .header-socials {
        list-style: none;
        margin: 0;
        padding: 0 0 0 13px;
        display: flex;
        align-items: center;
        gap: 8px;
        /* Same reasoning as `.brand`: the nav absorbs every bit of flex by
           scrolling, so these keep their natural width or are hidden outright. */
        flex: 0 0 auto;
        /* A hairline, not just a gap — it separates the marks from the logo
           without reading as a second brand element. */
        border-left: 1px solid rgb(255 255 255 / 0.22);
        /* The header's own 16px gap plus this padding would set them adrift from
           the brand they belong to; a negative start pulls the rule in close. */
        margin-left: -3px;
      }
      .header-socials a {
        display: block;
        line-height: 0;
        /* The marks are bare glyphs here, so this is what colours them —
           `currentColor` inside the SVG resolves against it. Slightly under
           white at rest so they read as secondary to the wordmark, which is the
           only thing in the header allowed to be pure white. */
        color: rgb(255 255 255 / 0.88);
        border-radius: 5px;
        transition:
          transform 0.16s ease,
          color 0.16s ease;
      }
      .header-socials a:hover {
        color: #fff;
        transform: translateY(-1px) scale(1.06);
      }
      .header-socials a:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 3px;
      }
      .header-socials svg {
        display: block;
      }

      /* Hidden until the panel breakpoint takes over below. 44px because it is
         the only way to reach anything on a phone — the icon itself is 30. */
      .nav-toggle {
        display: none;
        place-items: center;
        width: 44px;
        height: 44px;
        padding: 0;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: inherit;
        cursor: pointer;
      }
      .nav-toggle:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
      }
      .nav-toggle .pokeball {
        display: block;
        /* Global reduced-motion already flattens these to 0.01ms. */
        transition: transform 0.2s ease;
      }
      /* The centre button lights up when the menu is open, rather than the ball
         rotating. A Poké Ball turned 180° just puts the red half underneath,
         which reads as an upside-down ball rather than as an open menu; a lit
         button reads as "active" and leaves the mark the right way up. */
      .nav-toggle .pokeball circle:last-of-type {
        transition: fill 0.2s ease;
      }
      .nav-toggle[aria-expanded='true'] .pokeball {
        transform: scale(1.06);
      }
      .nav-toggle[aria-expanded='true'] .pokeball circle:last-of-type {
        fill: #ffe14d;
      }

      nav ul {
        display: flex;
        gap: 4px;
        margin: 0;
        padding: 0;
        list-style: none;
        overflow-x: auto;
        scrollbar-width: none;
        /* Deliberately not `justify-content: flex-end`: when a flex row
           overflows, end-alignment can push the first items past the start edge
           where no amount of scrolling reaches them. The current item is brought
           into view by script instead, which degrades to "starts at Home". */
        overscroll-behavior-x: contain;
        scroll-padding-inline: 12px;
      }
      nav ul::-webkit-scrollbar {
        display: none;
      }
      nav li {
        flex: 0 0 auto;
      }

      /*
       * Fades the left edge while the row is scrolled, so it reads as "there is
       * more back that way" rather than as a nav that starts at "Events".
       * `mask-image` rather than an overlaid gradient: the header is a solid
       * colour on some pages and sits over content on others, and a mask needs
       * no knowledge of what is behind it.
       *
       * animation-timeline is progressive enhancement — without support the nav
       * simply scrolls unfaded, which is the behaviour we already had.
       */
      @supports (animation-timeline: scroll(self inline)) {
        nav ul {
          animation: nav-fade-start linear both;
          animation-timeline: scroll(self inline);
          animation-range: 0 24px;
        }
        @keyframes nav-fade-start {
          from {
            mask-image: linear-gradient(to right, #000 0, #000 100%);
          }
          to {
            mask-image: linear-gradient(to right, transparent 0, #000 22px, #000 100%);
          }
        }
      }

      /* `0 0 auto`, not `0 1 auto`. Allowed to shrink, the brand used to give up
         six pixels and render "PoGo …" — truncated just enough to look like a
         bug, not enough to save room. It is an image now, but the reasoning
         holds: a squeezed logo is worse than a smaller one, so the brand keeps
         its natural width and the nav absorbs every bit of flex by scrolling.
         The breakpoint below steps the height down rather than letting flex
         distort it. */
      .brand {
        flex: 0 0 auto;
      }
      nav a {
        display: block;
        padding: 7px 12px;
        border-radius: 999px;
        color: rgb(255 255 255 / 0.82);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        white-space: nowrap;
      }
      nav a:hover {
        background: rgb(255 255 255 / 0.1);
        color: #fff;
      }
      /* `--accent-solid`, not `--accent`: this is dark text on a white chip, and
         in dark mode `--accent` is the *light* red meant for the opposite job —
         it measured 3.0:1 here. */
      nav a[aria-current='page'] {
        background: #fff;
        color: var(--accent-solid);
      }
      /*
       * The quick-action screen is the point of the whole site on a phone; it
       * earns a bit of visual weight in the nav.
       *
       * Black — the Poké Ball's band — rather than the orange it used to be.
       * White on `--poi-gym` measured 3.18:1, under AA, and orange on a red bar
       * was muddy besides. It also has to stay distinct from `[aria-current]`,
       * which is a *white* chip: if Go were white too it would look permanently
       * selected.
       */
      nav a.nav-highlight {
        background: var(--ink-900);
        color: #fff;
      }
      nav a.nav-highlight[aria-current='page'] {
        background: #fff;
        color: var(--accent-solid);
      }

      .site-footer {
        padding: 28px clamp(12px, 3vw, 24px);
        border-top: 1px solid var(--border);
        background: var(--bg-sunken);
        color: var(--text-muted);
        font-size: 0.76rem;
      }
      .site-footer p {
        max-width: 70ch;
        margin: 0 auto 10px;
      }
      .footer-links {
        text-align: center;
      }

      /* The logo is one indivisible image, so the old two-stage degrade (drop
         the tagline at 820px, then the wordmark at 430px) has nothing to drop.
         It steps down in height instead — still legible, and it hands ~30px
         back to the seven nav items it is competing with. */
      @media (max-width: 430px) {
        .brand-logo {
          height: 42px;
        }
      }

      /* The marks are a desktop affordance and nothing more. They cost roughly
         135px, and a squeezed nav does not overflow the header — it just scrolls
         — so keeping them on a phone would quietly shrink the primary navigation
         to pay for a secondary one. The home page's "Find us" carries the same
         four links, from the same source, so nothing is lost by dropping them. */
      @media (max-width: 1024px) {
        .header-socials {
          display: none;
        }
      }

      /*
       * Below 820px the nav stops being a scrolling row and becomes a panel
       * behind the Poké Ball.
       *
       * 820 rather than the ~590 where the row actually starts to overflow:
       * that is where the rest of the page already goes single-column, and a
       * header that reflows on a different boundary from the content under it
       * reads as a bug. It also means the row is never cramped — it is replaced
       * before it has to scroll at all.
       *
       * The panel is positioned against `.site-header`, which is `sticky` and
       * therefore already a containing block. It inherits the header's
       * `z-index: 900`, so it covers the map on the full-bleed pages too.
       */
      @media (max-width: 820px) {
        .nav-toggle {
          display: grid;
          margin-left: auto;
        }

        .site-header nav {
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          /* It is out of flow now, so the auto margin that kept the row right
             would do nothing but confuse the next reader. */
          margin-left: 0;
          background: var(--accent-solid);
          border-bottom: 4px solid var(--ink-900);
          box-shadow: 0 12px 24px -12px rgb(0 0 0 / 0.55);
          display: none;
        }
        .site-header nav[data-open] {
          display: block;
        }

        .site-header nav ul {
          flex-direction: column;
          align-items: stretch;
          /* The row's horizontal scroll has nothing to do here, and leaving it
             on clips the chips' focus rings. */
          overflow: visible;
          gap: 2px;
          padding: 8px clamp(12px, 3vw, 24px) 14px;
        }
        .site-header nav li {
          width: 100%;
        }
        nav a {
          padding: 11px 14px;
          font-size: 0.95rem;
        }
      }
    </style>
  </body>
</html>
