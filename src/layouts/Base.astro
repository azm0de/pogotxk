---
import '~/styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Full-bleed pages (the map) manage their own scrolling. */
  fullBleed?: boolean;
  ogImage?: string;
  /**
   * Open Graph type. Pages set this rather than emitting their own `og:type`
   * into the head slot — two conflicting tags is worse than one wrong one,
   * since scrapers pick between them unpredictably.
   */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'PoGo TXK — the Pokémon GO community for Texarkana, Texas and Arkansas. Spring Lake Park Campsite map, meetups, raids, and community news.',
  fullBleed = false,
  ogImage = '/og-default.png',
  ogType = 'website',
} = Astro.props;

const fullTitle = title === 'PoGo TXK' ? title : `${title} | PoGo TXK`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

/**
 * Primary navigation.
 *
 * `/live` earns a slot: it is the realtime flare board, one of the reasons the
 * site exists, and it was previously reachable only from a card on the home
 * page. `/eggs` and `/research` deliberately do NOT get slots — they link to
 * each other and to `/raids` through GameNav, which covers the set without
 * pushing this list to nine items.
 *
 * Order follows the day: where we are, when we meet, what is happening now.
 */
const nav = [
  { href: '/', label: 'Home' },
  { href: '/map', label: 'Map' },
  { href: '/events', label: 'Events' },
  { href: '/live', label: 'Live' },
  { href: '/raids', label: 'Raids' },
  { href: '/blog', label: 'News' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/go', label: 'Go', highlight: true },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#123254" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="PoGo TXK" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, canonical)} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="PoGo TXK" />

    {/* Per-page head additions — feed autodiscovery, article metadata, noindex.
        Without this slot, any <Fragment slot="head"> a page declares is
        silently dropped, which is invisible in the browser and only shows up
        as missing metadata in a scraper. */}
    <slot name="head" />
  </head>

  <body class={fullBleed ? 'is-full-bleed' : ''}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">TXK</span>
        <span class="brand-copy">
          <strong>PoGo TXK</strong>
          <span>Pokémon GO Texarkana</span>
        </span>
      </a>

      <nav aria-label="Primary">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class={item.highlight ? 'nav-highlight' : undefined}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <script is:inline>
      // Bring the current page's nav chip into view when the row is scrollable,
      // so /gallery does not open with its own tab off the right edge.
      // `instant` because a visible scroll animation on load reads as a glitch.
      (() => {
        const current = document.querySelector('.site-header nav a[aria-current="page"]');
        if (!current) return;
        const row = current.closest('ul');
        if (row && row.scrollWidth > row.clientWidth) {
          current.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'instant' });
        }
      })();
    </script>

    <main id="main">
      <slot />
    </main>

    {
      !fullBleed && (
        <footer class="site-footer">
          <p>
            <strong>PoGo TXK</strong> — Pokémon GO Texarkana. Not officially affiliated with
            Pokémon GO. Pokémon and its trademarks are ©1995–2026 Nintendo, Creatures, and
            GAMEFREAK. All images and names owned and trademarked by Nintendo, Niantic, The
            Pokémon Company, and GAMEFREAK are property of their respective owners.
          </p>
          <p class="footer-links">
            <a href="/about">About</a> · <a href="/conduct">Code of Conduct</a> ·
            <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a> ·
            <a href="https://discord.com/invite/2sYR5YdRpH" rel="noopener noreferrer" target="_blank"
              >Discord</a
            >
          </p>
        </footer>
      )
    }

    <style>
      /*
       * Sticky footer. On a short page the footer was rendering immediately
       * after the content and leaving bare background beneath it — 115px on
       * /live, 220px on /blog — which reads as the page having been cut off.
       *
       * `flex: 1 0 auto` on main, not `1 1 auto`: main must grow to fill a
       * short page but must never shrink below its content on a long one.
       *
       * vh first, dvh second, so browsers without dvh still get the behaviour
       * and those with it avoid the mobile URL-bar jump.
       */
      body {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }
      body > main {
        flex: 1 0 auto;
      }

      /* Overrides the min-height above with a hard height: these screens own
         the viewport and scroll internally rather than as a document. */
      body.is-full-bleed {
        height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      body.is-full-bleed main {
        flex: 1;
        min-height: 0;
      }

      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        height: var(--header-h);
        padding: 0 clamp(12px, 3vw, 24px);
        background: var(--navy-800);
        color: #fff;
        position: sticky;
        top: 0;
        z-index: 900;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: inherit;
        text-decoration: none;
      }
      .brand-mark {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: rgb(255 255 255 / 0.14);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.04em;
      }
      .brand-copy {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
      }
      .brand-copy strong {
        font-size: 0.98rem;
      }
      .brand-copy span {
        font-size: 0.72rem;
        opacity: 0.75;
      }

      /*
       * `min-width: 0` is what makes the `overflow-x: auto` below actually work.
       *
       * A flex item defaults to `min-width: auto`, which refuses to shrink below
       * its content. Without this the nav stayed its full 433px, the header grew
       * past the viewport, and every page scrolled sideways on a phone — 169px of
       * overhang at 375px wide, on all twelve routes. The scrolling nav was
       * written correctly from the start; this one property is all that was
       * stopping it from ever engaging.
       */
      .site-header nav {
        min-width: 0;
        position: relative;
      }

      nav ul {
        display: flex;
        gap: 4px;
        margin: 0;
        padding: 0;
        list-style: none;
        overflow-x: auto;
        scrollbar-width: none;
        /* Deliberately not `justify-content: flex-end`: when a flex row
           overflows, end-alignment can push the first items past the start edge
           where no amount of scrolling reaches them. The current item is brought
           into view by script instead, which degrades to "starts at Home". */
        overscroll-behavior-x: contain;
        scroll-padding-inline: 12px;
      }
      nav ul::-webkit-scrollbar {
        display: none;
      }
      nav li {
        flex: 0 0 auto;
      }

      /*
       * Fades the left edge while the row is scrolled, so it reads as "there is
       * more back that way" rather than as a nav that starts at "Events".
       * `mask-image` rather than an overlaid gradient: the header is a solid
       * colour on some pages and sits over content on others, and a mask needs
       * no knowledge of what is behind it.
       *
       * animation-timeline is progressive enhancement — without support the nav
       * simply scrolls unfaded, which is the behaviour we already had.
       */
      @supports (animation-timeline: scroll(self inline)) {
        nav ul {
          animation: nav-fade-start linear both;
          animation-timeline: scroll(self inline);
          animation-range: 0 24px;
        }
        @keyframes nav-fade-start {
          from {
            mask-image: linear-gradient(to right, #000 0, #000 100%);
          }
          to {
            mask-image: linear-gradient(to right, transparent 0, #000 22px, #000 100%);
          }
        }
      }

      /* The brand never wraps. At 580–700px it was folding onto three lines and
         spilling out of the fixed 60px header. */
      /* `0 0 auto`, not `0 1 auto`. Allowed to shrink, the brand gave up six
         pixels and rendered "PoGo …" — truncated just enough to look like a
         bug, not enough to save room. The nav absorbs every bit of flex by
         scrolling, so the brand keeps its natural width and is hidden outright
         at the breakpoints below when there is genuinely no space. */
      .brand {
        flex: 0 0 auto;
      }
      .brand-copy {
        min-width: 0;
      }
      .brand-copy strong,
      .brand-copy span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      nav a {
        display: block;
        padding: 7px 12px;
        border-radius: 999px;
        color: rgb(255 255 255 / 0.82);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        white-space: nowrap;
      }
      nav a:hover {
        background: rgb(255 255 255 / 0.1);
        color: #fff;
      }
      nav a[aria-current='page'] {
        background: #fff;
        color: var(--navy-800);
      }
      /* The quick-action screen is the point of the whole site on a phone;
         it earns a bit of visual weight in the nav. */
      nav a.nav-highlight {
        background: var(--poi-gym);
        color: #fff;
      }
      nav a.nav-highlight[aria-current='page'] {
        background: #fff;
        color: var(--navy-800);
      }

      .site-footer {
        padding: 28px clamp(12px, 3vw, 24px);
        border-top: 1px solid var(--border);
        background: var(--bg-sunken);
        color: var(--text-muted);
        font-size: 0.76rem;
      }
      .site-footer p {
        max-width: 70ch;
        margin: 0 auto 10px;
      }
      .footer-links {
        text-align: center;
      }

      /* Dropped well before the old 560px: the tagline was still competing with
         the nav for room through the whole 560–820px band, which is where the
         brand used to wrap. Below this the mark plus "PoGo TXK" is enough. */
      @media (max-width: 820px) {
        .brand-copy span {
          display: none;
        }
      }

      /* Under ~430px even the wordmark is losing the argument with seven nav
         items; the TXK mark alone still identifies the site and links home. */
      @media (max-width: 430px) {
        .brand-copy {
          display: none;
        }
      }
    </style>
  </body>
</html>
