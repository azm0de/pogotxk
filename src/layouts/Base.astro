---
import '~/styles/global.css';
import PokeBall from '~/components/PokeBall.astro';
import SocialIcon from '~/components/SocialIcon.astro';
import { SOCIALS } from '~/lib/socials';

interface Props {
  title: string;
  description?: string;
  /** Full-bleed pages (the map) manage their own scrolling. */
  fullBleed?: boolean;
  ogImage?: string;
  /**
   * Open Graph type. Pages set this rather than emitting their own `og:type`
   * into the head slot — two conflicting tags is worse than one wrong one,
   * since scrapers pick between them unpredictably.
   */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'PoGo TXK — the Pokémon GO community for Texarkana, Texas and Arkansas. Spring Lake Park Campsite map, meetups, raids, and community news.',
  fullBleed = false,
  ogImage = '/og-default.png',
  ogType = 'website',
} = Astro.props;

const fullTitle = title === 'PoGo TXK' ? title : `${title} | PoGo TXK`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

/**
 * Primary navigation.
 *
 * `/live` earns a slot: it is the realtime flare board, one of the reasons the
 * site exists, and it was previously reachable only from a card on the home
 * page. `/eggs` and `/research` deliberately do NOT get slots — they link to
 * each other and to `/raids` through GameNav, which covers the set without
 * pushing this list to nine items.
 *
 * Order follows the day: where we are, when we meet, what is happening now.
 */
const nav = [
  { href: '/', label: 'Home' },
  { href: '/map', label: 'Map' },
  { href: '/events', label: 'Events' },
  { href: '/live', label: 'Live' },
  { href: '/raids', label: 'Raids' },
  { href: '/blog', label: 'News' },
  { href: '/go', label: 'Go', ball: true, describe: 'the PoGo TXK app' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#c8071c" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="PoGo TXK" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, canonical)} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="PoGo TXK" />

    {/* Per-page head additions — feed autodiscovery, article metadata, noindex.
        Without this slot, any <Fragment slot="head"> a page declares is
        silently dropped, which is invisible in the browser and only shows up
        as missing metadata in a scraper. */}
    <slot name="head" />
  </head>

  <body class={fullBleed ? 'is-full-bleed' : ''}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href="/">
        {/*
          The stacked mark, TEXARKANA under the GO as usual. The wide 2.74:1
          lockup is still built at /art/logo-txk-wide.webp if this reads too
          small — inside a fixed 60px header the stacking costs real legibility,
          because the three tiers have to share the height the wide one spends
          on two.

          `alt` carries the full name because this image *is* the site's name —
          it replaced the text that used to say it.
        */}
        <img
          class="brand-logo"
          src="/art/logo-txk-classic.webp"
          width="850"
          height="793"
          alt="PoGo TXK — Pokémon GO Texarkana"
        />
      </a>

      {/*
        A Poké Ball rather than three lines. It only exists below 820px, where
        the nav collapses into a panel.

        Sits before the nav in source order deliberately: with the panel closed
        the links are `display: none` and out of the tab order entirely, and
        with it open Tab moves straight from the button into them. That is the
        whole focus management this needs — no trapping, no moving focus on
        open, nothing to get wrong.
      */}
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Open menu"
      >
        <PokeBall size={30} />
      </button>

      <nav id="primary-nav" aria-label="Primary">
        <ul>
          {
            nav.map((item) => (
              <li>
                {/*
                  Appended in an `sr-only` span, not set as an `aria-label`.

                  "Go" alone reads as a verb with no object — a screen-reader
                  user pulling up a list of links sees it beside "Map" and
                  "Events" with no way to tell what it does. `aria-label` fixes
                  that for assistive tech but leaves `textContent` as "Go", which
                  is what Lighthouse's link-text audit reads, so it kept failing
                  while looking fixed.

                  This way the name is genuinely descriptive for both, the
                  visible chip is untouched, and the accessible name still
                  *starts* with the visible word — WCAG 2.5.3, so speech input
                  users saying "click Go" still match.
                */}
                {/*
                  The ball replaces the word rather than joining it, but the word
                  is still in the markup — `.nav-go-label` is clipped to sr-only
                  in the row and made visible again in the phone panel.

                  Both halves of that matter. In the panel it has to be a word:
                  the menu button that opened the panel is itself a Poké Ball, so
                  a second one in the list underneath would be two identical
                  marks doing different jobs. And in the row it has to still be
                  *there*, because an icon whose label is `display: none` leaves
                  the accessible name as " — the PoGo TXK app", and leaves
                  Lighthouse's link-text audit reading an empty link.
                */}
                <a
                  href={item.href}
                  class:list={[item.highlight && 'nav-highlight', item.ball && 'nav-go']}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.ball && <PokeBall size={26} class="nav-go-ball" />}
                  {item.ball ? <span class="nav-go-label">{item.label}</span> : item.label}
                  {item.describe && <span class="sr-only"> — {item.describe}</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/*
        The same four links as the home page's "Find us", from the same source —
        see `~/lib/socials`. Marks only: there is no room for labels beside eight
        nav items, and these are four icons a member already recognises.

        After the nav, not tucked against the brand where they used to sit. That
        is a source order change rather than a CSS one on purpose: they are
        anchored to the right edge now, and reordering them visually with `order`
        would leave a keyboard user tabbing brand -> socials -> nav while the eye
        reads brand -> nav -> socials. Moving the markup keeps the two in step.

        Still before nothing important: the Poké Ball toggle stays immediately
        ahead of the nav it opens, which is the adjacency its own note below
        depends on.

        `aria-label` goes on the link and the mark stays decorative. Naming both
        would have a screen reader announce "Discord Discord" — the exact trap
        SocialIcon's `decorative` prop documents.
      */}
      {/*
        The socials and the account control share the right-hand zone, and the
        wrapper is what carries the `flex: 1 1 0` that used to sit on the list
        itself. That matters: the nav is centred by the two side zones being
        equal, so hanging the account control off the end as a third sibling
        would have shifted the nav left by exactly its width.
      */}
      <div class="header-right">
        <ul class="header-socials">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  href={social.href}
                  rel="noopener noreferrer"
                  target="_blank"
                  aria-label={`${social.label} (opens in a new tab)`}
                >
                  <SocialIcon name={social.name} size={22} bare />
                </a>
              </li>
            ))
          }
        </ul>

        {/*
          Filled in by the script below rather than rendered here, because four
          pages under this layout are prerendered (/conduct, /privacy, /terms,
          /offline). On those, `Astro.locals.user` is whatever it was at BUILD
          time — which is nobody, forever. A server-rendered control would tell
          a signed-in member they are signed out on a quarter of the site.

          Starts empty and unlabelled so nothing flashes before we know the
          answer; `hidden` comes off once it has something true to say.
        */}
        <div class="header-account" data-account hidden></div>
      </div>
    </header>

    <script is:inline>
      // Bring the current page's nav chip into view when the row is scrollable,
      // so /gallery does not open with its own tab off the right edge.
      // `instant` because a visible scroll animation on load reads as a glitch.
      //
      // Below 820px the row is a hidden column instead, where both measurements
      // are 0 and the condition is simply false — so this needs no breakpoint of
      // its own.
      (() => {
        const current = document.querySelector('.site-header nav a[aria-current="page"]');
        if (!current) return;
        const row = current.closest('ul');
        if (row && row.scrollWidth > row.clientWidth) {
          current.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'instant' });
        }
      })();

      // The Poké Ball menu.
      (() => {
        const btn = document.querySelector('.nav-toggle');
        const nav = document.getElementById('primary-nav');
        if (!btn || !nav) return;

        const isOpen = () => btn.getAttribute('aria-expanded') === 'true';
        const setOpen = (open) => {
          btn.setAttribute('aria-expanded', String(open));
          // The label is the button's whole accessible name, so it has to say
          // what the next press does, not what the icon is.
          btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          nav.toggleAttribute('data-open', open);
        };

        btn.addEventListener('click', () => setOpen(!isOpen()));

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && isOpen()) {
            setOpen(false);
            btn.focus();
          }
        });

        // Tapping the page behind it should close it. The button's own click is
        // already handled above; letting it fall through here would toggle twice
        // and the menu would never open.
        document.addEventListener('click', (e) => {
          if (!isOpen()) return;
          if (btn.contains(e.target) || nav.contains(e.target)) return;
          setOpen(false);
        });

        // Above the breakpoint the panel rules stop applying and the row is
        // visible regardless. Without this, `data-open` would survive the
        // resize and the menu would spring open again on the way back down.
        window
          .matchMedia('(min-width: 821px)')
          .addEventListener('change', (e) => e.matches && setOpen(false));
      })();
    </script>

    <script is:inline>
      /*
       * The account control.
       *
       * Built here rather than server-rendered because four pages under this
       * layout are prerendered, and on those the server's idea of "who is
       * signed in" is frozen at build time. One fetch is the honest answer.
       *
       * Everything is built with createElement and textContent. A Discord
       * display name is chosen by its owner and arrives from an API, so it is
       * untrusted string data — innerHTML here would be a stored XSS on every
       * page of the site.
       */
      (() => {
        const root = document.querySelector('[data-account]');
        if (!root) return;

        const el = (tag, props) => Object.assign(document.createElement(tag), props);
        // Where to come back to. Deliberately not the hash — it never reaches
        // the server, and `safeNext` would be judging a string it cannot see.
        const here = location.pathname + location.search;
        const next = encodeURIComponent(here);

        const signedOut = () => {
          root.append(
            el('a', {
              className: 'account-signin',
              href: '/auth/login?next=' + next,
              textContent: 'Sign in',
            }),
          );
        };

        const signedIn = (user) => {
          const details = el('details', { className: 'account-menu' });
          const summary = el('summary', { className: 'account-summary' });
          summary.setAttribute('aria-label', 'Account menu');

          if (user.avatarUrl) {
            summary.append(
              el('img', {
                className: 'account-avatar',
                src: user.avatarUrl,
                alt: '',
                width: 22,
                height: 22,
                loading: 'lazy',
                decoding: 'async',
              }),
            );
          } else {
            summary.append(el('span', { className: 'account-avatar' }));
          }
          summary.append(
            el('span', {
              className: 'account-name',
              textContent: user.displayName || user.username || 'Account',
            }),
          );

          // Session actions, plus one link out. Who is signed in is already
          // the summary's own avatar and name; a menu that opens over it
          // should hold actions, not repeat that back as prose. Delete stays
          // a link to its own confirmation page rather than a raw button
          // here — this menu is not the place to put something irreversible
          // one misclick away.
          const panel = el('div', { className: 'account-panel' });
          panel.append(
            el('a', { href: '/auth/logout?next=' + next, textContent: 'Sign out' }),
            // Signing out here does not sign out of Discord — this is the only
            // way off an account picked by mistake. See commit 4e12bcb.
            el('a', {
              href: '/auth/logout?switch=1&next=' + next,
              textContent: 'Use a different Discord account',
            }),
            el('a', { href: '/account/delete', textContent: 'Delete my account' }),
          );

          details.append(summary, panel);
          root.append(details);

          // A menu that will not close is worse than no menu.
          document.addEventListener('click', (e) => {
            if (details.open && !details.contains(e.target)) details.open = false;
          });
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && details.open) {
              details.open = false;
              summary.focus();
            }
          });
        };

        fetch('/api/me.json', { credentials: 'same-origin', headers: { accept: 'application/json' } })
          .then((res) => (res.ok ? res.json() : null))
          .then((data) => {
            if (!data) return; // Stay hidden rather than assert either state.
            data.user ? signedIn(data.user) : signedOut();
            root.hidden = false;
          })
          .catch(() => {
            /* Offline, or the endpoint is unreachable. Showing "Sign in" to
               someone who is signed in would be a lie, and showing nothing
               costs them only this shortcut — /go and /live still have theirs. */
          });
      })();
    </script>

    <main id="main">
      <slot />
    </main>

    {
      !fullBleed && (
        <footer class="site-footer">
          {/*
            The header carries the wordmark as an image; the footer had
            nothing of its own — just the same body-weight text as the legal
            paragraph beneath it, on every page on the site. This is the
            favicon's mark (`variant="neutral"`, a dark ring rather than the
            header's white one — `--bg-sunken` is not the header's known red
            in either theme) paired with the same display face the headings
            use, so it reads as the site's mark rather than another line of
            copy.
          */}
          <p class="footer-brand">
            <PokeBall size={20} variant="neutral" /> PoGo TXK
          </p>
          <p>
            Pokémon GO Texarkana. Not officially affiliated with
            Pokémon GO. Pokémon and its trademarks are ©1995–2026 Nintendo, Creatures, and
            GAMEFREAK. All images and names owned and trademarked by Nintendo, Niantic, The
            Pokémon Company, and GAMEFREAK are property of their respective owners.
          </p>
          <p class="footer-links">
            <a href="/about">About</a> · <a href="/conduct">Code of Conduct</a> ·{' '}
            <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a> ·{' '}
            <a href="https://discord.com/invite/2sYR5YdRpH" rel="noopener noreferrer" target="_blank"
              >Discord</a
            >
          </p>
        </footer>
      )
    }

    <style>
      /*
       * Sticky footer. On a short page the footer was rendering immediately
       * after the content and leaving bare background beneath it — 115px on
       * /live, 220px on /blog — which reads as the page having been cut off.
       *
       * `flex: 1 0 auto` on main, not `1 1 auto`: main must grow to fill a
       * short page but must never shrink below its content on a long one.
       *
       * vh first, dvh second, so browsers without dvh still get the behaviour
       * and those with it avoid the mobile URL-bar jump.
       */
      body {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }
      body > main {
        flex: 1 0 auto;
      }

      /* Overrides the min-height above with a hard height: these screens own
         the viewport and scroll internally rather than as a document. */
      body.is-full-bleed {
        height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      body.is-full-bleed main {
        flex: 1;
        min-height: 0;
      }

      .site-header {
        display: flex;
        align-items: center;
        gap: 16px;
        /*
         * 72, not the shared `--header-h`. That token is still 60 and the admin
         * bar still uses it — this is the public header only.
         *
         * The extra 12px are for the mark. Stacked, it is near enough square, so
         * at the old 48px it rendered 51px wide and three tiers of type had to
         * share that: "Pokémon", "GO" and "TEXARKANA" were shapes rather than
         * words. Nothing offsets content by the header height, so this is free
         * to change — checked, there is no scroll-margin or sticky offset keyed
         * to it anywhere.
         */
        height: 72px;
        padding: 0 clamp(12px, 3vw, 24px);
        color: #fff;
        /*
         * Flat red read as a coloured strip rather than as part of the ball.
         * The bar now darkens toward the black band, which is how a curved
         * surface behaves above a shadow line, and takes a 1px lit edge along
         * the top.
         *
         * Only ever *darker* than `--accent-solid`, never lighter, and that is a
         * contrast constraint rather than taste: the nav chips are 0.9 white on
         * this, which measures 4.92:1 against the flat colour. Lifting the mid
         * band even 7% takes it to 4.5:1 and a little further puts it under AA.
         * The lit edge is 1px of inset shadow for that reason — no text can sit
         * on it.
         */
        background: linear-gradient(
          180deg,
          var(--accent-solid) 0%,
          var(--accent-solid) 58%,
          #b00518 100%
        );
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.18);
        /*
         * The Poké Ball's band. Red above, white below, and this is the line
         * between them — solid black and deliberately thick, because on the ball
         * it is the heaviest part of the design, not a hairline.
         */
        border-bottom: 4px solid var(--ink-900);
        position: sticky;
        top: 0;
        z-index: 900;
      }

      /*
       * Lifts off the page once it stops sitting on it. A sticky bar with no
       * elevation reads as painted onto the content it is covering.
       *
       * Scroll-driven, so no listener and no class toggling — the same
       * progressive enhancement the nav's edge fade already uses. Without
       * support the header simply never gains the shadow, which is exactly the
       * header we had. The inset highlight is repeated in the keyframe because a
       * `box-shadow` animation replaces the whole list, not one layer of it.
       */
      @supports (animation-timeline: scroll()) {
        .site-header {
          animation: header-elevate linear both;
          animation-timeline: scroll();
          animation-range: 0 72px;
        }
        @keyframes header-elevate {
          to {
            box-shadow:
              inset 0 1px 0 rgb(255 255 255 / 0.18),
              0 8px 20px -6px rgb(0 0 0 / 0.45);
          }
        }
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: inherit;
        text-decoration: none;
      }
      /* Sized by height, never width — the bar is a fixed height and the logo
         has to sit inside it with air above and below. `width: auto` lets the
         intrinsic ratio decide the rest.

         58 of the 68px content box. The stacked mark spends its height on three
         tiers where the wide lockup spends it on two, so it needs every pixel
         the bar will give it: this is what took the rendered mark from 51px
         wide to 62px, which is the difference between reading "TEXARKANA" and
         seeing a smudge under the GO. */
      .brand-logo {
        display: block;
        height: 58px;
        width: auto;
      }

      /*
       * `min-width: 0` is what makes the `overflow-x: auto` below actually work.
       *
       * A flex item defaults to `min-width: auto`, which refuses to shrink below
       * its content. Without this the nav stayed its full 433px, the header grew
       * past the viewport, and every page scrolled sideways on a phone — 169px of
       * overhang at 375px wide, on all twelve routes. The scrolling nav was
       * written correctly from the start; this one property is all that was
       * stopping it from ever engaging.
       */
      .site-header nav {
        min-width: 0;
        position: relative;
        /*
         * The nav takes exactly its own width and the two side zones split
         * whatever is left, which is what centres it on the bar rather than
         * near the middle. See `.brand` and `.header-socials` below — they are
         * the `1fr` halves of that.
         */
        flex: 0 0 auto;
      }

      /*
       * The other half of the centring pair, and they moved to do it.
       *
       * These used to sit tucked against the brand behind a hairline, so that
       * the left of the bar was "who we are and where to find us" and the right
       * was purely navigation. That grouping was real, but it left both clusters
       * on one side and 422px of nothing in the middle of a 1100px bar, which is
       * most of why the header read as unfinished. Anchored to the far edge they
       * balance the mark instead, and the marks are recognisable enough not to
       * need the brand's company to be read as ours.
       */
      .header-right {
        flex: 1 1 0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 14px;
        /* Never let the account name push the nav around; it truncates instead. */
        min-width: 0;
      }
      .header-socials {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        flex: 0 0 auto;
      }
      .header-socials a {
        display: block;
        line-height: 0;
        /* The marks are bare glyphs here, so this is what colours them —
           `currentColor` inside the SVG resolves against it. Slightly under
           white at rest so they read as secondary to the wordmark, which is the
           only thing in the header allowed to be pure white. */
        color: rgb(255 255 255 / 0.88);
        border-radius: 5px;
        transition:
          transform 0.16s ease,
          color 0.16s ease;
      }
      .header-socials a:hover {
        color: #fff;
        transform: translateY(-1px) scale(1.06);
      }
      .header-socials a:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 3px;
      }
      .header-socials svg {
        display: block;
      }

      /* Hidden until the panel breakpoint takes over below. 44px because it is
         the only way to reach anything on a phone — the icon itself is 30. */
      .nav-toggle {
        display: none;
        place-items: center;
        width: 44px;
        height: 44px;
        padding: 0;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: inherit;
        cursor: pointer;
      }
      .nav-toggle:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
      }
      /*
       * `:global` on the ball, and it is required rather than stylistic.
       *
       * The mark is its own component now, so it renders with PokeBall.astro's
       * scope and not this file's. Scoped, these selectors compile to
       * `.pokeball[data-astro-cid-hkbrpulz]`, the ball carries no such attribute,
       * and every rule below silently stops matching — which is exactly what
       * happened to this animation the moment the SVG moved out of this file.
       * The `.nav-toggle` half stays scoped, so nothing leaks.
       */
      .nav-toggle :global(.pokeball) {
        display: block;
        /* Global reduced-motion already flattens these to 0.01ms. */
        transition: transform 0.2s ease;
      }
      /* The centre button lights up when the menu is open, rather than the ball
         rotating. A Poké Ball turned 180° just puts the red half underneath,
         which reads as an upside-down ball rather than as an open menu; a lit
         button reads as "active" and leaves the mark the right way up. */
      .nav-toggle :global(.pokeball circle:last-of-type) {
        transition: fill 0.2s ease;
      }
      .nav-toggle[aria-expanded='true'] :global(.pokeball) {
        transform: scale(1.06);
      }
      .nav-toggle[aria-expanded='true'] :global(.pokeball circle:last-of-type) {
        fill: #ffe14d;
      }

      nav ul {
        display: flex;
        gap: 4px;
        margin: 0;
        padding: 0;
        list-style: none;
        overflow-x: auto;
        scrollbar-width: none;
        /* Deliberately not `justify-content: flex-end`: when a flex row
           overflows, end-alignment can push the first items past the start edge
           where no amount of scrolling reaches them. The current item is brought
           into view by script instead, which degrades to "starts at Home". */
        overscroll-behavior-x: contain;
        scroll-padding-inline: 12px;
      }
      nav ul::-webkit-scrollbar {
        display: none;
      }
      nav li {
        flex: 0 0 auto;
      }

      /*
       * Fades the left edge while the row is scrolled, so it reads as "there is
       * more back that way" rather than as a nav that starts at "Events".
       * `mask-image` rather than an overlaid gradient: the header is a solid
       * colour on some pages and sits over content on others, and a mask needs
       * no knowledge of what is behind it.
       *
       * animation-timeline is progressive enhancement — without support the nav
       * simply scrolls unfaded, which is the behaviour we already had.
       */
      @supports (animation-timeline: scroll(self inline)) {
        nav ul {
          animation: nav-fade-start linear both;
          animation-timeline: scroll(self inline);
          animation-range: 0 24px;
        }
        @keyframes nav-fade-start {
          from {
            mask-image: linear-gradient(to right, #000 0, #000 100%);
          }
          to {
            mask-image: linear-gradient(to right, transparent 0, #000 22px, #000 100%);
          }
        }
      }

      /*
       * One of the two zones the nav is centred between. `1 1 0` makes this and
       * `.header-socials` split the leftover width evenly, so the nav lands on
       * the bar's true centre — with a 62px mark on one side and 126px of marks
       * on the other, anything simpler leaves it centred by eye and off by
       * thirty-odd pixels.
       *
       * Growing is safe where shrinking would not be. A flex item's automatic
       * minimum size is its content, so this can never squeeze the logo — the
       * old `0 0 auto` was guarding against a *text* wordmark that truncated to
       * "PoGo …", and that has been an image for some time. The breakpoint below
       * still steps the height down rather than letting flex distort it.
       */
      .brand {
        flex: 1 1 0;
      }
      nav a {
        display: block;
        padding: 8px 14px;
        border-radius: 999px;
        /* 0.9, up from 0.82. Measured on the flat bar: 0.9 white is 4.92:1 and
           0.82 is 4.34:1 — the old value was already under AA for body-sized
           text, and it read as greyed-out besides. */
        color: rgb(255 255 255 / 0.9);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        white-space: nowrap;
        /* Transparent at rest so the chip's box never shifts when the border
           appears on hover. */
        border: 1px solid transparent;
        transition:
          background-color 0.16s ease,
          border-color 0.16s ease,
          color 0.16s ease;
      }
      nav a:hover {
        background: rgb(255 255 255 / 0.13);
        border-color: rgb(255 255 255 / 0.28);
        color: #fff;
      }
      /* `--accent-solid`, not `--accent`: this is dark text on a white chip, and
         in dark mode `--accent` is the *light* red meant for the opposite job —
         it measured 3.0:1 here. */
      nav a[aria-current='page'] {
        background: #fff;
        color: var(--accent-solid);
        border-color: #fff;
        /* The selected chip is the one thing on the bar that should look like it
           is sitting on top of it rather than in it. */
        box-shadow: 0 2px 6px rgb(0 0 0 / 0.28);
      }
      nav a[aria-current='page']:hover {
        background: #fff;
        color: var(--accent-solid);
      }
      /*
       * The quick-action screen is the point of the whole site on a phone; it
       * earns a bit of visual weight in the nav.
       *
       * Black — the Poké Ball's band — rather than the orange it used to be.
       * White on `--poi-gym` measured 3.18:1, under AA, and orange on a red bar
       * was muddy besides. It also has to stay distinct from `[aria-current]`,
       * which is a *white* chip: if Go were white too it would look permanently
       * selected.
       */
      nav a.nav-highlight {
        background: var(--ink-900);
        color: #fff;
        border-color: var(--ink-900);
        box-shadow: 0 2px 6px rgb(0 0 0 / 0.32);
      }
      nav a.nav-highlight:hover {
        background: var(--ink-900);
        border-color: rgb(255 255 255 / 0.4);
        color: #fff;
      }
      nav a.nav-highlight[aria-current='page'] {
        background: #fff;
        color: var(--accent-solid);
        border-color: #fff;
      }

      /* --- /go, as the ball ------------------------------------------------
       *
       * No chip behind it. The others earn their pill by being words that need
       * a boundary; this one is already a shape, and a full-colour mark in a row
       * of white text is louder than any pill would make it.
       *
       * Round, and sized to a 40px box rather than to the 26px art, so the
       * target stays a comfortable one on a touch screen where this is the
       * densest thing in the row.
       */
      nav a.nav-go {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        padding: 0;
        border-radius: 999px;
        line-height: 0;
      }
      nav a.nav-go:hover {
        background: rgb(255 255 255 / 0.13);
        border-color: rgb(255 255 255 / 0.28);
      }
      /* `:global` for the same reason as the toggle above — the ball is a child
         component and carries none of this file's scope. */
      nav a.nav-go :global(.pokeball) {
        transition: transform 0.16s ease;
      }
      nav a.nav-go:hover :global(.pokeball) {
        transform: scale(1.08);
      }
      /*
       * The current-page state cannot be the white chip the other items use —
       * filling the box white would leave a white-ringed ball on white and erase
       * its own outline. A ring around it instead, which is the same "this one
       * is selected" signal without touching the mark.
       */
      nav a.nav-go[aria-current='page'] {
        background: rgb(255 255 255 / 0.16);
        border-color: #fff;
      }
      /* Clipped rather than removed: an icon whose label is `display: none` has
         no accessible name left but the description, and reads as an empty link
         to Lighthouse. The phone panel below un-clips it. */
      .nav-go-label {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .site-footer {
        padding: 28px clamp(12px, 3vw, 24px);
        border-top: 1px solid var(--border);
        background: var(--bg-sunken);
        color: var(--text-muted);
        font-size: 0.76rem;
      }
      .site-footer p {
        max-width: 70ch;
        margin: 0 auto 10px;
      }
      .footer-brand {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-bottom: 14px;
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text);
      }
      .footer-links {
        text-align: center;
      }

      /* The logo is one indivisible image, so the old two-stage degrade (drop
         the tagline at 820px, then the wordmark at 430px) has nothing to drop.
         It steps down in height instead — still legible, and it hands ~30px
         back to the seven nav items it is competing with. */
      @media (max-width: 430px) {
        .site-header {
          height: 64px;
        }
        .brand-logo {
          height: 50px;
        }
      }

      /* The marks are a desktop affordance and nothing more. They cost roughly
         135px, and a squeezed nav does not overflow the header — it just scrolls
         — so keeping them on a phone would quietly shrink the primary navigation
         to pay for a secondary one. The home page's "Find us" carries the same
         four links, from the same source, so nothing is lost by dropping them. */
      @media (max-width: 1024px) {
        .header-socials {
          display: none;
        }
      }

      /*
       * Below 820px the nav stops being a scrolling row and becomes a panel
       * behind the Poké Ball.
       *
       * 820 rather than the ~590 where the row actually starts to overflow:
       * that is where the rest of the page already goes single-column, and a
       * header that reflows on a different boundary from the content under it
       * reads as a bug. It also means the row is never cramped — it is replaced
       * before it has to scroll at all.
       *
       * The panel is positioned against `.site-header`, which is `sticky` and
       * therefore already a containing block. It inherits the header's
       * `z-index: 900`, so it covers the map on the full-bleed pages too.
       */
      @media (max-width: 820px) {
        .nav-toggle {
          display: grid;
          margin-left: auto;
        }

        .site-header nav {
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          /* It is out of flow now, so the auto margin that kept the row right
             would do nothing but confuse the next reader. */
          margin-left: 0;
          background: var(--accent-solid);
          border-bottom: 4px solid var(--ink-900);
          box-shadow: 0 12px 24px -12px rgb(0 0 0 / 0.55);
          display: none;
        }
        .site-header nav[data-open] {
          display: block;
        }

        .site-header nav ul {
          flex-direction: column;
          align-items: stretch;
          /* The row's horizontal scroll has nothing to do here, and leaving it
             on clips the chips' focus rings. */
          overflow: visible;
          gap: 2px;
          padding: 8px clamp(12px, 3vw, 24px) 14px;
        }
        .site-header nav li {
          width: 100%;
        }
        nav a {
          padding: 11px 14px;
          font-size: 0.95rem;
        }

        /*
         * In the panel /go is a word again, and the ball goes away.
         *
         * The control that opened this panel is a Poké Ball sitting a few pixels
         * above it. A second one in the list would be the same mark meaning two
         * different things on one screen — and in a stacked list of words, a
         * lone icon is the odd row out rather than the prominent one.
         */
        nav a.nav-go {
          display: block;
          width: auto;
          height: auto;
          padding: 11px 14px;
          border-radius: 999px;
          line-height: inherit;
        }
        nav a.nav-go :global(.pokeball) {
          display: none;
        }
        /*
         * And the current-page state goes back to the white chip the other rows
         * use. The ring treatment above is built for a mark, which carries its
         * own colour — a word does not, and it keeps `color: var(--accent-solid)`
         * from the generic `[aria-current]` rule, so over a 16%-white wash it
         * came out dark red on red. Unnoticeable in the row, where the label is
         * clipped and there is nothing to read; plainly broken here, where it is
         * the only visible thing in the chip.
         */
        nav a.nav-go[aria-current='page'] {
          background: #fff;
          border-color: #fff;
        }
        .nav-go-label {
          position: static;
          width: auto;
          height: auto;
          margin: 0;
          overflow: visible;
          clip: auto;
        }
      }
    </style>

    {/*
      The account control's CSS, split out and `is:global` on purpose.

      Every node under `.header-account` is built with `document.createElement`
      in the script above, never by Astro — and Astro's scoped styles work by
      compiling `.foo` to `.foo[data-astro-cid-hkbrpulz]`, then stamping that
      attribute onto the elements it renders server-side. A `createElement`
      node never gets stamped, so every one of these selectors was silently
      matching nothing: the whole control has been rendering in raw browser
      defaults — an unstyled `<details>`/`<summary>` with its native disclosure
      triangle, and an unpositioned panel just flowing in normal document flow
      — since the day it shipped. That triangle is almost certainly the "play
      button" reported in prod, and the unpositioned panel is the "ugly text
      overlay": neither is a design problem the rules below were ever wrong
      about, they simply never ran.
    */}
    <style is:global>
      .header-account {
        flex: 0 0 auto;
        min-width: 0;
      }
      .header-account[hidden] {
        display: none;
      }

      .account-signin {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 32px;
        padding: 0 12px;
        border-radius: 999px;
        border: 1px solid rgb(255 255 255 / 0.34);
        color: #fff;
        font: 600 0.82rem/1 inherit;
        text-decoration: none;
        white-space: nowrap;
        transition:
          background-color 0.16s ease,
          border-color 0.16s ease;
      }
      .account-signin:hover {
        background: rgb(255 255 255 / 0.14);
        border-color: rgb(255 255 255 / 0.6);
      }
      .account-signin:focus-visible,
      .account-summary:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 3px;
      }

      .account-menu {
        position: relative;
      }
      /*
       * The marker is a disclosure triangle by default in every engine — the
       * "play button". `list-style: none` is the standards-track way to kill
       * it, `::-webkit-details-marker` is the legacy WebKit pseudo, and
       * `::marker` is added as a third belt: Chromium has a known quirk where
       * overriding `display` away from `list-item` on a `<summary>` (which
       * this rule does, to `inline-flex`) does not reliably suppress the
       * generated marker through `list-style` alone. All three are cheap
       * insurance against one engine's quirk outliving this comment.
       */
      .account-summary {
        list-style: none;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        max-width: 190px;
        height: 32px;
        padding: 0 10px;
        border-radius: 999px;
        border: 1px solid rgb(255 255 255 / 0.28);
        cursor: pointer;
        user-select: none;
      }
      .account-summary::-webkit-details-marker {
        display: none;
      }
      .account-summary::marker {
        display: none;
      }
      .account-summary:hover {
        background: rgb(255 255 255 / 0.14);
      }
      .account-avatar {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        flex: 0 0 auto;
        background: rgb(255 255 255 / 0.2);
      }
      .account-name {
        font: 600 0.82rem/1 inherit;
        color: #fff;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .account-panel {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        z-index: 60;
        /* Wide enough that "Use a different Discord account" — the longest
           row — never wraps to a second line. */
        min-width: 260px;
        padding: 6px;
        border-radius: 12px;
        /* Not the header's red: this is a surface floating over the page, and
           it has to read against whatever is under it rather than against the
           bar it hangs from. */
        background: #16212f;
        border: 1px solid #2b3a51;
        box-shadow: 0 14px 34px -10px rgb(0 0 0 / 0.62);
        color: #e8edf4;
      }
      .account-panel a {
        display: block;
        padding: 9px 10px;
        border-radius: 8px;
        color: inherit;
        font-size: 0.86rem;
        text-decoration: none;
      }
      .account-panel a:hover {
        background: #223047;
      }
      .account-panel a:focus-visible {
        outline: 2px solid #6ea8ff;
        outline-offset: -2px;
      }

      /* On a phone the header is already tight and the nav has collapsed into a
         panel, so the name goes and the avatar carries the control alone. */
      @media (max-width: 560px) {
        .account-name {
          display: none;
        }
        .account-summary {
          padding: 0 6px;
        }
      }
    </style>
  </body>
</html>
