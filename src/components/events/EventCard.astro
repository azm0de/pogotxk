---
/**
 * One event, community meetup or global game event alike — both arrive as a
 * `CalendarEvent`, so the card does not need to know which.
 *
 * On the kiosk board this is a calendar row, not a poster: a 64px thumbnail, the
 * time as the loudest line, then the title. The banner it used to carry made the
 * artwork the biggest thing on a card whose whole job is "when".
 *
 * The absolute local time is always rendered server-side; the countdown is an
 * optional enhancement layered on top of it.
 */

import type { CalendarEvent } from '~/lib/events';
import { describeRecurrence } from '~/lib/db/meetups';
import { proxiedImageUrl } from '~/lib/game-image';
import Countdown from './Countdown.astro';
import './EventCard.css';

interface Props {
  event: CalendarEvent;
  /** Pre-formatted local time, e.g. "Wed, Aug 5 · 6:00 PM – 7:00 PM CDT". */
  when: string;
  state: 'live' | 'ongoing' | 'upcoming' | 'past';
  /**
   * Render the event's artwork as a thumbnail. Both current callers pass it; the
   * default stays off so a new caller opts in rather than inheriting a network
   * request per card by accident.
   */
  showImage?: boolean;
  /**
   * The group this card sits in already names its state in its heading
   * ("Running now", "Recently finished"), so the card drops the word. Eight
   * RUNNING badges under a heading that says Running now is the heading typed
   * out eight more times.
   */
  stateNamedByGroup?: boolean;
  /**
   * How much of the row the artwork takes. `thumb` is the 64px square the
   * calendar scans past sixty times; `plate` runs the art down the whole left
   * side of the card; `poster` makes the art the whole card, with the words on
   * a scrim at its foot and no provenance plate — for the home page's short
   * list, where the owner wants the picture to be the card.
   */
  art?: 'thumb' | 'plate' | 'poster';
}

const {
  event,
  when,
  state,
  showImage = false,
  stateNamedByGroup = false,
  art = 'thumb',
} = Astro.props;

/*
 * Leek Duck artwork, served through our own origin — see lib/game-image.ts.
 *
 * Their placeholder for an event with no artwork is the Pokémon GO logo itself,
 * which this site does not use anywhere, and which says nothing about the event
 * either. Those rows fall back to `fallbackArt` below instead of Leek Duck's
 * picture.
 */
const GENERIC_ART = /events-default-img/;
const raw = showImage ? proxiedImageUrl(event.imageUrl) : null;
const image = raw && !GENERIC_ART.test(raw) ? raw : null;

/*
 * Fallback art, by event type, for a card with no real picture.
 *
 * Refusing Leek Duck's placeholder used to leave nothing to show at all: a
 * poster with no image falls back further still, to the bare `--ink-800`
 * rectangle in EventCard.css — legal, logo-free, and the least appealing
 * outcome available. These three images are the site's own instead: Niantic
 * key art already sitting in `public/hero/` under the fan-use position this
 * redesign already uses it under (the home hero, the campsite band), chosen
 * by event type rather than left blank. Being the site's own asset, no Leek
 * Duck credit or provenance plate attaches to them.
 *
 * Two of the three collages are themselves a problem, though: each is a
 * Niantic-drawn poster carrying the official "Pokémon GO" wordmark in one
 * corner and a copyright line along an edge, and a 16:9 poster card shows a
 * 16:9 picture whole — `object-fit: cover` has no excess to crop when the box
 * and the picture already share an aspect ratio. `anchor` and `zoom` below
 * are enlargement, not positioning: EventCard.css scales the picture up
 * about the fixed corner named by `anchor`, which pushes the wordmark and
 * the copyright line off the edge they sit against and out of the frame.
 * That is what keeps the site's no-logo rule true on these cards too.
 * `raid-battle` carries neither and stays at zoom 1.
 */
interface FallbackArt {
  src: string;
  srcset: string;
  /**
   * `transform-origin` for `zoom` below — the corner of the picture held
   * fixed while the rest enlarges around it, so the wordmark and the
   * copyright line (both near an edge) are what moves out of frame.
   */
  anchor: string;
  /**
   * `transform: scale()` applied to the picture inside its clipped 16:9 box.
   * `1` leaves it exactly as delivered; each per-bucket comment below works
   * out how much of which edge a higher value cuts.
   */
  zoom: number;
}

// Explicit rather than left to the substring test alone: `max-mondays` is a
// real ScrapedDuck slug that names a raid promotion but contains neither
// "raid" nor "battle".
const RAID_EVENT_TYPES = new Set([
  'raid-battles',
  'raid-day',
  'raid-hour',
  'raid-weekend',
  'elite-raids',
  'shadow-raids',
  'max-battles',
  'max-mondays',
]);

function fallbackArt(eventType: string | null | undefined): FallbackArt {
  const type = eventType?.trim().toLowerCase() ?? '';

  if (type === 'community-day') {
    return {
      src: '/hero/outing-960.webp',
      srcset: '/hero/outing-640.webp 640w, /hero/outing-960.webp 960w, /hero/outing-1280.webp 1280w',
      // The wordmark sits top-right (x ≈ 80–98%, y ≈ 3–20%) and the
      // copyright line runs the bottom edge. Anchored at the left edge, a
      // third of the way down, and enlarged 1.35x, the window that shows
      // through drops the right 26%, the top 9% and the bottom 17% — taking
      // the wordmark and the copyright line with them.
      anchor: '0% 35%',
      zoom: 1.35,
    };
  }

  if (RAID_EVENT_TYPES.has(type) || /raid|battle/.test(type)) {
    return {
      src: '/hero/raid-battle-960.webp',
      srcset:
        '/hero/raid-battle-640.webp 640w, /hero/raid-battle-960.webp 960w, /hero/raid-battle-1280.webp 1280w, /hero/raid-battle-1600.webp 1600w',
      // Carries neither the wordmark nor a copyright line — the one of the
      // three that doesn't — so there is nothing to crop out: zoom stays at
      // 1 and the anchor is inert.
      anchor: '50% 50%',
      zoom: 1,
    };
  }

  // Event, research, timed research, season, GO Pass, Hatch Day, PokéStop
  // Showcase, GO Fest, and anything this feed has not shipped yet.
  return {
    src: '/hero/pokestop-960.webp',
    srcset: '/hero/pokestop-640.webp 640w, /hero/pokestop-960.webp 960w, /hero/pokestop-1280.webp 1280w',
    // The wordmark sits bottom-left (x ≈ 2–15%, y ≈ 85–98%) and the
    // copyright line runs the bottom edge. Anchored at the top-right corner
    // and enlarged 1.3x, the window that shows through drops the left 23%
    // and the bottom 23% — taking the wordmark and the copyright line with
    // them.
    anchor: '100% 0%',
    zoom: 1.3,
  };
}

const fallback = showImage && !image ? fallbackArt(event.eventType) : null;

/*
 * The poster's own two widths: ~520px per card, two abreast inside the
 * 1100px `--container` once its gutters and the row's gap come out, and full
 * width less a phone's gutters in one column — the same rough approximation
 * the community photo's `sizes` already uses for that (src/pages/index.astro).
 * Raw px, not the tokens themselves: `sizes` is read by the HTML parser
 * before any stylesheet runs, so it cannot resolve a custom property.
 */
const FALLBACK_SIZES = '(min-width: 768px) 520px, calc(100vw - 40px)';

const recurrence = describeRecurrence(event.rrule ?? null);
const cancelled = event.status === 'CANCELLED';

// The UID's local part doubles as the anchor, so /events#meetup-3 survives a
// rename of the meetup it points at.
const anchor = event.uid.split('@')[0];

/*
 * The category word.
 *
 * Upstream headings are a mixed bag: some classify the event ("Raid Hour"), and
 * some say nothing at all — 8 of the 60 cards on this page came through headed
 * "Event", which on an events page is a badge that spends space to repeat the
 * page title. Those drop out and the card carries no badge at all.
 */
const CATEGORY_DROP = new Set(['event', 'events', 'live event', 'pokémon go', 'pokemon go']);
const CATEGORY_RENAME: Record<string, string> = {
  'pokémon spotlight hour': 'Spotlight Hour',
  'pokemon spotlight hour': 'Spotlight Hour',
  'pokémon go fest': 'GO Fest',
  'pokemon go fest': 'GO Fest',
  'community meetup': 'Meetup',
};

function categoryLabel(): string | null {
  if (event.source === 'meetup') return 'Meetup';
  const raw = event.heading?.trim();
  if (!raw) return null;
  const key = raw.toLowerCase();
  if (CATEGORY_DROP.has(key)) return null;
  return CATEGORY_RENAME[key] ?? raw;
}

const category = categoryLabel();

/**
 * The state as a word, because colour is never the only signal here.
 *
 * "Live" rides with the time and is never suppressed: a heading of "Running
 * now" covers a season that started in June as well as an hour that started at
 * six, and only the badge separates them. The quieter words are the ones the
 * heading really does say twice.
 */
const stateWord =
  state === 'live' ? 'Live' : state === 'ongoing' ? 'Running' : state === 'past' ? 'Finished' : null;
const badgeState = stateWord && state !== 'live' && !stateNamedByGroup ? stateWord : null;

const summary = event.description?.split('\n\n')[0]?.trim() ?? '';
const blurb = summary.length > 240 ? `${summary.slice(0, 237).trimEnd()}…` : summary;

// Only link out to somewhere that is actually elsewhere; a meetup with no
// Campfire page links back to this very card, which is not worth a link.
const externalUrl = event.url && !event.url.includes('/events#') ? event.url : null;

/*
 * Where the row came from, named — as a label, not a second link.
 *
 * This started as a "Details" button, 60 red controls naming nothing, and
 * became an anchor naming its destination. It was still the title link's
 * destination: two of the three links on every card went to the same URL, which
 * is how /events came to carry 120 links, 60 of them called "On Leek Duck".
 * The card is already that link end to end. What was missing was never a second
 * target, only the provenance, so this is now a printed plate: where the row
 * came from, and the arrow saying the card leaves the site.
 */
function sourceLabel(): string | null {
  if (!externalUrl) return null;
  try {
    const host = new URL(externalUrl).hostname;
    if (host.endsWith('leekduck.com')) return 'Leek Duck';
    if (host.endsWith('nianticlabs.com')) return 'Campfire';
  } catch {
    return null;
  }
  return null;
}

const source = sourceLabel();
---

{/*
  `--linked` rather than `:has(.event-title-link)`. The cursor and hover state
  are how anyone knows the card is clickable at all, and that should not depend
  on `:has()` being implemented — the stretched link itself works either way, but
  an invisible affordance is not an affordance.
*/}
<article
  class={`event-card card${externalUrl ? ' event-card--linked' : ''}${art === 'plate' ? ' event-card--plate' : ''}${art === 'poster' ? ' event-card--poster' : ''}`}
  id={anchor}
  data-state={state}
  data-source={event.source}
  data-cancelled={cancelled ? '' : undefined}
  aria-labelledby={`${anchor}-title`}
>
  {
    /* The box renders whenever there is a picture to put in it: real Leek Duck
       art, or — since an event with none of its own is served the Pokémon GO
       logo as upstream's "placeholder", and this site never shows that logo —
       this card's fallback art by event type instead. Only `showImage` being
       off leaves no box at all: four blank squares in a row read as four
       broken images, and the card's grid collapses to one column instead. */
    showImage && (image || fallback) && (
      <div class={`event-image${fallback ? ' event-image--fallback' : ''}`}>
        {/* Decorative either way: the title beside it says the same thing a
            real image's alt text would, and a fallback picture was never of
            the event to begin with — inventing alt text for either would be
            worse than none. */}
        {
          image ? (
            <img src={image} alt="" loading="lazy" decoding="async" width="64" height="64" />
          ) : (
            fallback && (
              <img
                src={fallback.src}
                srcset={fallback.srcset}
                sizes={FALLBACK_SIZES}
                alt=""
                loading="lazy"
                decoding="async"
                width="960"
                height="540"
                style={`--fallback-anchor: ${fallback.anchor}; --fallback-zoom: ${fallback.zoom}`}
              />
            )
          )
        }
      </div>
    )
  }

  <div class="event-body">
    {/*
      The time is the biggest line on the card. Everything else on an events page
      is a tie-breaker: people are here to find out when.
    */}
    <p class="event-when">
      <time datetime={event.start}>{when}</time>
      {
        /* No countdown once it is running: the state badge beside it already
           says "Live", and a season that has been live for six weeks does not
           need a ticker. On an upcoming card the countdown is also what
           announces the flip to live. */
        state === 'upcoming' && !cancelled && (
          <Countdown start={event.start} end={event.end} title={event.summary} />
        )
      }
      {/* Only "Live" rides with the time. "Running" and "Finished" go under the
          title with the category, so a multi-line date range is not followed by
          a lone badge sitting where an eyebrow would. */}
      {state === 'live' && <span class="badge badge--live">{stateWord}</span>}
    </p>

    {/*
      The title carries the link, not a button.

      The button was the obvious anchor for a stretched link and it does not
      work: the home page hides `.event-actions` outright, and a `display: none`
      element generates no boxes, so its `::after` never exists and the card
      stayed inert exactly where it was wanted most. The title renders
      everywhere.

      The `id` sits on the inner span so `aria-labelledby` names the card with
      the event alone — on the heading, the "(opens in a new tab)" note would
      have become part of the card's name.
    */}
    <h3 class="event-title">
      {
        externalUrl ? (
          <a class="event-title-link" href={externalUrl} rel="noopener noreferrer" target="_blank">
            <span id={`${anchor}-title`}>{event.summary}</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        ) : (
          <span id={`${anchor}-title`}>{event.summary}</span>
        )
      }
    </h3>

    {
      (category || cancelled || recurrence || badgeState) && (
        <p class="event-badges">
          {category && <span class="badge">{category}</span>}
          {badgeState && <span class="badge badge--outline">{badgeState}</span>}
          {cancelled && <span class="badge badge--outline">Cancelled</span>}
          {recurrence && <span class="badge badge--outline event-badge--repeat">{recurrence}</span>}
        </p>
      )
    }

    {
      event.location && (
        <p class="event-where">
          <span class="event-where-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="14" height="14">
              <path
                fill="currentColor"
                d="M8 0a5 5 0 0 0-5 5c0 3.6 4.4 10.4 4.6 10.7a.5.5 0 0 0 .8 0C8.6 15.4 13 8.6 13 5a5 5 0 0 0-5-5Zm0 7a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z"
              />
            </svg>
          </span>
          {event.locationUrl ? (
            <a class="target" href={event.locationUrl}>
              {event.location}
            </a>
          ) : (
            <span>{event.location}</span>
          )}
        </p>
      )
    }

    {blurb && <p class="event-blurb">{blurb}</p>}

    {
      source && art !== 'poster' && (
        <p class="event-actions">
          {/* Not a link: the title above it already goes here, and it carries
              the "(opens in a new tab)" note for both of them. */}
          <span class="badge badge--outline event-source">
            {source}
            <svg class="event-source-arrow" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
              <path
                d="M8 16 16 8M9.5 8H16v6.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </p>
      )
    }
  </div>
</article>
