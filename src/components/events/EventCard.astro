---
/**
 * One event, community meetup or global game event alike — both arrive as a
 * `CalendarEvent`, so the card does not need to know which.
 *
 * On the kiosk board this is a calendar row, not a poster: a 64px thumbnail, the
 * time as the loudest line, then the title. The banner it used to carry made the
 * artwork the biggest thing on a card whose whole job is "when".
 *
 * The absolute local time is always rendered server-side; the countdown is an
 * optional enhancement layered on top of it.
 */

import type { CalendarEvent } from '~/lib/events';
import { describeRecurrence } from '~/lib/db/meetups';
import { proxiedImageUrl } from '~/lib/game-image';
import Countdown from './Countdown.astro';
import './EventCard.css';

interface Props {
  event: CalendarEvent;
  /** Pre-formatted local time, e.g. "Wed, Aug 5 · 6:00 PM – 7:00 PM CDT". */
  when: string;
  state: 'live' | 'ongoing' | 'upcoming' | 'past';
  /**
   * Render the event's artwork as a thumbnail. Both current callers pass it; the
   * default stays off so a new caller opts in rather than inheriting a network
   * request per card by accident.
   */
  showImage?: boolean;
}

const { event, when, state, showImage = false } = Astro.props;

/*
 * Leek Duck artwork, served through our own origin — see lib/game-image.ts.
 *
 * Their placeholder for an event with no artwork is the Pokémon GO logo itself,
 * which this site does not use anywhere, and which says nothing about the event
 * either. Those rows keep the flat thumbnail panel instead.
 */
const GENERIC_ART = /events-default-img/;
const raw = showImage ? proxiedImageUrl(event.imageUrl) : null;
const image = raw && !GENERIC_ART.test(raw) ? raw : null;

const recurrence = describeRecurrence(event.rrule ?? null);
const cancelled = event.status === 'CANCELLED';

// The UID's local part doubles as the anchor, so /events#meetup-3 survives a
// rename of the meetup it points at.
const anchor = event.uid.split('@')[0];

/*
 * The category word.
 *
 * Upstream headings are a mixed bag: some classify the event ("Raid Hour"), and
 * some say nothing at all — 8 of the 60 cards on this page came through headed
 * "Event", which on an events page is a badge that spends space to repeat the
 * page title. Those drop out and the card carries no badge at all.
 */
const CATEGORY_DROP = new Set(['event', 'events', 'live event', 'pokémon go', 'pokemon go']);
const CATEGORY_RENAME: Record<string, string> = {
  'pokémon spotlight hour': 'Spotlight Hour',
  'pokemon spotlight hour': 'Spotlight Hour',
  'pokémon go fest': 'GO Fest',
  'pokemon go fest': 'GO Fest',
  'community meetup': 'Meetup',
};

function categoryLabel(): string | null {
  if (event.source === 'meetup') return 'Meetup';
  const raw = event.heading?.trim();
  if (!raw) return null;
  const key = raw.toLowerCase();
  if (CATEGORY_DROP.has(key)) return null;
  return CATEGORY_RENAME[key] ?? raw;
}

const category = categoryLabel();

/** The state as a word, because colour is never the only signal here. */
const stateWord =
  state === 'live' ? 'Live' : state === 'ongoing' ? 'Running' : state === 'past' ? 'Finished' : null;

const summary = event.description?.split('\n\n')[0]?.trim() ?? '';
const blurb = summary.length > 240 ? `${summary.slice(0, 237).trimEnd()}…` : summary;

// Only link out to somewhere that is actually elsewhere; a meetup with no
// Campfire page links back to this very card, which is not worth a link.
const externalUrl = event.url && !event.url.includes('/events#') ? event.url : null;

/*
 * Where the row came from, named.
 *
 * This replaces the "Details" button — 60 of them shipped on this page, each a
 * red control saying nothing about its destination. The source link says where
 * it goes and reads as provenance, which is the honest description of an
 * outbound link on data we did not write.
 */
function sourceLabel(): string | null {
  if (!externalUrl) return null;
  try {
    const host = new URL(externalUrl).hostname;
    if (host.endsWith('leekduck.com')) return 'On Leek Duck';
    if (host.endsWith('nianticlabs.com')) return 'On Campfire';
  } catch {
    return null;
  }
  return null;
}

const source = sourceLabel();
---

{/*
  `--linked` rather than `:has(.event-title-link)`. The cursor and hover state
  are how anyone knows the card is clickable at all, and that should not depend
  on `:has()` being implemented — the stretched link itself works either way, but
  an invisible affordance is not an affordance.
*/}
<article
  class={`event-card card${externalUrl ? ' event-card--linked' : ''}`}
  id={anchor}
  data-state={state}
  data-source={event.source}
  data-cancelled={cancelled ? '' : undefined}
  aria-labelledby={`${anchor}-title`}
>
  {
    /* The box renders whenever the caller asked for artwork, with or without an
       image in it: it is the fallback surface while the picture loads, it is
       what a 404 leaves behind, and it keeps every row in a column aligned on
       one left rail. */
    showImage && (
      <div class="event-image">
        {/* Decorative: the title right beside it says the same thing, and
            upstream gives us no alt text — inventing one would be worse than
            none. */}
        {image && (
          <img src={image} alt="" loading="lazy" decoding="async" width="64" height="64" />
        )}
      </div>
    )
  }

  <div class="event-body">
    {/*
      The time is the biggest line on the card. Everything else on an events page
      is a tie-breaker: people are here to find out when.
    */}
    <p class="event-when">
      <time datetime={event.start}>{when}</time>
      {
        /* No countdown once it is running: the state badge beside it already
           says "Live", and a season that has been live for six weeks does not
           need a ticker. On an upcoming card the countdown is also what
           announces the flip to live. */
        state === 'upcoming' && !cancelled && (
          <Countdown start={event.start} end={event.end} title={event.summary} />
        )
      }
      {/* Only "Live" rides with the time. "Running" and "Finished" go under the
          title with the category, so a multi-line date range is not followed by
          a lone badge sitting where an eyebrow would. */}
      {state === 'live' && <span class="badge badge--live">{stateWord}</span>}
    </p>

    {/*
      The title carries the link, not a button.

      The button was the obvious anchor for a stretched link and it does not
      work: the home page hides `.event-actions` outright, and a `display: none`
      element generates no boxes, so its `::after` never exists and the card
      stayed inert exactly where it was wanted most. The title renders
      everywhere.

      The `id` sits on the inner span so `aria-labelledby` names the card with
      the event alone — on the heading, the "(opens in a new tab)" note would
      have become part of the card's name.
    */}
    <h3 class="event-title">
      {
        externalUrl ? (
          <a class="event-title-link" href={externalUrl} rel="noopener noreferrer" target="_blank">
            <span id={`${anchor}-title`}>{event.summary}</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        ) : (
          <span id={`${anchor}-title`}>{event.summary}</span>
        )
      }
    </h3>

    {
      (category || cancelled || recurrence || (stateWord && state !== 'live')) && (
        <p class="event-badges">
          {category && <span class="badge">{category}</span>}
          {stateWord && state !== 'live' && <span class="badge badge--outline">{stateWord}</span>}
          {cancelled && <span class="badge badge--outline">Cancelled</span>}
          {recurrence && <span class="badge badge--outline event-badge--repeat">{recurrence}</span>}
        </p>
      )
    }

    {
      event.location && (
        <p class="event-where">
          <span class="event-where-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="14" height="14">
              <path
                fill="currentColor"
                d="M8 0a5 5 0 0 0-5 5c0 3.6 4.4 10.4 4.6 10.7a.5.5 0 0 0 .8 0C8.6 15.4 13 8.6 13 5a5 5 0 0 0-5-5Zm0 7a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z"
              />
            </svg>
          </span>
          {event.locationUrl ? (
            <a class="target" href={event.locationUrl}>
              {event.location}
            </a>
          ) : (
            <span>{event.location}</span>
          )}
        </p>
      )
    }

    {blurb && <p class="event-blurb">{blurb}</p>}

    {
      source && (
        <p class="event-actions">
          <a
            class="target event-source"
            href={externalUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            {source}
            <svg class="event-source-arrow" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
              <path
                d="M8 16 16 8M9.5 8H16v6.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
      )
    }
  </div>
</article>
