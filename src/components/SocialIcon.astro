---
/**
 * Brand marks for the social links.
 *
 * Inlined as SVG rather than loaded from a CDN icon font: these sit in the
 * page's most-linked section, and an external request that fails leaves four
 * unlabelled squares. They are also single-colour, so they inherit
 * `currentColor` and work on every button background without a second asset.
 *
 * All four are the official marks, used nominatively to link to our own
 * profiles on those services. Discord, Facebook and Instagram come from Simple
 * Icons (CC0); Campfire is traced from Niantic's app icon.
 *
 * Campfire is the one with a full-colour icon (a purple-to-cyan tile behind an
 * orange flame). It is drawn here as a single-colour silhouette like the other
 * three, because these sit on brand-coloured tiles — one full-colour tile in a
 * row of white marks reads as a rendering bug rather than a brand. The shape is
 * theirs and unmistakable; only the fill is ours.
 */

interface Props {
  name: 'discord' | 'campfire' | 'facebook' | 'instagram';
  size?: number;
  /**
   * Default true, because every current use sits beside a visible text label.
   * Announcing the mark as well makes a screen reader read "Discord Discord".
   * Pass false only where the icon is the only thing naming the link.
   */
  decorative?: boolean;
}

const { name, size = 22, decorative = true } = Astro.props;

const PATHS: Record<Props['name'], string> = {
