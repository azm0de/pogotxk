---
/**
 * The four social marks, as each brand's actual app icon.
 *
 * Inlined as SVG rather than fetched: these sit in the most-linked section on
 * the site, and an external request that fails leaves four blank squares. Being
 * vector, they also stay sharp at any size and cost no extra requests.
 *
 * Niantic publishes no vector Campfire logo — campfire.nianticlabs.com is a
 * Google Sites page serving rasters, and the "Campfire" logos on the vector
 * aggregator sites are a different company's. So the Campfire icon here is
 * traced from the app icon: the purple-to-cyan tile, the concentric rings, the
 * flame, and the white dome at its base.
 *
 * All four are used nominatively — to link to our own presence on each service.
 * The marks remain the property of their owners.
 */

interface Props {
  name: 'discord' | 'campfire' | 'facebook' | 'instagram';
  size?: number;
  /**
   * Default true, because every current use sits beside a visible text label.
   * Announcing the mark as well makes a screen reader read "Discord Discord".
   * Pass false only where the icon is the only thing naming the link.
   */
  decorative?: boolean;
}

const { name, size = 44, decorative = true } = Astro.props;

const LABEL: Record<Props['name'], string> = {
  discord: 'Discord',
  campfire: 'Campfire',
  facebook: 'Facebook',
  instagram: 'Instagram',
};

// Namespaces the gradient/clip ids. Derived from the name rather than randomised
// so the markup is byte-stable across renders; each icon appears once per page,
// and were one repeated the duplicate defs would be identical anyway.
const uid = `si-${name}`;
---

<svg
  viewBox="0 0 48 48"
  width={size}
  height={size}
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : LABEL[name]}
  focusable="false"
>
  {
    name === 'discord' && (
      <>
        <rect width="48" height="48" rx="11" fill="#5865F2" />
        <g transform="translate(9.6 9.6) scale(1.2)">
          <path
            fill="#fff"
            d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286ZM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189Zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"
          />
        </g>
      </>
    )
  }

  {
    name === 'facebook' && (
      <>
        <rect width="48" height="48" rx="11" fill="#0866FF" />
        {/* The f sits on the baseline and bleeds off the bottom, as on the real icon. */}
        <path
          fill="#fff"
          d="M32.6 30.9 33.65 24.3H27.3v-4.28c0-1.8.89-3.56 3.72-3.56h2.9v-5.62s-2.63-.45-5.15-.45c-5.25 0-8.69 3.18-8.69 8.95v5.07h-5.81v6.6h5.81V48h7.15V30.9Z"
        />
      </>
    )
  }

  {
    name === 'instagram' && (
      <>
        <defs>
          <radialGradient id={`${uid}-g`} cx="0.3" cy="1.07" r="1.2">
            <stop offset="0%" stop-color="#FDF497" />
            <stop offset="5%" stop-color="#FDF497" />
            <stop offset="45%" stop-color="#FD5949" />
            <stop offset="60%" stop-color="#D6249F" />
            <stop offset="90%" stop-color="#285AEB" />
          </radialGradient>
        </defs>
        <rect width="48" height="48" rx="11" fill={`url(#${uid}-g)`} />
        <rect
          x="13"
          y="13"
          width="22"
          height="22"
          rx="6.4"
          fill="none"
          stroke="#fff"
          stroke-width="2.7"
        />
        <circle cx="24" cy="24" r="5.6" fill="none" stroke="#fff" stroke-width="2.7" />
        <circle cx="30.9" cy="17.1" r="1.7" fill="#fff" />
      </>
    )
  }

  {
    name === 'campfire' && (
      <>
        <defs>
          {/* Purple at the top through blue to cyan at the base. */}
          <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#8B5CF6" />
            <stop offset="42%" stop-color="#5AA6F8" />
            <stop offset="100%" stop-color="#5CF6EE" />
          </linearGradient>
          {/* Red at the tip falling to yellow where it meets the dome. */}
          <linearGradient id={`${uid}-fl`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#FF2D3B" />
            <stop offset="55%" stop-color="#FF8A1E" />
            <stop offset="100%" stop-color="#FFD447" />
          </linearGradient>
          {/* The rings are drawn full-width and clipped to the tile. */}
          <clipPath id={`${uid}-clip`}>
            <rect width="48" height="48" rx="11" />
          </clipPath>
        </defs>

        <g clip-path={`url(#${uid}-clip)`}>
          <rect width="48" height="48" fill={`url(#${uid}-bg)`} />

          {/* Concentric lighter arcs sweeping up from the base. Drawn oversized
              and clipped, which is what gives them the flat-bottomed sweep. */}
          <ellipse cx="24" cy="58" rx="44" ry="40" fill="#fff" opacity="0.17" />
          <ellipse cx="24" cy="60" rx="32" ry="30" fill="#fff" opacity="0.2" />

          {/* The flame reaches the bottom edge and is clipped by the tile, so
              the cyan only shows at the rounded corners — as on the real icon.
              Sides are near-straight below the tip and flare out toward the
              base; a plain triangle reads as a generic mountain. */}
          {/* Stroked in its own fill with a round join purely to soften the
              tip — the real tip has a small radius, and rounding the join is
              far less brittle than hand-fitting an arc onto the apex. */}
          <path
            fill={`url(#${uid}-fl)`}
            stroke={`url(#${uid}-fl)`}
            stroke-width="1.8"
            stroke-linejoin="round"
            d="M24 10.4C28.2 20.6 42.8 33.8 42.8 47.2H5.2C5.2 33.8 19.8 20.6 24 10.4Z"
          />

          {/* Solid white, not a hole. The dome on the real icon is white against
              a cyan base — punching through would tint it with the gradient. */}
          <circle cx="24" cy="45.6" r="7.1" fill="#fff" />
        </g>
      </>
    )
  }
</svg>
