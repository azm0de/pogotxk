  // Niantic's Campfire mark: a pointed arch with a domed opening at its base.
  // Two subpaths + evenodd, so the dome is a hole the tile shows through —
  // filling it white would only work on a background that happens to be white.
  // Proportions follow the app icon: the arch is wider than it is tall, and the
  // dome spans about a third of the base. Getting that ratio wrong makes it
  // read as a generic triangle, which is the whole thing this replaced.
  campfire:
    'M12 3.8C14 8.2 22.2 16.5 22.2 21H1.8C1.8 16.5 10 8.2 12 3.8Z M8.5 21a3.5 3.5 0 0 1 7 0Z',
};

/** Icons whose shape is defined by holes rather than a single outline. */
const EVENODD = new Set<Props['name']>(['campfire']);

const LABEL: Record<Props['name'], string> = {
  discord: 'Discord',
  campfire: 'Campfire',
  facebook: 'Facebook',
  instagram: 'Instagram',
};
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : LABEL[name]}
  focusable="false"
>
  <path
    fill="currentColor"
    fill-rule={EVENODD.has(name) ? 'evenodd' : undefined}
    d={PATHS[name]}
  />
</svg>
