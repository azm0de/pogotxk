---
/**
 * The Poké Ball.
 *
 * Three things use it — the brand plate in the header, the menu toggle below
 * 820px, and the footer mark — so it lives in one place rather than as copies
 * that drift apart the first time one of them is adjusted.
 *
 * Decorative by default. Every current caller sits inside a control or a plate
 * that already carries its own accessible name, and naming the mark as well
 * would have a screen reader announce the thing twice.
 *
 * Every colour below is a raw hex on purpose. This is a mark, not a surface:
 * its colours are the object's own (white shell, black band, the brand red)
 * and they must not follow a theme, or the ball turns grey at night. They are
 * therefore exempt from the tokens rule, and each one is commented where it
 * sits.
 */
interface Props {
  size?: number;
  class?: string;
  /**
   * `on-red` is the header's mark: a white shell with the black band and a red
   * centre button. On the red bar this is the only version that keeps its own
   * silhouette — a red-topped ball loses its top half into the background, and
   * what is left reads as a ring with a dot in it.
   *
   * `neutral` is the favicon's treatment (`public/favicon.svg`): the same white
   * shell with a dark ring, for a mark that has to hold on `--bg-sunken` in
   * both themes rather than on one known red.
   *
   * `red` is the original two-tone ball, kept for anywhere the mark sits on a
   * light page and can afford its red half.
   */
  variant?: 'on-red' | 'neutral' | 'red';
}

const { size = 30, class: className, variant = 'on-red' } = Astro.props;

/* The outer ring. White on the red bar so the shell reads as one shape against
   it; ink everywhere else, where a white ring would erase itself. */
const ring = variant === 'on-red' ? '#ffffff' : '#0f0f11';
/* The centre button. Brand red on the two flat variants, which is what stops a
   white-and-black ball reading as a golf ball; white on the two-tone one, where
   the red is already spent on the top half. */
const button = variant === 'red' ? '#ffffff' : '#c8071c';
---

<svg
  class:list={['pokeball', className]}
  viewBox="0 0 40 40"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  {/* The shell. White in every variant. */}
  <circle cx="20" cy="20" r="17" fill="#ffffff"></circle>
  {
    variant === 'red' && (
      /* Upper half only: sweep-flag 1 from the leftmost point runs over the
         top. Brighter than the header's own #c8071c so the two reds are not
         mistaken for one another. */
      <path d="M3 20a17 17 0 0 1 34 0Z" fill="#ff2f3d" />
    )
  }
  {/* The band. Weights are set for 30px, not for the 4x view where they were
      drawn: at 4/3/3 the black swallowed most of a 25px ball and it read as a
      dark disc. #0f0f11 is `--ink-900`'s value, pinned here because the mark
      does not follow the theme. */}
  <path d="M3 20h34" stroke="#0f0f11" stroke-width="3.2"></path>
  <circle cx="20" cy="20" r="17" fill="none" stroke={ring} stroke-width="2.6"></circle>
  {/* The centre button, ringed in the band's own ink. */}
  <circle cx="20" cy="20" r="5.8" fill={button} stroke="#0f0f11" stroke-width="2.4"></circle>
</svg>
