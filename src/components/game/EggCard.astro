---
/**
 * One species in an egg pool.
 *
 * Hatch CP is fixed at level 20, so the min/max here is the entire spread you
 * can get — worth showing, because it is how you spot a hundo before you power
 * anything up.
 *
 * A pool where every species shares the same rarity tier, or where every one of
 * them can be shiny, says so once in its panel head instead of printing the
 * same mark on twenty-seven cards: `showRarity` and `showShiny` are how the
 * page turns those off.
 */
import './game.css';
import ShinyMark from './ShinyMark.astro';
import { proxiedImageUrl } from '~/lib/game-image';
import { type EggEntry } from '~/lib/scrapedduck';
import { formatCp } from '~/lib/game-format';

interface Props {
  egg: EggEntry;
  /** False when the whole pool shares one rarity tier and the head says so. */
  showRarity?: boolean;
  /** False when every species in the pool has the same shiny answer. */
  showShiny?: boolean;
}

const { egg, showRarity = true, showShiny = true } = Astro.props;

const art = proxiedImageUrl(egg.image);

const flags = [
  egg.isAdventureSync && 'Adventure Sync',
  egg.isGiftExchange && 'From gifts',
  egg.isRegional && 'Regional',
].filter((flag): flag is string => typeof flag === 'string');

// Leek Duck publishes `rarity` as a 1–5 tier and does not document which end is
// rare, so the dots are shown as their raw tier rather than relabelled
// "common"/"rare" — inventing a direction here would be worse than showing none.
const RARITY_MAX = 5;
// A missing `rarity` would otherwise reach the template as NaN and be announced
// as "rarity tier NaN of 5"; no dots is the honest rendering of "not published".
const rarity = Number.isFinite(egg.rarity)
  ? Math.min(Math.max(Math.round(egg.rarity), 0), RARITY_MAX)
  : 0;
const dots = Array.from({ length: RARITY_MAX }, (_, i) => i < rarity);
---

<li class="card g-card" data-shiny={egg.canBeShiny ? 'true' : 'false'}>
  <div class="g-card-top">
    <h3 class="g-card-name">{egg.name}</h3>
    {showShiny && egg.canBeShiny && <ShinyMark />}
  </div>

  {/* alt="" — the species name is the heading directly above it. */}
  {
    art ? (
      <img class="g-art" src={art} alt="" width="96" height="96" loading="lazy" decoding="async" />
    ) : (
      <span class="g-art" aria-hidden="true" />
    )
  }

  <dl class="g-facts">
    <dt>Hatch CP</dt>
    <dd>{formatCp(egg.combatPower)}</dd>
    {showRarity && <dt>Rarity tier</dt>}
    {
      showRarity && (
        <dd>
          <span
            class="g-rarity"
            role="img"
            aria-label={`Leek Duck rarity tier ${rarity} of ${RARITY_MAX}`}
          >
            {dots.map((on) => (
              <span class:list={[on && 'is-on']} />
            ))}
          </span>
        </dd>
      )
    }
  </dl>

  {
    flags.length > 0 && (
      <ul class="g-badges" aria-label={`${egg.name} notes`}>
        {flags.map((flag) => (
          <li class="badge">{flag}</li>
        ))}
      </ul>
    )
  }
</li>
