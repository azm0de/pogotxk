---
/**
 * "Where did this come from and how old is it" line.
 *
 * A stale raid list is still useful, but only if the reader can see that it is
 * stale — someone standing at a gym needs to know whether to trust the tier
 * before they burn a pass. The exact local time sits beside the fuzzy one
 * because "2 hours ago" is useless once the page itself has been open a while.
 */
import './game.css';
import { relativeTime } from '~/lib/scrapedduck';
import { DEFAULT_TZ, formatInZone } from '~/lib/time';

interface Props {
  fetchedAt: string | null;
  stale: boolean;
  /** What the feed is called in prose, e.g. "raid list". */
  label: string;
  /** Why the refresh failed, when we know. Carried on the feed payload. */
  error?: string | null;
}

const { fetchedAt, stale, label, error = null } = Astro.props;

/**
 * `stale` covers two different failures and they deserve different words.
 * getFeed lands here both when upstream was unreachable *and* when it answered
 * 200 with a body we refused — a truncated scrape, an empty array. Blaming Leek
 * Duck for the second is wrong, and sends anyone debugging it to the wrong
 * place.
 */
const reachedButUnusable = Boolean(error && /parse|empty|array|shape|invalid/i.test(error));
const staleReason = reachedButUnusable
  ? 'The last update did not look right, so we kept the previous data rather than showing you something wrong.'
  : 'Leek Duck could not be reached on the last try — we kept the previous data rather than showing you nothing.';

const relative = relativeTime(fetchedAt);
const absolute = fetchedAt ? formatInZone(fetchedAt, DEFAULT_TZ) : null;
---

<!--
  No role="status": this is server-rendered and never updates, so announcing it
  as a live region only competes with the genuine one on /raids.
-->
<p class:list={['g-status', stale && 'g-status--stale']}>
  {
    fetchedAt ? (
      <>
        <span>
          {stale ? <strong>Showing a saved copy.</strong> : null} This {label} was last refreshed{' '}
          <strong>{relative}</strong>
          {absolute ? <> (<time datetime={fetchedAt}>{absolute}</time>)</> : null}.
        </span>
        {stale ? <span>{staleReason}</span> : null}
      </>
    ) : (
      <span><strong>Live data unavailable.</strong> We have not been able to reach the {label} source yet.</span>
    )
  }
</p>
