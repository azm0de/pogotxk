---
/**
 * One field research task and everything it can reward.
 *
 * Upstream ships the task text as a fragment of Leek Duck's markup, so it goes
 * through `stripTags` before Astro escapes it — we render their words, never
 * their HTML. The reward art goes through our proxy rather than their CDN.
 */
import './game.css';
import ShinyMark from './ShinyMark.astro';
import { proxiedImageUrl } from '~/lib/game-image';
import { type ResearchTask } from '~/lib/scrapedduck';
import { formatCp, stripTags } from '~/lib/game-format';

interface Props {
  task: ResearchTask;
}

const { task } = Astro.props;

const text = stripTags(task.text);
const rewards = (task.rewards ?? []).map((reward) => ({
  ...reward,
  image: proxiedImageUrl(reward.image),
}));
const anyShiny = rewards.some((reward) => reward.canBeShiny);

/*
 * The same rule /eggs applies to its pools: a mark that says the same thing on
 * every tile is not a mark, it is wallpaper. Most tasks reward one encounter, so
 * "✦ SHINY REWARD" in the card head and "✦ SHINY" on the tile under it were the
 * same sentence twice, 33 times down the page. Where the card agrees with
 * itself the head says it once; where only some rewards can be shiny the tiles
 * are the only thing saying which, so they stay.
 */
const everyShiny = rewards.length > 0 && rewards.every((reward) => reward.canBeShiny);
---

<li class="card g-card" data-shiny={anyShiny ? 'true' : 'false'}>
  <div class="g-card-top">
    <h3 class="g-card-name">{text}</h3>
    {anyShiny && <ShinyMark label="Shiny reward" />}
  </div>

  <ul class="g-rewards" aria-label={`Rewards for ${text}`}>
    {
      rewards.map((reward) => (
        <li class="g-reward">
          {/* alt="" — the reward's name is printed directly under it. */}
          {reward.image ? (
            <img
              class="g-art g-art--sm"
              src={reward.image}
              alt=""
              width="56"
              height="56"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span class="g-art g-art--sm" aria-hidden="true" />
          )}
          <span class="g-reward-name">{reward.name}</span>
          <span class="g-reward-cp">CP {formatCp(reward.combatPower)}</span>
          {reward.canBeShiny && !everyShiny && <ShinyMark />}
        </li>
      ))
    }
  </ul>

  {rewards.length === 0 && <p class="g-reward-none">Reward not listed upstream.</p>}
</li>

<style>
  /* Reward tiles are specific to this card, so they stay scoped here rather
     than growing the shared sheet. Nothing in this block is a primitive name. */
  .g-rewards {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .g-reward {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    width: 108px;
    min-width: 0;
    padding: var(--space-2) var(--space-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-sunken);
    text-align: center;
  }
  /* Was 11.5px, under the readable floor for a name somebody is matching
     against a game screen in sunlight. */
  .g-reward-name {
    min-width: 0;
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: var(--lh-ui);
  }
  .g-reward-cp {
    color: var(--text-muted);
    font-family: var(--font-sign);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
  .g-reward-none {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
